// The test plugin's panel: what shows inside the DAW's plugin window. Built from the app's own style (studio.slint),
// so it looks like the app. Two views: Sounds (a list from the app's sound library, click to play through the track)
// with the app's own filters and orders)
// and DAW check (every CLAP extension the DAW was asked for, and whether it has it).

import { Theme, Type, Space, SearchBox, ListLine, StudioButton, Segmented, TickLine, Caps, Heart } from "../../mo-ui/ui/studio.slint";
import { ListView } from "../../mo-ui/ui/list.slint";

import "../../mo-ui/fonts/IBMPlexSans-400.ttf";
import "../../mo-ui/fonts/IBMPlexSans-600.ttf";
import "../../mo-ui/fonts/IBMPlexMono-400.ttf";

export struct SoundLine {
    name: string,
    // The folder it's in, shorter: the second line.
    folder: string,
    // Its type, tempo, key and length, as far as the app knows them: after the folder.
    facts: string,
    favourite: bool,
    // Its waveform, white on nothing (the line tints it); empty until it's read, or when it has none.
    wave: image,
}

// One type in the filter column, with how many sounds picking it would show.
export struct TypeLine {
    text: string,
    count: string,
    on: bool,
}

export struct ExtensionLine {
    // What the extension is for, in plain words.
    name: string,
    // The id the DAW was asked for, exactly.
    id: string,
    offered: bool,
}

export component Panel inherits Window {
    // The DAW and its version, and the track the plugin is on, when the DAW says.
    in property <string> host;
    in property <string> track;
    in property <[SoundLine]> sounds;
    // How the read went: "Reading the sound library", "1,234 sounds", or what's wrong.
    in property <string> status;
    // What's playing, or what went wrong playing it.
    in property <string> playing;
    in property <[ExtensionLine]> extensions;
    in property <string> extensions-summary;
    // "Copied" after Copy list, or what went wrong.
    in property <string> copied;
    // The filter column: the most used types, hits or loops, and your favourites.
    in property <[TypeLine]> types;
    in property <bool> hits;
    in property <bool> loops;
    in property <bool> favourites;
    // The orders on offer, and the one the list is in.
    in property <[string]> orders;
    in property <int> order;
    in-out property <int> picked: -1;
    in-out property <int> view: 0;
    callback search(string);
    callback play(int);
    callback stop();
    callback toggle-type(string);
    callback toggle-hits();
    callback toggle-loops();
    callback toggle-favourites();
    callback pick-order(int);
    callback copy();

    title: "Music Organiser";
    preferred-width: 760px;
    preferred-height: 560px;
    background: Theme.background;
    default-font-family: Theme.text-font;
    default-font-size: Type.body;

    VerticalLayout {
        padding: Space.lg;
        spacing: Space.md;

        HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                spacing: Space.xs;
                Text {
                    text: "Music Organiser";
                    color: Theme.text;
                    font-size: Type.heading;
                    font-weight: 600;
                }
                Text {
                    text: root.track == "" ? root.host : root.host + "  ·  track " + root.track;
                    color: Theme.muted;
                    font-size: Type.meta;
                }
            }
            Rectangle { }
            Segmented {
                choices: ["Sounds", "DAW check"];
                current: root.view;
                picked(i) => { root.view = i; }
            }
        }

        if root.view == 0: HorizontalLayout {
            spacing: Space.lg;
            // The filter column, as the app's pages have it: ticks, each with its count.
            VerticalLayout {
                width: 176px;
                alignment: start;
                spacing: 0;
                Caps {
                    text: "TYPE";
                    height: 22px;
                }
                for t in root.types: TickLine {
                    text: t.text;
                    count: t.count;
                    on: t.on;
                    dim: t.count == "0" && !t.on;
                    clicked => { root.toggle-type(t.text); }
                }
                Rectangle { height: Space.md; }
                Caps {
                    text: "LENGTH";
                    height: 22px;
                }
                TickLine {
                    text: "Hits";
                    on: root.hits;
                    clicked => { root.toggle-hits(); }
                }
                TickLine {
                    text: "Loops";
                    on: root.loops;
                    clicked => { root.toggle-loops(); }
                }
                Rectangle { height: Space.md; }
                Caps {
                    text: "YOURS";
                    height: 22px;
                }
                TickLine {
                    text: "Favourites";
                    on: root.favourites;
                    clicked => { root.toggle-favourites(); }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    SearchBox {
                        horizontal-stretch: 1;
                        hint: "Search sounds";
                        edited(text) => { root.search(text); }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "Stop";
                        clicked => { root.stop(); }
                    }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.status;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    Segmented {
                        horizontal-stretch: 0;
                        choices: root.orders;
                        current: root.order;
                        pad: Space.md;
                        picked(i) => { root.pick-order(i); }
                    }
                }
                ListView {
                    row-height: 48px;
                    rows: root.sounds.length;
                    for sound[i] in root.sounds: ListLine {
                        height: 48px;
                        selected: i == root.picked;
                        clicked => {
                            root.picked = i;
                            root.play(i);
                        }
                        HorizontalLayout {
                            padding-left: Space.md;
                            padding-right: Space.md;
                            spacing: Space.sm;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: sound.name;
                                    color: Theme.text;
                                    font-size: Type.row-title;
                                    overflow: elide;
                                }
                                Text {
                                    text: sound.facts == "" ? sound.folder : sound.folder + "  ·  " + sound.facts;
                                    color: Theme.faint;
                                    font-size: Type.meta;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                // The size mo-plugin's waves.rs makes the picture for.
                                Image {
                                    width: 120px;
                                    height: 30px;
                                    source: sound.wave;
                                    image-fit: fill;
                                    colorize: i == root.picked ? Theme.accent : Theme.muted;
                                }
                            }
                            if sound.favourite: VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Heart { }
                            }
                        }
                    }
                }
                Text {
                    text: root.playing;
                    color: Theme.accent;
                    font-size: Type.meta;
                    overflow: elide;
                }
            }
        }

        if root.view == 1: VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                spacing: Space.md;
                Text {
                    horizontal-stretch: 1;
                    text: root.extensions-summary;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    spacing: Space.xs;
                    StudioButton {
                        text: "Copy list";
                        clicked => { root.copy(); }
                    }
                    Text {
                        text: root.copied;
                        color: Theme.accent;
                        font-size: Type.small;
                        horizontal-alignment: center;
                    }
                }
            }
            ListView {
                row-height: 40px;
                rows: root.extensions.length;
                for ext in root.extensions: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.md;
                        spacing: Space.md;
                        Text {
                            width: 28px;
                            vertical-alignment: center;
                            text: ext.offered ? "Yes" : "No";
                            color: ext.offered ? Theme.accent : Theme.faint;
                            font-size: Type.meta;
                            font-weight: 600;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: ext.name;
                                color: ext.offered ? Theme.text : Theme.muted;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: ext.id;
                                color: Theme.faint;
                                font-size: Type.small;
                                font-family: Theme.number-font;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            // The credit Slint's royalty-free licence asks for, as the app's About box gives it.
            Text {
                text: "Made with Slint";
                color: Theme.faint;
                font-size: Type.small;
            }
        }
    }
}
