// The test plugin's panel: what shows inside the DAW's plugin window. Built from the app's own style (studio.slint),
// so it looks like the app. Its views: Sounds (the app's sound library as a list or as the Galaxy, click to play
// through the track, with the app's own filters and orders), MIDI, Presets,
// Chords (Chord check: the chord the notes played in make, as the app's chord reader names it) and DAW check (every
// CLAP extension the DAW was asked for, and whether it has it).

import { Theme, Type, Space, SearchBox, ListLine, StudioButton, Segmented, TickLine, Caps, Heart, Dot, FilterList, FilterView, FilterChoice, RangeSlider, LikeFavourites, PickButton, PointerPad, HoverNote, MapName, MapInset, LinkText, OneOfChip, YearRange, YearBar, ToggleChip, DragHandle, MenuItem } from "../../mo-ui/ui/studio.slint";
import { CurveBench, GridStrip, CurveEditorData, EditorDot, ClipTile, RulerMark } from "../../mo-ui/ui/pages/curve_editor.slint";
export { FilterView, FilterChoice, YearBar, Theme, CurveEditorData, EditorDot, ClipTile, RulerMark, MenuItem }
import { ListView } from "../../mo-ui/ui/list.slint";

import "../../mo-ui/fonts/IBMPlexSans-400.ttf";
import "../../mo-ui/fonts/IBMPlexSans-600.ttf";
import "../../mo-ui/fonts/IBMPlexMono-400.ttf";

export struct SoundLine {
    name: string,
    // The folder it's in, shorter: the second line.
    folder: string,
    // Its type, tempo, key and length, as far as the app knows them: after the folder.
    facts: string,
    favourite: bool,
    // Its type's colour, as its place in the theme's list (mo-app's `sounds::type_colour`); -1 for grey.
    colour: int,
    // Its waveform, white on nothing (the line tints it in its type's colour); empty until it's read, or when it has none.
    wave: image,
}

// A part from the app's MIDI index, as a line of the MIDI tab.
export struct PartLine {
    // The track or clip's name.
    title: string,
    // Where it's from: "Night drive 12 · FL Studio", or "MIDI file in Dark Keys".
    from: string,
    // "Piano · Chords · Cm · 8 bars · 64 notes".
    details: string,
    // Its kind's colour, as the app's MIDI page has it (a place in the theme's sound type colours; -1 for grey).
    colour: int,
}

// A preset file, as a line of the Presets tab (mo-app's `presets::line`).
// One line of the Curves tab, in words (mo-app's `presets::curve_line`).
export struct CurveLine {
    name: string,
    // What it moved: "Serum · Cutoff".
    under: string,
    // "In 3 songs", "In Bitwig's library".
    found: string,
    // "4 bars".
    length: string,
    // Its shape as path commands in a 300 by 100 box.
    shape: string,
}

export struct PresetLine {
    name: string,
    // "Serum · Bass  ·  Synth  ·  fxp".
    details: string,
    // The part guessed from its name or category ("Bass", "Pad?"), or "".
    part: string,
    // The part's colour (a place in the theme's sound type colours; -1 for grey).
    colour: int,
}

// A chord Chord check read, on its strip of the newest bars (mo-plugin's `chordcheck`).
export struct ChordBox {
    name: string,
    // Where it starts: "3.1" is bar 3, beat 1 of the take.
    at: string,
    // How sure the reader is: 0 sure, 1 the same notes have another name too, 2 not sure.
    sure: int,
    // It sounds now.
    now: bool,
}

// A take of Chord check's that's over, as a line of its list.
export struct TakeLine {
    // "07:12  ·  6 bars".
    title: string,
    // "3 of 8 chords labelled  ·  Saved".
    details: string,
}

// A chord of the take picked, to label: where it starts, what the reader read ("" for no chord), how sure it was (as
// ChordBox's), its other choices, and what you said ("" not yet).
export struct LabelLine {
    at: string,
    read: string,
    sure: int,
    choices: [string],
    said: string,
}

export struct ExtensionLine {
    // What the extension is for, in plain words.
    name: string,
    // The id the DAW was asked for, exactly.
    id: string,
    offered: bool,
}

// A neighbourhood's name over the Galaxy's map: which one, where the middle of its bottom edge is, its type's colour
// and how strongly it shows.
export struct SkyName {
    region: int,
    name: string,
    x: length,
    y: length,
    colour: int,
    fade: float,
}

// A dot on the Galaxy's trail: where its star is on the view, and how strongly it shows (fainter with age).
export struct TrailDot {
    x: length,
    y: length,
    fade: float,
}

// A line of the Galaxy's Swept card: a sound heard on the map lately, and whether Back and Next are on it.
export struct SweptLine {
    name: string,
    kind: string,
    colour: int,
    current: bool,
}

export component Panel inherits Window {
    // The DAW and its version, and the track the plugin is on, when the DAW says.
    in property <string> host;
    in property <string> track;
    // The track's colour, when the DAW says (see-through when it doesn't): a dot by its name.
    in property <color> track-colour: transparent;
    in property <[SoundLine]> sounds;
    // How the read went: "Reading the sound library", "1,234 sounds", or what's wrong.
    in property <string> status;
    // What's playing, or what went wrong playing it.
    in property <string> playing;
    in property <[ExtensionLine]> extensions;
    in property <string> extensions-summary;
    // "Copied" after Copy list, or what went wrong.
    in property <string> copied;
    // The filter column, as the app's Sounds page has it (mo-app's `sounds::chips`): each choice with its count.
    in property <FilterView> type-filter;
    // How many types the column has room for as lines of their own, before the More types menu: what's left of its
    // height once everything under the types has its room, in lines (a TickLine is 26px high). Never under 9.
    in-out property <int> type-lines: 9;
    in property <FilterView> length-filter;
    in property <FilterView> key-filter;
    in property <FilterView> tag-filter;
    in property <bool> mix-well;
    in property <bool> favourites;
    // Hide silent sounds (as the app's Sounds page has it), and its words with how many there are.
    in property <bool> hide-silent: true;
    in property <string> hide-silent-words: "Hide silent sounds";
    // With Favourites on: how far the sounds like them reach (0 only them, 1 the most adventurous), the words by it,
    // and the slider let go at a place (0 to 1).
    in-out property <float> like-favourites;
    in property <string> like-favourites-words;
    callback like-favourites-set(float);
    // The Tempo slider: its ends and step, where its handles are, what's picked in words, and its bars.
    in property <int> tempo-low-end;
    in property <int> tempo-high-end: 100;
    in property <int> tempo-step: 1;
    in property <int> tempo-low;
    in property <int> tempo-high: 100;
    in property <string> tempo-words;
    in property <[float]> tempo-bars;
    // The orders on offer, and the one the list is in.
    in property <[string]> orders;
    in property <int> order;
    in-out property <int> picked: -1;
    in-out property <int> view: 0;
    // How wide a line's waveform is: it grows with the window (the list sets it); mo-plugin's waves.rs makes the
    // pictures this wide.
    in-out property <length> wave-width: 120px;
    // The sounds as the Galaxy (every sound a star, as on the app's Sounds page) and not as a list.
    in-out property <bool> galaxy;
    // The stars' picture, and where it sits on the Galaxy's view now (it's moved and stretched with the view until
    // the next picture is drawn).
    // The names over the map, zoomed out (a click flies into its neighbourhood), and the rings round the star under
    // the mouse and the star last played.
    in property <[SkyName]> sky-names;
    callback sky-name(int);
    in property <bool> sky-ring;
    in property <length> sky-ring-x;
    in property <length> sky-ring-y;
    in property <bool> sky-picked;
    in property <length> sky-picked-x;
    in property <length> sky-picked-y;
    in property <image> sky-picture;
    // What the Galaxy sits on: the graphics card paints its picture over the same colour.
    out property <color> sky-well: Theme.well;
    in property <length> sky-x;
    in property <length> sky-y;
    in property <length> sky-w;
    in property <length> sky-h;
    // A word in the middle while there's no map to show ("Reading the galaxy", or why there's none).
    in property <string> sky-note;
    // The star under the mouse: its name ("" for none) and where the mouse is.
    in property <string> sky-hover;
    in property <length> sky-hover-x;
    in property <length> sky-hover-y;
    // The map is being dragged.
    in property <bool> sky-grabbing;
    // Every sound type's colour, for the stars.
    out property <[color]> type-colours: Theme.sound-types;
    // The Galaxy's view is this big now.
    callback sky-size(length, length);
    // A button went down on the Galaxy (true: the right or middle one, which moves the map), the mouse moved, and
    // the button came up again; `sky-cancelled` first when the press was taken away.
    callback sky-down(length, length, bool);
    callback sky-move(length, length);
    callback sky-up(bool);
    callback sky-cancelled();
    // The wheel, in notches (positive flies in).
    callback sky-wheel(float);
    // The mouse left the Galaxy.
    callback sky-gone();
    // Back out to the whole map.
    callback sky-home();
    // The mini-map, once the view has flown in: the whole map, with a box round the part on show (0 to 1 each way).
    in property <bool> sky-mini;
    in property <image> sky-mini-picture;
    in property <string> sky-mini-title;
    in property <float> sky-mini-x;
    in property <float> sky-mini-y;
    in property <float> sky-mini-w;
    in property <float> sky-mini-h;
    // Pressed or dragged on, this far across and down it (0 to 1).
    callback sky-mini-go(float, float);
    // What makes a star bigger and brighter ("Liked", "Length"...), one always picked.
    in property <FilterView> sky-light;
    callback sky-light-by(string);
    // The trail: a line through the stars heard lately (a path's commands, in the view's points), a dot on each, and
    // the Swept card that lists them, newest first.
    in property <string> sky-trail;
    in property <[TrailDot]> sky-trail-dots;
    in property <[SweptLine]> sky-swept;
    // The Swept card was clicked into: Up and Down go through its sounds.
    in-out property <bool> sky-swept-keys;
    callback sky-swept-go(int);
    // 1: to the sound swept before (Back); -1: to the one after (Next).
    callback sky-swept-step(int);
    callback sky-swept-clear();
    // An arrow key with the keys on the Galaxy: -1 Left, 1 Right, -2 Up, 2 Down (as the app numbers them).
    callback sky-arrow(int);
    // The year strip beside the sounds, as on the app's Sounds page: the years sounds were added in, newest first,
    // and the places of the years picked (-1 for none). Drag over years to show only those.
    in property <[YearBar]> years;
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    // Where the sound playing is in its file, for the line on its waveform: the row it's on (-1 for none) and how
    // far through the whole sound (0 the start, 1 the end).
    in property <int> playing-row: -1;
    // A line to bring into sight in each list (the DAW's knobs pick lines): its top, and a count that goes up each
    // time it's asked.
    in property <length> sounds-show-top;
    in property <int> sounds-show-ask;
    in property <length> parts-show-top;
    in property <int> parts-show-ask;
    in property <length> presets-show-top;
    in property <int> presets-show-ask;
    in property <float> playing-at;
    // What's typed in the search box: kept while another tab shows, as the list keeps it.
    in-out property <string> search-text;
    callback search(string);
    // A line was clicked: on its waveform at this spot (0 its start, up to 1, its end), or anywhere else on it (-1).
    // The sound plays from the spot, or from the start; a click on the line that's playing stops it instead.
    callback play(int, float);
    // A line is being dragged out (onto a track): its row.
    callback drag-out(int);
    // Whether lines can be dragged out on this system, and the row being carried (-1 for none).
    in property <bool> can-drag;
    in property <int> carried: -1;
    callback stop();
    // Record: what comes in, from the DAW's input to the plugin (its sidechain) or straight from a sound card, saved
    // as a WAV that drags out like a sound. `record-from` is the card's name, "" for the DAW's input.
    in property <[string]> record-from-choices;
    in property <string> record-from;
    in property <bool> recording;
    in property <string> record-said;
    // Listen: what the plugin hears at its input (the notes the track plays most, the hits' tempo), in words.
    in property <string> hears;
    // The last take saved, by its file name ("" for none), dragged out like a sound; `recorded-carried` while it is.
    in property <string> recorded-name;
    in property <bool> recorded-carried;
    callback record-from-picked(string);
    callback record();
    callback record-stop();
    callback recorded-play();
    callback recorded-drag-out();
    // In Bitwig: the picked sound goes in the place of the Sampler selected there, keeping its settings.
    in property <bool> in-bitwig;
    callback try-in-sampler();
    // Trim silence: sounds play without the silence at their start and end (the files stay as they are), with how
    // quiet counts as silence in dB below full scale, and a pick from its menu ("-50").
    in property <bool> trim-silence;
    in property <int> trim-level-db: -60;
    in property <[string]> trim-choices;
    // A pick from its menu: "-50 dB", or "" for off.
    callback pick-trim(string);
    // The Loop switch: a sound clicked plays round and round until it's stopped or another is clicked.
    in-out property <bool> loop-on;
    callback loop-changed(bool);
    // Match tempo: while looping, a loop whose tempo is known plays at the DAW's, its pitch kept.
    in-out property <bool> match-tempo;
    callback match-tempo-changed(bool);
    // In time: a sound clicked while the song plays starts on the next beat (a hit) or bar (a loop).
    in-out property <bool> in-time: true;
    callback in-time-changed(bool);
    // A choice was picked or unpicked on a filter ("type", "length", "key", "tag"): its words.
    callback pick(string, string);
    // Nothing picked on a filter (or "more-types": only the types in the More menu).
    callback clear(string);
    // An on/off line: "mix-well", "favourites" or "hide-silent".
    callback toggle(string);
    callback tempo-picked(int, int);
    callback pick-order(int);
    callback copy();

    // The MIDI tab: the parts, the status line ("1,234 parts", or what's wrong), the filter column as the app's MIDI
    // page has it (mo-app's `midi::chips`), the orders, the year strip and the line picked.
    in property <[PartLine]> parts;
    in property <string> midi-status;
    // Said over an empty list ("" for nothing).
    in property <string> midi-empty;
    in property <FilterView> kind-filter;
    in property <FilterView> from-filter;
    in property <FilterView> part-key-filter;
    in property <[string]> midi-orders;
    in property <int> midi-order;
    in property <[YearBar]> midi-years;
    in property <int> midi-years-from: -1;
    in property <int> midi-years-to: -1;
    in-out property <int> midi-picked: -1;
    // The row being carried out (-1 for none), and what the drag said ("" for nothing).
    in property <int> midi-carried: -1;
    in property <string> midi-said;
    // What's typed in the search box: kept while the tab is away, as the list keeps it.
    in-out property <string> midi-search-text;
    callback midi-search(string);
    // A choice was picked or unpicked on a filter ("kind", "from", "key"): its words; or nothing picked on one.
    callback midi-pick(string, string);
    callback midi-clear(string);
    callback midi-pick-order(int);
    callback midi-years-picked(int, int);
    callback midi-years-cleared();
    // A line is being dragged out (onto a track): its row.
    callback midi-drag-out(int);
    // A part was clicked: it plays as a loop through the track (with the app's SoundFont), or stops when it's the
    // one playing.
    callback midi-play(int);
    // The piano roll of the part picked (empty for none), drawn by mo-app's piano roll for a room this big.
    in property <image> midi-roll;
    // How wide the roll shows (the list's width): the picture is drawn this wide, or wider when it follows the playing.
    in-out property <length> midi-roll-width: 400px;
    // How wide the picture is (0 for none), and where the loop's bars run across it.
    in property <length> midi-roll-points;
    in property <length> midi-roll-from;
    in property <length> midi-roll-to;
    // How far through its loop the part the roll shows is playing (0 to 1), or -1 when it isn't playing.
    in property <float> midi-head: -1;
    // The roll follows the playing: a long part is drawn a few bars to the room, and scrolls under the play head.
    in-out property <bool> midi-follow: true;
    callback midi-follow-changed();
    // Send MIDI: a part clicked plays as notes out of the plugin, for an instrument after it, in time with the DAW,
    // instead of with the SoundFont.
    in-out property <bool> midi-out;
    callback midi-out-changed(bool);

    // The Chords tab (Chord check): the chord the notes played into the plugin make, as the app's chord reader names
    // it ("" for none yet), how sure it is in words, the keys held and how far the take is, and the chords of the
    // newest bars.
    in property <string> chord-name;
    in property <string> chord-sure;
    in property <string> chord-line;
    in property <[ChordBox]> chord-strip;
    // Thru: the notes played in go on out of the plugin's note output, for an instrument after it.
    in-out property <bool> chord-thru: true;
    callback chord-thru-changed(bool);
    // The takes that are over, newest first, the one picked, its chords to label, and what happened last ("Saved",
    // or what's wrong).
    in property <[TakeLine]> takes;
    in-out property <int> take-picked: -1;
    in property <[LabelLine]> take-chords;
    in property <string> take-said;
    callback take-pick(int);
    // Chord `row` of the take picked: "right", "choice" (with which, from 0), "not a chord" or "skip".
    callback label(int, string, int);
    // Chord `row` named as typed: whether the name was read (the box is cleared only then, so a slip can be mended).
    callback label-typed(int, string) -> bool;

    // The Presets tab: the preset files, the status line, the filter column as the app's Presets page has it (mo-app's
    // `presets::filter_chips`), the orders, the year strip and the line picked.
    in property <[PresetLine]> presets;
    in property <string> preset-status;
    in property <string> preset-empty;
    in property <FilterView> preset-part-filter;
    in property <FilterView> preset-kind-filter;
    in property <FilterView> preset-format-filter;
    in property <FilterView> preset-plugin-filter;
    // Where a preset was found (in a song, or a file on disk), and the synths whose track plays nothing, shown or not.
    in property <FilterView> preset-from-filter;
    in property <bool> preset-unused;
    callback preset-unused-toggled(bool);
    in property <[string]> preset-orders;
    in property <int> preset-order;
    in property <[YearBar]> preset-years;
    in property <int> preset-years-from: -1;
    in property <int> preset-years-to: -1;
    in-out property <int> preset-picked: -1;
    in property <int> preset-carried: -1;
    // Said under the list: where the picked preset loads, or what a drag said ("" for nothing).
    in property <string> preset-said;
    in-out property <string> preset-search-text;
    callback preset-search(string);
    // A choice was picked or unpicked on a filter ("part", "type", "format", "plugin"); or nothing picked on one.
    callback preset-pick(string, string);
    callback preset-clear(string);
    callback preset-pick-order(int);
    callback preset-years-picked(int, int);
    callback preset-years-cleared();
    callback preset-click(int);
    // A line is being dragged out (onto a track or a device): its row.
    callback preset-drag-out(int);

    // The Curves tab: the curves the app's Presets › Curves keeps, its search, Found in filter and Show hidden, as the
    // app's list has them, and a curve dragged out as a Bitwig curve file.
    in property <[CurveLine]> curves;
    in property <string> curve-status;
    in property <string> curve-empty;
    in property <FilterView> curve-from-filter;
    in property <bool> curve-hidden;
    in-out property <int> curve-picked: -1;
    in property <int> curve-carried: -1;
    in property <string> curve-said;
    in-out property <string> curve-search-text;
    callback curve-search(string);
    callback curve-pick(string);
    callback curve-clear();
    callback curve-hidden-toggled(bool);
    callback curve-drag-out(int);
    // The curve editor, in the list's place while a curve is open in it (the app's own, from `CurveEditorData`): a
    // click on a curve opens it, Back shows the list again. The edited curve is dragged out from its own strip.
    in property <bool> curve-editing;
    in property <bool> curve-edit-lifted;
    callback curve-open(int);
    callback curve-back();
    callback curve-edit-drag-out();

    title: "Music Organiser";
    preferred-width: 760px;
    preferred-height: 560px;
    background: Theme.background;
    default-font-family: Theme.text-font;
    default-font-size: Type.body;

    VerticalLayout {
        padding: Space.lg;
        spacing: Space.md;

        HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                spacing: Space.xs;
                Text {
                    text: "Music Organiser";
                    color: Theme.text;
                    font-size: Type.heading;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        text: root.track == "" ? root.host : root.host + "  ·  track " + root.track;
                        color: Theme.muted;
                        font-size: Type.meta;
                    }
                    if root.track != "" && root.track-colour.alpha > 0: Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.track-colour;
                    }
                    Rectangle { }
                }
            }
            Rectangle { }
            // Curves sits beside Presets, as the app's Presets page has them, but is view 5 (the views before it kept
            // their numbers).
            Segmented {
                choices: ["Sounds", "MIDI", "Presets", "Curves", "Chords", "DAW check"];
                current: root.view == 5 ? 3 : root.view >= 3 ? root.view + 1 : root.view;
                picked(i) => { root.view = i == 3 ? 5 : i > 3 ? i - 1 : i; }
            }
        }

        if root.view == 0: HorizontalLayout {
            spacing: Space.lg;
            // The filter column, laid out as the app's Sounds page lays out its own: tick lists, each choice with its
            // count. It scrolls with the wheel when the window is too short for them all.
            flick := Flickable {
                width: 196px;
                content-width: self.width;
                content-height: max(self.height, lists.preferred-height);
                mouse-drag-pan-enabled: false;
                // The column was made taller or shorter, or what's under the types changed.
                // What everything but the types' own lines needs.
                property <length> rest: lists.preferred-height - root.type-filter.chips.length * 26px;
                function fit() {
                    root.type-lines = max(9, Math.floor((self.height - self.rest) / 26px));
                }
                init => { self.fit(); }
                changed height => { self.fit(); }
                changed rest => { self.fit(); }
                lists := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: flick.width - Space.md;
                    alignment: start;
                    spacing: Space.md;
                    FilterList {
                        name: "TYPE";
                        more-name: "More types";
                        filter: root.type-filter;
                        toggled(text) => { root.pick("type", text); }
                        cleared => { root.clear("more-types"); }
                    }
                    // One of three, so a switch: both, hits (one-shots) or loops.
                    VerticalLayout {
                        Caps {
                            text: "LENGTH";
                            height: 22px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Segmented {
                                property <[FilterChoice]> lengths: root.length-filter.chips;
                                choices: ["All", "Hits", "Loops"];
                                pad: Space.md;
                                current: self.lengths.length < 2 ? 0 : self.lengths[0].on ? 1 : self.lengths[1].on ? 2 : 0;
                                picked(i) => {
                                    if i == 0 {
                                        root.clear("length");
                                    } else if i != self.current {
                                        root.pick("length", self.lengths[i - 1].text);
                                    }
                                }
                            }
                        }
                    }
                    FilterList {
                        name: "KEY";
                        filter: root.key-filter;
                        toggled(text) => { root.pick("key", text); }
                        cleared => { root.clear("key"); }
                    }
                    if root.key-filter.more-picked != "": TickLine {
                        text: "Keys that mix well";
                        on: root.mix-well;
                        clicked => { root.toggle("mix-well"); }
                    }
                    // A span of tempos, so a slider with two handles; its bars show where the sounds are.
                    VerticalLayout {
                        padding-right: Space.sm;
                        HorizontalLayout {
                            height: 22px;
                            Caps {
                                text: "TEMPO";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.tempo-words;
                                color: tempo.on ? Theme.text : Theme.faint;
                                font-size: Type.meta;
                                font-weight: tempo.on ? 600 : 400;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        tempo := RangeSlider {
                            low-end: root.tempo-low-end;
                            high-end: root.tempo-high-end;
                            step: root.tempo-step;
                            low: root.tempo-low;
                            high: root.tempo-high;
                            bars: root.tempo-bars;
                            changed(low, high) => { root.tempo-picked(low, high); }
                        }
                    }
                    if root.tag-filter.chips.length + root.tag-filter.more.length > 0: FilterList {
                        name: "TAG";
                        more-name: "More tags";
                        filter: root.tag-filter;
                        toggled(text) => { root.pick("tag", text); }
                        cleared => { root.clear("tag"); }
                    }
                    VerticalLayout {
                        Caps {
                            text: "SHOW ONLY";
                            height: 22px;
                        }
                        TickLine {
                            text: "Favourites";
                            on: root.favourites;
                            clicked => { root.toggle("favourites"); }
                        }
                        // The sounds most like your favourites show beside them, a few or many.
                        if root.favourites: LikeFavourites {
                            value <=> root.like-favourites;
                            words: root.like-favourites-words;
                            released(v) => { root.like-favourites-set(v); }
                        }
                        TickLine {
                            text: root.hide-silent-words;
                            on: root.hide-silent;
                            clicked => { root.toggle("hide-silent"); }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    SearchBox {
                        horizontal-stretch: 1;
                        hint: "Search sounds";
                        text <=> root.search-text;
                        edited(text) => { root.search(text); }
                    }
                    Segmented {
                        horizontal-stretch: 0;
                        choices: ["List", "Galaxy"];
                        current: root.galaxy ? 1 : 0;
                        pad: Space.md;
                        picked(i) => { root.galaxy = i == 1; }
                    }
                    PickButton {
                        horizontal-stretch: 0;
                        name: "Trim silence";
                        value: root.trim-silence ? root.trim-level-db + " dB" : "";
                        none-text: "Off: play the whole file";
                        choices: root.trim-choices;
                        picked(t) => { root.pick-trim(t); }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "In time";
                        main: root.in-time;
                        tip: root.in-time ? "In time: while the song plays, a sound starts on the next beat, a loop on the next bar" : "Start sounds on the next beat while the song plays";
                        clicked => {
                            root.in-time = !root.in-time;
                            root.in-time-changed(root.in-time);
                        }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "Loop";
                        main: root.loop-on;
                        tip: root.loop-on ? "Looping: a sound plays round until you stop it" : "Play sounds round and round until you stop them";
                        clicked => {
                            root.loop-on = !root.loop-on;
                            root.loop-changed(root.loop-on);
                        }
                    }
                    if root.loop-on: StudioButton {
                        horizontal-stretch: 0;
                        text: "Match tempo";
                        main: root.match-tempo;
                        tip: "Loops play at the DAW's tempo, their pitch kept (loops the library knows the tempo of)";
                        clicked => {
                            root.match-tempo = !root.match-tempo;
                            root.match-tempo-changed(root.match-tempo);
                        }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "Stop";
                        clicked => { root.stop(); }
                    }
                    if root.in-bitwig && root.picked >= 0: StudioButton {
                        horizontal-stretch: 0;
                        text: "In Bitwig's Sampler";
                        tip: "Put the picked sound in the Sampler selected in Bitwig, keeping its settings (a first try)";
                        clicked => { root.try-in-sampler(); }
                    }
                }
                HorizontalLayout {
                    spacing: Space.sm;
                    PickButton {
                        horizontal-stretch: 0;
                        name: "Record from";
                        value: root.record-from;
                        none-text: "The DAW's input to the plugin";
                        choices: root.record-from-choices;
                        picked(t) => { root.record-from-picked(t); }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: root.recording ? "Stop recording" : "Record";
                        main: root.recording;
                        tip: root.record-from == "" ? "Record what the DAW sends the plugin's input (in Bitwig, pick it in the plugin's sidechain)" : "Record " + root.record-from + " straight from the sound card";
                        clicked => {
                            if root.recording {
                                root.record-stop();
                            } else {
                                root.record();
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.record-said;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                }
                if root.recorded-name != "": ListLine {
                    height: 36px;
                    draggable: root.can-drag;
                    lifted: root.recorded-carried;
                    clicked => { root.recorded-play(); }
                    drag-out => { root.recorded-drag-out(); }
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.md;
                        Text {
                            vertical-alignment: center;
                            text: root.recorded-name + "  \u{b7}  click to hear it, drag it into your project";
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                }
                if root.hears != "": Text {
                    text: root.hears;
                    color: Theme.muted;
                    font-size: Type.meta;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.status;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    if !root.galaxy: Segmented {
                        horizontal-stretch: 0;
                        choices: root.orders;
                        current: root.order;
                        pad: Space.md;
                        picked(i) => { root.pick-order(i); }
                    }
                    if root.galaxy: StudioButton {
                        horizontal-stretch: 0;
                        text: "Whole galaxy";
                        clicked => { root.sky-home(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    property <length> years-width: root.years.length > 1 ? 56px : 0px;
                    if self.years-width > 0: YearRange {
                        x: parent.width - self.width;
                        y: 0;
                        width: parent.years-width;
                        height: parent.height;
                        years: root.years;
                        picked-from: root.years-from;
                        picked-to: root.years-to;
                        picked(a, b) => { root.years-picked(a, b); }
                        cleared => { root.years-cleared(); }
                    }
                    // The Galaxy: the wheel flies in and out, the right button moves the map, a click plays a star and
                    // the left button held down plays the stars it passes.
                    if root.galaxy: Rectangle {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        background: Theme.well;
                        border-radius: Theme.radius;
                        clip: true;
                        init => {
                            root.sky-size(self.width, self.height);
                            sky-keys.focus();
                        }
                        changed width => { root.sky-size(self.width, self.height); }
                        changed height => { root.sky-size(self.width, self.height); }
                        Image {
                            x: root.sky-x;
                            y: root.sky-y;
                            width: root.sky-w;
                            height: root.sky-h;
                            source: root.sky-picture;
                            image-fit: fill;
                        }
                        if root.sky-trail != "": Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: parent.width / 1px;
                            viewbox-height: parent.height / 1px;
                            commands: root.sky-trail;
                            stroke: Theme.text;
                            stroke-width: 1.2px;
                            opacity: 0.45;
                        }
                        for d in root.sky-trail-dots: Rectangle {
                            x: d.x - 4px;
                            y: d.y - 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.text;
                            opacity: 0.2 + 0.6 * d.fade;
                        }
                        if root.sky-note != "": Text {
                            width: parent.width - 2 * Space.lg;
                            text: root.sky-note;
                            color: Theme.muted;
                            font-size: Type.body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        if root.sky-ring: Rectangle {
                            x: root.sky-ring-x - 7px;
                            y: root.sky-ring-y - 7px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 1.5px;
                            border-color: Theme.text;
                            opacity: 0.7;
                        }
                        if root.sky-picked: Rectangle {
                            x: root.sky-picked-x - 9px;
                            y: root.sky-picked-y - 9px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 2px;
                            border-color: Theme.accent;
                        }
                        // The keys come here when the Galaxy opens or is pressed (and leave for the search box when
                        // that's clicked): the arrows go from star to star.
                        sky-keys := FocusScope {
                            width: 0;
                            height: 0;
                            key-pressed(e) => {
                                if e.text == Key.LeftArrow {
                                    root.sky-arrow(-1);
                                } else if e.text == Key.RightArrow {
                                    root.sky-arrow(1);
                                } else if e.text == Key.UpArrow {
                                    root.sky-arrow(-2);
                                } else if e.text == Key.DownArrow {
                                    root.sky-arrow(2);
                                } else {
                                    return reject;
                                }
                                accept
                            }
                        }
                        PointerPad {
                            grabbing: root.sky-grabbing;
                            down(x, y) => {
                                sky-keys.focus();
                                root.sky-swept-keys = false;
                                root.sky-down(x, y, false);
                            }
                            side-down(x, y) => {
                                sky-keys.focus();
                                root.sky-down(x, y, true);
                            }
                            side-up => { root.sky-up(true); }
                            move(x, y) => { root.sky-move(x, y); }
                            cancelled => { root.sky-cancelled(); }
                            up => { root.sky-up(false); }
                            wheel(x, dx, dy, ctrl, shift) => { root.sky-wheel(dy); }
                            gone => { root.sky-gone(); }
                        }
                        for l in root.sky-names: MapName {
                            x: l.x - self.width / 2;
                            y: l.y - self.height;
                            text: l.name;
                            tint: Theme.sound-type(l.colour);
                            opacity: l.fade;
                            clicked => { root.sky-name(l.region); }
                        }
                        if root.sky-mini: MapInset {
                            x: parent.width - self.width - Space.md;
                            y: parent.height - self.height - Space.md;
                            picture: root.sky-mini-picture;
                            title: root.sky-mini-title;
                            box-x: root.sky-mini-x;
                            box-y: root.sky-mini-y;
                            box-width: root.sky-mini-w;
                            box-height: root.sky-mini-h;
                            go(x, y) => { root.sky-mini-go(x, y); }
                        }
                        // The map's own setting, on the map, as the app's.
                        OneOfChip {
                            x: Space.md;
                            y: Space.md;
                            name: "Light by";
                            filter: root.sky-light;
                            picked(text) => { root.sky-light-by(text); }
                        }
                        // The Swept card, as the app's: the sounds heard on the map lately. It leaves the mini-map
                        // its corner, and stays away in a view too narrow for both it and the map.
                        if root.sky-swept.length > 0 && parent.width >= 420px: Rectangle {
                            x: parent.width - self.width - Space.md;
                            y: Space.md;
                            width: 250px;
                            height: min(swept-card.preferred-height, parent.height - 2 * Space.md - (root.sky-mini ? 170px + Space.md : 0px));
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            // Accent while the arrow keys go through it.
                            border-color: root.sky-swept-keys && sky-keys.has-focus ? Theme.accent : Theme.edge;
                            clip: true;
                            // The card takes its own clicks and the wheel, so they don't reach the map under it; a
                            // click on it hands it the arrow keys.
                            TouchArea {
                                clicked => {
                                    sky-keys.focus();
                                    root.sky-swept-keys = true;
                                }
                                scroll-event(e) => { accept }
                            }
                            swept-card := VerticalLayout {
                                padding: Space.md;
                                spacing: Space.xs;
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Caps {
                                        text: "SWEPT";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    StudioButton {
                                        text: "Back";
                                        tip: "The sound swept before this one";
                                        clicked => {
                                            sky-keys.focus();
                                            root.sky-swept-keys = true;
                                            root.sky-swept-step(1);
                                        }
                                    }
                                    StudioButton {
                                        text: "Next";
                                        tip: "The sound swept after this one";
                                        clicked => {
                                            sky-keys.focus();
                                            root.sky-swept-keys = true;
                                            root.sky-swept-step(-1);
                                        }
                                    }
                                }
                                for line[i] in root.sky-swept: ListLine {
                                    height: 30px;
                                    selected: line.current;
                                    tip: line.kind;
                                    clicked => {
                                        sky-keys.focus();
                                        root.sky-swept-keys = true;
                                        root.sky-swept-go(i);
                                    }
                                    HorizontalLayout {
                                        padding-left: Space.sm;
                                        padding-right: Space.sm;
                                        spacing: Space.sm;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Dot { tint: Theme.sound-type(line.colour); }
                                        }
                                        Text {
                                            text: line.name;
                                            color: line.current ? Theme.text : Theme.muted;
                                            font-size: Type.meta;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    // What the arrow keys do here, so it's seen, not guessed.
                                    Text {
                                        text: root.sky-swept-keys && sky-keys.has-focus ? "Up and Down go through these" : "Click here, then Up and Down";
                                        color: root.sky-swept-keys && sky-keys.has-focus ? Theme.accent : Theme.muted;
                                        font-size: Type.meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    LinkText {
                                        text: "Clear";
                                        tint: Theme.muted;
                                        font-size: Type.meta;
                                        clicked => { root.sky-swept-clear(); }
                                    }
                                }
                            }
                        }
                        if root.sky-hover != "": HoverNote {
                            text: root.sky-hover;
                            at-x: root.sky-hover-x;
                            at-y: root.sky-hover-y;
                            room-width: parent.width;
                            room-height: parent.height;
                        }
                    }
                    ListView {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        visible: !root.galaxy;
                        row-height: 48px;
                        rows: root.sounds.length;
                        show-top: root.sounds-show-top;
                        show-ask: root.sounds-show-ask;
                        // The waveforms take a bit under half of a line, in steps (so dragging the window's edge
                        // doesn't ask for new pictures at every pixel), and never less than 120.
                        function fit() {
                            root.wave-width = max(120px, Math.floor(self.width * 0.45 / 40px) * 40px);
                        }
                        init => { self.fit(); }
                        changed width => { self.fit(); }
                        for sound[i] in root.sounds: ListLine {
                            height: 48px;
                            selected: i == root.picked;
                            draggable: root.can-drag;
                            lifted: i == root.carried;
                            clicked => {
                                root.picked = i;
                                // A click on the waveform plays from that spot; anywhere else, from the start.
                                root.play(i, wave.source.width > 0 && self.pressed-x >= wave.absolute-position.x - self.absolute-position.x
                                    && self.pressed-x < wave.absolute-position.x - self.absolute-position.x + wave.width
                                    ? (self.pressed-x - (wave.absolute-position.x - self.absolute-position.x)) / wave.width : -1);
                            }
                            drag-out => { root.drag-out(i); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                // Its type's colour, as the app's own sound lines show it.
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Dot { tint: Theme.sound-type(sound.colour); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: sound.name;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: sound.facts == "" ? sound.folder : sound.folder + "  ·  " + sound.facts;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    // The size mo-plugin's waves.rs makes the picture for.
                                    wave := Image {
                                        width: root.wave-width;
                                        height: 30px;
                                        source: sound.wave;
                                        image-fit: fill;
                                        colorize: Theme.sound-type(sound.colour);
                                        // Where it's playing now.
                                        if i == root.playing-row: Rectangle {
                                            x: min(parent.width - self.width, max(0px, parent.width * root.playing-at - self.width / 2));
                                            y: -3px;
                                            width: 2px;
                                            height: parent.height + 6px;
                                            border-radius: 1px;
                                            background: Theme.text;
                                        }
                                    }
                                }
                                if sound.favourite: VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Heart { }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.playing;
                    color: Theme.accent;
                    font-size: Type.meta;
                    overflow: elide;
                }
            }
        }

        if root.view == 1: HorizontalLayout {
            spacing: Space.lg;
            // The filter column, as the app's MIDI page has it.
            Flickable {
                width: 196px;
                content-width: self.width;
                content-height: max(self.height, part-lists.preferred-height);
                mouse-drag-pan-enabled: false;
                part-lists := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width - Space.md;
                    alignment: start;
                    spacing: Space.md;
                    FilterList {
                        name: "KIND";
                        filter: root.kind-filter;
                        toggled(text) => { root.midi-pick("kind", text); }
                        cleared => { root.midi-clear("kind"); }
                    }
                    FilterList {
                        name: "FROM";
                        filter: root.from-filter;
                        toggled(text) => { root.midi-pick("from", text); }
                        cleared => { root.midi-clear("from"); }
                    }
                    FilterList {
                        name: "KEY";
                        filter: root.part-key-filter;
                        toggled(text) => { root.midi-pick("key", text); }
                        cleared => { root.midi-clear("key"); }
                    }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    SearchBox {
                        horizontal-stretch: 1;
                        hint: "Search MIDI";
                        text <=> root.midi-search-text;
                        edited(text) => { root.midi-search(text); }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "Stop";
                        clicked => { root.stop(); }
                    }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.midi-status;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    Segmented {
                        horizontal-stretch: 0;
                        choices: root.midi-orders;
                        current: root.midi-order;
                        pad: Space.md;
                        picked(i) => { root.midi-pick-order(i); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    property <length> years-width: root.midi-years.length > 1 ? 56px : 0px;
                    if self.years-width > 0: YearRange {
                        x: parent.width - self.width;
                        y: 0;
                        width: parent.years-width;
                        height: parent.height;
                        years: root.midi-years;
                        picked-from: root.midi-years-from;
                        picked-to: root.midi-years-to;
                        picked(a, b) => { root.midi-years-picked(a, b); }
                        cleared => { root.midi-years-cleared(); }
                    }
                    if root.midi-empty != "": Text {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        text: root.midi-empty;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    ListView {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        row-height: 48px;
                        rows: root.parts.length;
                        show-top: root.parts-show-top;
                        show-ask: root.parts-show-ask;
                        for part[i] in root.parts: ListLine {
                            height: 48px;
                            selected: i == root.midi-picked;
                            draggable: root.can-drag;
                            lifted: i == root.midi-carried;
                            clicked => {
                                root.midi-picked = i;
                                root.midi-play(i);
                            }
                            drag-out => { root.midi-drag-out(i); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Dot { tint: Theme.sound-type(part.colour); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: part.title;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: part.from + "  ·  " + part.details;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                // The piano roll of the part picked, as the app's MIDI page draws it.
                Rectangle {
                    height: root.midi-picked >= 0 ? 120px : 0px;
                    init => { root.midi-roll-width = self.width; }
                    changed width => { root.midi-roll-width = self.width; }
                    visible: root.midi-picked >= 0;
                    background: Theme.well;
                    border-radius: Theme.radius;
                    clip: true;
                    property <length> wide: root.midi-roll-points > 0 ? root.midi-roll-points : self.width;
                    property <length> head-x: root.midi-roll-from + root.midi-head * (root.midi-roll-to - root.midi-roll-from);
                    // How far the picture is moved left: the play head kept in the middle while following, within
                    // the picture's ends.
                    property <length> shift: root.midi-follow && root.midi-head >= 0 && self.wide > self.width
                        ? max(0px, min(self.head-x - self.width / 2, self.wide - self.width)) : 0px;
                    Image {
                        x: -parent.shift;
                        width: parent.wide;
                        height: parent.height;
                        source: root.midi-roll;
                        image-fit: fill;
                    }
                    if root.midi-head >= 0 && root.midi-roll-points > 0: Rectangle {
                        x: parent.head-x - parent.shift - 1px;
                        y: 0;
                        width: 2px;
                        height: parent.height;
                        background: Theme.accent;
                    }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.midi-said != "" ? root.midi-said : root.playing != "" ? root.playing
                            : root.can-drag ? "Click a part to hear it, drag it onto a track to put it there as a MIDI clip" : "Click a part to hear it";
                        color: root.midi-said != "" || root.playing != "" ? Theme.accent : Theme.faint;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    TickLine {
                        horizontal-stretch: 0;
                        width: 120px;
                        text: "Send MIDI";
                        on: root.midi-out;
                        clicked => {
                            root.midi-out = !root.midi-out;
                            root.midi-out-changed(root.midi-out);
                        }
                    }
                    if root.midi-picked >= 0: TickLine {
                        horizontal-stretch: 0;
                        width: 150px;
                        text: "Follow playback";
                        on: root.midi-follow;
                        clicked => {
                            root.midi-follow = !root.midi-follow;
                            root.midi-follow-changed();
                        }
                    }
                }
            }
        }

        if root.view == 2: HorizontalLayout {
            spacing: Space.lg;
            // The filter column, as the app's Presets page has it.
            Flickable {
                width: 196px;
                content-width: self.width;
                content-height: max(self.height, preset-lists.preferred-height);
                mouse-drag-pan-enabled: false;
                preset-lists := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width - Space.md;
                    alignment: start;
                    spacing: Space.md;
                    FilterList {
                        name: "PART";
                        filter: root.preset-part-filter;
                        toggled(text) => { root.preset-pick("part", text); }
                        cleared => { root.preset-clear("part"); }
                    }
                    FilterList {
                        name: "TYPE";
                        filter: root.preset-kind-filter;
                        toggled(text) => { root.preset-pick("type", text); }
                        cleared => { root.preset-clear("type"); }
                    }
                    FilterList {
                        name: "FOUND IN";
                        filter: root.preset-from-filter;
                        toggled(text) => { root.preset-pick("from", text); }
                        cleared => { root.preset-clear("from"); }
                    }
                    // As the app's page has it, on the page and not in a menu.
                    TickLine {
                        text: "Synths that play nothing";
                        on: root.preset-unused;
                        clicked => { root.preset-unused-toggled(!root.preset-unused); }
                    }
                    FilterList {
                        name: "FORMAT";
                        filter: root.preset-format-filter;
                        toggled(text) => { root.preset-pick("format", text); }
                        cleared => { root.preset-clear("format"); }
                    }
                    FilterList {
                        name: "PLUGIN";
                        filter: root.preset-plugin-filter;
                        toggled(text) => { root.preset-pick("plugin", text); }
                        cleared => { root.preset-clear("plugin"); }
                    }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                SearchBox {
                    hint: "Search presets";
                    text <=> root.preset-search-text;
                    edited(text) => { root.preset-search(text); }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.preset-status;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    Segmented {
                        horizontal-stretch: 0;
                        choices: root.preset-orders;
                        current: root.preset-order;
                        pad: Space.md;
                        picked(i) => { root.preset-pick-order(i); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    property <length> years-width: root.preset-years.length > 1 ? 56px : 0px;
                    if self.years-width > 0: YearRange {
                        x: parent.width - self.width;
                        y: 0;
                        width: parent.years-width;
                        height: parent.height;
                        years: root.preset-years;
                        picked-from: root.preset-years-from;
                        picked-to: root.preset-years-to;
                        picked(a, b) => { root.preset-years-picked(a, b); }
                        cleared => { root.preset-years-cleared(); }
                    }
                    if root.preset-empty != "": Text {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        text: root.preset-empty;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    ListView {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        row-height: 48px;
                        rows: root.presets.length;
                        show-top: root.presets-show-top;
                        show-ask: root.presets-show-ask;
                        for preset[i] in root.presets: ListLine {
                            height: 48px;
                            selected: i == root.preset-picked;
                            draggable: root.can-drag;
                            lifted: i == root.preset-carried;
                            clicked => {
                                root.preset-picked = i;
                                root.preset-click(i);
                            }
                            drag-out => { root.preset-drag-out(i); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Dot { tint: Theme.sound-type(preset.colour); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: preset.name;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: preset.details;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 0;
                                    vertical-alignment: center;
                                    text: preset.part;
                                    color: Theme.muted;
                                    font-size: Type.meta;
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.preset-said != "" ? root.preset-said
                        : root.can-drag ? "Drag a preset onto a track or a device to load it" : "Click a preset to see where it loads";
                    color: root.preset-said != "" ? Theme.accent : Theme.faint;
                    font-size: Type.meta;
                    overflow: elide;
                }
            }
        }

        if root.view == 5 && root.curve-editing: VerticalLayout {
            spacing: Space.sm;
            // The name plate: back to the list, the curve's name, how it's heard, Undo and Redo.
            HorizontalLayout {
                height: 32px;
                spacing: Space.sm;
                StudioButton {
                    horizontal-stretch: 0;
                    text: "‹ Curves";
                    tip: "Back to the list. The edits are kept while the plugin's window is open";
                    clicked => { root.curve-back(); }
                }
                Text {
                    text: CurveEditorData.name;
                    color: Theme.text;
                    font-size: Type.row-title;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if CurveEditorData.changed: Text {
                    text: "edited";
                    color: Theme.muted;
                    font-size: Type.meta;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                ToggleChip {
                    text: "Metronome";
                    on: CurveEditorData.metronome;
                    clicked => { CurveEditorData.metronome-toggled(); }
                }
                StudioButton {
                    horizontal-stretch: 0;
                    width: 32px;
                    icon: "M 5.5 3 L 2 6.5 L 5.5 10 M 2 6.5 L 10 6.5 A 4 4 0 0 1 10 14.5 L 7 14.5";
                    tip: "Undo";
                    enabled: CurveEditorData.can-undo;
                    clicked => { CurveEditorData.undo(); }
                }
                StudioButton {
                    horizontal-stretch: 0;
                    width: 32px;
                    icon: "M 10.5 3 L 14 6.5 L 10.5 10 M 14 6.5 L 6 6.5 A 4 4 0 0 0 6 14.5 L 9 14.5";
                    tip: "Redo";
                    enabled: CurveEditorData.can-redo;
                    clicked => { CurveEditorData.redo(); }
                }
            }
            CurveBench {
                menus: false;
                compact: true;
            }
            // What the app keeps in its right-click menu, as buttons: a DAW's plugin window opens no menus.
            HorizontalLayout {
                height: 28px;
                spacing: Space.xs;
                for item in CurveEditorData.part-menu: StudioButton {
                    horizontal-stretch: 0;
                    text: item.what;
                    enabled: item.enabled;
                    clicked => { CurveEditorData.menu-chosen(item.id); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                height: 32px;
                spacing: Space.md;
                StudioButton {
                    horizontal-stretch: 0;
                    text: CurveEditorData.playing ? "Stop" : "Hear";
                    main: CurveEditorData.playing;
                    tip: CurveEditorData.playing ? "Stop the tone" : "Hear the curve as the volume of a tone through this track, at the song's speed";
                    clicked => { CurveEditorData.hear(); }
                }
                GridStrip {
                    named: false;
                }
                DragHandle {
                    horizontal-stretch: 1;
                    text: root.can-drag ? "Drag the curve as it is now into Bitwig" : "Drag it out in Bitwig";
                    draggable: root.can-drag;
                    lifted: root.curve-edit-lifted;
                    drag-out => { root.curve-edit-drag-out(); }
                }
            }
            if root.curve-said != "": Text {
                text: root.curve-said;
                color: Theme.accent;
                font-size: Type.meta;
                overflow: elide;
            }
        }

        if root.view == 5 && !root.curve-editing: HorizontalLayout {
            spacing: Space.lg;
            VerticalLayout {
                width: 196px;
                alignment: start;
                spacing: Space.md;
                FilterList {
                    name: "FOUND IN";
                    filter: root.curve-from-filter;
                    toggled(text) => { root.curve-pick(text); }
                    cleared => { root.curve-clear(); }
                }
                TickLine {
                    text: "Show hidden curves";
                    on: root.curve-hidden;
                    clicked => { root.curve-hidden-toggled(!root.curve-hidden); }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                SearchBox {
                    hint: "Search curves";
                    text <=> root.curve-search-text;
                    edited(text) => { root.curve-search(text); }
                }
                Text {
                    text: root.curve-status;
                    color: Theme.muted;
                    font-size: Type.meta;
                    overflow: elide;
                }
                Rectangle {
                    vertical-stretch: 1;
                    if root.curve-empty != "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.curve-empty;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    ListView {
                        width: parent.width;
                        height: parent.height;
                        row-height: 48px;
                        rows: root.curves.length;
                        for curve[i] in root.curves: ListLine {
                            height: 48px;
                            selected: i == root.curve-picked;
                            draggable: root.can-drag;
                            lifted: i == root.curve-carried;
                            clicked => {
                                root.curve-picked = i;
                                root.curve-open(i);
                            }
                            drag-out => { root.curve-drag-out(i); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.md;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    width: 84px;
                                    Path {
                                        x: 2px;
                                        y: 8px;
                                        width: parent.width - 4px;
                                        height: parent.height - 16px;
                                        viewbox-width: 300;
                                        viewbox-height: 100;
                                        commands: curve.shape;
                                        stroke: Theme.accent;
                                        stroke-width: 1.5px;
                                        fill: transparent;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: curve.name;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: curve.under;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Text {
                                        text: curve.found;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: curve.length;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.curve-said != "" ? root.curve-said
                        : root.can-drag ? "Click a curve to edit it · drag one onto a Curves device or an automation lane" : "Click a curve to edit it";
                    color: root.curve-said != "" ? Theme.accent : Theme.faint;
                    font-size: Type.meta;
                    overflow: elide;
                }
            }
        }

        if root.view == 3: VerticalLayout {
            spacing: Space.lg;
            HorizontalLayout {
                spacing: Space.md;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: "Play into the plugin: the chord the app's chord reader hears shows here as you play.";
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                StudioButton {
                    horizontal-stretch: 0;
                    text: "Thru";
                    main: root.chord-thru;
                    tip: root.chord-thru
                        ? "The notes you play go on out of the plugin, for an instrument after it"
                        : "Pass the notes you play on out of the plugin, for an instrument after it";
                    clicked => {
                        root.chord-thru = !root.chord-thru;
                        root.chord-thru-changed(root.chord-thru);
                    }
                }
            }
            HorizontalLayout {
                spacing: Space.lg;
                VerticalLayout {
                    min-width: 220px;
                    max-width: 300px;
                    spacing: Space.xs;
                    Text {
                        text: root.chord-name == "" ? "No chord yet" : root.chord-name;
                        color: root.chord-name == "" ? Theme.faint : Theme.text;
                        font-size: Type.page-title;
                        font-weight: 600;
                    }
                    Text {
                        text: root.chord-sure;
                        color: Theme.muted;
                        font-size: Type.body;
                    }
                    Text {
                        text: root.chord-line;
                        color: Theme.faint;
                        font-size: Type.meta;
                        font-family: Theme.number-font;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.xs;
                    Text {
                        text: "The last bars  (? not sure, ≈ the same notes have another name)";
                        color: Theme.muted;
                        font-size: Type.meta;
                        font-weight: 600;
                    }
                    // The chords of the newest bars, in order: the one sounding now in the accent colour; a chord the reader
                    // isn't sure of is fainter, with a question mark by where it starts; one whose notes have another
                    // name too has "≈" there.
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        for c in root.chord-strip: Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: c.now ? Theme.accent : Theme.stroke;
                            background: Theme.surface;
                            min-width: 72px;
                            VerticalLayout {
                                padding: Space.sm;
                                spacing: 2px;
                                Text {
                                    text: c.name;
                                    color: c.now ? Theme.accent : c.sure == 2 ? Theme.faint : Theme.text;
                                    font-size: Type.body;
                                    font-weight: 600;
                                }
                                Text {
                                    text: c.sure == 2 ? c.at + "  ?" : c.sure == 1 ? c.at + "  ≈" : c.at;
                                    color: Theme.faint;
                                    font-size: Type.small;
                                    font-family: Theme.number-font;
                                }
                            }
                        }
                    }
                    Rectangle { }
                }
            }
            Text {
                text: root.takes.length == 0
                    ? "Your takes: a take ends after two bars with no keys down, then shows here to label"
                    : "Your takes: pick one, then say what each chord really is (it's saved in the Chord check folder)";
                color: Theme.muted;
                font-size: Type.meta;
                font-weight: 600;
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Space.lg;
                ListView {
                    width: 210px;
                    row-height: 44px;
                    rows: root.takes.length;
                    for t[i] in root.takes: ListLine {
                        height: 44px;
                        selected: i == root.take-picked;
                        clicked => {
                            root.take-picked = i;
                            root.take-pick(i);
                        }
                        VerticalLayout {
                            padding-left: Space.sm;
                            padding-right: Space.sm;
                            alignment: center;
                            Text {
                                text: t.title;
                                color: Theme.text;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: t.details;
                                color: Theme.faint;
                                font-size: Type.small;
                                overflow: elide;
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: Space.sm;
                    Text {
                        text: root.take-said;
                        color: Theme.accent;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    ListView {
                        row-height: 76px;
                        rows: root.take-chords.length;
                        for c[i] in root.take-chords: Rectangle {
                            height: 76px;
                            VerticalLayout {
                                padding: Space.xs;
                                spacing: Space.xs;
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Text {
                                        width: 40px;
                                        text: c.at;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        font-family: Theme.number-font;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: c.read == "" ? "No chord read" : c.read;
                                        color: c.sure == 2 ? Theme.muted : Theme.text;
                                        font-size: Type.body;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: c.said == "" ? "" : "You said: " + c.said;
                                        color: Theme.accent;
                                        font-size: Type.meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.xs;
                                    alignment: start;
                                    StudioButton {
                                        text: "Right";
                                        main: c.said == "Right";
                                        tip: c.read == "" ? "Right: there's no chord here" : "Right: it is " + c.read;
                                        clicked => { root.label(i, "right", 0); }
                                    }
                                    for name[j] in c.choices: StudioButton {
                                        text: name;
                                        main: c.said == name;
                                        tip: "It's " + name;
                                        clicked => { root.label(i, "choice", j); }
                                    }
                                    StudioButton {
                                        text: "Not a chord";
                                        main: c.said == "Not a chord";
                                        tip: "Passing notes or a run, not a chord";
                                        clicked => { root.label(i, "not a chord", 0); }
                                    }
                                    StudioButton {
                                        text: "Skip";
                                        main: c.said == "Skipped";
                                        tip: "Not sure: left out of the bench";
                                        clicked => { root.label(i, "skip", 0); }
                                    }
                                    typed := SearchBox {
                                        width: 150px;
                                        search: false;
                                        hint: "Type it";
                                        key(k) => {
                                            if (k == Key.Return && self.text != "") {
                                                if (root.label-typed(i, self.text)) {
                                                    self.text = "";
                                                }
                                                return true;
                                            }
                                            return false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.view == 4: VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                spacing: Space.md;
                Text {
                    horizontal-stretch: 1;
                    text: root.extensions-summary;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    spacing: Space.xs;
                    StudioButton {
                        text: "Copy list";
                        clicked => { root.copy(); }
                    }
                    Text {
                        text: root.copied;
                        color: Theme.accent;
                        font-size: Type.small;
                        horizontal-alignment: center;
                    }
                }
            }
            ListView {
                row-height: 40px;
                rows: root.extensions.length;
                for ext in root.extensions: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.md;
                        spacing: Space.md;
                        Text {
                            width: 28px;
                            vertical-alignment: center;
                            text: ext.offered ? "Yes" : "No";
                            color: ext.offered ? Theme.accent : Theme.faint;
                            font-size: Type.meta;
                            font-weight: 600;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: ext.name;
                                color: ext.offered ? Theme.text : Theme.muted;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: ext.id;
                                color: Theme.faint;
                                font-size: Type.small;
                                font-family: Theme.number-font;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            // The credit Slint's royalty-free licence asks for, as the app's About box gives it.
            Text {
                text: "Made with Slint";
                color: Theme.faint;
                font-size: Type.small;
            }
        }
    }
}
