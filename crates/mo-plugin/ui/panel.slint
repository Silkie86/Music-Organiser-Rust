// The test plugin's panel: what shows inside the DAW's plugin window. Built from the app's own style (studio.slint),
// so it looks like the app. Two views: Sounds (the app's sound library as a list or as the Galaxy, click to play
// through the track, with the app's own filters and orders)
// and DAW check (every CLAP extension the DAW was asked for, and whether it has it).

import { Theme, Type, Space, SearchBox, ListLine, StudioButton, Segmented, TickLine, Caps, Heart, Dot, FilterList, FilterView, FilterChoice, RangeSlider, PickButton, PointerPad, HoverNote, MapName, MapInset, LinkText, OneOfChip, YearRange, YearBar } from "../../mo-ui/ui/studio.slint";
export { FilterView, FilterChoice, YearBar }
import { ListView } from "../../mo-ui/ui/list.slint";

import "../../mo-ui/fonts/IBMPlexSans-400.ttf";
import "../../mo-ui/fonts/IBMPlexSans-600.ttf";
import "../../mo-ui/fonts/IBMPlexMono-400.ttf";

export struct SoundLine {
    name: string,
    // The folder it's in, shorter: the second line.
    folder: string,
    // Its type, tempo, key and length, as far as the app knows them: after the folder.
    facts: string,
    favourite: bool,
    // Its type's colour, as its place in the theme's list (mo-app's `sounds::type_colour`); -1 for grey.
    colour: int,
    // Its waveform, white on nothing (the line tints it in its type's colour); empty until it's read, or when it has none.
    wave: image,
}

export struct ExtensionLine {
    // What the extension is for, in plain words.
    name: string,
    // The id the DAW was asked for, exactly.
    id: string,
    offered: bool,
}

// A neighbourhood's name over the Galaxy's map: which one, where the middle of its bottom edge is, its type's colour
// and how strongly it shows.
export struct SkyName {
    region: int,
    name: string,
    x: length,
    y: length,
    colour: int,
    fade: float,
}

// A dot on the Galaxy's trail: where its star is on the view, and how strongly it shows (fainter with age).
export struct TrailDot {
    x: length,
    y: length,
    fade: float,
}

// A line of the Galaxy's Swept card: a sound heard on the map lately, and whether Back and Next are on it.
export struct SweptLine {
    name: string,
    kind: string,
    colour: int,
    current: bool,
}

export component Panel inherits Window {
    // The DAW and its version, and the track the plugin is on, when the DAW says.
    in property <string> host;
    in property <string> track;
    in property <[SoundLine]> sounds;
    // How the read went: "Reading the sound library", "1,234 sounds", or what's wrong.
    in property <string> status;
    // What's playing, or what went wrong playing it.
    in property <string> playing;
    in property <[ExtensionLine]> extensions;
    in property <string> extensions-summary;
    // "Copied" after Copy list, or what went wrong.
    in property <string> copied;
    // The filter column, as the app's Sounds page has it (mo-app's `sounds::chips`): each choice with its count.
    in property <FilterView> type-filter;
    // How many types the column has room for as lines of their own, before the More types menu: what's left of its
    // height once everything under the types has its room, in lines (a TickLine is 26px high). Never under 9.
    in-out property <int> type-lines: 9;
    in property <FilterView> length-filter;
    in property <FilterView> key-filter;
    in property <FilterView> tag-filter;
    in property <bool> mix-well;
    in property <bool> favourites;
    // The Tempo slider: its ends and step, where its handles are, what's picked in words, and its bars.
    in property <int> tempo-low-end;
    in property <int> tempo-high-end: 100;
    in property <int> tempo-step: 1;
    in property <int> tempo-low;
    in property <int> tempo-high: 100;
    in property <string> tempo-words;
    in property <[float]> tempo-bars;
    // The orders on offer, and the one the list is in.
    in property <[string]> orders;
    in property <int> order;
    in-out property <int> picked: -1;
    in-out property <int> view: 0;
    // How wide a line's waveform is: it grows with the window (the list sets it); mo-plugin's waves.rs makes the
    // pictures this wide.
    in-out property <length> wave-width: 120px;
    // The sounds as the Galaxy (every sound a star, as on the app's Sounds page) and not as a list.
    in-out property <bool> galaxy;
    // The stars' picture, and where it sits on the Galaxy's view now (it's moved and stretched with the view until
    // the next picture is drawn).
    // The names over the map, zoomed out (a click flies into its neighbourhood), and the rings round the star under
    // the mouse and the star last played.
    in property <[SkyName]> sky-names;
    callback sky-name(int);
    in property <bool> sky-ring;
    in property <length> sky-ring-x;
    in property <length> sky-ring-y;
    in property <bool> sky-picked;
    in property <length> sky-picked-x;
    in property <length> sky-picked-y;
    in property <image> sky-picture;
    // What the Galaxy sits on: the graphics card paints its picture over the same colour.
    out property <color> sky-well: Theme.well;
    in property <length> sky-x;
    in property <length> sky-y;
    in property <length> sky-w;
    in property <length> sky-h;
    // A word in the middle while there's no map to show ("Reading the galaxy", or why there's none).
    in property <string> sky-note;
    // The star under the mouse: its name ("" for none) and where the mouse is.
    in property <string> sky-hover;
    in property <length> sky-hover-x;
    in property <length> sky-hover-y;
    // The map is being dragged.
    in property <bool> sky-grabbing;
    // Every sound type's colour, for the stars.
    out property <[color]> type-colours: Theme.sound-types;
    // The Galaxy's view is this big now.
    callback sky-size(length, length);
    // A button went down on the Galaxy (true: the right or middle one, which moves the map), the mouse moved, and
    // the button came up again; `sky-cancelled` first when the press was taken away.
    callback sky-down(length, length, bool);
    callback sky-move(length, length);
    callback sky-up(bool);
    callback sky-cancelled();
    // The wheel, in notches (positive flies in).
    callback sky-wheel(float);
    // The mouse left the Galaxy.
    callback sky-gone();
    // Back out to the whole map.
    callback sky-home();
    // The mini-map, once the view has flown in: the whole map, with a box round the part on show (0 to 1 each way).
    in property <bool> sky-mini;
    in property <image> sky-mini-picture;
    in property <string> sky-mini-title;
    in property <float> sky-mini-x;
    in property <float> sky-mini-y;
    in property <float> sky-mini-w;
    in property <float> sky-mini-h;
    // Pressed or dragged on, this far across and down it (0 to 1).
    callback sky-mini-go(float, float);
    // What makes a star bigger and brighter ("Liked", "Length"...), one always picked.
    in property <FilterView> sky-light;
    callback sky-light-by(string);
    // The trail: a line through the stars heard lately (a path's commands, in the view's points), a dot on each, and
    // the Swept card that lists them, newest first.
    in property <string> sky-trail;
    in property <[TrailDot]> sky-trail-dots;
    in property <[SweptLine]> sky-swept;
    // The Swept card was clicked into: Up and Down go through its sounds.
    in-out property <bool> sky-swept-keys;
    callback sky-swept-go(int);
    // 1: to the sound swept before (Back); -1: to the one after (Next).
    callback sky-swept-step(int);
    callback sky-swept-clear();
    // An arrow key with the keys on the Galaxy: -1 Left, 1 Right, -2 Up, 2 Down (as the app numbers them).
    callback sky-arrow(int);
    // The year strip beside the sounds, as on the app's Sounds page: the years sounds were added in, newest first,
    // and the places of the years picked (-1 for none). Drag over years to show only those.
    in property <[YearBar]> years;
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    // Where the sound playing is in its file, for the line on its waveform: the row it's on (-1 for none) and how
    // far through the whole sound (0 the start, 1 the end).
    in property <int> playing-row: -1;
    in property <float> playing-at;
    callback search(string);
    // A line was clicked: on its waveform at this spot (0 its start, up to 1, its end), or anywhere else on it (-1).
    // The sound plays from the spot, or from the start; a click on the line that's playing stops it instead.
    callback play(int, float);
    // A line is being dragged out (onto a track): its row.
    callback drag-out(int);
    // Whether lines can be dragged out on this system, and the row being carried (-1 for none).
    in property <bool> can-drag;
    in property <int> carried: -1;
    callback stop();
    // Trim silence: sounds play without the silence at their start and end (the files stay as they are), with how
    // quiet counts as silence in dB below full scale, and a pick from its menu ("-50").
    in property <bool> trim-silence;
    in property <int> trim-level-db: -60;
    in property <[string]> trim-choices;
    // A pick from its menu: "-50 dB", or "" for off.
    callback pick-trim(string);
    // A choice was picked or unpicked on a filter ("type", "length", "key", "tag"): its words.
    callback pick(string, string);
    // Nothing picked on a filter (or "more-types": only the types in the More menu).
    callback clear(string);
    // An on/off line: "mix-well" or "favourites".
    callback toggle(string);
    callback tempo-picked(int, int);
    callback pick-order(int);
    callback copy();

    title: "Music Organiser";
    preferred-width: 760px;
    preferred-height: 560px;
    background: Theme.background;
    default-font-family: Theme.text-font;
    default-font-size: Type.body;

    VerticalLayout {
        padding: Space.lg;
        spacing: Space.md;

        HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                spacing: Space.xs;
                Text {
                    text: "Music Organiser";
                    color: Theme.text;
                    font-size: Type.heading;
                    font-weight: 600;
                }
                Text {
                    text: root.track == "" ? root.host : root.host + "  ·  track " + root.track;
                    color: Theme.muted;
                    font-size: Type.meta;
                }
            }
            Rectangle { }
            Segmented {
                choices: ["Sounds", "DAW check"];
                current: root.view;
                picked(i) => { root.view = i; }
            }
        }

        if root.view == 0: HorizontalLayout {
            spacing: Space.lg;
            // The filter column, laid out as the app's Sounds page lays out its own: tick lists, each choice with its
            // count. It scrolls with the wheel when the window is too short for them all.
            flick := Flickable {
                width: 196px;
                content-width: self.width;
                content-height: max(self.height, lists.preferred-height);
                mouse-drag-pan-enabled: false;
                // The column was made taller or shorter, or what's under the types changed.
                // What everything but the types' own lines needs.
                property <length> rest: lists.preferred-height - root.type-filter.chips.length * 26px;
                function fit() {
                    root.type-lines = max(9, Math.floor((self.height - self.rest) / 26px));
                }
                init => { self.fit(); }
                changed height => { self.fit(); }
                changed rest => { self.fit(); }
                lists := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: flick.width - Space.md;
                    alignment: start;
                    spacing: Space.md;
                    FilterList {
                        name: "TYPE";
                        more-name: "More types";
                        filter: root.type-filter;
                        toggled(text) => { root.pick("type", text); }
                        cleared => { root.clear("more-types"); }
                    }
                    // One of three, so a switch: both, hits (one-shots) or loops.
                    VerticalLayout {
                        Caps {
                            text: "LENGTH";
                            height: 22px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Segmented {
                                property <[FilterChoice]> lengths: root.length-filter.chips;
                                choices: ["All", "Hits", "Loops"];
                                pad: Space.md;
                                current: self.lengths.length < 2 ? 0 : self.lengths[0].on ? 1 : self.lengths[1].on ? 2 : 0;
                                picked(i) => {
                                    if i == 0 {
                                        root.clear("length");
                                    } else if i != self.current {
                                        root.pick("length", self.lengths[i - 1].text);
                                    }
                                }
                            }
                        }
                    }
                    FilterList {
                        name: "KEY";
                        filter: root.key-filter;
                        toggled(text) => { root.pick("key", text); }
                        cleared => { root.clear("key"); }
                    }
                    if root.key-filter.more-picked != "": TickLine {
                        text: "Keys that mix well";
                        on: root.mix-well;
                        clicked => { root.toggle("mix-well"); }
                    }
                    // A span of tempos, so a slider with two handles; its bars show where the sounds are.
                    VerticalLayout {
                        padding-right: Space.sm;
                        HorizontalLayout {
                            height: 22px;
                            Caps {
                                text: "TEMPO";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.tempo-words;
                                color: tempo.on ? Theme.text : Theme.faint;
                                font-size: Type.meta;
                                font-weight: tempo.on ? 600 : 400;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        tempo := RangeSlider {
                            low-end: root.tempo-low-end;
                            high-end: root.tempo-high-end;
                            step: root.tempo-step;
                            low: root.tempo-low;
                            high: root.tempo-high;
                            bars: root.tempo-bars;
                            changed(low, high) => { root.tempo-picked(low, high); }
                        }
                    }
                    if root.tag-filter.chips.length + root.tag-filter.more.length > 0: FilterList {
                        name: "TAG";
                        more-name: "More tags";
                        filter: root.tag-filter;
                        toggled(text) => { root.pick("tag", text); }
                        cleared => { root.clear("tag"); }
                    }
                    VerticalLayout {
                        Caps {
                            text: "SHOW ONLY";
                            height: 22px;
                        }
                        TickLine {
                            text: "Favourites";
                            on: root.favourites;
                            clicked => { root.toggle("favourites"); }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    SearchBox {
                        horizontal-stretch: 1;
                        hint: "Search sounds";
                        edited(text) => { root.search(text); }
                    }
                    Segmented {
                        horizontal-stretch: 0;
                        choices: ["List", "Galaxy"];
                        current: root.galaxy ? 1 : 0;
                        pad: Space.md;
                        picked(i) => { root.galaxy = i == 1; }
                    }
                    PickButton {
                        horizontal-stretch: 0;
                        name: "Trim silence";
                        value: root.trim-silence ? root.trim-level-db + " dB" : "";
                        none-text: "Off: play the whole file";
                        choices: root.trim-choices;
                        picked(t) => { root.pick-trim(t); }
                    }
                    StudioButton {
                        horizontal-stretch: 0;
                        text: "Stop";
                        clicked => { root.stop(); }
                    }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.status;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    if !root.galaxy: Segmented {
                        horizontal-stretch: 0;
                        choices: root.orders;
                        current: root.order;
                        pad: Space.md;
                        picked(i) => { root.pick-order(i); }
                    }
                    if root.galaxy: StudioButton {
                        horizontal-stretch: 0;
                        text: "Whole galaxy";
                        clicked => { root.sky-home(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    property <length> years-width: root.years.length > 1 ? 56px : 0px;
                    if self.years-width > 0: YearRange {
                        x: parent.width - self.width;
                        y: 0;
                        width: parent.years-width;
                        height: parent.height;
                        years: root.years;
                        picked-from: root.years-from;
                        picked-to: root.years-to;
                        picked(a, b) => { root.years-picked(a, b); }
                        cleared => { root.years-cleared(); }
                    }
                    // The Galaxy: the wheel flies in and out, the right button moves the map, a click plays a star and
                    // the left button held down plays the stars it passes.
                    if root.galaxy: Rectangle {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        background: Theme.well;
                        border-radius: Theme.radius;
                        clip: true;
                        init => {
                            root.sky-size(self.width, self.height);
                            sky-keys.focus();
                        }
                        changed width => { root.sky-size(self.width, self.height); }
                        changed height => { root.sky-size(self.width, self.height); }
                        Image {
                            x: root.sky-x;
                            y: root.sky-y;
                            width: root.sky-w;
                            height: root.sky-h;
                            source: root.sky-picture;
                            image-fit: fill;
                        }
                        if root.sky-trail != "": Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: parent.width / 1px;
                            viewbox-height: parent.height / 1px;
                            commands: root.sky-trail;
                            stroke: Theme.text;
                            stroke-width: 1.2px;
                            opacity: 0.45;
                        }
                        for d in root.sky-trail-dots: Rectangle {
                            x: d.x - 4px;
                            y: d.y - 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.text;
                            opacity: 0.2 + 0.6 * d.fade;
                        }
                        if root.sky-note != "": Text {
                            width: parent.width - 2 * Space.lg;
                            text: root.sky-note;
                            color: Theme.muted;
                            font-size: Type.body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        if root.sky-ring: Rectangle {
                            x: root.sky-ring-x - 7px;
                            y: root.sky-ring-y - 7px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 1.5px;
                            border-color: Theme.text;
                            opacity: 0.7;
                        }
                        if root.sky-picked: Rectangle {
                            x: root.sky-picked-x - 9px;
                            y: root.sky-picked-y - 9px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 2px;
                            border-color: Theme.accent;
                        }
                        // The keys come here when the Galaxy opens or is pressed (and leave for the search box when
                        // that's clicked): the arrows go from star to star.
                        sky-keys := FocusScope {
                            width: 0;
                            height: 0;
                            key-pressed(e) => {
                                if e.text == Key.LeftArrow {
                                    root.sky-arrow(-1);
                                } else if e.text == Key.RightArrow {
                                    root.sky-arrow(1);
                                } else if e.text == Key.UpArrow {
                                    root.sky-arrow(-2);
                                } else if e.text == Key.DownArrow {
                                    root.sky-arrow(2);
                                } else {
                                    return reject;
                                }
                                accept
                            }
                        }
                        PointerPad {
                            grabbing: root.sky-grabbing;
                            down(x, y) => {
                                sky-keys.focus();
                                root.sky-swept-keys = false;
                                root.sky-down(x, y, false);
                            }
                            side-down(x, y) => {
                                sky-keys.focus();
                                root.sky-down(x, y, true);
                            }
                            side-up => { root.sky-up(true); }
                            move(x, y) => { root.sky-move(x, y); }
                            cancelled => { root.sky-cancelled(); }
                            up => { root.sky-up(false); }
                            wheel(x, dx, dy, ctrl, shift) => { root.sky-wheel(dy); }
                            gone => { root.sky-gone(); }
                        }
                        for l in root.sky-names: MapName {
                            x: l.x - self.width / 2;
                            y: l.y - self.height;
                            text: l.name;
                            tint: Theme.sound-type(l.colour);
                            opacity: l.fade;
                            clicked => { root.sky-name(l.region); }
                        }
                        if root.sky-mini: MapInset {
                            x: parent.width - self.width - Space.md;
                            y: parent.height - self.height - Space.md;
                            picture: root.sky-mini-picture;
                            title: root.sky-mini-title;
                            box-x: root.sky-mini-x;
                            box-y: root.sky-mini-y;
                            box-width: root.sky-mini-w;
                            box-height: root.sky-mini-h;
                            go(x, y) => { root.sky-mini-go(x, y); }
                        }
                        // The map's own setting, on the map, as the app's.
                        OneOfChip {
                            x: Space.md;
                            y: Space.md;
                            name: "Light by";
                            filter: root.sky-light;
                            picked(text) => { root.sky-light-by(text); }
                        }
                        // The Swept card, as the app's: the sounds heard on the map lately. It leaves the mini-map
                        // its corner, and stays away in a view too narrow for both it and the map.
                        if root.sky-swept.length > 0 && parent.width >= 420px: Rectangle {
                            x: parent.width - self.width - Space.md;
                            y: Space.md;
                            width: 250px;
                            height: min(swept-card.preferred-height, parent.height - 2 * Space.md - (root.sky-mini ? 170px + Space.md : 0px));
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            // Accent while the arrow keys go through it.
                            border-color: root.sky-swept-keys && sky-keys.has-focus ? Theme.accent : Theme.edge;
                            clip: true;
                            // The card takes its own clicks and the wheel, so they don't reach the map under it; a
                            // click on it hands it the arrow keys.
                            TouchArea {
                                clicked => {
                                    sky-keys.focus();
                                    root.sky-swept-keys = true;
                                }
                                scroll-event(e) => { accept }
                            }
                            swept-card := VerticalLayout {
                                padding: Space.md;
                                spacing: Space.xs;
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Caps {
                                        text: "SWEPT";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    StudioButton {
                                        text: "Back";
                                        tip: "The sound swept before this one";
                                        clicked => {
                                            sky-keys.focus();
                                            root.sky-swept-keys = true;
                                            root.sky-swept-step(1);
                                        }
                                    }
                                    StudioButton {
                                        text: "Next";
                                        tip: "The sound swept after this one";
                                        clicked => {
                                            sky-keys.focus();
                                            root.sky-swept-keys = true;
                                            root.sky-swept-step(-1);
                                        }
                                    }
                                }
                                for line[i] in root.sky-swept: ListLine {
                                    height: 30px;
                                    selected: line.current;
                                    tip: line.kind;
                                    clicked => {
                                        sky-keys.focus();
                                        root.sky-swept-keys = true;
                                        root.sky-swept-go(i);
                                    }
                                    HorizontalLayout {
                                        padding-left: Space.sm;
                                        padding-right: Space.sm;
                                        spacing: Space.sm;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Dot { tint: Theme.sound-type(line.colour); }
                                        }
                                        Text {
                                            text: line.name;
                                            color: line.current ? Theme.text : Theme.muted;
                                            font-size: Type.meta;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    // What the arrow keys do here, so it's seen, not guessed.
                                    Text {
                                        text: root.sky-swept-keys && sky-keys.has-focus ? "Up and Down go through these" : "Click here, then Up and Down";
                                        color: root.sky-swept-keys && sky-keys.has-focus ? Theme.accent : Theme.muted;
                                        font-size: Type.meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    LinkText {
                                        text: "Clear";
                                        tint: Theme.muted;
                                        font-size: Type.meta;
                                        clicked => { root.sky-swept-clear(); }
                                    }
                                }
                            }
                        }
                        if root.sky-hover != "": HoverNote {
                            text: root.sky-hover;
                            at-x: root.sky-hover-x;
                            at-y: root.sky-hover-y;
                            room-width: parent.width;
                            room-height: parent.height;
                        }
                    }
                    ListView {
                        x: 0;
                        width: parent.width - parent.years-width;
                        height: parent.height;
                        visible: !root.galaxy;
                        row-height: 48px;
                        rows: root.sounds.length;
                        // The waveforms take a bit under half of a line, in steps (so dragging the window's edge
                        // doesn't ask for new pictures at every pixel), and never less than 120.
                        function fit() {
                            root.wave-width = max(120px, Math.floor(self.width * 0.45 / 40px) * 40px);
                        }
                        init => { self.fit(); }
                        changed width => { self.fit(); }
                        for sound[i] in root.sounds: ListLine {
                            height: 48px;
                            selected: i == root.picked;
                            draggable: root.can-drag;
                            lifted: i == root.carried;
                            clicked => {
                                root.picked = i;
                                // A click on the waveform plays from that spot; anywhere else, from the start.
                                root.play(i, wave.source.width > 0 && self.pressed-x >= wave.absolute-position.x - self.absolute-position.x
                                    && self.pressed-x < wave.absolute-position.x - self.absolute-position.x + wave.width
                                    ? (self.pressed-x - (wave.absolute-position.x - self.absolute-position.x)) / wave.width : -1);
                            }
                            drag-out => { root.drag-out(i); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                // Its type's colour, as the app's own sound lines show it.
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Dot { tint: Theme.sound-type(sound.colour); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: sound.name;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: sound.facts == "" ? sound.folder : sound.folder + "  ·  " + sound.facts;
                                        color: Theme.faint;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    // The size mo-plugin's waves.rs makes the picture for.
                                    wave := Image {
                                        width: root.wave-width;
                                        height: 30px;
                                        source: sound.wave;
                                        image-fit: fill;
                                        colorize: Theme.sound-type(sound.colour);
                                        // Where it's playing now.
                                        if i == root.playing-row: Rectangle {
                                            x: min(parent.width - self.width, max(0px, parent.width * root.playing-at - self.width / 2));
                                            y: -3px;
                                            width: 2px;
                                            height: parent.height + 6px;
                                            border-radius: 1px;
                                            background: Theme.text;
                                        }
                                    }
                                }
                                if sound.favourite: VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Heart { }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.playing;
                    color: Theme.accent;
                    font-size: Type.meta;
                    overflow: elide;
                }
            }
        }

        if root.view == 1: VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                spacing: Space.md;
                Text {
                    horizontal-stretch: 1;
                    text: root.extensions-summary;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    spacing: Space.xs;
                    StudioButton {
                        text: "Copy list";
                        clicked => { root.copy(); }
                    }
                    Text {
                        text: root.copied;
                        color: Theme.accent;
                        font-size: Type.small;
                        horizontal-alignment: center;
                    }
                }
            }
            ListView {
                row-height: 40px;
                rows: root.extensions.length;
                for ext in root.extensions: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.md;
                        spacing: Space.md;
                        Text {
                            width: 28px;
                            vertical-alignment: center;
                            text: ext.offered ? "Yes" : "No";
                            color: ext.offered ? Theme.accent : Theme.faint;
                            font-size: Type.meta;
                            font-weight: 600;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: ext.name;
                                color: ext.offered ? Theme.text : Theme.muted;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: ext.id;
                                color: Theme.faint;
                                font-size: Type.small;
                                font-family: Theme.number-font;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            // The credit Slint's royalty-free licence asks for, as the app's About box gives it.
            Text {
                text: "Made with Slint";
                color: Theme.faint;
                font-size: Type.small;
            }
        }
    }
}
