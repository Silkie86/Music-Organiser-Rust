// The arrangement at the top of a song's Overview: the project drawn as its DAW shows it. mo-app works out the shapes
// on a background thread, and the graphics card draws them into a picture (mo-ui's arrangement.rs and canvas.rs; the
// processor where there's no card); the words are laid on top here, in the app's own fonts, each clipped to its strip:
// track names on the left, the ruler along the top, clip names on the timeline.
import { Theme, CutText, Type, Space, ToggleChip, PointerPad, HoverNote, Seam, Widths, StudioButton, Icons, CloseButton, Caps, LinkText, ValueLine } from "../studio.slint";

// How a label on the picture looks.
export enum ArrKind {
    // A track's name, a group's, an automation lane's, and what plays a track under its name.
    lane, group, automation, detail,
    // The view's name at the ruler's left, a bar number, a marker on its flag.
    head, bar, marker,
    // A clip's name on its title bar, and "muted" and other small notes.
    clip, small,
}

// Words to lay on the picture. `x` and `y` are from the view's top left; `width` is the room there is.
export struct ArrLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    text: string,
    kind: ArrKind,
    muted: bool,
}

// One of the song's instruments in the Sounds panel, and the General MIDI sound it plays with (mo-ui's
// arrangement_play.rs).
export struct ArrSound {
    name: string,
    sound: string,
    // The sound and why it was matched, or that you picked it.
    tip: string,
    // You picked it (it isn't the one matched).
    yours: bool,
    colour: color,
    has-colour: bool,
}

// A sound to pick in the panel's open line: its name, and whether it's the one playing.
export struct ArrChoice {
    name: string,
    on: bool,
}

// What the preview shows and what it reports, filled and answered by mo-ui's arrangement.rs.
export global ArrangementData {
    // The project's views ("FL Studio playlist", "As it opens in Bitwig"); chips only when there's more than one.
    in property <[string]> views;
    in-out property <int> view;
    // "140 BPM · 64 bars · 2:44 · 12 tracks · 80 clips · 2,400 notes"
    in property <string> summary;
    in property <[string]> notes;
    // Shown instead of the picture while it's read, or when there's nothing to draw.
    in property <string> message: "Reading the arrangement…";
    in property <image> picture;
    in property <length> header-width: 172px;
    // The track names' right edge dragged to a new width: the app draws the song again with it.
    callback names-resizing(length);
    in property <length> ruler-height: 24px;
    in property <[ArrLabel]> header-labels;
    in property <[ArrLabel]> timeline-labels;
    in property <[ArrLabel]> ruler-labels;
    in property <string> hover-text;
    in property <length> hover-x;
    in property <length> hover-y;
    in property <bool> dragging;
    // A clip or a track dragged out of the app, to a DAW (mo-ui's arrangement.rs): where it is on the view, dimmed
    // while it's carried (`lifted`) and with a glow round it for a moment once it has landed.
    in property <length> lifted-x;
    in property <length> lifted-y;
    in property <length> lifted-width;
    in property <length> lifted-height;
    in property <bool> lifted;
    in property <bool> landed;

    callback pick-view(int);
    callback resized(length, length);
    // The wheel, in notches (positive away from you), with Ctrl and Shift.
    callback wheel(length, float, float, bool, bool);
    // The left button: on a clip or a track's name it drags that out of the app, elsewhere it moves the view.
    callback grab(length, length);
    callback moved(length, length);
    callback let-go();
    // The right or middle button moves the view wherever it's pressed.
    callback side-grab(length, length);
    callback side-let-go();
    callback double-clicked();
    callback left();

    // Playing the song's MIDI with General MIDI sounds (mo-ui's arrangement_play.rs): Play, the playhead (a click on
    // the ruler moves it), and the Sounds panel, where each instrument's sound can be changed.
    in property <bool> can-play;
    in property <string> play-tip;
    in property <string> play-key;
    in property <bool> playing;
    // Under the picture: why it can't play (no SoundFont, say).
    in property <string> play-note;
    in property <bool> playhead-shown;
    in property <length> playhead-x;
    callback toggle-play();
    // While it plays: where the playhead is now.
    callback tick();
    in property <[ArrSound]> sounds;
    in property <string> sounds-badge;
    in-out property <bool> sounds-open;
    // The line whose sounds are shown to pick from (-1 none), the family shown there, and its sounds.
    in property <int> sound-open: -1;
    in property <[string]> families;
    in property <int> family-shown;
    in property <[ArrChoice]> family-sounds;
    callback pick-line(int);
    callback show-family(int);
    callback pick-sound(int);
    callback matched-sound();
}

// The sounds to pick from under an open line: General MIDI's families, then the family's sounds.
component SoundPicker inherits VerticalLayout {
    in property <bool> yours;
    padding-left: Space.sm;
    padding-right: Space.sm;
    padding-bottom: Space.sm;
    spacing: Space.sm;
    FlexboxLayout {
        spacing: Space.xs;
        for f[j] in ArrangementData.families: ToggleChip {
            text: f;
            on: j == ArrangementData.family-shown;
            clicked => { ArrangementData.show-family(j); }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.stroke;
    }
    FlexboxLayout {
        spacing: Space.xs;
        for c[k] in ArrangementData.family-sounds: ToggleChip {
            text: c.name;
            on: c.on;
            clicked => { ArrangementData.pick-sound(k); }
        }
    }
    if root.yours: HorizontalLayout {
        alignment: start;
        LinkText {
            text: "Back to the matched sound";
            tint: Theme.muted;
            font-size: Type.meta;
            clicked => { ArrangementData.matched-sound(); }
        }
    }
}

component Words inherits Rectangle {
    in property <[ArrLabel]> labels;
    // Where this strip is in the view, so a label's place in the view becomes its place in the strip.
    in property <length> from-x;
    in property <length> from-y;
    clip: true;
    for l in labels: Text {
        x: l.x - root.from-x;
        y: l.y - root.from-y;
        width: l.width;
        height: l.height;
        text: l.text;
        overflow: elide;
        vertical-alignment: center;
        font-family: l.kind == ArrKind.bar ? Theme.number-font : Theme.text-font;
        font-size: l.kind == ArrKind.lane || l.kind == ArrKind.group ? Type.meta
            : l.kind == ArrKind.clip || l.kind == ArrKind.small ? Type.tiny : Type.small;
        font-weight: l.kind == ArrKind.group || l.kind == ArrKind.head ? 600
            : l.kind == ArrKind.lane || l.kind == ArrKind.clip ? 500 : 400;
        letter-spacing: l.kind == ArrKind.head ? 0.8px : 0px;
        color: l.muted ? Theme.faint
            : l.kind == ArrKind.lane || l.kind == ArrKind.group || l.kind == ArrKind.clip ? Theme.text
            : l.kind == ArrKind.marker ? Theme.on-warning
            : l.kind == ArrKind.small ? Theme.faint
            : Theme.muted;
    }
}

// The drawn arrangement, with its view chips, summary and notes above it.
export component ArrangementPreview inherits VerticalLayout {
    spacing: Space.sm;
    // The playhead follows the song while its MIDI plays.
    Timer {
        interval: 33ms;
        running: ArrangementData.playing;
        triggered => { ArrangementData.tick(); }
    }
    // In a narrow panel the chips and the summary wrap onto lines of their own, so none runs past its edge. Chips
    // only when there's more than one view.
    FlexboxLayout {
        spacing: Space.sm;
        cross-axis-alignment: center;
        vertical-stretch: 0;
        StudioButton {
            icon: ArrangementData.playing ? Icons.stop : Icons.play;
            tip: ArrangementData.playing ? "Stop" : ArrangementData.play-tip;
            key: ArrangementData.play-key;
            enabled: ArrangementData.can-play || ArrangementData.playing;
            clicked => { ArrangementData.toggle-play(); }
        }
        if ArrangementData.sounds.length > 0: ToggleChip {
            icon: Icons.keys;
            badge: ArrangementData.sounds-badge;
            text: "Sounds";
            tip: "The General MIDI sound each instrument plays with; click one to change it";
            on: ArrangementData.sounds-open;
            clicked => { ArrangementData.sounds-open = !ArrangementData.sounds-open; }
        }
        for v[i] in ArrangementData.views.length > 1 ? ArrangementData.views : []: ToggleChip {
            text: v;
            on: i == ArrangementData.view;
            clicked => { ArrangementData.pick-view(i); }
        }
        CutText {
            horizontal-stretch: 1;
            own-mouse: true;
            text: ArrangementData.summary;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
        }
    }
    if ArrangementData.play-note != "": Text {
        text: ArrangementData.play-note;
        color: Theme.warning;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    for n in ArrangementData.notes: Text {
        text: n;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    Rectangle {
        vertical-stretch: 1;
        min-height: 160px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke;
        background: Theme.surface;
        clip: true;
        if ArrangementData.message != "": Text {
            text: ArrangementData.message;
            color: Theme.muted;
            font-size: Type.body;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 2 * Space.lg;
        }
        canvas := Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            visible: ArrangementData.message == "";
            init => { ArrangementData.resized(self.width, self.height); }
            changed width => { ArrangementData.resized(self.width, self.height); }
            changed height => { ArrangementData.resized(self.width, self.height); }
            Image {
                width: parent.width;
                height: parent.height;
                source: ArrangementData.picture;
                image-fit: fill;
            }
            // The line under the mouse, drawn here so moving the mouse doesn't need a new picture.
            if ArrangementData.hover-text != "": Rectangle {
                x: ArrangementData.hover-x;
                y: ArrangementData.ruler-height;
                width: 1px;
                height: max(0px, parent.height - ArrangementData.ruler-height);
                background: Theme.muted;
            }
            // The playhead: where the song's MIDI plays from, or is playing now.
            if ArrangementData.playhead-shown: Rectangle {
                x: ArrangementData.playhead-x - 1px;
                y: 0;
                width: 2px;
                height: parent.height;
                background: Theme.accent;
            }
            if ArrangementData.playhead-shown: Path {
                x: ArrangementData.playhead-x - 5px;
                y: 0;
                width: 10px;
                height: 7px;
                viewbox-width: 10;
                viewbox-height: 7;
                commands: "M 0 0 L 10 0 L 5 7 Z";
                fill: Theme.accent;
            }
            Words {
                x: 0;
                y: ArrangementData.ruler-height;
                width: ArrangementData.header-width;
                height: max(0px, parent.height - ArrangementData.ruler-height);
                from-x: self.x;
                from-y: self.y;
                labels: ArrangementData.header-labels;
            }
            Words {
                x: ArrangementData.header-width;
                y: ArrangementData.ruler-height;
                width: max(0px, parent.width - ArrangementData.header-width);
                height: max(0px, parent.height - ArrangementData.ruler-height);
                from-x: self.x;
                from-y: self.y;
                labels: ArrangementData.timeline-labels;
            }
            Words {
                x: 0;
                y: 0;
                width: parent.width;
                height: ArrangementData.ruler-height;
                from-x: 0;
                from-y: 0;
                labels: ArrangementData.ruler-labels;
            }
            // The clip or track being dragged out: dimmed in the view's own colour, then the landing glow.
            if ArrangementData.lifted || ArrangementData.landed: Rectangle {
                x: ArrangementData.lifted-x;
                y: ArrangementData.lifted-y;
                width: ArrangementData.lifted-width;
                height: ArrangementData.lifted-height;
                background: ArrangementData.lifted ? Theme.surface.with-alpha(0.6) : transparent;
            }
            Rectangle {
                x: ArrangementData.lifted-x - 1px;
                y: ArrangementData.lifted-y - 1px;
                width: ArrangementData.lifted-width + 2px;
                height: ArrangementData.lifted-height + 2px;
                border-radius: 3px;
                border-width: 2px;
                border-color: Theme.accent;
                opacity: 0;
                states [
                    landed when ArrangementData.landed: {
                        opacity: 1;
                        in {
                            animate opacity { duration: 90ms; }
                        }
                        out {
                            animate opacity { duration: 600ms; easing: ease-out; }
                        }
                    }
                ]
            }
            PointerPad {
                grabbing: ArrangementData.dragging;
                down(x, y) => { ArrangementData.grab(x, y); }
                move(x, y) => { ArrangementData.moved(x, y); }
                up => { ArrangementData.let-go(); }
                side-down(x, y) => { ArrangementData.side-grab(x, y); }
                side-up => { ArrangementData.side-let-go(); }
                double => { ArrangementData.double-clicked(); }
                wheel(x, across, down, ctrl, shift) => { ArrangementData.wheel(x, across, down, ctrl, shift); }
                gone => { ArrangementData.left(); }
            }
            // The track names' right edge: drag it to give the names more or less room (over the pad, so it gets the
            // mouse first there).
            Seam {
                x: ArrangementData.header-width - self.width;
                y: ArrangementData.ruler-height;
                width: Space.md;
                height: max(0px, parent.height - ArrangementData.ruler-height);
                part: "songs.tracks";
                // The width last asked for, as soon as it's asked (the picture with it comes a moment later).
                now: Widths.songs-tracks > 0 ? min(Widths.songs-tracks, self.most) : ArrangementData.header-width;
                most: max(self.least, min(Widths.most("songs.tracks"), parent.width / 2));
                resizing(w) => { ArrangementData.names-resizing(w); }
            }
            // What's under the mouse, beside it.
            if ArrangementData.hover-text != "": HoverNote {
                text: ArrangementData.hover-text;
                at-x: ArrangementData.hover-x;
                at-y: ArrangementData.hover-y;
                room-width: parent.width;
                room-height: parent.height;
            }
            // Each instrument's sound, over the timeline's right: on top of all, so it takes the mouse first.
            if ArrangementData.sounds-open: Rectangle {
                width: min(340px, max(240px, parent.width - ArrangementData.header-width - 2 * Space.sm));
                x: parent.width - self.width - Space.sm;
                y: ArrangementData.ruler-height + Space.xs;
                height: max(0px, parent.height - self.y - Space.sm);
                background: Theme.surface-raised;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.edge;
                drop-shadow-color: Theme.shadow;
                drop-shadow-blur: 12px;
                // Clicks and the wheel on it stay on it.
                TouchArea {
                    scroll-event(e) => { accept }
                }
                VerticalLayout {
                    padding: Space.xs;
                    spacing: Space.xs;
                    HorizontalLayout {
                        padding-left: Space.sm;
                        Caps {
                            text: "SOUNDS";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CloseButton {
                            tip: "Close";
                            clicked => { ArrangementData.sounds-open = false; }
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[i] in ArrangementData.sounds: VerticalLayout {
                                ValueLine {
                                    name: s.name;
                                    value: s.sound;
                                    tip: s.tip;
                                    changed: s.yours;
                                    tint: s.has-colour ? s.colour : Theme.faint;
                                    open: i == ArrangementData.sound-open;
                                    clicked => { ArrangementData.pick-line(i); }
                                }
                                if i == ArrangementData.sound-open: SoundPicker {
                                    yours: s.yours;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
