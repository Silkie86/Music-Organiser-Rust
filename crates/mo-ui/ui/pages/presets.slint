// The Presets page (spec 3.4a): every sound made inside your songs and your preset files, with the part each one
// plays, in one list with the picked one's card beside it; and the Curves section, the shapes your settings moved in,
// to drop onto a Bitwig lane (Solomon, 2 Nov 2026). Only shared parts from studio.slint; mo-app decides every word
// (mo_app::presets), mo-ui/src/presets.rs fills it.
import { ListView, ListBox, Fit } from "../list.slint";
import { CurveEditor } from "curve_editor.slint";
import { Theme, AppKeys, Type, Space, Well, SearchBox, ToggleChip, FilterList, FilterColumn, TickLine, FilterView, ListLine, DragHandle, Caps, ColumnHead, StudioButton, StudioSlider, Segmented, MenuItem, CardAction, CardActions, RightClickMenu, SidePanel, PanelDivider, EmptyState, Dot, PageHeader, YearRange, YearBar, ActionKey, Icons } from "../studio.slint";

// One line of the sounds list.
export struct PresetLine {
    // Its place among the lines shown, for picking it.
    row: int,
    name: string,
    // The plugin and where it sits: "Serum · Bass".
    under: string,
    // "Bass", "Lead?" for a weak guess, "" for none.
    part: string,
    // The part's colour, a place in Theme.sound-types (-1 grey).
    colour: int,
    part-tip: string,
    // You set the part.
    fixed: bool,
    // The song, or a preset file's folder.
    from: string,
    kind: string,
    format: string,
    picked: bool,
}

// One of a card's facts: a name in capitals over its value.
export struct PresetFact {
    name: string,
    value: string,
}

// A part to fix the picked sound to, on its card: one click sets it.
export struct PartChip {
    text: string,
    id: string,
    on: bool,
}

// The picked sound's card.
export struct PresetCard {
    over: string,
    name: string,
    plugin: string,
    part: string,
    colour: int,
    reason: string,
    // The part you set, or "".
    fixed: string,
    hint: string,
    path: string,
    fixable: bool,
}

// One line of the curves list.
export struct CurveLineInfo {
    row: int,
    name: string,
    under: string,
    found: string,
    length: string,
    hidden: bool,
    // Path commands in a 300 by 100 box (mo_app::presets::SHAPE_BOX).
    shape: string,
    picked: bool,
}

export global PresetsData {
    // 0 Sounds, 1 Curves.
    in property <int> section;
    in property <string> summary;
    // The work going on, in words, and how far it's got (0 to 1, or -1 when it can't say).
    in property <string> busy;
    in property <float> done;

    // The words in the search box, for the section on show.
    in-out property <string> search;
    // The Sounds section.
    callback search-edited(string);
    // The filters, as chips of their own or menus (mo_app::filters).
    in property <FilterView> part-filter;
    in property <FilterView> format-filter;
    in property <FilterView> type-filter;
    in property <FilterView> plugin-filter;
    in property <FilterView> from-filter;
    // The song the list is cut to (a song's Presets tab), or "".
    in property <string> song;
    in property <bool> any-filter;
    in property <bool> unused;
    // A filter's choice was picked or unpicked: which filter ("part", "format", "type", "plugin", "from", or the
    // Curves section's "found-in") and the choice's words; or its menu's Any was.
    callback toggle(string, string);
    callback clear-chip(string);
    callback clear();
    // The column the sounds list goes by, as its heading says it ("" for the list as it was found), and whether
    // that order is turned round; a click on a heading (its words) picks, turns round, then lets go.
    in property <string> order-column;
    in property <bool> order-reversed;
    callback order-picked(string);
    callback clear-song();
    callback unused-toggled(bool);
    in property <[PresetLine]> lines;
    in property <int> shown;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <[YearBar]> years;
    // The years picked, as places on the strip (-1 for none).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    callback select(int);
    // Dragging a sound out onto a track in a DAW, or into a folder (mo-ui's presets/drag_out.rs): a line by its place
    // among those shown, or the picked one by its card's handle; then `drag-let-go` if the button comes up before the
    // drag has got going (for a curve's drag too: only one drag goes at a time). The one carried is dimmed
    // (`lifted-…`) and glows for a moment once it has landed (`landed-…`); -1 for none.
    callback drag-row(int);
    callback drag-picked();
    callback drag-let-go();
    in property <int> lifted-row: -1;
    in property <int> landed-row: -1;
    in property <bool> lifted-picked;
    in property <bool> landed-picked;
    // Up and down the list: -1 or 1.
    callback step(int);
    // Bring the picked line into view: its place, and a count that goes up each time it's asked.
    in property <int> show-row;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    // Where the list is turned to (list.slint's ListView keeps it): it's there again when the page is shown again.
    in-out property <length> list-y;
    in property <bool> panel-shown;
    in-out property <length> panel-width: 400px;
    callback panel-resized(length);
    callback close-panel();
    in property <PresetCard> card;
    in property <[PresetFact]> facts;
    in property <[CardAction]> actions;
    in property <[PartChip]> parts;
    // What the last export or send did.
    in property <string> message;
    // The audition in Bitwig, whichever line is picked: what it says ("" when there's none), whether it plays yet (so
    // it can be kept), and its buttons' keys.
    in property <string> hearing;
    in property <bool> hearing-playing;
    in property <string> keep-audition-key;
    callback stop-audition();
    callback keep-audition();
    // The right-click menu: the card's actions and the part fixes, each with its key.
    in property <[MenuItem]> menu;
    callback menu-chosen(string);
    // Export these: every sound shown.
    in property <ActionKey> export-shown-key;
    in property <bool> exporting;
    callback export-shown();

    // The Curves section (the search box is shared: `search` holds the section's words on show).
    // Found in: its chips go through `toggle` and `clear-chip`, as "found-in".
    in property <FilterView> curve-found-in;
    // What kind of curve: its shape, its rhythm (as a note length) and its feel.
    in property <FilterView> curve-shape;
    in property <FilterView> curve-rhythm;
    in property <FilterView> curve-feel;
    in property <bool> curve-hidden;
    callback curve-hidden-toggled(bool);
    // Randomise: its words, whether it can roll, its length (a place in 1, 2, 4, 8 bars), how wild (0 to 1) and
    // that in a word, and whether its parts have mixed lengths.
    in property <string> random-says;
    in property <bool> random-can;
    in property <int> random-bars;
    in property <float> random-wild;
    in property <string> random-wild-name;
    in property <bool> random-mixed;
    in property <string> randomise-key;
    callback random-bars-picked(int);
    callback random-wild-moved(float);
    callback random-mixed-toggled(bool);
    callback randomise();
    // "Other speeds too": the rhythms picked show curves at half and double speed as well, sent stretched.
    in property <bool> curve-other-speeds;
    callback curve-other-speeds-toggled(bool);
    in property <[CurveLineInfo]> curve-lines;
    in property <int> curves-shown;
    in property <string> curve-empty-title;
    in property <string> curve-empty-text;
    callback curve-select(int);
    callback curve-step(int);
    in property <int> curve-show-row;
    in property <int> curve-show-ask;
    in-out property <int> curve-show-done;
    // Where the curves' list is turned to, kept the same way.
    in-out property <length> curve-list-y;
    in property <bool> curve-panel-shown;
    // The lines under the editor card's "In 2 songs".
    in property <[MenuItem]> curve-found-menu;
    in property <[CardAction]> curve-actions;
    in property <[MenuItem]> curve-menu;
    in property <string> curve-message;
    callback curve-chosen(string);
    // A curve's file dragged out (onto a Bitwig automation lane), by its line (`curve-drag-row`, its place among those
    // shown) or the card's handle (`curve-drag`); then `drag-let-go`, as for a sound, if the button comes up before the
    // drag has got going. Dimmed while carried, glows once landed; -1 for no line.
    callback curve-drag-row(int);
    // While a curve is open in the editor (`curve-panel-shown`), each line shows a + that adds its curve to that one,
    // by its row.
    callback curve-add(int);
    callback curve-drag();
    in property <int> curve-lifted-row: -1;
    in property <int> curve-landed-row: -1;
    in property <bool> curve-lifted;
    in property <bool> curve-landed;
    // Renaming the picked curve: the box shows while this is on.
    in-out property <bool> renaming;
    in-out property <string> rename-text;
    callback rename-done(string);
}

// A line of the sounds list.
component PresetLineView inherits ListLine {
    in property <PresetLine> line;
    // As the heading's.
    in property <bool> tight;
    callback chosen();
    height: 48px;
    selected: line.picked;
    tip: line.part-tip;
    // The part column carries the reason (spec: the reason on hover).
    tip-from: self.width * 0.5;
    draggable: true;
    lifted: root.line.row == PresetsData.lifted-row;
    landed: root.line.row == PresetsData.landed-row;
    drag-out => { PresetsData.drag-row(root.line.row); }
    drag-let-go => { PresetsData.drag-let-go(); }
    clicked => {
        root.chosen();
        PresetsData.select(root.line.row);
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        VerticalLayout {
            alignment: center;
            Dot { tint: Theme.sound-type(root.line.colour); }
        }
        VerticalLayout {
            horizontal-stretch: 3;
            preferred-width: 0px;
            min-width: 0px;
            alignment: center;
            Text {
                text: root.line.name;
                color: Theme.text;
                font-size: Type.body;
                overflow: elide;
            }
            Text {
                text: root.line.under;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
        }
        Text {
            width: 96px;
            text: root.line.part;
            color: root.line.part == "" ? Theme.faint : Theme.sound-type(root.line.colour);
            font-size: Type.meta;
            font-weight: root.line.fixed ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 2;
            preferred-width: 0px;
            min-width: 0px;
            text: root.line.from;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.tight: Text {
            width: 56px;
            text: root.line.kind;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        if !root.tight: Text {
            width: 72px;
            text: root.line.format;
            color: Theme.faint;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// The sounds list's headings: a click puts the list in that column's order (A to Z), a second click turns it round,
// a third puts it back as it was found.
component PresetHeading inherits HorizontalLayout {
    // A narrow list (beside the filter column and the card at 1440 wide) leaves out Kind and File, which the card
    // says too, so the preset's name and its song keep their room.
    in property <bool> tight;
    height: 28px;
    padding-left: Space.md + Space.sm + Space.md;
    padding-right: Space.md + Space.md;
    spacing: Space.md;
    ColumnHead {
        horizontal-stretch: 3; preferred-width: 0px; min-width: 0px;
        text: "PRESET";
        on: PresetsData.order-column == "Sound";
        up: !PresetsData.order-reversed;
        clicked => { PresetsData.order-picked("Sound"); }
    }
    ColumnHead {
        width: 96px;
        text: "PART";
        on: PresetsData.order-column == "Part";
        up: !PresetsData.order-reversed;
        clicked => { PresetsData.order-picked("Part"); }
    }
    ColumnHead {
        horizontal-stretch: 2; preferred-width: 0px; min-width: 0px;
        text: "SONG OR FOLDER";
        on: PresetsData.order-column == "Song or folder";
        up: !PresetsData.order-reversed;
        clicked => { PresetsData.order-picked("Song or folder"); }
    }
    if !root.tight: ColumnHead {
        width: 56px;
        text: "KIND";
        on: PresetsData.order-column == "Kind";
        up: !PresetsData.order-reversed;
        clicked => { PresetsData.order-picked("Kind"); }
    }
    if !root.tight: ColumnHead {
        width: 72px;
        text: "FILE";
        right: true;
        on: PresetsData.order-column == "File";
        up: !PresetsData.order-reversed;
        clicked => { PresetsData.order-picked("File"); }
    }
}

// A curve's shape, drawn in its box (the renderer draws it on the graphics card when there is one).
component CurveShape inherits Rectangle {
    in property <string> shape;
    in property <color> tint: Theme.text;
    in property <length> line: 1.5px;
    Path {
        x: root.line;
        y: root.line;
        width: root.width - 2 * root.line;
        height: root.height - 2 * root.line;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.shape;
        stroke: root.tint;
        stroke-width: root.line;
        fill: transparent;
    }
}

component CurveLineView inherits ListLine {
    in property <CurveLineInfo> line;
    callback chosen();
    height: 48px;
    selected: line.picked;
    draggable: true;
    lifted: root.line.row == PresetsData.curve-lifted-row;
    landed: root.line.row == PresetsData.curve-landed-row;
    drag-out => { PresetsData.curve-drag-row(root.line.row); }
    drag-let-go => { PresetsData.drag-let-go(); }
    clicked => {
        root.chosen();
        PresetsData.curve-select(root.line.row);
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        Well {
            width: 64px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            CurveShape {
                shape: root.line.shape;
                // A curve is information, not something on: plain ink, fainter when hidden.
                tint: root.line.hidden ? Theme.faint : Theme.text;
            }
        }
        VerticalLayout {
            horizontal-stretch: 3;
            preferred-width: 0px;
            min-width: 0px;
            alignment: center;
            Text {
                text: root.line.name;
                color: root.line.hidden ? Theme.muted : Theme.text;
                font-size: Type.body;
                overflow: elide;
            }
            Text {
                text: root.line.under;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
        }
        // The list is a narrow column beside the editor: where a curve was found is on its card, and the name gets
        // the room.
        if root.line.hidden: Text {
            horizontal-stretch: 0;
            text: "Hidden";
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 52px;
            text: root.line.length;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // Joining curves: this one goes into the curve in the editor.
        if PresetsData.curve-panel-shown: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            StudioButton {
                width: 32px;
                icon: Icons.add;
                tip: "Add this curve to the one in the editor: in place of the highlighted part, or at its end";
                clicked => { PresetsData.curve-add(root.line.row); }
            }
        }
    }
}

// The picked sound: what it is, the part it plays and why (one click fixes it), what can be done with it, its facts.
component PresetPanel inherits SidePanel {
    close => { PresetsData.close-panel(); }
    Caps { text: PresetsData.card.over; }
    Text {
        text: PresetsData.card.name;
        color: Theme.text;
        font-family: Theme.title-font;
        font-size: Type.panel-title;
        font-weight: 600;
        wrap: word-wrap;
        min-width: 0px;
    }
    if PresetsData.card.plugin != "": Text {
        text: PresetsData.card.plugin;
        color: Theme.muted;
        font-size: Type.body;
        wrap: word-wrap;
        min-width: 0px;
    }
    // Where to take the sound from to drag it onto a track (Solomon, 13 Nov 2026): Bitwig loads only its own presets
    // dropped there, so it goes as one wherever one can be made.
    DragHandle {
        text: "Drag onto a track or into a folder";
        tip: "It goes as a Bitwig preset where one can be made, so Bitwig loads it; else as its preset file";
        lifted: PresetsData.lifted-picked;
        landed: PresetsData.landed-picked;
        drag-out => { PresetsData.drag-picked(); }
        drag-let-go => { PresetsData.drag-let-go(); }
    }
    // Every card's buttons: the lit one first, in even columns (the UX review of 10 Nov, B2).
    CardActions {
        room: root.inside;
        actions: PresetsData.actions;
        chosen(id) => { PresetsData.menu-chosen(id); }
    }
    if PresetsData.message != "": Text {
        text: PresetsData.message;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    VerticalLayout {
        spacing: Space.xs;
        Caps { text: PresetsData.card.fixed != "" ? "PART (YOU SET IT)" : "PART"; }
        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Dot { tint: Theme.sound-type(PresetsData.card.colour); }
            }
            Text {
                text: PresetsData.card.part;
                color: PresetsData.card.colour < 0 ? Theme.muted : Theme.sound-type(PresetsData.card.colour);
                font-size: Type.row-title;
                font-weight: 600;
            }
        }
        Text {
            text: PresetsData.card.reason;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    if PresetsData.card.fixable: VerticalLayout {
        spacing: Space.xs;
        Caps { text: "IT'S REALLY"; }
        FlexboxLayout {
            spacing: Space.xs;
            for p in PresetsData.parts: ToggleChip {
                text: p.text;
                on: p.on;
                clicked => { PresetsData.menu-chosen(p.id); }
            }
        }
    }
    // Its facts side by side, as on every card (the UX review of 10 Nov, B4); a long song name wraps in its column.
    // Each column's width comes from the card: words inside a `for` are measured as one line otherwise.
    HorizontalLayout {
        spacing: Space.md;
        for f in PresetsData.facts: VerticalLayout {
            property <length> wide: (root.inside - (PresetsData.facts.length - 1) * Space.md) / max(1, PresetsData.facts.length);
            width: self.wide;
            spacing: Space.xs;
            alignment: start;
            Caps { text: f.name; }
            Text {
                width: parent.wide;
                text: f.value;
                color: Theme.text;
                font-size: Type.meta;
                wrap: word-wrap;
            }
        }
    }
    if PresetsData.card.hint != "": Text {
        text: PresetsData.card.hint;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    Text {
        text: PresetsData.card.path;
        color: Theme.faint;
        font-size: Type.small;
        wrap: word-wrap;
        min-width: 0px;
    }
    Rectangle { vertical-stretch: 1; }
}

export component PresetsPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }
    // A curve's rename box had the keys as it went (Enter or Esc in it, or its card closed): nothing had them then, so
    // no key worked until a click (the whole-app review of 10 Nov, U-1). They come back to the list. Only then: a box
    // that goes while the keys are elsewhere (in the search, say) leaves them there.
    property <bool> rename-keys;
    property <bool> renaming: PresetsData.section == 1 && PresetsData.curve-panel-shown && PresetsData.renaming;
    changed renaming => {
        if (!self.renaming && self.rename-keys) {
            self.rename-keys = false;
            keys.focus();
        }
    }

    VerticalLayout {
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        PageHeader {
            title: PresetsData.section == 0 ? "Presets" : "Curves";
            summary: PresetsData.summary;
            busy: PresetsData.busy;
            done: PresetsData.done;
        }
        HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            // One box for both sections (Presets and Curves are two places on the rail, shown by this one page): the
            // page keeps each section's words and puts them back on a switch.
            search-box := SearchBox {
                // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and
                // Ctrl+Down step through the list from here.
                page-search: true;
                horizontal-stretch: 1;
                min-width: 320px;
                max-width: 480px;
                hint: PresetsData.section == 0 ? "Search presets, plugins, songs and parts" : "Search curves, songs and settings";
                text <=> PresetsData.search;
                edited(t) => { PresetsData.search-edited(t); }
                key(k) => {
                    if (k == Key.DownArrow) {
                        keys.focus();
                        if (PresetsData.section == 0) {
                            PresetsData.step(1);
                        } else {
                            PresetsData.curve-step(1);
                        }
                        return true;
                    }
                    false
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if PresetsData.section == 1: VerticalLayout {
                alignment: center;
                StudioButton {
                    horizontal-stretch: 0;
                    text: "Randomise";
                    enabled: PresetsData.random-can;
                    tip: "Make a new curve from parts of the curves shown; with a highlight, roll only that part again";
                    key: PresetsData.randomise-key;
                    clicked => { PresetsData.randomise(); }
                }
            }
            if PresetsData.section == 0: VerticalLayout {
                alignment: center;
                StudioButton {
                    horizontal-stretch: 0;
                    text: "Export these";
                    main: true;
                    enabled: PresetsData.shown > 0 && !PresetsData.exporting;
                    tip: PresetsData.export-shown-key.what;
                    key: PresetsData.export-shown-key.key;
                    clicked => { PresetsData.export-shown(); }
                }
            }
        }
        // The audition playing in Bitwig, whatever line is picked and whichever section is on show, with its
        // Stop and Keep (the 6 Nov review's D-4 and X3-1).
        if PresetsData.hearing != "": Rectangle {
            height: 48px;
            background: Theme.surface-raised;
            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.sm;
                alignment: stretch;
                Text {
                    horizontal-stretch: 1;
                    text: PresetsData.hearing;
                    color: Theme.text;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    StudioButton {
                        text: "Stop in Bitwig";
                        tip: "Stop it and take its track out of Bitwig again";
                        clicked => { PresetsData.stop-audition(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    StudioButton {
                        text: "Keep in Bitwig";
                        tip: "Stop it playing and leave its track, preset and part in the project";
                        key: PresetsData.keep-audition-key;
                        enabled: PresetsData.hearing-playing;
                        clicked => { PresetsData.keep-audition(); }
                    }
                }
            }
        }
        split := Rectangle {
            vertical-stretch: 1;
            // The list, the year strip beside it, and the picked line's card.
            area := Rectangle {
                x: column.room;
                y: 0;
                width: split.width - self.x;
                height: split.height;
                property <bool> panel: PresetsData.section == 0 ? PresetsData.panel-shown : PresetsData.curve-panel-shown;
                // The card's place is always there (empty until something is picked), so nothing moves when it is.
                // On Curves the list is a narrow column (268, up to 360 in a wide window) and the editor card has all
                // the rest: the picture is what the page is for.
                property <length> list-width: PresetsData.section == 1
                    ? max(268px, min(360px, self.width * 22%))
                    : min(Fit.list-max, max(380px, self.width - PresetsData.panel-width - divider.width));
                property <length> card-width: self.width - self.list-width - divider.width;
                property <length> years-width: PresetsData.section == 0 && PresetsData.years.length > 1 && PresetsData.empty-title == "" ? 56px : 0px;
                if area.years-width > 0: YearRange {
                    x: area.list-width - area.years-width;
                    y: 0;
                    height: area.height;
                    years: PresetsData.years;
                    picked-from: PresetsData.years-from;
                    picked-to: PresetsData.years-to;
                    picked(a, b) => { PresetsData.years-picked(a, b); }
                    cleared => { PresetsData.years-cleared(); }
                }
                keys := FocusScope {
                    x: 0;
                    width: area.list-width - area.years-width;
                    key-pressed(event) => {
                        if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                            return reject;
                        }
                        if (event.text == Key.UpArrow) {
                            if (PresetsData.section == 0) {
                                PresetsData.step(-1);
                            } else {
                                PresetsData.curve-step(-1);
                            }
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            if (PresetsData.section == 0) {
                                PresetsData.step(1);
                            } else {
                                PresetsData.curve-step(1);
                            }
                            return accept;
                        }
                        reject
                    }
                    Well {
                        if PresetsData.section == 0 && PresetsData.empty-title != "": EmptyState {
                            title: PresetsData.empty-title;
                            text: PresetsData.empty-text;
                            action: PresetsData.any-filter && PresetsData.shown == 0 ? "Clear the filters" : "";
                            act => { PresetsData.clear(); }
                        }
                        if PresetsData.section == 0 && PresetsData.empty-title == "": ListBox {
                            turned: list.content-y;
                            after: list.row-height;
                            to-top => { list.to-top(); }
                            VerticalLayout {
                                PresetHeading {
                                    tight: area.list-width < 620px;
                                }
                                list := ListView {
                                    row-height: 48px;
                                    rows: PresetsData.lines.length;
                                    show-top: PresetsData.show-row * self.row-height;
                                    show-ask: PresetsData.show-ask;
                                    show-done <=> PresetsData.show-done;
                                    kept-y <=> PresetsData.list-y;
                                    for l in PresetsData.lines: PresetLineView {
                                        tight: area.list-width < 620px;
                                        // Every line this height: the list counts on it.
                                        height: list.row-height;
                                        line: l;
                                        chosen => { keys.focus(); }
                                        right-clicked(x, y) => {
                                            keys.focus();
                                            menu.open-at(x, y);
                                        }
                                    }
                                }
                            }
                        }
                        if PresetsData.section == 1 && PresetsData.curve-empty-title != "": EmptyState {
                            title: PresetsData.curve-empty-title;
                            text: PresetsData.curve-empty-text;
                        }
                        if PresetsData.section == 1 && PresetsData.curve-empty-title == "": ListBox {
                            turned: curve-list.content-y;
                            after: curve-list.row-height;
                            to-top => { curve-list.to-top(); }
                            curve-list := ListView {
                                row-height: 48px;
                                rows: PresetsData.curve-lines.length;
                                show-top: PresetsData.curve-show-row * self.row-height;
                                show-ask: PresetsData.curve-show-ask;
                                show-done <=> PresetsData.curve-show-done;
                                kept-y <=> PresetsData.curve-list-y;
                                for l in PresetsData.curve-lines: CurveLineView {
                                    // Every line this height: the list counts on it.
                                    height: curve-list.row-height;
                                    line: l;
                                    chosen => { keys.focus(); }
                                    right-clicked(x, y) => {
                                        keys.focus();
                                        curve-menu.open-at(x, y);
                                    }
                                }
                            }
                        }
                    }
                }
                divider := PanelDivider {
                    x: area.list-width;
                    height: parent.height;
                    // The card's width as it's shown, so a drag starts from what you see. The list stops at its
                    // widest, so in a wide window the seam only goes left of there.
                    panel-width: area.card-width;
                    room: area.width;
                    // The Curves list keeps its own width: only the Presets seam can be dragged.
                    enabled: PresetsData.section == 0;
                    resizing(w) => { PresetsData.panel-width = w; }
                    resized(w) => { PresetsData.panel-resized(w); }
                }
                if PresetsData.section == 0 && PresetsData.panel-shown: PresetPanel {
                    x: area.list-width + divider.width;
                    width: area.card-width;
                    height: parent.height;
                }
                if PresetsData.section == 1 && PresetsData.curve-panel-shown: CurveEditor {
                    x: area.list-width + divider.width;
                    width: area.card-width;
                    height: parent.height;
                    close => { PresetsData.curve-select(-1); }
                    renaming: PresetsData.renaming;
                    rename-text <=> PresetsData.rename-text;
                    rename-keys <=> root.rename-keys;
                    rename-done(name) => { PresetsData.rename-done(name); }
                    rename-dropped => { PresetsData.renaming = false; }
                    lifted: PresetsData.curve-lifted;
                    landed: PresetsData.curve-landed;
                    drag-out => { PresetsData.curve-drag(); }
                    drag-let-go => { PresetsData.drag-let-go(); }
                    actions: PresetsData.curve-actions;
                    message: PresetsData.curve-message;
                    chosen(id) => { PresetsData.curve-chosen(id); }
                    found-opens: PresetsData.curve-found-menu.length > 0;
                    found-clicked(x, y) => { found-menu.open-at(x, y); }
                }
                if !area.panel: SidePanel {
                    x: area.list-width + divider.width;
                    width: area.card-width;
                    height: parent.height;
                    closable: false;
                    EmptyState {
                        vertical-stretch: 1;
                        title: PresetsData.section == 0 ? "Pick a sound" : "Pick a curve";
                        text: PresetsData.section == 0
                            ? "Where it's from, its part and what it can do show here."
                            : "Its shape, where it was found and what it can do show here.";
                    }
                }
                menu := RightClickMenu {
                    items: PresetsData.menu;
                    chosen(id) => { PresetsData.menu-chosen(id); }
                }
                curve-menu := RightClickMenu {
                    items: PresetsData.curve-menu;
                    chosen(id) => { PresetsData.curve-chosen(id); }
                }
                // Under the editor card's "In 2 songs": the places the picked curve was found.
                found-menu := RightClickMenu {
                    items: PresetsData.curve-found-menu;
                    chosen(id) => { PresetsData.curve-chosen(id); }
                }
            }
            // The filters, in a column at the side as on every page (Solomon, 10 Nov 2026): a short list's choices
            // as a tick list, the plugins in a menu that scrolls; more than one part or plugin can be picked, one or
            // none of the rest. After the list, so the opened column of a narrow window lies over it.
            column := FilterColumn {
                page-width: split.width;
                height: split.height;
                active: PresetsData.section == 0 && PresetsData.any-filter;
                if PresetsData.section == 0: FilterList {
                    name: "PLUGIN";
                    filter: PresetsData.plugin-filter;
                    toggled(text) => { PresetsData.toggle("plugin", text); }
                    cleared => { PresetsData.clear-chip("plugin"); }
                }
                if PresetsData.section == 0: FilterList {
                    name: "PART";
                    filter: PresetsData.part-filter;
                    toggled(text) => { PresetsData.toggle("part", text); }
                    cleared => { PresetsData.clear-chip("part"); }
                }
                // The plugin's format (VST2, VST3, CLAP, AU, or Native: the DAW's own).
                if PresetsData.section == 0: FilterList {
                    name: "FORMAT";
                    filter: PresetsData.format-filter;
                    toggled(text) => { PresetsData.toggle("format", text); }
                    cleared => { PresetsData.clear-chip("format"); }
                }
                if PresetsData.section == 0: FilterList {
                    name: "TYPE";
                    filter: PresetsData.type-filter;
                    toggled(text) => { PresetsData.toggle("type", text); }
                    cleared => { PresetsData.clear-chip("type"); }
                }
                // Where the sound was found: in a song, or as a preset file on disk.
                if PresetsData.section == 0: FilterList {
                    name: "FOUND IN";
                    filter: PresetsData.from-filter;
                    toggled(text) => { PresetsData.toggle("from", text); }
                    cleared => { PresetsData.clear-chip("from"); }
                }
                // On the page, not in an options menu (Solomon, 4 Nov 2026: nothing useful hidden away). Clear leaves it.
                if PresetsData.section == 0: TickLine {
                    text: "Synths that play nothing";
                    on: PresetsData.unused;
                    clicked => { PresetsData.unused-toggled(!PresetsData.unused); }
                }
                if PresetsData.section == 0 && PresetsData.song != "": TickLine {
                    text: "Song: " + PresetsData.song;
                    on: true;
                    clicked => { PresetsData.clear-song(); }
                }
                if PresetsData.section == 0 && PresetsData.any-filter: HorizontalLayout {
                    alignment: start;
                    StudioButton {
                        text: "Clear filters";
                        clicked => { PresetsData.clear(); }
                    }
                }
                if PresetsData.section == 1: FilterList {
                    name: "FOUND IN";
                    filter: PresetsData.curve-found-in;
                    toggled(text) => { PresetsData.toggle("found-in", text); }
                    cleared => { PresetsData.clear-chip("found-in"); }
                }
                if PresetsData.section == 1: FilterList {
                    name: "SHAPE";
                    filter: PresetsData.curve-shape;
                    toggled(text) => { PresetsData.toggle("curve-shape", text); }
                    cleared => { PresetsData.clear-chip("curve-shape"); }
                }
                if PresetsData.section == 1: FilterList {
                    name: "RHYTHM";
                    filter: PresetsData.curve-rhythm;
                    toggled(text) => { PresetsData.toggle("curve-rhythm", text); }
                    cleared => { PresetsData.clear-chip("curve-rhythm"); }
                }
                if PresetsData.section == 1: TickLine {
                    text: "Other speeds too";
                    on: PresetsData.curve-other-speeds;
                    clicked => { PresetsData.curve-other-speeds-toggled(!PresetsData.curve-other-speeds); }
                }
                if PresetsData.section == 1: FilterList {
                    name: "FEEL";
                    filter: PresetsData.curve-feel;
                    toggled(text) => { PresetsData.toggle("curve-feel", text); }
                    cleared => { PresetsData.clear-chip("curve-feel"); }
                }
                if PresetsData.section == 1: TickLine {
                    text: "The curves I hid";
                    on: PresetsData.curve-hidden;
                    clicked => { PresetsData.curve-hidden-toggled(!PresetsData.curve-hidden); }
                }
                // Randomise's settings, right under the filters that choose what it's made from (as Kits on Sounds).
                if PresetsData.section == 1: Rectangle {
                    height: 1px;
                    background: Theme.edge;
                }
                if PresetsData.section == 1: Caps {
                    text: "RANDOMISE";
                }
                if PresetsData.section == 1: Text {
                    text: PresetsData.random-says;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                if PresetsData.section == 1: HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        text: "Bars";
                        color: Theme.muted;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                    Segmented {
                        choices: ["1", "2", "4", "8"];
                        pad: Space.md;
                        current: PresetsData.random-bars;
                        picked(i) => { PresetsData.random-bars-picked(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if PresetsData.section == 1: HorizontalLayout {
                    Text {
                        text: "How wild";
                        color: Theme.muted;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: PresetsData.random-wild-name;
                        color: Theme.text;
                        font-size: Type.meta;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                if PresetsData.section == 1: StudioSlider {
                    height: 28px;
                    tip: "From parts as they are (Spliced) to most parts sped up, reversed, flipped, stuttered or faded (Wild)";
                    value: PresetsData.random-wild;
                    moved(v) => { PresetsData.random-wild-moved(v); }
                }
                if PresetsData.section == 1: TickLine {
                    text: "Mixed beat divisions";
                    on: PresetsData.random-mixed;
                    clicked => { PresetsData.random-mixed-toggled(!PresetsData.random-mixed); }
                }
            }
        }
    }
}
