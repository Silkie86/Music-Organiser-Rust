// The Plugins page (spec 3.6): every plugin your songs use, what to install to open more of them, the plugins taking
// room that no song has used for years, and the picked plugin's card beside the list: the songs using it, its room on
// disk and its installed copies. The same list and side card as every page (Solomon, 1 Nov 2026), the card always
// there. Only shared parts from studio.slint; mo-app decides every word (mo_app::plugins), mo-ui/src/plugins.rs
// fills it. Read-only for now: Clean up, Uninstall and Move join in the page's second part.
import { ListView } from "../list.slint";
import { Theme, AppKeys, Type, Space, Well, SearchBox, ToggleChip, TickBox, FilterPicks, FilterView, ListLine, Caps, StudioButton, LinkText, Segmented, CardAction, CardActions, MenuItem, RightClickMenu, SidePanel, PanelDivider, EmptyState, Dot, PageHeader, YearRange, YearBar, TabBar } from "../studio.slint";

// One line of the list.
export struct PluginListLine {
    // Where the plugin is in mo-app's rows, for picking it.
    row: int,
    name: string,
    // "VST3 · Instrument · Xfer Records · FL Studio, Bitwig".
    details: string,
    // "12 songs", or "No songs".
    songs: string,
    // "Mar 2024", or "Never".
    last: string,
    size: string,
    // 0 installed, 1 missing, 2 installed but unused.
    state: int,
}

// An "Install these" card: a missing plugin and how many songs it helps open.
export struct NeededCard {
    row: int,
    count: string,
    label: string,
    name: string,
    details: string,
    // "You have Ozone 11, which may open them".
    other: string,
}

// One part of the picked plugin's room on disk, for the bar.
export struct RoomBar {
    name: string,
    size: string,
    share: float,
    // 0 plugin files, 1 presets and settings, 2 sounds.
    kind: int,
}

export struct RoomFolder {
    kind: string,
    path: string,
    size: string,
    // "Shared with Kontakt 7".
    shared: string,
    added: bool,
    // "Not its" (or "Take off") can leave it out; `at` is its place in the list.
    can-say: bool,
    at: int,
}

// A song (or a save) using the picked plugin.
export struct UseRow {
    name: string,
    daw: string,
    date: string,
    saves: string,
    // Its line in the card's list, for opening it on the Songs page.
    at: int,
}

// One installed copy of the picked plugin, as the plugin scanner read it.
// One of the picked plugin's folders on its Clean up list: ticked to go, or why it stays.
export struct CleanRow {
    path: string,
    kind: string,
    size: string,
    why: string,
    can: bool,
    ticked: bool,
}

export struct CopyRow {
    format: string,
    name: string,
    details: string,
    id: string,
    path: string,
    note: string,
}

export global PluginsData {
    in property <string> summary;
    // Shown instead of the list while it loads, or when the library can't be read.
    in property <string> message: "Reading your plugins…";
    in property <[PluginListLine]> lines;
    in property <int> selected: -1;
    in-out property <string> search;
    // The filters, the same as on every page: Show, Kind, Format and DAW.
    in property <FilterView> show-filter;
    in property <FilterView> kind-filter;
    in property <FilterView> format-filter;
    in property <FilterView> daw-filter;
    in property <bool> any-filter;
    // The orders, each a chip with the picked one lit.
    in property <FilterView> sort-filter;
    // The year strip beside the list: the years plugins were used in.
    in property <[YearBar]> years;
    // The picked years' places on the strip (-1 for none).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();

    // The Install these cards, what they'd open, or that every song has what it needs.
    in property <[NeededCard]> cards;
    in property <string> cards-summary;
    in property <bool> all-installed;
    // "46.7 GB in 2 plugins none of your songs have used in over 2 years."
    in property <string> freeable;
    // What moves cut off part way (the app or the computer stopped) left on the other drive, with Clear.
    in property <string> half-copy-text;
    in property <bool> can-clear-half-copies;
    callback clear-half-copies();
    // When the plugins were last measured (or that a measure is running), and Measure again (review X1-2).
    in property <string> measure-text;
    in property <bool> can-measure: true;
    in property <string> measure-key;
    in property <string> measure-tip;
    callback measure-plugins();

    // The page's options, shown on the page beside what they change. has-missing: some song's newest save misses a
    // plugin (so the cards' count shows even when they're off); has-sizes: some plugin's room is measured.
    in property <bool> has-missing;
    in property <bool> has-sizes;
    in property <[string]> card-counts;
    in property <int> card-count;
    in property <[string]> unused-choices;
    in property <int> unused-index;
    callback card-count-picked(int);
    callback unused-picked(int);

    // The side card.
    in-out property <length> panel-width: 420px;
    in property <bool> has-pick;
    in property <string> name;
    in property <string> facts;
    in property <string> state-text;
    in property <int> state;
    in property <string> other;
    in property <[CardAction]> actions;
    in property <[MenuItem]> menu;
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <string> uses-note;
    in property <[UseRow]> uses;
    in property <FilterView> use-daws;
    in property <bool> every-save;
    in property <string> room-summary;
    in property <string> room-shared;
    in property <[RoomBar]> room-bars;
    in property <[RoomFolder]> room-folders;
    // "Add a folder…" can add one the guess missed.
    in property <bool> can-add-folder;
    callback folder-not-its(int);
    callback add-folder();
    in property <string> sizes-note;
    // Clean up or Uninstall, on the On disk tab: 0 looking (checking the folders, or for its uninstaller), 1 the list to
    // tick (for Uninstall, its uninstallers to pick one of, or its plugin files), 2 working (sending to the Recycle Bin,
    // or waiting for its uninstaller), 3 done, 4 putting back.
    in property <bool> clean-shown;
    in property <int> clean-stage;
    in property <string> clean-title;
    in property <string> clean-intro;
    in property <[CleanRow]> clean-rows;
    in property <string> clean-freed;
    in property <bool> clean-can-go;
    in property <string> clean-result;
    in property <[string]> clean-problems;
    in property <bool> clean-can-put-back;
    in property <string> clean-warning;
    in property <string> clean-busy-text;
    in property <bool> clean-can-stop;
    in property <string> clean-go-text;
    in property <string> clean-keep-text;
    // Uninstall finished: Clean up is offered for what it left.
    in property <bool> clean-offer-clean;
    // What this session's clean-ups sent to the Recycle Bin for the picked plugin, with Put back.
    in property <string> binned-text;
    callback clean-ticked(int, bool);
    callback clean-confirm();
    callback clean-close();
    callback clean-stop();
    callback put-back();
    callback clean-leftovers();
    in property <[CopyRow]> copies;
    in property <string> copies-note;
    in property <string> scanner-note;

    callback search-edited(string);
    // A filter's choice picked or unpicked: the filter ("show", "kind", "format", "daw") and the choice's words.
    callback toggle(string, string);
    callback clear-filter(string);
    /// "Show them": turns Big and unused on (never off).
    callback show-unused();
    callback sort-picked(string);
    callback clear();
    callback select(int);
    // Up and Down step through the list (review X3-8); the list scrolls to the line at show-row when show-ask changes.
    callback step(int);
    in property <int> show-row;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    callback close-panel();
    callback menu-chosen(string);
    callback use-daw-picked(string);
    callback use-daws-cleared();
    callback every-save-toggled();
    callback open-use(int);
    callback panel-resized(length);
}

// A plugin's state as a small word in its colour.
component StatePill inherits Rectangle {
    in property <int> state;
    in property <string> text;
    property <color> tint: state == 1 ? Theme.missing : state == 2 ? Theme.warning : Theme.ok;
    width: label.preferred-width + 2 * Space.sm;
    height: 20px;
    border-radius: 10px;
    background: tint.transparentize(85%);
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: Type.tiny;
        font-weight: 600;
    }
}

// A missing plugin worth installing: the big number, the plugin, what it is. A click picks it.
component NeededTile inherits Rectangle {
    in property <NeededCard> card;
    in property <bool> picked;
    callback clicked;
    width: 188px;
    height: col.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: picked ? Theme.accent : Theme.edge;
    background: Theme.surface;
    // The list line's look: lit under the mouse, raised when picked.
    ListLine {
        selected: root.picked;
        clicked => { root.clicked(); }
    }
    col := VerticalLayout {
        padding: Space.md;
        spacing: Space.xs;
        alignment: start;
        HorizontalLayout {
            spacing: Space.sm;
            Text {
                text: root.card.count;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.heading;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.card.label;
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        Text {
            text: root.card.name;
            color: Theme.text;
            font-size: Type.body;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.card.details;
            color: Theme.muted;
            font-size: Type.small;
            overflow: elide;
        }
        if root.card.other != "": Text {
            text: root.card.other;
            color: Theme.ok;
            font-size: Type.small;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
}

// The picked plugin. Nothing in it may be wider than the card: long names and paths wrap.
component PluginPanel inherits SidePanel {
    close => { PluginsData.close-panel(); }
    if !PluginsData.has-pick: EmptyState {
        vertical-stretch: 1;
        title: "Pick a plugin";
        text: "The songs using it show here, newest first, with its room on disk and its installed copies.";
    }
    if PluginsData.has-pick: HorizontalLayout {
        spacing: Space.sm;
        alignment: start;
        StatePill {
            state: PluginsData.state;
            text: PluginsData.state-text;
        }
    }
    if PluginsData.has-pick: Text {
        text: PluginsData.name;
        color: Theme.text;
        font-family: Theme.title-font;
        font-size: Type.panel-title;
        font-weight: 600;
        wrap: word-wrap;
        min-width: 0px;
    }
    if PluginsData.has-pick: Text {
        text: PluginsData.facts;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    if PluginsData.has-pick && PluginsData.other != "": Text {
        text: PluginsData.other;
        color: Theme.ok;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    if PluginsData.has-pick: CardActions {
        actions: PluginsData.actions;
        chosen(id) => { PluginsData.menu-chosen(id); }
    }
    if PluginsData.has-pick: TabBar {
        tabs: PluginsData.tabs;
        current <=> PluginsData.tab;
    }
    // The songs using it.
    if PluginsData.has-pick && PluginsData.tab == 0: VerticalLayout {
        spacing: Space.sm;
        vertical-stretch: 1;
        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            // Each DAW its songs come from, as a chip: pick as many as you like, as the list's DAW filter.
            if PluginsData.use-daws.chips.length > 0: FilterPicks {
                name: "DAW";
                filter: PluginsData.use-daws;
                toggled(text) => { PluginsData.use-daw-picked(text); }
                cleared => { PluginsData.use-daws-cleared(); }
            }
            ToggleChip {
                text: "Every save";
                on: PluginsData.every-save;
                clicked => { PluginsData.every-save-toggled(); }
            }
        }
        if PluginsData.uses-note != "": Text {
            text: PluginsData.uses-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        Well {
            min-height: 220px;
            vertical-stretch: 1;
            ListView {
                for u in PluginsData.uses: ListLine {
                    height: 36px;
                    tip: "Open it on the Songs page";
                    clicked => { PluginsData.open-use(u.at); }
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.md;
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            Dot { tint: Theme.daw(u.daw); }
                        }
                        Text {
                            text: u.name;
                            color: Theme.text;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if u.saves != "": Text {
                            text: u.saves;
                            color: Theme.faint;
                            font-size: Type.small;
                            vertical-alignment: center;
                        }
                        Text {
                            text: u.date;
                            color: Theme.muted;
                            font-family: Theme.number-font;
                            font-size: Type.small;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 96px;
                        }
                    }
                }
            }
        }
    }
    // Its room on disk.
    // Clean up: the folders that may go, ticked or not, and why the rest stay; then what went, with Put back.
    if PluginsData.has-pick && PluginsData.tab == 1 && PluginsData.clean-shown: VerticalLayout {
        spacing: Space.md;
        Text {
            text: PluginsData.clean-title;
            color: Theme.text;
            font-size: Type.body;
            font-weight: 600;
            wrap: word-wrap;
            min-width: 0px;
        }
        if PluginsData.clean-warning != "": Text {
            text: PluginsData.clean-warning;
            color: Theme.warning;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        if PluginsData.clean-intro != "": Text {
            text: PluginsData.clean-intro;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        if PluginsData.clean-stage == 1: VerticalLayout {
            spacing: Space.sm;
            for row[i] in PluginsData.clean-rows: Well {
                height: line.preferred-height;
                line := VerticalLayout {
                    padding: Space.md;
                    spacing: Space.xs;
                    HorizontalLayout {
                        spacing: Space.sm;
                        if row.can: TickBox {
                            text: row.kind;
                            checked: row.ticked;
                            changed checked => { PluginsData.clean-ticked(i, self.checked); }
                        }
                        if !row.can: Text {
                            text: row.kind;
                            color: Theme.muted;
                            font-size: Type.meta;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: row.size;
                            color: Theme.muted;
                            font-family: Theme.number-font;
                            font-size: Type.meta;
                            vertical-alignment: center;
                        }
                    }
                    if row.path != "": Text {
                        text: row.path;
                        color: Theme.faint;
                        font-size: Type.small;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                    if row.why != "": Text {
                        text: row.can ? row.why : "Stays: " + row.why;
                        color: Theme.warning;
                        font-size: Type.small;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                }
            }
            if PluginsData.clean-freed != "": Text {
                text: PluginsData.clean-freed;
                color: Theme.text;
                font-size: Type.meta;
                wrap: word-wrap;
                min-width: 0px;
            }
            HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                StudioButton {
                    text: PluginsData.clean-go-text;
                    main: true;
                    enabled: PluginsData.clean-can-go;
                    clicked => { PluginsData.clean-confirm(); }
                }
                StudioButton {
                    text: PluginsData.clean-keep-text;
                    clicked => { PluginsData.clean-close(); }
                }
            }
        }
        if PluginsData.clean-stage == 0 || PluginsData.clean-stage == 2 || PluginsData.clean-stage == 4: HorizontalLayout {
            spacing: Space.sm;
            Text {
                text: PluginsData.clean-busy-text;
                wrap: word-wrap;
                min-width: 0px;
                horizontal-stretch: 1;
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
            }
            if PluginsData.clean-can-stop: StudioButton {
                text: "Stop";
                clicked => { PluginsData.clean-stop(); }
            }
        }
        if PluginsData.clean-stage == 3: VerticalLayout {
            spacing: Space.sm;
            Text {
                text: PluginsData.clean-result;
                color: Theme.text;
                font-size: Type.meta;
                wrap: word-wrap;
                min-width: 0px;
            }
            for p in PluginsData.clean-problems: Text {
                text: p;
                color: Theme.warning;
                font-size: Type.small;
                wrap: word-wrap;
                min-width: 0px;
            }
            HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                if PluginsData.clean-offer-clean: StudioButton {
                    text: "Clean up what it left…";
                    main: true;
                    clicked => { PluginsData.clean-leftovers(); }
                }
                if PluginsData.clean-can-put-back: StudioButton {
                    text: "Put back";
                    clicked => { PluginsData.put-back(); }
                }
                StudioButton {
                    text: "Done";
                    clicked => { PluginsData.clean-close(); }
                }
            }
        }
    }
    if PluginsData.has-pick && PluginsData.tab == 1 && !PluginsData.clean-shown: VerticalLayout {
        spacing: Space.md;
        if PluginsData.binned-text != "": HorizontalLayout {
            spacing: Space.sm;
            Text {
                text: PluginsData.binned-text;
                color: Theme.muted;
                font-size: Type.meta;
                wrap: word-wrap;
                min-width: 0px;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                LinkText {
                    text: "Put back";
                    font-size: Type.meta;
                    clicked => { PluginsData.put-back(); }
                }
            }
        }
        Text {
            text: PluginsData.room-summary;
            color: Theme.text;
            font-size: Type.body;
            wrap: word-wrap;
            min-width: 0px;
        }
        // Its parts in three greys: a kind of file isn't a DAW, a sound type or a warning, whose colours mean those.
        if PluginsData.room-bars.length > 0: Rectangle {
            height: 10px;
            border-radius: 5px;
            clip: true;
            background: Theme.well;
            HorizontalLayout {
                for b in PluginsData.room-bars: Rectangle {
                    horizontal-stretch: max(0.01, b.share);
                    background: b.kind == 0 ? Theme.text : b.kind == 1 ? Theme.muted : Theme.faint;
                }
            }
        }
        for b in PluginsData.room-bars: HorizontalLayout {
            spacing: Space.sm;
            VerticalLayout {
                alignment: center;
                Dot { tint: b.kind == 0 ? Theme.text : b.kind == 1 ? Theme.muted : Theme.faint; }
            }
            Text {
                text: b.name;
                color: Theme.text;
                font-size: Type.meta;
                horizontal-stretch: 1;
            }
            Text {
                text: b.size;
                color: Theme.muted;
                font-family: Theme.number-font;
                font-size: Type.meta;
            }
        }
        if PluginsData.room-shared != "": Text {
            text: PluginsData.room-shared;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        if PluginsData.room-folders.length > 0: Caps { text: "FILES AND FOLDERS"; }
        for f in PluginsData.room-folders: VerticalLayout {
            spacing: Space.xs;
            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: f.kind + (f.added ? " (added by you)" : "");
                    color: Theme.text;
                    font-size: Type.meta;
                    horizontal-stretch: 1;
                }
                Text {
                    text: f.size;
                    color: Theme.muted;
                    font-family: Theme.number-font;
                    font-size: Type.meta;
                }
                if f.can-say: LinkText {
                    text: f.added ? "Take off" : "Not its";
                    tint: Theme.muted;
                    font-size: Type.meta;
                    clicked => { PluginsData.folder-not-its(f.at); }
                }
            }
            Text {
                text: f.path;
                color: Theme.faint;
                font-size: Type.small;
                wrap: word-wrap;
                min-width: 0px;
            }
            if f.shared != "": Text {
                text: f.shared;
                color: Theme.warning;
                font-size: Type.small;
                wrap: word-wrap;
                min-width: 0px;
            }
        }
        if PluginsData.can-add-folder: HorizontalLayout {
            alignment: start;
            StudioButton {
                text: "Add a folder…";
                clicked => { PluginsData.add-folder(); }
            }
        }
        Text {
            text: PluginsData.sizes-note;
            color: Theme.faint;
            font-size: Type.small;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    // Its installed copies.
    if PluginsData.has-pick && PluginsData.tab == 2: VerticalLayout {
        spacing: Space.md;
        if PluginsData.copies-note != "": Text {
            text: PluginsData.copies-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        for c in PluginsData.copies: Well {
            height: copy.preferred-height;
            copy := VerticalLayout {
                padding: Space.md;
                spacing: Space.xs;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: c.format;
                        color: Theme.muted;
                        font-size: Type.tiny;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: c.name;
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: 600;
                        wrap: word-wrap;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                }
                if c.details != "": Text {
                    text: c.details;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                if c.id != "": Text {
                    text: c.id;
                    color: Theme.faint;
                    font-family: Theme.number-font;
                    font-size: Type.small;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                Text {
                    text: c.path;
                    color: Theme.faint;
                    font-size: Type.small;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                if c.note != "": Text {
                    text: c.note;
                    color: Theme.muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                    min-width: 0px;
                }
            }
        }
        Text {
            text: PluginsData.scanner-note;
            color: Theme.faint;
            font-size: Type.small;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    // The spare room goes here, not between the parts.
    Rectangle { vertical-stretch: 1; }
}

export component PluginsPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }

    VerticalLayout {
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        HorizontalLayout {
            spacing: Space.md;
            vertical-stretch: 0;
            PageHeader {
                horizontal-stretch: 1;
                title: "Plugins";
                summary: PluginsData.summary;
            }
        }
        HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            search-box := SearchBox {
                // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and
                // Ctrl+Down step through the list from here.
                page-search: true;
                horizontal-stretch: 1;
                hint: "Search plugins or makers";
                text <=> PluginsData.search;
                edited(t) => { PluginsData.search-edited(t); }
                key(k) => {
                    // Down goes into the list, as on Sounds, MIDI and Presets, when a line shows.
                    if (k == Key.DownArrow && PluginsData.message == "" && PluginsData.lines.length > 0) {
                        keys.focus();
                        PluginsData.step(1);
                        return true;
                    }
                    false
                }
            }
            // The list's order, each on show behind its name as on Sounds and MIDI (the whole-app review of 6 Nov, X3-5).
            VerticalLayout {
                alignment: center;
                FilterPicks {
                    name: "Order";
                    filter: PluginsData.sort-filter;
                    toggled(text) => { PluginsData.sort-picked(text); }
                }
            }
        }
        // The filters, each behind its name; more than one can be picked in each. They wrap when the window is narrow.
        FlexboxLayout {
            spacing: Space.md;
            vertical-stretch: 0;
            FilterPicks {
                name: "Show";
                filter: PluginsData.show-filter;
                toggled(text) => { PluginsData.toggle("show", text); }
                cleared => { PluginsData.clear-filter("show"); }
            }
            FilterPicks {
                name: "Kind";
                filter: PluginsData.kind-filter;
                toggled(text) => { PluginsData.toggle("kind", text); }
                cleared => { PluginsData.clear-filter("kind"); }
            }
            FilterPicks {
                name: "Format";
                filter: PluginsData.format-filter;
                toggled(text) => { PluginsData.toggle("format", text); }
                cleared => { PluginsData.clear-filter("format"); }
            }
            FilterPicks {
                name: "DAW";
                filter: PluginsData.daw-filter;
                toggled(text) => { PluginsData.toggle("daw", text); }
                cleared => { PluginsData.clear-filter("daw"); }
            }
            if PluginsData.any-filter: ToggleChip {
                text: "Clear";
                on: false;
                clicked => { PluginsData.clear(); }
            }
        }
        // What to install to open more of your songs.
        if PluginsData.has-missing: VerticalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            HorizontalLayout {
                spacing: Space.md;
                Caps {
                    text: "INSTALL THESE TO OPEN MORE OF YOUR SONGS";
                    vertical-alignment: center;
                }
                Text {
                    text: PluginsData.cards.length > 0 ? PluginsData.cards-summary : "Cards are off.";
                    color: Theme.muted;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: "Cards";
                    color: Theme.muted;
                    font-size: Type.meta;
                    vertical-alignment: center;
                }
                Segmented {
                    choices: PluginsData.card-counts;
                    current: PluginsData.card-count;
                    picked(i) => { PluginsData.card-count-picked(i); }
                }
            }
            if PluginsData.cards.length > 0: HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                for c in PluginsData.cards: NeededTile {
                    card: c;
                    picked: c.row == PluginsData.selected;
                    clicked => { PluginsData.select(c.row); }
                }
            }
        }
        if PluginsData.all-installed: Text {
            text: "Every song has the plugins it needs on this computer.";
            color: Theme.ok;
            font-size: Type.meta;
        }
        if PluginsData.has-sizes: HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            Text {
                text: PluginsData.freeable != "" ? "Room to free: " + PluginsData.freeable
                    : "No installed plugin has gone unused that long.";
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                overflow: elide;
            }
            if PluginsData.freeable != "": VerticalLayout {
                alignment: center;
                LinkText {
                    text: "Show them";
                    font-size: Type.meta;
                    clicked => { PluginsData.show-unused(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Unused after";
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
            }
            Segmented {
                choices: PluginsData.unused-choices;
                current: PluginsData.unused-index;
                picked(i) => { PluginsData.unused-picked(i); }
            }
        }
        if PluginsData.half-copy-text != "": HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            Text {
                text: PluginsData.half-copy-text;
                color: Theme.warning;
                font-size: Type.meta;
                wrap: word-wrap;
                min-width: 0px;
                horizontal-stretch: 1;
            }
            if PluginsData.can-clear-half-copies: VerticalLayout {
                alignment: center;
                LinkText {
                    text: "Clear it";
                    font-size: Type.meta;
                    clicked => { PluginsData.clear-half-copies(); }
                }
            }
        }
        if PluginsData.measure-text != "": HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            Text {
                text: PluginsData.measure-text;
                color: Theme.faint;
                font-size: Type.meta;
                vertical-alignment: center;
                overflow: elide;
            }
            if PluginsData.can-measure: VerticalLayout {
                alignment: center;
                StudioButton {
                    text: "Measure again";
                    tip: PluginsData.measure-tip;
                    key: PluginsData.measure-key;
                    clicked => { PluginsData.measure-plugins(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // The list, the year strip and the picked plugin's card.
        area := Rectangle {
            vertical-stretch: 1;
            property <length> list-width: max(380px, self.width - PluginsData.panel-width - divider.width);
            property <length> years-width: PluginsData.years.length > 1 && PluginsData.message == "" ? 56px : 0px;
            property <bool> wide: self.list-width > 640px;
            keys := FocusScope {
                x: 0;
                width: area.list-width - area.years-width;
                height: parent.height;
                key-pressed(event) => {
                    if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                        return reject;
                    }
                    if (event.text == Key.UpArrow) {
                        PluginsData.step(-1);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        PluginsData.step(1);
                        return accept;
                    }
                    reject
                }
                Well {
                    if PluginsData.message != "": EmptyState {
                        x: Space.xl;
                        width: parent.width - 2 * Space.xl;
                        title: PluginsData.message;
                    }
                    if PluginsData.message == "" && PluginsData.lines.length == 0: EmptyState {
                        x: Space.xl;
                        width: parent.width - 2 * Space.xl;
                        title: "No plugins match";
                        text: "Try fewer filters or other words.";
                        action: PluginsData.any-filter ? "Clear the filters" : "";
                        act => { PluginsData.clear(); }
                    }
                    if PluginsData.message == "": plugin-list := ListView {
                        row-height: 56px;
                        rows: PluginsData.lines.length;
                        show-top: PluginsData.show-row * self.row-height;
                        show-ask: PluginsData.show-ask;
                        show-done <=> PluginsData.show-done;
                        for line in PluginsData.lines: ListLine {
                            // Every line this height: the list counts on it.
                            height: plugin-list.row-height;
                            selected: line.row == PluginsData.selected;
                            clicked => {
                                keys.focus();
                                PluginsData.select(line.row);
                            }
                            right-clicked(x, y) => { menu.open-at(x, y); }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.md;
                                VerticalLayout {
                                    alignment: center;
                                    Dot { tint: line.state == 1 ? Theme.missing : line.state == 2 ? Theme.warning : Theme.ok; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Space.xs;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: line.name;
                                        color: Theme.text;
                                        font-size: Type.row-title;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: line.details;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    width: 80px;
                                    text: line.songs;
                                    color: Theme.text;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                                if area.wide: Text {
                                    width: 76px;
                                    text: line.last;
                                    color: Theme.muted;
                                    font-family: Theme.number-font;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    width: 72px;
                                    text: line.size;
                                    color: line.state == 2 ? Theme.warning : Theme.muted;
                                    font-family: Theme.number-font;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
            if area.years-width > 0: YearRange {
                x: area.list-width - area.years-width;
                width: area.years-width;
                height: parent.height;
                years: PluginsData.years;
                picked-from: PluginsData.years-from;
                picked-to: PluginsData.years-to;
                picked(a, b) => { PluginsData.years-picked(a, b); }
                cleared => { PluginsData.years-cleared(); }
            }
            divider := PanelDivider {
                x: area.list-width;
                height: parent.height;
                panel-width: PluginsData.panel-width;
                room: area.width;
                resizing(w) => { PluginsData.panel-width = w; }
                resized(w) => { PluginsData.panel-resized(w); }
            }
            PluginPanel {
                x: area.list-width + divider.width;
                width: area.width - self.x;
                height: parent.height;
            }
            menu := RightClickMenu {
                items: PluginsData.menu;
                chosen(id) => { PluginsData.menu-chosen(id); }
            }
        }
    }
}
