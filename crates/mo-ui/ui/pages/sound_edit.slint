// The Sounds Edit strip (the 1.1 plan's light sample edits; its look is Solomon's "Build it like this" of 27 Nov 2026,
// mock-ups 12 to 14): a strip along the bottom of the page, E to open and close it, that edits the picked sound. One
// row of tools: Play and the sound's name, then the keys that trim it to a part picked on its waveform, fade it in and
// out (or drag the fades' corner handles), reverse it, normalise it, crossfade a loop and turn it up or down. Undo and
// redo step through the edits; holding O (or A|B) plays the original. Under the tools its screen, with a level meter
// beside it, and along the foot the edits so far and what to do with them: the edit is dragged out, or saved, as a
// copy in the export folder's Edited sounds. The file itself never changes (rule 2). Tempo, pitch and Tail wait for
// the stretcher. The work is in Rust, with no screen, so the plugin shows the same strip (mo-app `edit_strip.rs`;
// mo-ui `sounds/edit_strip.rs` is the app's side of it).
//
// Its Slices (mock-up 9; their look is mock-up 13) cut the edit at its hits, or on the beats, for a drum machine's
// pads: a line at each cut, to drag or double-click away (a double-click between two adds one), each slice's number in
// a cell along the screen's foot, a click in a slice to hear it, the pads they go on beside the screen (a press plays
// one too), and Send to put them on a Drum Machine in Bitwig from C1 or in a numbered folder (mo-app
// `edit_strip/slices.rs`).

import { Theme, Type, Space, Heights, Well, Caps, Dot, StudioButton, TempoStepper, DragHandle, InfoTip, Waveform, Icons, RowSeam, FadeHandle, Widths, MenuChip, StudioSlider, MenuCard, MenuLine, Groove, CutText, PlayKey, JoinedKeys, JoinedKey, IconKey, ABSwitch, LevelMeter, ScreenTag, DoneNote, PadGrid, CountingKey, MouseField } from "../studio.slint";

// A mark on the strip's ruler: where (0 to 1 across the waveform), what it says, and whether it's a bar's (brighter).
export struct EditMark {
    at: float,
    text: string,
    bar: bool,
}

// One edit made so far, as a chip under the screen; the last one (the one Undo takes back) is lit. With the Slices
// on there are none: the foot names the slice picked instead.
export struct EditChip {
    text: string,
    last: bool,
}

// A cut on the Slices' waveform: where (0 to 1 across the part on show), the number of the slice it starts, and how
// much room there is to the next line (0 to 1 across): how wide its slice's cell is.
export struct SliceCut {
    at: float,
    number: int,
    room: float,
}

// The room the strip's screen has, told to Rust as it's laid out (mo-app's `edit_strip::screen::Room`): how wide and
// high the screen is, how far in from its sides the waveform starts and ends, how high the ruler's band along its top
// is, where a waveform at full scale reaches up to and down to (from the screen's top), and how many pixels there are
// to a point.
export struct EditRoom {
    width: length,
    height: length,
    inset: length,
    band: length,
    top: length,
    bottom: length,
    scale: float,
}

export global SoundEdit {
    // Open: the strip shows along the bottom of the page.
    in-out property <bool> shown;
    // The sound it edits: its name, its type's colour, and what it is, under its name ("3.75 s · 128 BPM · 2 bars";
    // with the Slices on, how many there are and the one picked).
    in property <string> name;
    in property <int> colour;
    in property <string> facts;
    // Its tempo, for the length of a part as it's picked: 0 when that isn't known.
    in property <float> bpm;
    // Why there's nothing to edit (it couldn't be read, it's too long): shown where the waveform goes. "" for none.
    in property <string> note;
    // Read and ready to edit.
    in property <bool> ready;
    // The screen's waveform over the part on show (the whole of it unless zoomed in): a picture three screens high,
    // one under the other (the sound as it is; dim, for what's outside the part picked; lit, for what has played),
    // drawn in Rust for the room the screen says it has (`laid-out`). How long the part on show lasts and where it
    // starts (seconds).
    in property <image> wave-picture;
    in property <float> view-seconds;
    in property <float> view-from;
    // The part picked on it (0 to 1 across the part on show; none unless `pick-to` is past `pick-from`), and whether
    // each of its edges is on a hit.
    in property <float> pick-from;
    in property <float> pick-to;
    in property <bool> pick-from-on-hit;
    in property <bool> pick-to-on-hit;
    // The fades' handles, 0 to 1 across (where the fade in ends and the fade out starts), each shown only while its end
    // of the sound is in sight; their curves, paths 1000 across and 100 high ("" for a fade that isn't there); what
    // each takes away, the same way, a shape to shade; and, while a handle is dragged, how long its fade is now.
    in property <float> fade-in;
    in property <float> fade-out;
    in property <bool> fade-in-shown;
    in property <bool> fade-out-shown;
    in property <string> fade-in-curve;
    in property <string> fade-out-curve;
    in property <string> fade-in-shade;
    in property <string> fade-out-shade;
    in property <string> fade-text;
    in property <[EditMark]> ruler;
    in property <[EditChip]> chips;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // Any edits made now (undo may have taken them all back): something to save.
    in property <bool> has-edits;
    in property <bool> has-part;
    in property <bool> zoomed;
    // The gain of the part picked (or the whole sound), as the stepper shows it ("−1.5 dB"), and whether it's been
    // changed from none.
    in property <string> gain-text: "0.0 dB";
    in property <bool> gain-changed;
    // The edit goes over full scale somewhere: its tops are red, and Normalise would bring it back.
    in property <bool> too-loud;
    // Playing: the strip's play plays; where it started and where it has got to, both across the part on show (0 to 1
    // while they're in sight; what's between them is lit); and whether it's the original that's heard.
    in property <bool> playing;
    in property <float> played-from;
    in property <float> played;
    in property <bool> original;
    // The level meter: how far up each side is lit (0 to 1), the highest each gets, from where up it's amber, that
    // highest as a number ("−3.0"), and whether it's over full scale.
    in property <float> level-left;
    in property <float> level-right;
    in property <float> hold-left;
    in property <float> hold-right;
    in property <float> meter-amber: 0.86;
    in property <string> peak-text;
    in property <bool> over;
    // Where copies go, for the tips ("Exports\Edited sounds").
    in property <string> folder-text: "Edited sounds";
    // What the drag handle carries ("Drag the edit"; with the Slices on, "Drag slice 5"), whether there's anything for
    // it to carry (with the Slices on, only once a slice is picked), and whether it's being carried or has just landed.
    in property <string> drag-text: "Drag the edit";
    in property <bool> can-drag: true;
    in property <bool> lifted;
    in property <bool> landed;
    // The Save button: what it says ("Save copy", "Saving…", "Saved"), whether it can be pressed, and whether the copy
    // of these very edits is saved. Beside it, how the last save went, in two lines: "Saved in Edited sounds" over the
    // copy's name, or (`save-failed`) that it couldn't be, over why. "" for none.
    in property <string> save-text: "Save copy";
    in property <bool> can-save;
    in property <bool> saved;
    in property <string> save-note;
    in property <string> save-detail;
    in property <bool> save-failed;
    // The Slices: on (the tools give way to the slicing's), the cuts on show, the slice picked (0 to 1 across; none
    // unless `slice-to` is past `slice-from`), and where the first cut is (what's before it is in no slice).
    in property <bool> slicing;
    in property <[SliceCut]> cuts;
    in property <float> slice-from;
    in property <float> slice-to;
    in property <float> first-cut;
    // The slice picked by its number, from 1 (0 for none): its cell along the screen's foot is lit, and its pad; and
    // a count that changes with every pick, of the same slice too (the pads turn back to its page). And the slice
    // that runs in from before the stretch on show, zoomed in past its cut: its number (0 for none) and how far
    // across it runs. It has no line in sight, but its cell.
    in property <int> slice-number;
    in property <int> slice-picks;
    in property <int> lead-number;
    in property <float> lead-room;
    // What the cuts go by ("Hits", "Every beat"…) and the choices; whether it's the hits (the sensitivity then
    // counts); how big a hit must be, 0 (only the biggest) to 1 (the smallest too); and how far each slice runs.
    in property <string> cut-at;
    in property <[string]> cut-at-choices;
    in property <bool> cut-at-hits;
    in-out property <float> sensitivity: 0.5;
    in property <string> each;
    in property <[string]> each-choices;
    // The Send button's words ("Send 20 slices") and whether there's anything to send (and none on their way); each
    // slice's pad, by its note's name as Bitwig has it ("C1", "C#1"…): one for every slice, in sight or not, so they
    // count the cuts too; what Send's menu says of their folder ("A numbered folder, 01 … 20"), and where the slices
    // are saved.
    in property <string> send-text: "Send the slices";
    in property <bool> can-send;
    in property <[string]> pads;
    in property <string> to-folder-text: "A numbered folder";
    in property <string> saved-in;
    // These slices are on their way (`sending`): the button is a bar that fills as they're made (`send-progress`, 0
    // to 1), its words counting along ("Making 13 of 20", then "Waiting for Bitwig"), and their pads fill, the first
    // `pads-made` of them, the next one lit while it's being made (`pads-making`). Once they're where they were sent
    // (`sent`), the button says where ("In Bitwig"), with a tick.
    in property <bool> sending;
    in property <float> send-progress;
    in property <bool> sent;
    // These slices couldn't be sent: said beside Send in red, over why (the whole of it in the note's tip). "" for
    // nothing to say.
    in property <string> send-note;
    in property <string> send-detail;
    in property <int> pads-made;
    in property <bool> pads-making;
    // What the strip's foot says with the Slices on: the slice picked ("Slice 5") and its length and pad
    // ("0.23 s · pad E1"); with none picked, only the pads they all go on ("Pads C1 to G3").
    in property <string> slice-name;
    in property <string> slice-facts;
    // Whether a Drum Machine in Bitwig is one of the places the slices can go: always from the app; from the plugin,
    // only while Bitwig is the DAW it's in. And how long the edits wait, as the tip says it.
    in property <bool> can-bitwig: true;
    in property <string> kept-while: "while the app is open";
    // The keys from the shortcut list, for the tips.
    in property <string> play-key;
    in property <string> slices-key;
    in property <string> bitwig-key;
    in property <string> edit-key;
    in property <string> undo-key;
    in property <string> redo-key;
    in property <string> save-key;
    in property <string> original-key;
    in property <string> trim-key;
    in property <string> fade-in-key;
    in property <string> fade-out-key;
    in property <string> reverse-key;
    in property <string> normalise-key;
    in property <string> louder-key;
    in property <string> quieter-key;
    in property <string> loop-key;
    // The screen was laid out, or its size or the window's scale changed: the room its waveform has.
    callback laid-out(EditRoom);
    // Play: the edit plays (the part picked, or the slice, with one), or stops.
    callback play();
    // A tool, by its id in the shortcut list ("sounds.editTrim"), as its key does.
    callback tool(string);
    callback gain-stepped(int);
    callback gain-reset();
    // A fade's handle dragged to `at` (0 to 1 across; the fade in's for `true`), and let go.
    callback fade-moving(bool, float);
    callback fade-let-go(bool);
    pure callback snap(float, float) -> float;
    // How long a part of so many seconds is, as its badge says it ("0.94 s · 2 beats"), at this tempo (0 for none).
    pure callback part-text(float, float) -> string;
    callback wave-pressed();
    callback picked(float, float);
    callback seek(float);
    callback stop();
    // A press inside the part picked that moved: the part is carried out. The drag handle picked up: what its words
    // say is. Let go before the drag had got going.
    callback drag-part();
    callback drag-handle();
    callback drag-let-go();
    callback hear-original(bool);
    // Zoomed in on the part picked (`true`), or the whole sound.
    callback zoom(bool);
    callback close();
    // The words about the saved copy clicked: it's shown in its folder.
    callback show-saved();
    // The Slices' choices.
    callback cut-at-picked(string);
    callback sensitivity-moved(float);
    callback sensitivity-released(float);
    callback each-picked(string);
    // A press on the Slices' waveform at `at` (0 to 1 across), a line within `within` of it taken hold of, Shift held
    // or not (no snapping to the hits); the mouse moved with it held (`far` once it has gone too far to be a click);
    // let go (`cut-short` when the window lost the mouse); and a double-click.
    callback slice-down(float, float, bool);
    callback slice-move(float, bool, bool);
    callback slice-up(bool);
    callback slice-double();
    // Whether a cut's line is within `within` of `at` (0 to 1 across): the mouse there takes hold of it. It's asked
    // with `cuts-mark`, which is another number whenever the lines (or the stretch shown) are others: the mouse's
    // shape is worked out again then, though the mouse hasn't moved.
    pure callback slice-near(float, float, int) -> bool;
    in property <int> cuts-mark;
    // A pad pressed: its slice (from 0) is picked and plays.
    callback pad-pressed(int);
}

// A thin upright line between two groups of a row of tools.
component ToolsGap inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    Rectangle {
        width: 1px;
        height: 20px;
        background: Theme.stroke;
    }
}

// A slice's cell along the foot of the strip's screen, as wide as its slice: its number, where there's room for it.
// The one picked is lit; the one a click would play (the mouse is over its slice, and not on a line) a little.
component SliceCell inherits Rectangle {
    in property <int> number;
    in property <bool> picked;
    in property <bool> under-mouse;
    visible: self.width >= 2px;
    border-radius: 2px;
    background: root.picked ? Theme.accent : root.under-mouse ? Theme.surface-raised.brighter(40%) : Theme.surface-raised;
    Text {
        width: parent.width;
        height: parent.height;
        visible: self.preferred-width + 4px <= parent.width;
        text: root.number;
        color: root.picked ? Theme.accent-text : root.under-mouse ? Theme.text : Theme.muted;
        font-family: Theme.number-font;
        font-size: Type.tiny;
        font-weight: root.picked ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The strip's screen: the waveform as a picture (drawn in Rust for the room this says it has, mo-app's
// `edit_strip::screen`), and laid on it here what moves with the mouse or as it plays, so none of that draws the
// picture again: the part picked, the fades, the play head, the ruler's numbers.
component EditScreen inherits Well {
    in property <bool> on;
    // How far in from its sides the waveform starts and ends, and how high the ruler's band along its top is.
    property <length> inset: 10px;
    property <length> band: 20px;
    // How high the slices' cells along its foot are.
    property <length> cells: 16px;
    property <color> pick: Theme.here-colour;
    view := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        clip: true;
        // How wide the waveform itself is, and where it reaches up to and down to at full scale: under it is the
        // foot, with the hits' marks; or, with the Slices on, the slices' cells.
        property <length> wide: max(1px, self.width - 2 * root.inset);
        property <length> top: root.band + 5px;
        property <length> foot: SoundEdit.slicing ? root.cells + 6px : 12px;
        property <length> bottom: self.height - self.foot;
        property <float> scale: 1px / 1phx;
        // How high one of the picture's three screens is.
        property <length> one: SoundEdit.wave-picture.height / 3 * 1phx;
        // A part shows: not while the original is heard, which shows whole, as it was.
        property <bool> part: wave.shows-part && !SoundEdit.original;
        property <length> from-x: root.inset + wave.shown-from * self.wide;
        property <length> to-x: root.inset + wave.shown-to * self.wide;
        // What has played is lit: between where the play started and where it has got to, as far as that's in sight.
        // (The play head runs right to left while the original is heard over a stretch the edit has reversed.)
        property <float> lit-from: clamp(min(SoundEdit.played-from, SoundEdit.played), 0, 1);
        property <float> lit-to: clamp(max(SoundEdit.played-from, SoundEdit.played), 0, 1);
        property <length> head-x: root.inset + SoundEdit.played * self.wide;
        property <bool> head: root.on && SoundEdit.playing && SoundEdit.played >= 0 && SoundEdit.played <= 1;
        // How far down the play head's line runs: to the screen's foot, or with the Slices on to their cells, so it
        // never runs through a slice's number.
        property <length> head-foot: SoundEdit.slicing ? self.height - root.cells - 3px : self.height;
        // The fade whose handle is being dragged: 1 the fade in's, 2 the fade out's.
        property <int> fade-drag;
        function laid-out() {
            SoundEdit.laid-out({
                width: self.width,
                height: self.height,
                inset: root.inset,
                band: root.band,
                top: self.top,
                bottom: self.bottom,
                scale: self.scale,
            });
        }
        init => {
            self.laid-out();
        }
        changed width => {
            self.laid-out();
        }
        changed height => {
            self.laid-out();
        }
        changed foot => {
            self.laid-out();
        }
        changed scale => {
            self.laid-out();
        }
        // The picture, shown pixel for pixel: it's made for the screen's size at the window's scale. The sound as it
        // is, or dim while a part is picked, with the part itself as it is.
        if root.on: Image {
            x: 0;
            y: view.part ? -view.one : 0;
            width: self.source.width * 1phx;
            height: self.source.height * 1phx;
            source: SoundEdit.wave-picture;
        }
        if root.on && view.part: Rectangle {
            x: view.from-x;
            width: view.to-x - view.from-x;
            clip: true;
            Image {
                x: -parent.x;
                y: 0;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: SoundEdit.wave-picture;
            }
        }
        // While it plays, what hasn't played yet stands back a little, and what has is lit.
        if root.on && SoundEdit.playing: Rectangle {
            x: view.part ? view.from-x : root.inset;
            y: root.band;
            width: view.part ? view.to-x - view.from-x : view.wide;
            height: view.bottom - root.band;
            background: Theme.well.transparentize(view.part ? 72% : 62%);
        }
        if root.on && SoundEdit.playing && view.lit-to > view.lit-from: Rectangle {
            x: root.inset + view.lit-from * view.wide;
            width: (view.lit-to - view.lit-from) * view.wide;
            clip: true;
            Image {
                x: -parent.x;
                y: -2 * view.one;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: SoundEdit.wave-picture;
            }
        }
        // The part picked: a tint over it, a bar along its top and an edge at each end, with a grip to take hold of.
        // The edge being dragged glows, and an edge that's on a hit stands on a wider foot.
        if view.part: Rectangle {
            x: view.from-x;
            y: root.band;
            width: view.to-x - view.from-x;
            height: parent.height - root.band;
            background: root.pick.transparentize(91%);
        }
        if view.part && wave.changing: Rectangle {
            x: root.inset + wave.moving * view.wide - self.width / 2;
            y: root.band;
            width: 18px;
            height: parent.height - root.band;
            background: root.pick.transparentize(86%);
        }
        if view.part: Rectangle {
            x: view.from-x;
            y: root.band - 2px;
            width: view.to-x - view.from-x;
            height: 3px;
            background: root.pick;
        }
        for end in (view.part ? 2 : 0): Rectangle {
            property <bool> on-hit: end == 0 ? wave.from-on-hit : wave.to-on-hit;
            x: (end == 0 ? view.from-x : view.to-x) - 1px;
            y: root.band - 2px;
            width: 2px;
            height: parent.height - self.y;
            background: root.pick;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 28px;
                border-radius: self.width / 2;
                background: root.pick;
                Rectangle {
                    width: 1.5px;
                    height: 14px;
                    border-radius: 0.75px;
                    background: root.pick.mix(Theme.well, 0.25);
                }
            }
            Rectangle {
                visible: parent.on-hit;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height;
                width: 4px;
                height: 9px;
                border-radius: 1px;
                background: root.pick;
            }
        }
        // The fades: what each takes away is shaded, and its curve is drawn over the sound at full scale.
        fades := Rectangle {
            x: root.inset;
            y: view.top;
            width: view.wide;
            height: view.bottom - view.top;
            visible: root.on && !SoundEdit.slicing && !SoundEdit.original;
            if SoundEdit.fade-in-shade != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-in-shade;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                fill: Theme.well.transparentize(40%);
            }
            if SoundEdit.fade-out-shade != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-out-shade;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                fill: Theme.well.transparentize(40%);
            }
            if SoundEdit.fade-in-shade != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-in-shade;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                fill: Theme.warning.transparentize(93%);
            }
            if SoundEdit.fade-out-shade != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-out-shade;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                fill: Theme.warning.transparentize(93%);
            }
            if SoundEdit.fade-in-curve != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-in-curve;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                stroke: Theme.warning;
                stroke-width: 1.5px;
            }
            if SoundEdit.fade-out-curve != "": Path {
                width: parent.width;
                height: parent.height;
                commands: SoundEdit.fade-out-curve;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                stroke: Theme.warning;
                stroke-width: 1.5px;
            }
        }
        // The mouse on the waveform: a click plays from there, a drag across it picks a part, a press on one of the
        // part's edges moves it, and a press inside the part that moves carries the part out. It draws only the line
        // under the mouse; what the press is doing is read from it above and below.
        wave := Waveform {
            x: root.inset;
            y: root.band;
            width: view.wide;
            height: parent.height - root.band;
            bare: true;
            playing: SoundEdit.playing;
            seconds: SoundEdit.view-seconds;
            from-seconds: SoundEdit.view-from;
            can-seek: root.on && !SoundEdit.slicing;
            can-pick: root.on && !SoundEdit.slicing;
            pick-from: SoundEdit.pick-from;
            pick-to: SoundEdit.pick-to;
            pick-from-on-hit: SoundEdit.pick-from-on-hit;
            pick-to-on-hit: SoundEdit.pick-to-on-hit;
            pick-tint: root.pick;
            seek(at) => { SoundEdit.seek(at); }
            stop => { SoundEdit.stop(); }
            pressed => { SoundEdit.wave-pressed(); }
            snap(at, within) => { SoundEdit.snap(at, within) }
            picked(from, to) => { SoundEdit.picked(from, to); }
            drag-part => { SoundEdit.drag-part(); }
            part-let-go => { SoundEdit.drag-let-go(); }
        }
        // The Slices: what's before the first cut dimmed, the slice picked lit, a line at each cut with a small
        // handle at its top, and along the foot a cell for each slice with its number (the one picked lit, the one
        // under the mouse a little). The mouse is the page's: a press on a line moves it, a click in a slice (or its
        // cell) plays it, a press in one that moves carries it out.
        if root.on && SoundEdit.slicing: Rectangle {
            // Where the cells start: the lines run down to them.
            property <length> cells-y: self.height - root.cells - 3px;
            x: root.inset;
            y: root.band;
            width: view.wide;
            height: parent.height - root.band;
            // The screen's own face behind the cells' row, from the waveform's foot down: the ruler's lines end there,
            // and only the cuts' lines reach the cells.
            Rectangle {
                x: -root.inset;
                y: parent.cells-y - 3px;
                width: view.width;
                height: parent.height - self.y;
                background: Theme.well;
            }
            Rectangle {
                x: 0;
                width: parent.width * clamp(SoundEdit.first-cut, 0, 1);
                height: parent.cells-y - 3px;
                background: Theme.well.transparentize(45%);
            }
            if SoundEdit.slice-to > SoundEdit.slice-from: Rectangle {
                x: parent.width * SoundEdit.slice-from;
                y: 0;
                width: parent.width * (SoundEdit.slice-to - SoundEdit.slice-from);
                height: parent.cells-y;
                background: root.pick.transparentize(80%);
            }
            for c in SoundEdit.cuts: Rectangle {
                x: c.at * parent.width;
                y: 0;
                width: 1px;
                height: parent.cells-y;
                background: root.pick.transparentize(30%);
            }
            for c in SoundEdit.cuts: Path {
                x: c.at * parent.width - 4px;
                y: 0;
                width: 9px;
                height: 6px;
                viewbox-width: 9;
                viewbox-height: 6;
                commands: "M 0 0 L 9 0 L 4.5 6 Z";
                fill: root.pick;
            }
            if SoundEdit.lead-number > 0: SliceCell {
                x: 1px;
                y: parent.cells-y;
                width: max(0px, SoundEdit.lead-room * parent.width - 2px);
                height: root.cells;
                number: SoundEdit.lead-number;
                picked: SoundEdit.lead-number == SoundEdit.slice-number;
                under-mouse: slice-touch.in-slice && slice-touch.mouse-x < SoundEdit.lead-room * parent.width;
            }
            for c in SoundEdit.cuts: SliceCell {
                x: c.at * parent.width + 1px;
                y: parent.cells-y;
                width: max(0px, c.room * parent.width - 2px);
                height: root.cells;
                number: c.number;
                picked: c.number == SoundEdit.slice-number;
                under-mouse: slice-touch.in-slice && slice-touch.mouse-x >= c.at * parent.width
                    && slice-touch.mouse-x < (c.at + c.room) * parent.width;
            }
            slice-touch := MouseField {
                // How near a line a press takes hold of it.
                property <length> line-room: 5px;
                // Where the press was, and whether it's held: whether it has gone too far to be a click.
                property <length> down-x;
                property <length> down-y;
                property <bool> held;
                // The mouse is on a line: a press there takes hold of the line, and the cursor says so. Elsewhere over
                // the screen it's in a slice, which a click plays: that slice's cell says so.
                property <bool> on-line: SoundEdit.slice-near(self.mouse-x / max(1px, self.width),
                    self.line-room / max(1px, self.width), SoundEdit.cuts-mark);
                property <bool> in-slice: self.inside && !self.on-line;
                mouse-cursor: self.on-line ? MouseCursor.ew-resize : MouseCursor.pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        self.held = true;
                        self.down-x = self.mouse-x;
                        self.down-y = self.mouse-y;
                        SoundEdit.slice-down(self.mouse-x / max(1px, self.width), self.line-room / max(1px, self.width), e.modifiers.shift);
                    } else if e.kind == PointerEventKind.move && self.held {
                        SoundEdit.slice-move(self.mouse-x / max(1px, self.width), e.modifiers.shift,
                            abs(self.mouse-x - self.down-x) > 3px || abs(self.mouse-y - self.down-y) > 3px);
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.held {
                        self.held = false;
                        SoundEdit.slice-up(false);
                    } else if e.kind == PointerEventKind.cancel && self.held {
                        self.held = false;
                        SoundEdit.slice-up(true);
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.right && SoundEdit.playing {
                        // A right click stops it, as on any waveform.
                        SoundEdit.stop();
                    }
                }
                double-clicked => { SoundEdit.slice-double(); }
            }
        }
        // The fades' handles, at the top of the sound where each fade ends: a ring where there's none yet.
        Rectangle {
            x: root.inset;
            width: view.wide;
            visible: fades.visible;
            if SoundEdit.fade-in-shown: FadeHandle {
                y: view.top - self.height / 2;
                at: SoundEdit.fade-in;
                room: view.wide;
                hollow: SoundEdit.fade-in-curve == "";
                tip: "Drag to fade in";
                key: SoundEdit.fade-in-key;
                moving(at) => {
                    view.fade-drag = 1;
                    SoundEdit.fade-moving(true, at);
                }
                let-go => {
                    view.fade-drag = 0;
                    SoundEdit.fade-let-go(true);
                }
            }
            if SoundEdit.fade-out-shown: FadeHandle {
                y: view.top - self.height / 2;
                at: SoundEdit.fade-out;
                room: view.wide;
                hollow: SoundEdit.fade-out-curve == "";
                tip: "Drag to fade out";
                key: SoundEdit.fade-out-key;
                moving(at) => {
                    view.fade-drag = 2;
                    SoundEdit.fade-moving(false, at);
                }
                let-go => {
                    view.fade-drag = 0;
                    SoundEdit.fade-let-go(false);
                }
            }
        }
        // How long the fade being dragged is now, beside its handle.
        if fades.visible && view.fade-drag != 0 && SoundEdit.fade-text != "": ScreenTag {
            property <length> at: root.inset + (view.fade-drag == 1 ? SoundEdit.fade-in : SoundEdit.fade-out) * view.wide;
            x: clamp(view.fade-drag == 1 ? self.at + 14px : self.at - 14px - self.width, 2px, max(2px, view.width - self.width - 2px));
            y: view.top + 12px;
            text: SoundEdit.fade-text;
            tint: Theme.warning;
        }
        // The play head: a little light behind it, its line, and its marker in the ruler's band.
        if view.head: Rectangle {
            // Behind it is on its right while it runs right to left.
            property <bool> leftward: SoundEdit.played < SoundEdit.played-from;
            property <length> trail: clamp((view.lit-to - view.lit-from) * view.wide, 0px, 44px);
            x: self.leftward ? view.head-x : view.head-x - self.trail;
            y: root.band;
            width: self.trail;
            height: view.head-foot - root.band;
            background: self.leftward
                ? @linear-gradient(90deg, Theme.text.transparentize(90%) 0%, Theme.text.transparentize(100%) 100%)
                : @linear-gradient(90deg, Theme.text.transparentize(100%) 0%, Theme.text.transparentize(90%) 100%);
        }
        if view.head: Rectangle {
            x: view.head-x - 1px;
            y: root.band;
            width: 2px;
            height: view.head-foot - root.band;
            background: Theme.text;
        }
        if view.head: Path {
            x: view.head-x - self.width / 2;
            y: root.band - 6px;
            width: 10px;
            height: 8px;
            viewbox-width: 10;
            viewbox-height: 8;
            commands: "M 0 0 L 10 0 L 10 3 L 5 8 L 0 3 Z";
            fill: Theme.text;
        }
        // How long the part picked is, riding on top of it: over the play head's line too, so that never runs through
        // its words.
        if view.part: ScreenTag {
            x: clamp((view.from-x + view.to-x - self.width) / 2, 2px, max(2px, view.width - self.width - 2px));
            y: root.band + 7px;
            text: SoundEdit.part-text((wave.shown-to - wave.shown-from) * SoundEdit.view-seconds, SoundEdit.bpm);
            tint: root.pick;
        }
        // The ruler's numbers, in the band: bars and beats when the tempo's known, else seconds. Each beside its
        // line; none where there's no room for it before the screen's end (the last one, at the sound's end).
        for m in SoundEdit.ruler: Text {
            x: root.inset + m.at * view.wide + 5px;
            y: (root.band - self.preferred-height) / 2;
            visible: self.x + self.preferred-width <= view.width - 2px;
            text: m.text;
            color: m.bar ? Theme.muted : Theme.faint;
            font-family: Theme.number-font;
            font-size: Type.small;
        }
        if root.on && SoundEdit.original: ScreenTag {
            x: root.inset;
            y: root.band + 7px;
            text: "Original";
        }
        if !root.on: Text {
            text: SoundEdit.note != "" ? SoundEdit.note : "Reading the sound…";
            color: Theme.muted;
            font-size: Type.meta;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 2 * Space.xl;
            x: Space.xl;
        }
    }
}

// What one of the Slices' choices is, said before its chip.
component ChoiceName inherits Text {
    color: Theme.muted;
    font-size: Type.meta;
    vertical-alignment: center;
}

// The Slices' choices: what the cuts go by, how big a hit must be to get one (with how many cuts that gives, counted
// as the slider moves), and how far each slice runs.
component SliceChoices inherits HorizontalLayout {
    // How long the Sensitivity's track is: shorter where the row of tools is tight.
    in property <length> track: 120px;
    spacing: Space.md;
    HorizontalLayout {
        spacing: Space.sm;
        ChoiceName { text: "Cut at"; }
        VerticalLayout {
            alignment: center;
            MenuChip {
                name: "Cut at";
                bare: true;
                value: SoundEdit.cut-at;
                choices: SoundEdit.cut-at-choices;
                has-any: false;
                lights: false;
                picked(c) => { SoundEdit.cut-at-picked(c); }
            }
        }
    }
    if SoundEdit.cut-at-hits: HorizontalLayout {
        spacing: Space.sm;
        StudioSlider {
            low: "Sensitivity";
            tip: "How big a hit must be to get a cut: further right, smaller ones too";
            track-width: root.track;
            value <=> SoundEdit.sensitivity;
            moved(v) => { SoundEdit.sensitivity-moved(v); }
            released(v) => { SoundEdit.sensitivity-released(v); }
        }
        // As wide whatever the count, so nothing after it moves as the slider does.
        HorizontalLayout {
            width: 56px;
            alignment: start;
            spacing: Space.xs;
            Text {
                text: SoundEdit.pads.length;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.meta;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: SoundEdit.pads.length == 1 ? "cut" : "cuts";
                color: Theme.muted;
                font-family: Theme.number-font;
                font-size: Type.meta;
                vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        spacing: Space.sm;
        ChoiceName { text: "Each slice"; }
        VerticalLayout {
            alignment: center;
            MenuChip {
                name: "Each slice";
                bare: true;
                value: SoundEdit.each;
                choices: SoundEdit.each-choices;
                has-any: false;
                lights: false;
                picked(c) => { SoundEdit.each-picked(c); }
            }
        }
    }
}

// The strip.
export component EditStrip inherits Rectangle {
    // Its name among the parts you can drag, which has its least and most height: the app's Sounds page and the
    // plugin's panel each have one of their own, kept where each keeps its widths.
    in property <string> part;
    // The most a drag may make it: the page keeps room above it. Only the drag reads it: the strip's height is the
    // page's to share out (a short window takes room from the list first, then from the strip, down to its least).
    in property <length> most-height;
    min-height: Widths.least(root.part);
    preferred-height: clamp(Widths.sounds-edit, Widths.least(root.part), Widths.most(root.part));
    max-height: self.preferred-height;
    vertical-stretch: 0;
    background: Theme.surface;
    property <color> tint: Theme.sound-type(SoundEdit.colour);
    property <bool> on: SoundEdit.ready;
    // What the row of tools has room for, by how wide the strip is. Its parts are as wide whatever the sound, so
    // each of these is where they stop fitting, added up: Play 36, the name (240 beside the edit's tools, 200 beside
    // the Slices' choices, and at least 120), the edit's tools 407 (505 with the three that wait for the stretcher),
    // the Slices key and choices up to 594 (with the longest of the choices' words, "to the sound's end") and the
    // Sensitivity's track, undo to close 233, 8 between each two, and 12 at each end.
    //   The name: it would be squeezed under 120 below this (the Slices' own row always has room for it).
    property <bool> named: SoundEdit.slicing || self.width >= 860px;
    //   The three tools that wait for the stretcher, beside the name at its full width.
    property <bool> roomy: self.width >= 1088px;
    //   So little room that the keys are narrower (a small window).
    property <bool> tight: !SoundEdit.slicing && self.width < 724px;
    //   The Slices' choices beside the Slices key; under this they have a row of their own. The Sensitivity's track
    //   gives way first, from 120 down to 64, so the name keeps 176: room for a heading as long as "64 slices ·
    //   16 bars" under it, whatever the choices say.
    property <bool> one-row: self.width >= 1170px;
    property <length> track: clamp(self.width - 1106px, 64px, 120px);
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.edge;
    }
    VerticalLayout {
        padding: Space.md;
        padding-top: Space.sm;
        spacing: Space.sm;
        // The tools, in one row: Play and the sound's name; the edit's tools (or the Slices' choices); undo, redo and
        // A|B; and the view's keys. The row is placed by hand in a room as wide as the strip, so what's in it doesn't
        // count in how wide the strip (and so the window) must be: what it shows can then go by the strip's width.
        // The room is two rows high when the Slices' choices need a row of their own (a row in the strip's own layout
        // that came and went with the strip's width would go round in a circle: the width depends on the rows).
        tools-room := Rectangle {
            property <bool> second: SoundEdit.slicing && !root.one-row;
            height: self.second ? 38px + Space.sm + Heights.button : 38px;
            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 38px;
                spacing: Space.sm;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    PlayKey {
                        playing: SoundEdit.playing;
                        enabled: root.on;
                        tip: SoundEdit.playing ? "Stop" : SoundEdit.slicing ? "Play the slice picked, or the whole edit" : SoundEdit.has-part ? "Play the part picked" : "Play the edit";
                        key: SoundEdit.play-key;
                        clicked => { SoundEdit.play(); }
                    }
                }
                // Its name, and under it what it is. As wide whatever the name, so the tools never move from sound to
                // sound; narrower only when the row has no room.
                if root.named: VerticalLayout {
                    property <length> most: SoundEdit.slicing ? 200px : 240px;
                    alignment: center;
                    horizontal-stretch: 0;
                    min-width: 0px;
                    preferred-width: self.most;
                    max-width: self.most;
                    HorizontalLayout {
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            Dot { tint: root.tint; }
                        }
                        CutText {
                            own-mouse: true;
                            text: SoundEdit.name;
                            color: Theme.text;
                            font-family: Theme.title-font;
                            font-size: Type.body;
                            font-weight: 600;
                            vertical-alignment: center;
                            min-width: 0px;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        padding-left: Space.lg;
                        CutText {
                            own-mouse: true;
                            text: SoundEdit.facts;
                            color: Theme.muted;
                            font-family: Theme.number-font;
                            font-size: Type.meta;
                            min-width: 0px;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.named: ToolsGap { }
                // The edit's tools.
                if !SoundEdit.slicing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        height: Heights.button;
                        spacing: Space.sm;
                        JoinedKeys {
                            JoinedKey {
                                first: true;
                                tight: root.tight;
                                icon: Icons.trim;
                                tip: SoundEdit.has-part ? "Keep only the part picked" : "Trim: pick a part on the waveform first, then this keeps only that";
                                key: SoundEdit.trim-key;
                                enabled: root.on && SoundEdit.has-part;
                                hot: root.on && SoundEdit.has-part;
                                clicked => { SoundEdit.tool("sounds.editTrim"); }
                            }
                            JoinedKey {
                                tight: root.tight;
                                icon: Icons.fade-in;
                                tip: SoundEdit.has-part ? "Fade in across the part picked" : "Fade in at the start (drag its yellow handle to make it longer)";
                                key: SoundEdit.fade-in-key;
                                enabled: root.on;
                                clicked => { SoundEdit.tool("sounds.editFadeIn"); }
                            }
                            JoinedKey {
                                tight: root.tight;
                                icon: Icons.fade-out;
                                tip: SoundEdit.has-part ? "Fade out across the part picked" : "Fade out at the end (drag its yellow handle to make it longer)";
                                key: SoundEdit.fade-out-key;
                                enabled: root.on;
                                clicked => { SoundEdit.tool("sounds.editFadeOut"); }
                            }
                            JoinedKey {
                                tight: root.tight;
                                icon: Icons.reverse;
                                tip: SoundEdit.has-part ? "Play the part picked backwards" : "Play it backwards";
                                key: SoundEdit.reverse-key;
                                enabled: root.on;
                                clicked => { SoundEdit.tool("sounds.editReverse"); }
                            }
                            JoinedKey {
                                tight: root.tight;
                                icon: Icons.normalise;
                                tip: SoundEdit.too-loud ? "Normalise: it goes over full scale now, and this brings its loudest moment back to it" : "Normalise: its loudest moment at full scale";
                                key: SoundEdit.normalise-key;
                                enabled: root.on;
                                hot: root.on && SoundEdit.too-loud;
                                clicked => { SoundEdit.tool("sounds.editNormalise"); }
                            }
                            JoinedKey {
                                last: true;
                                tight: root.tight;
                                icon: Icons.crossfade;
                                tip: SoundEdit.has-part ? "Make the part picked loop without a click (it keeps only the loop)" : "Make it loop without a click";
                                key: SoundEdit.loop-key;
                                enabled: root.on;
                                clicked => { SoundEdit.tool("sounds.editLoop"); }
                            }
                        }
                        TempoStepper {
                            sunk: true;
                            warn: SoundEdit.too-loud;
                            bpm-text: SoundEdit.gain-text;
                            changed: SoundEdit.gain-changed;
                            enabled: root.on;
                            down-tip: SoundEdit.has-part ? "Turn the part picked down" : "Turn it down";
                            up-tip: SoundEdit.has-part ? "Turn the part picked up" : "Turn it up";
                            value-tip: SoundEdit.too-loud ? "Too loud: it goes over full scale" : "Half a dB a step";
                            reset-tip: "Back to no gain";
                            slower-key: SoundEdit.quieter-key;
                            faster-key: SoundEdit.louder-key;
                            stepped(by) => { SoundEdit.gain-stepped(by); }
                            reset => { SoundEdit.gain-reset(); }
                        }
                        JoinedKeys {
                            JoinedKey {
                                first: true;
                                last: true;
                                tight: root.tight;
                                icon: Icons.slices;
                                tip: "Slices: cut it at its hits for a drum machine's pads";
                                key: SoundEdit.slices-key;
                                enabled: root.on;
                                clicked => { SoundEdit.tool("sounds.editSlices"); }
                            }
                        }
                        // Waiting for the stretcher (the 1.1 plan's step 5): faint, with why in their tips.
                        if root.roomy: HorizontalLayout {
                            IconKey {
                                icon: Icons.tempo;
                                tip: "Tempo: once you've picked the stretcher by ear";
                                enabled: false;
                            }
                            IconKey {
                                icon: Icons.pitch;
                                tip: "Pitch: once you've picked the stretcher by ear";
                                enabled: false;
                            }
                            IconKey {
                                icon: Icons.tail;
                                tip: "Tail: once you've picked the stretcher by ear";
                                enabled: false;
                            }
                        }
                    }
                }
                // The Slices' choices: the Slices key, lit, to go back to the tools; then what the cuts go by, how big a
                // hit must be, and how far each slice runs.
                if SoundEdit.slicing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        height: Heights.button;
                        spacing: Space.sm;
                        JoinedKeys {
                            JoinedKey {
                                first: true;
                                last: true;
                                icon: Icons.slices;
                                text: "Slices";
                                lit: true;
                                tip: "Back to the edit's tools";
                                key: SoundEdit.slices-key;
                                clicked => { SoundEdit.tool("sounds.editSlices"); }
                            }
                        }
                        if root.one-row: SliceChoices {
                            track: root.track;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        height: Heights.button;
                        spacing: Space.sm;
                        HorizontalLayout {
                            IconKey {
                                tight: root.tight;
                                icon: Icons.undo;
                                tip: "Undo";
                                key: SoundEdit.undo-key;
                                enabled: SoundEdit.can-undo;
                                clicked => { SoundEdit.tool("sounds.editUndo"); }
                            }
                            IconKey {
                                tight: root.tight;
                                icon: Icons.redo;
                                tip: "Redo";
                                key: SoundEdit.redo-key;
                                enabled: SoundEdit.can-redo;
                                clicked => { SoundEdit.tool("sounds.editRedo"); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ABSwitch {
                                original: SoundEdit.original;
                                enabled: root.on;
                                tip: "Hold to hear the original (A); let go for the edit (B)";
                                key: SoundEdit.original-key;
                                held(down) => { SoundEdit.hear-original(down); }
                            }
                        }
                        if !root.tight: ToolsGap { }
                        HorizontalLayout {
                            IconKey {
                                tight: root.tight;
                                icon: Icons.whole;
                                tip: "See the whole sound";
                                enabled: SoundEdit.zoomed;
                                clicked => { SoundEdit.zoom(false); }
                            }
                            IconKey {
                                tight: root.tight;
                                icon: Icons.zoom;
                                tip: "Zoom in on the part picked";
                                enabled: SoundEdit.has-part && !SoundEdit.zoomed;
                                clicked => { SoundEdit.zoom(true); }
                            }
                            IconKey {
                                tight: root.tight;
                                icon: Icons.clear;
                                tip: "Close the Edit strip (your edits wait here until you come back)";
                                key: SoundEdit.edit-key;
                                clicked => { SoundEdit.close(); }
                            }
                        }
                    }
                }
            }
            // The Slices' choices on a row of their own, where the tools' row has no room for them.
            if tools-room.second: HorizontalLayout {
                x: 0px;
                y: 38px + Space.sm;
                width: parent.width;
                height: Heights.button;
                alignment: start;
                SliceChoices { }
            }
        }
        // The screen, and the level beside it; between them, with the Slices on, the pads. Placed by hand, as the row
        // of tools is, so that whether the pads show can go by how wide the strip is: they give way where the screen
        // would be left too narrow, or the row is too low for them.
        screen-row := Rectangle {
            property <bool> pads: SoundEdit.slicing && root.width >= 900px && self.height >= 128px;
            property <length> pads-wide: 200px;
            vertical-stretch: 1;
            min-height: 80px;
            EditScreen {
                x: 0px;
                y: 0px;
                width: max(0px, meter.x - Space.sm - (screen-row.pads ? screen-row.pads-wide + Space.sm : 0px));
                height: parent.height;
                on: root.on;
            }
            if screen-row.pads: PadGrid {
                x: meter.x - Space.sm - self.width;
                y: 0px;
                width: screen-row.pads-wide;
                height: parent.height;
                pads: SoundEdit.pads;
                picked: SoundEdit.slice-number;
                picks: SoundEdit.slice-picks;
                made: SoundEdit.pads-made;
                making: SoundEdit.pads-making;
                enabled: root.on;
                pressed(slice) => { SoundEdit.pad-pressed(slice); }
            }
            meter := LevelMeter {
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                left: SoundEdit.level-left;
                right: SoundEdit.level-right;
                left-hold: SoundEdit.hold-left;
                right-hold: SoundEdit.hold-right;
                amber-from: SoundEdit.meter-amber;
                over: SoundEdit.over;
                text: SoundEdit.peak-text;
                tip: SoundEdit.over
                    ? "It goes over full scale, by as much as the number says (dB): turn it down, or Normalise"
                    : "How loud it is as it plays. The number is its loudest moment, in dB under full scale";
            }
        }
        // The edits so far, how the last save went, and what to do with the edit (or the slices).
        HorizontalLayout {
            height: 36px;
            spacing: Space.sm;
            // The chips: when there are more than fit, the oldest run off the left (the newest is the one Undo takes
            // back), so a long list of edits never pushes the strip wider. They share what room there is with the
            // words about a save, in a small window. With the Slices on, the slice picked is named here instead, with
            // how long it is and its pad: as wide as those words (and a dot to spare, so no rounding cuts them
            // short), and in a small window a note beside it (a send that failed) is cut short before they are.
            Rectangle {
                horizontal-stretch: SoundEdit.slicing ? 0 : 1;
                min-width: 0px;
                preferred-width: SoundEdit.slicing ? foot-facts.x + foot-facts.preferred-width + 1px : 200px;
                clip: true;
                if !SoundEdit.slicing && SoundEdit.chips.length == 0: Text {
                    x: 0px;
                    y: 0px;
                    height: parent.height;
                    text: "No edits yet";
                    color: Theme.faint;
                    font-size: Type.meta;
                    vertical-alignment: center;
                }
                // The slice's name, then its facts, placed by hand so that neither is ever a stub of itself where
                // room is short: the facts are cut short first, and go when there's no room for the first of them
                // ("· 6.56 s…", "Pads C1…"); the name is there whole or not at all (the app's smallest window,
                // beside a send that failed, has no room for it).
                foot-name := Text {
                    x: 0px;
                    y: 0px;
                    height: parent.height;
                    visible: SoundEdit.slicing && parent.width >= self.preferred-width;
                    text: SoundEdit.slice-name;
                    color: Theme.text;
                    font-family: Theme.number-font;
                    font-size: Type.meta;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                foot-facts := Text {
                    x: SoundEdit.slice-name == "" ? 0px : foot-name.preferred-width + Space.sm;
                    y: 0px;
                    width: max(0px, parent.width - self.x);
                    height: parent.height;
                    visible: SoundEdit.slicing && self.width >= min(self.preferred-width, 80px);
                    text: (SoundEdit.slice-name != "" ? "\u{00b7} " : "") + SoundEdit.slice-facts;
                    color: SoundEdit.cuts.length == 0 ? Theme.faint : Theme.muted;
                    font-family: Theme.number-font;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !SoundEdit.slicing: HorizontalLayout {
                    x: min(0px, parent.width - self.width);
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: 26px;
                    spacing: Space.xs;
                    for c in SoundEdit.chips: Rectangle {
                        width: chip-text.preferred-width + 2 * Space.sm;
                        border-radius: self.height / 2;
                        border-width: 1px;
                        border-color: c.last ? Theme.accent.transparentize(30%) : Theme.stroke;
                        background: Theme.background;
                        chip-text := Text {
                            text: c.text;
                            color: c.last ? Theme.text : Theme.muted;
                            font-size: Type.meta;
                            font-family: Theme.number-font;
                        }
                    }
                }
            }
            if SoundEdit.save-note != "" && !SoundEdit.slicing: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                DoneNote {
                    text: SoundEdit.save-note;
                    detail: SoundEdit.save-detail;
                    failed: SoundEdit.save-failed;
                    tip: "Show the copy in its folder";
                    clicked => { SoundEdit.show-saved(); }
                }
            }
            // A send that failed: it gives way before the slice's name does, down to its first line ("Couldn't send
            // the slices").
            if SoundEdit.send-note != "" && SoundEdit.slicing: VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                DoneNote {
                    text: SoundEdit.send-note;
                    detail: SoundEdit.send-detail;
                    failed: true;
                    least: 180px;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                InfoTip {
                    text: SoundEdit.slicing
                        ? "A line at every cut: drag one to move it (it snaps to the hits; hold Shift for none), double-click one to take it away, or between two to add one. Click a slice to hear it, or drag it out on its own. The slices you send are saved in a folder of their own in " + SoundEdit.folder-text + "; the file on disk never changes."
                        : "The file on disk never changes: what you save or drag out is a copy in " + SoundEdit.folder-text + ". Your edits wait here " + SoundEdit.kept-while + ", sound by sound, until you come back to them.";
                }
            }
            // The drag handle: the edit's (or the part's); with the Slices on, the slice picked's, and it waits until
            // one is.
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                DragHandle {
                    width: 170px;
                    text: SoundEdit.drag-text;
                    tip: !SoundEdit.slicing ? "Drag it into your DAW or a folder, as edited: a copy in " + SoundEdit.folder-text
                        : SoundEdit.can-drag ? "Drag this slice into your DAW or a folder: a copy in " + SoundEdit.folder-text
                        : "Click a slice, or its pad, to pick it: then it can be dragged out from here";
                    lit: SoundEdit.slicing ? SoundEdit.can-drag : SoundEdit.has-edits;
                    draggable: SoundEdit.can-drag;
                    cursor: SoundEdit.can-drag ? MouseCursor.grab : MouseCursor.default;
                    lifted: SoundEdit.lifted;
                    landed: SoundEdit.landed;
                    drag-out => { SoundEdit.drag-handle(); }
                    drag-let-go => { SoundEdit.drag-let-go(); }
                }
            }
            if !SoundEdit.slicing: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                StudioButton {
                    width: 132px;
                    text: SoundEdit.save-text;
                    main: true;
                    done: SoundEdit.saved;
                    tip: "Save the sound as edited, a copy in " + SoundEdit.folder-text + " (the file itself never changes)";
                    key: SoundEdit.save-key;
                    enabled: root.on && SoundEdit.can-save;
                    clicked => { SoundEdit.tool("sounds.editSave"); }
                }
            }
            // Send: its menu opens above it (the strip is at the foot of the window), with the places the slices can
            // go (a Drum Machine in Bitwig, where that can be reached, and a folder of their own); and, under the Drum
            // Machine's line where the strip has no room for the pads themselves, the pad each one lands on (four
            // across, as a Drum Machine's page; eight for more than sixteen). While the slices are on their way the
            // button is a bar that counts them along; once they're there it says where, and a click sends them again.
            if SoundEdit.slicing: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                send := Rectangle {
                    property <bool> pads: !screen-row.pads && SoundEdit.can-bitwig;
                    property <int> across: SoundEdit.pads.length > 16 ? 8 : 4;
                    property <int> rows: ceil(SoundEdit.pads.length / self.across);
                    property <length> pad-width: 66px;
                    property <length> pad-height: 28px;
                    property <length> pads-height: self.pads ? self.rows * self.pad-height + Space.xs : 0px;
                    // As wide as its longest line and that line's key ("A Drum Machine in Bitwig, from C1", Alt+B).
                    property <length> menu-width: self.pads ? max(400px, self.across * self.pad-width + Space.xs + 2 * Space.sm) : 400px;
                    property <length> menu-height: 2 * Space.xs + 26px + (SoundEdit.can-bitwig ? 32px : 0px) + self.pads-height + 32px + 2px + 26px;
                    // As wide as Drag the edit whatever it says ("Send 9 slices", "Making 10 of 20"), so nothing beside
                    // it moves as the Sensitivity changes how many there are, or as a send counts along.
                    width: 170px;
                    height: Heights.button;
                    send-button := StudioButton {
                        width: parent.width;
                        visible: !SoundEdit.sending;
                        text: SoundEdit.send-text;
                        main: true;
                        menu: !SoundEdit.sent;
                        done: SoundEdit.sent;
                        tip: SoundEdit.sent ? "Click to send them again, or somewhere else"
                            : "Each slice becomes a file of its own, for a drum machine's pads";
                        enabled: root.on && SoundEdit.can-send;
                        clicked => { send-menu.show(); }
                    }
                    if SoundEdit.sending: CountingKey {
                        width: parent.width;
                        text: SoundEdit.send-text;
                        progress: SoundEdit.send-progress;
                    }
                    send-menu := PopupWindow {
                        x: send-button.width - send.menu-width;
                        y: -send.menu-height - Space.xs;
                        width: send.menu-width;
                        height: send.menu-height;
                        MenuCard {
                            HorizontalLayout {
                                padding-left: Space.md;
                                Caps {
                                    text: "SEND THE SLICES TO";
                                    height: 26px;
                                    vertical-alignment: center;
                                }
                            }
                            if SoundEdit.can-bitwig: MenuLine {
                                text: "A Drum Machine in Bitwig, from C1";
                                key: SoundEdit.bitwig-key;
                                clicked => { SoundEdit.tool("sounds.editSlicesBitwig"); }
                            }
                            if send.pads: Rectangle {
                                height: send.pads-height;
                                for note[i] in SoundEdit.pads: Rectangle {
                                    x: Space.sm + mod(i, send.across) * send.pad-width;
                                    y: floor(i / send.across) * send.pad-height;
                                    width: send.pad-width - Space.xs;
                                    height: send.pad-height - Space.xs;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.here-colour.transparentize(50%);
                                    background: Theme.here-colour.transparentize(90%);
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Space.xs;
                                        Text {
                                            text: i + 1;
                                            color: Theme.text;
                                            font-family: Theme.number-font;
                                            font-size: Type.meta;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: note;
                                            color: Theme.muted;
                                            font-family: Theme.number-font;
                                            font-size: Type.meta;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            MenuLine {
                                text: SoundEdit.to-folder-text;
                                key: SoundEdit.save-key;
                                clicked => { SoundEdit.tool("sounds.editSave"); }
                            }
                            Groove { }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                Text {
                                    text: SoundEdit.saved-in;
                                    color: Theme.faint;
                                    font-size: Type.meta;
                                    height: 26px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Its top edge, to drag it taller or shorter.
    RowSeam {
        x: 0;
        y: -self.height / 2;
        width: parent.width;
        part: root.part;
        now: root.height;
        most: max(Widths.least(root.part), min(Widths.most(root.part), root.most-height));
        resizing(h) => { Widths.sounds-edit = h; }
    }
}
