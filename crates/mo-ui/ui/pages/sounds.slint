// The Sounds page: every sound in your library as Tiles, a List, the History of what you played or Rediscover (unused
// sounds that fit your taste), with the type chips
// and filters over them and the picked sound's panel beside them. Agreed mock-up: the design canvas, 2026-11-01.
// The picked sound's card takes your say: a favourite, your own type and tags, kept in the app's own sound library.
import { ListView, Fit } from "../list.slint";
import { Theme, AppKeys, Type, Space, Well, StudioSlider, SearchBox, ToggleChip, MenuChip, FilterPicks, FilterView, FilterChoice, ListLine, DragHandle, Caps, ColumnHead, Heart, HeartToggle, TagChip, WordBox, PickButton, StudioButton, CloseButton, HoverNote, PointerPad, Segmented, MenuItem, MenuButton, CardAction, CardActions, RightClickMenu, SidePanel, PanelDivider, EmptyState, Waveform, Dot, PageHeader, LinkText, MapName, MapInset, YearRange, YearBar } from "../studio.slint";

// One tile: `row` is its place in the shown sounds, for picking it.
export struct SoundTile {
    row: int,
    name: string,
    facts: string,
    colour: int,
    favourite: bool,
    wave: string,
    points: int,
    picked: bool,
    playing: bool,
}

// One of the sounds like the picked one: `place` finds it in the library, `likeness` is "92%".
export struct AlikeLine {
    place: int,
    name: string,
    sound-type: string,
    colour: int,
    likeness: string,
}

// One sample folder on Rediscover, with how much of it your projects use: "12 of 340 used".
export struct FolderLine {
    folder: string,
    name: string,
    used: string,
}

// One pad of the kit builder: its name ("Kick"), and the sound on it with a line about it.
export struct PadLine {
    name: string,
    sound: string,
    detail: string,
    colour: int,
    filled: bool,
    locked: bool,
    picked: bool,
    playing: bool,
}

// One row of tiles, as many as fit the list's width.
export struct TileRow {
    tiles: [SoundTile],
}

// One line of the List and History views.
export struct SoundLine {
    row: int,
    name: string,
    sound-type: string,
    colour: int,
    key: string,
    bpm: string,
    length: string,
    used: string,
    // The same, in words that make sense without the Used column's name over them: "used in 12 projects".
    used-words: string,
    folder: string,
    // When it was played, on History.
    when: string,
    // Why it's suggested, on Rediscover.
    reason: string,
    favourite: bool,
    picked: bool,
    playing: bool,
}

// One fact under the picked sound's waveform ("Key", "Fm").
export struct SoundFact {
    name: string,
    value: string,
}

// The picked sound, for its panel.
// A name over the zoomed-out galaxy, like "KICK": (x, y) is the middle of its bottom edge on the view.
export struct GalaxyLabel {
    region: int,
    name: string,
    x: length,
    y: length,
    colour: int,
    fade: float,
}

// A sound the galaxy's sweep passed, newest first; `current` is the one Back and Next are on.
export struct SweptLine {
    name: string,
    kind: string,
    colour: int,
    current: bool,
    // The sound's place in the library, for a drag out of the app (as a "Sounds like this" line's).
    place: int,
}

// A swept star on the view, fainter the longer ago it was swept.
export struct TrailDot {
    x: length,
    y: length,
    fade: float,
}

// A project on the picked sound's card: its save's id (to open it on the Songs page), name, DAW and the day it was
// last saved.
export struct UsedInLine {
    id: int,
    name: string,
    daw: string,
    saved: string,
}

export struct PickedSound {
    name: string,
    sound-type: string,
    colour: int,
    // Where the type came from: "you set this", "from its name", "learned from your library".
    type-from: string,
    path: string,
    wave: string,
    points: int,
    // How long the waveform lasts (the analysis reads up to the first minute).
    seconds: float,
    facts: [SoundFact],
    favourite: bool,
    // Your own type for it ("" when you haven't given it one).
    own-type: string,
    // What the analysis says it sounds like ("punchy, bright").
    character: string,
    // The projects that use it, newest first (or, for a sound Rediscover dug out that none use, those of the sound it
    // sounds like), with the words on the card's switch ("Used in 4") and above the list.
    projects: [UsedInLine],
    projects-title: string,
    projects-note: string,
}

export global SoundsData {
    // Sounds like the picked one, most alike first, and a word while there are none to show.
    in property <[AlikeLine]> alike;
    in property <string> alike-note;
    // Which list the card shows under its switch: 0 the sounds like it, 1 the projects that use it. It stays as
    // picked from sound to sound.
    in-out property <int> card-list;
    // A project on the card's Used in list was clicked: it opens on the Songs page.
    callback open-project(int);
    callback pick-alike(int);
    callback play-alike(int);
    in property <string> summary;
    // The job working on the page (reading the library), and how far.
    in property <string> busy;
    in property <float> done;
    // Instead of the list, when there's nothing to show yet: why, and what to do.
    in property <string> empty-title;
    in property <string> empty-text;

    // 0 Tiles, 1 List, 2 Galaxy, 3 History, 4 Rediscover, 5 Kits.
    in property <[string]> views: ["Tiles", "List", "Galaxy", "History", "Rediscover", "Kits"];
    in property <int> view;
    callback pick-view(int);

    // Rediscover: what it digs out (type, years, how adventurous, how many) and whether sounds used once count. Each
    // choice is on show, as the filters' are (one type at most, the years on its year strip, one of the counts).
    in property <FilterView> re-type-filter;
    // Rediscover's own year strip (it picks its own years, apart from the filters'): as `years` and its span.
    in property <[YearBar]> re-years;
    in property <int> re-years-from: -1;
    in property <int> re-years-to: -1;
    callback re-years-picked(int, int);
    callback re-years-cleared();
    // 0 (close to what you use) to 1 (further afield).
    in-out property <float> re-adventure;
    callback re-adventure-set(float);
    in property <FilterView> re-count-filter;
    in property <bool> re-rarely;
    // "type" and the type clicked, which joins or leaves the ones picked as on the Type filter ("" is any type);
    // "more-types" for the More types menu's Any, which keeps the types picked on their chips; or "count" and how many.
    callback re-pick(string, string);
    // Whether Rediscover has a type picked, for its Clear types chip.
    in property <bool> re-any-type;
    callback re-toggle-rarely();
    callback re-shuffle();
    in property <bool> re-busy;
    // What it learned your taste from, over the list; and instead of the list when there's nothing.
    in property <string> re-intro;
    in property <string> re-empty-title;
    in property <string> re-empty-text;
    // Sample folders by how little of them your projects use; a click lists that folder's sounds.
    in property <[FolderLine]> folders;
    callback pick-folder(string);

    // The galaxy: the stars drawn, a word while there's no map, and what the stars are placed by.
    in property <image> galaxy-image;
    // Where the picture sits on the view: moved and stretched at once while the next one is drawn.
    in property <length> galaxy-image-x;
    in property <length> galaxy-image-y;
    in property <length> galaxy-image-width;
    in property <length> galaxy-image-height;
    in property <string> galaxy-note;
    in property <bool> galaxy-busy;
    // What the stars are placed by, each choice on show.
    in property <FilterView> placing-filter;
    callback galaxy-place-by(string);
    // The year strip beside the list: each year with how much is in it; drag over years to show only those.
    in property <[YearBar]> years;
    // The places in `years` of the first and last years picked, top first (-1 when none are).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    // What makes a star bigger and brighter, each choice on show.
    in property <FilterView> light-filter;
    callback galaxy-light-by(string);
    // How long each star a sweep reaches plays, each choice on show.
    in property <FilterView> sweep-play-filter;
    callback galaxy-sweep-plays(string);
    callback galaxy-lay-out();
    callback galaxy-reset();
    // The view's size, and the mouse on it: a left drag plays each star it passes, a right or middle drag moves the
    // map, a click picks the star under the mouse and a double-click plays it, the wheel zooms round the mouse by
    // notches.
    callback galaxy-resized(length, length);
    // A press: the left button sweeps (plays each star it passes), the right or middle button moves the map.
    callback galaxy-down(length, length, bool);
    callback galaxy-move(length, length);
    // Where the view is in the window, set at each press: a sweep that holds the pointer puts it back on a star.
    in-out property <length> galaxy-sky-x;
    in-out property <length> galaxy-sky-y;
    // A button came up: the right or middle one (true), or the left one.
    callback galaxy-up(bool);
    callback galaxy-cancelled();
    callback galaxy-double();
    callback galaxy-wheel(float);
    callback galaxy-gone();
    in property <bool> galaxy-grabbing;
    in property <length> galaxy-mouse-x;
    in property <length> galaxy-mouse-y;
    in property <string> galaxy-hover-text;
    // The faint ring round the star under the mouse: the one a click picks.
    in property <bool> galaxy-hover-shown;
    in property <length> galaxy-hover-x;
    in property <length> galaxy-hover-y;
    // The ring round the picked star.
    // The zoomed-out names (a click flies into its cloud), the sweep's trail as a line through the swept stars
    // (path commands in points), its dots, and the Swept card's lines (a click goes to one; Back and Next step by one).
    in property <[GalaxyLabel]> galaxy-labels;
    callback galaxy-label(int);
    in property <string> galaxy-trail;
    in property <[TrailDot]> galaxy-trail-dots;
    in property <[SweptLine]> galaxy-swept;
    callback galaxy-swept-go(int);
    callback galaxy-swept-step(int);
    // The Swept card was clicked into: Up and Down go through its sounds until the map is clicked (or Left or Right).
    in-out property <bool> galaxy-swept-keys;
    callback galaxy-swept-clear();
    // The mini-map, once the view has flown in: the whole map, the part on show, and a line above it.
    in property <bool> galaxy-mini-shown;
    in property <image> galaxy-mini-image;
    in property <string> galaxy-mini-title;
    in property <float> galaxy-mini-x;
    in property <float> galaxy-mini-y;
    in property <float> galaxy-mini-width;
    in property <float> galaxy-mini-height;
    callback galaxy-mini(float, float);
    in property <bool> galaxy-picked-shown;
    in property <length> galaxy-picked-x;
    in property <length> galaxy-picked-y;

    // The kit builder: its pads, and how it rolls, exports and goes to Bitwig.
    in property <[PadLine]> pads;
    in property <string> kit-status;
    in property <bool> kit-busy;
    // The kit is on its way to Bitwig.
    in property <bool> kit-sending;
    // The kit is being copied into its folder.
    in property <bool> kit-exporting;
    // "unused", "pack", "elektron", "mono" or "normalise", and whether each is on.
    callback kit-toggle(string);
    in property <bool> kit-unused;
    in property <bool> kit-pack;
    in property <bool> kit-elektron;
    in property <bool> kit-mono;
    in property <bool> kit-normalise;
    // "key", and the value ("" for any key).
    callback kit-choose(string, string);
    in property <string> kit-key;
    in property <[string]> kit-keys;
    // 0 (the best fits) to 1 (anything that fits).
    in-out property <float> kit-randomness;
    callback kit-randomness-set(float);
    // The sound types a pad can be added for, as the "Add a pad" menu lists them (each one's id is its type).
    in property <[MenuItem]> kit-types;
    callback kit-add(string);
    callback kit-roll();
    callback kit-export();
    callback kit-to-bitwig();
    // A pad, by its place: pick its sound, play it, lock it, roll it again or take it out.
    callback pad-pick(int);
    callback pad-play(int);
    callback pad-lock(int);
    callback pad-roll(int);
    callback pad-remove(int);

    in-out property <string> search;
    callback search-edited(string);
    // The filters, the same as on every page: the types (the most used as chips, the rest in More types), hits or
    // loops, the key, the tempo and the tags, each choice with how many sounds it would show.
    in property <FilterView> type-filter;
    in property <FilterView> length-filter;
    in property <FilterView> key-filter;
    in property <FilterView> tempo-filter;
    in property <FilterView> tag-filter;
    // A choice was picked or unpicked: the filter ("type", "length", "key", "tempo" or "tag") and the choice's words.
    callback toggle-choice(string, string);
    // Picks nothing on a filter: "type" (Clear types), "more-types" (the More types menu's Any) or another filter.
    callback clear-chip(string);
    // Whether any type is picked: shows the Clear types chip.
    in property <bool> any-type;
    in property <bool> mix-well;
    // The picked sound's tags, each lit while the Tag filter has it: a click picks or unpicks it there.
    in property <[FilterChoice]> picked-tags;
    in property <bool> unused;
    in property <bool> used;
    // The use counts are in, so the Used and Unused chips can work.
    in property <bool> knows-use;
    in property <bool> favourites;
    // Hide duplicates: on, and its words with how many copies it hides (or how far finding them has got).
    in property <bool> hide-copies;
    in property <string> hide-copies-text: "Hide duplicates";
    // The forgotten folder clicked on Rediscover that the list is narrowed to (its own sounds), or none.
    in property <string> folder;
    in property <bool> any-filter;
    // "mix-well", "unused", "used", "favourites", "hide-copies" or "folder".
    callback toggle(string);
    callback clear();

    // The order Tiles and List are in, each on show (one is always picked).
    in property <FilterView> order-filter;
    callback pick-order(string);
    // The List view's column the list goes by, as its heading says it ("" for an order no column stands for), whether
    // that order is turned round, and a click on a heading (its words).
    in property <string> order-column;
    in property <bool> order-reversed;
    callback order-by-column(string);
    callback shuffle();
    in property <bool> autoplay;
    callback toggle-autoplay();

    // How many sounds are shown, for the list's empty state.
    in property <int> shown;
    in property <[TileRow]> tile-rows;
    in property <[SoundLine]> lines;
    // How many tiles fit side by side; the page says when that changes.
    callback columns-changed(int);
    // The place of the picked sound's line or tile row, to bring it into view, and a count that changes each time.
    in property <int> show-row;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    // The tiles or the lines were made afresh (the view switched between them, say): the page brings the picked sound
    // into view in them once they're laid out.
    callback list-made();

    callback select(int);
    callback play-row(int);
    // Dragging a sound out of the app, to a DAW or a folder (mo-ui's sounds/drag_out.rs): a tile or a line by its row,
    // a pad by its place, a "Sounds like this" or a Galaxy's swept line by its sound's place in the library, or the
    // picked sound by its card's handle; then `drag-let-go` if the button comes up before the drag has got going. The
    // one carried is dimmed (`lifted-…`) and glows for a moment once it has landed (`landed-…`); -1 for none.
    callback drag-row(int);
    callback drag-pad(int);
    callback drag-alike(int);
    callback drag-picked();
    callback drag-let-go();
    in property <bool> lifted-picked;
    in property <bool> landed-picked;
    in property <int> lifted-row: -1;
    in property <int> landed-row: -1;
    in property <int> lifted-pad: -1;
    in property <int> landed-pad: -1;
    in property <int> lifted-alike: -1;
    in property <int> landed-alike: -1;
    // Arrow keys: -1 or 1 across, -2 or 2 up and down.
    // Moves the pick: -1/1 left and right, -2/2 up and down; `held` when it's the key repeating.
    callback step(int, bool);

    in property <bool> panel-shown;
    in property <PickedSound> picked;
    in property <bool> playing;
    // How much of the picked sound has played, from 0 to 1.
    in property <float> played;
    in-out property <length> panel-width: 400px;
    callback panel-resized(length);
    callback play();
    callback seek(float);
    callback close-panel();
    // The picked sound's right-click menu, and what was chosen (from it or a button on the card).
    in property <[MenuItem]> menu;
    callback menu-chosen(string);
    // The same, as the card's buttons after Play.
    in property <[CardAction]> actions;
    in property <string> play-tip;
    in property <string> play-key;
    // Your say about the picked sound: a favourite or not, your own type for it ("" takes yours away), and a tag added
    // or taken away. Each is kept in the app's own sound library, and shows at once.
    callback toggle-favourite();
    callback set-type(string);
    callback add-tag(string);
    callback remove-tag(string);
    // The types you can give a sound, and the keys of Favourite and Add a tag from the shortcut list (rule 15), with
    // what Add a tag does, for the tag box's tooltip.
    in property <[string]> type-choices;
    in property <string> favourite-key;
    in property <string> tag-key;
    in property <string> tag-tip;
    // Changes each time Add a tag's key is pressed: the card's tag box takes the keys.
    in property <int> tag-asked;
}

// A tile's width at least; as many as fit go in a row.
global TileSize {
    out property <length> width: 200px;
    out property <length> height: 112px;
}

// Where the tiles are on show, for the graphics card's picture of them (`TileGrid`), in the window's points: the list's
// top (0 or less as it scrolls), the room on show (the well the list is in), the tiles in a row, a tile's size, the gap
// around them and the room inside one, the height of its first line (the name, with its dot and heart) and its
// waveform's place down it; and how far past a whole pixel the picture's corner sits, across and down (0 to 1), with
// pixels to a point.
export struct TileGridAt {
    top: float,
    width: float,
    height: float,
    columns: int,
    tile-width: float,
    tile-height: float,
    gap: float,
    inside: float,
    name-height: float,
    wave-top: float,
    wave-height: float,
    over-x: float,
    over-y: float,
    scale: float,
}

// The look's colours a tile is drawn in, and its corners' radius in points.
export struct TileLook {
    radius: float,
    background: color,
    well: color,
    surface: color,
    raised: color,
    edge: color,
    accent: color,
}

// The tiles' shapes on the graphics card (mo-ui's sounds/grid.rs): the well they're in, and every tile's background,
// edge, dot and waveform, drawn as one picture of the tiles on show, under the window's own words (one picture draws
// much faster than the window's hundreds of shapes). An empty picture where there's no card (the
// screenshots, an old driver, MO_DRAW_CPU): each tile then draws its shapes itself. `asked` changes when the tiles or
// the card do, so the picture is drawn again.
export global TileGrid {
    in-out property <int> asked;
    pure callback picture(TileGridAt, TileLook, int) -> image;
}

// A tile. Its parts sit at places worked out once for all the tiles (`name-height`, `wave-top`, `wave-height`), which
// the graphics card's picture of them uses too.
component SoundTileView inherits Rectangle {
    in property <SoundTile> tile;
    in property <length> name-height;
    in property <length> facts-height;
    in property <length> wave-top;
    in property <length> wave-height;
    // Whether the grid's picture under the tile draws its shapes; the tile then shows only its words and its heart, and
    // its other parts only while it plays or is under the mouse.
    in property <bool> on-card;
    // A click on it, so the page can take the keys (arrows, Space) from the search box.
    callback chosen();
    callback right-clicked(length, length);
    height: TileSize.height;
    border-radius: Theme.radius;
    border-width: root.on-card ? 0 : 1px;
    border-color: root.on-card ? transparent : tile.picked ? Theme.accent : Theme.edge;
    background: root.on-card ? transparent : tile.picked ? Theme.surface-raised : Theme.surface;
    // The first line's height: the name, or the heart beside it if that were taller.
    property <length> line-height: max(root.name-height, 10px);
    // Drawn by the window, not the picture: off the card, and on the card while the tile plays or is under the mouse,
    // whose shade covers what the picture drew of it.
    property <bool> itself: !root.on-card || root.tile.playing || line.hovered;
    // Dimmed as a whole while it's dragged out. With the tiles' picture on the graphics card, only what the tile draws
    // itself (its words, its heart) dims for now: the picture doesn't know the lifted row yet.
    opacity: root.tile.row == SoundsData.lifted-row ? 0.4 : 1;
    line := ListLine {
        selected: false;
        draggable: true;
        landed: root.tile.row == SoundsData.landed-row;
        drag-out => { SoundsData.drag-row(root.tile.row); }
        drag-let-go => { SoundsData.drag-let-go(); }
        clicked => {
            root.chosen();
            SoundsData.select(root.tile.row);
        }
        double-clicked => { SoundsData.play-row(root.tile.row); }
        right-clicked(x, y) => { root.right-clicked(x, y); }
        if root.itself: Dot {
            x: Space.md;
            y: Space.md + (root.line-height - self.height) / 2;
            tint: Theme.sound-type(root.tile.colour);
        }
        Text {
            x: Space.md + 8px + Space.sm;
            y: Space.md;
            width: root.width - 2 * Space.md - 8px - Space.sm - (root.tile.favourite ? Space.sm + 11px : 0);
            height: root.name-height;
            text: root.tile.name;
            color: Theme.text;
            font-size: Type.body;
            font-weight: 600;
            overflow: elide;
        }
        if root.tile.favourite: Heart {
            x: root.width - Space.md - self.width;
            y: Space.md + (root.line-height - self.height) / 2;
        }
        Text {
            x: Space.md;
            y: Space.md + root.line-height + Space.xs;
            width: root.width - 2 * Space.md;
            height: root.facts-height;
            text: root.tile.facts;
            color: Theme.muted;
            font-size: Type.meta;
            overflow: elide;
        }
        if root.itself: Waveform {
            x: Space.md;
            y: root.wave-top;
            width: root.width - 2 * Space.md;
            height: root.wave-height;
            shape: root.tile.wave;
            points: root.tile.points;
            tint: Theme.sound-type(root.tile.colour);
            playing: root.tile.playing;
            played: root.tile.playing ? SoundsData.played : 1;
        }
    }
}

// A sound's name in a list line, lit while it plays, with a heart after it when it's a favourite. Its room starts from
// nothing and stretches, so every line splits the room the same way.
component SoundName inherits HorizontalLayout {
    in property <SoundLine> line;
    preferred-width: 0px;
    min-width: 0px;
    spacing: Space.sm;
    Text {
        horizontal-stretch: 1;
        preferred-width: 0px;
        min-width: 0px;
        text: root.line.name;
        color: root.line.playing ? Theme.accent : Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.line.favourite: VerticalLayout {
        alignment: center;
        Heart { }
    }
}

// The List, History and Rediscover views' line. In a narrow list (`narrow`) it takes two lines, its name and length
// over the rest, because the columns alone (about 510 px) are wider than the list there and the name had no room.
component SoundLineView inherits ListLine {
    in property <SoundLine> line;
    in property <bool> history;
    in property <bool> rediscover;
    in property <bool> narrow;
    // A click on it, so the page can take the keys (arrows, Space) from the search box.
    callback chosen();
    // Its columns after the name, one after another for a narrow list's second line, the empty ones left out, in
    // words that make sense without the columns' names over them: "Bass · Am · 140 BPM · played Tue · from Loops".
    // On Rediscover its reason comes first, as it's why the sound is there, so the line is cut short after it.
    property <string> facts: root.rediscover ? root.then(root.line.reason, root.about)
        : root.then(root.then(root.about, root.history ? root.labelled("played", root.line.when) : root.line.used-words),
            root.labelled("from", root.line.folder));
    // What it is: its type, key and tempo.
    property <string> about: root.then(root.then(root.line.sound-type, root.line.key), root.line.bpm);
    pure function then(first: string, next: string) -> string {
        return first == "" ? next : next == "" ? first : first + " · " + next;
    }
    pure function labelled(word: string, value: string) -> string {
        return value == "" ? "" : word + " " + value;
    }
    selected: line.picked;
    draggable: true;
    lifted: root.line.row == SoundsData.lifted-row;
    landed: root.line.row == SoundsData.landed-row;
    drag-out => { SoundsData.drag-row(root.line.row); }
    drag-let-go => { SoundsData.drag-let-go(); }
    clicked => {
        root.chosen();
        SoundsData.select(root.line.row);
    }
    double-clicked => { SoundsData.play-row(root.line.row); }
    if !root.narrow: HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        VerticalLayout {
            alignment: center;
            Dot { tint: Theme.sound-type(root.line.colour); }
        }
        // Columns that stretch start from no width, so every line splits the room the same way.
        SoundName {
            horizontal-stretch: 2;
            line: root.line;
        }
        Text {
            width: 110px;
            text: root.line.sound-type;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 52px;
            text: root.line.key;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        Text {
            width: 80px;
            text: root.line.bpm;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        Text {
            width: 56px;
            text: root.line.length;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // Rediscover's reasons say how it's used already.
        Text {
            width: root.rediscover ? 0 : 96px;
            text: root.rediscover ? "" : root.history ? root.line.when : root.line.used;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            horizontal-stretch: root.rediscover ? 3 : 1;
            preferred-width: 0px;
            min-width: 0px;
            text: root.rediscover ? root.line.reason : root.line.folder;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.narrow: VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                alignment: center;
                Dot { tint: Theme.sound-type(root.line.colour); }
            }
            SoundName {
                horizontal-stretch: 1;
                line: root.line;
            }
            Text {
                width: 56px;
                text: root.line.length;
                color: Theme.muted;
                font-family: Theme.number-font;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        // Under the name: past the dot and the room after it, as the line above has.
        HorizontalLayout {
            spacing: Space.md;
            Rectangle { width: 8px; }
            Text {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                text: root.facts;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
        }
    }
}

// The List, History and Rediscover views' column names; in a narrow list, those of a line's first line.
component ListHeading inherits HorizontalLayout {
    in property <bool> history;
    in property <bool> rediscover;
    in property <bool> narrow;
    // The plain List: a click on Sound, Type or Key orders it, a second click turns it round. History and Rediscover
    // have their own order.
    property <bool> orders: !root.history && !root.rediscover;
    padding-left: Space.md + Space.xs;
    padding-right: Space.md + Space.xs;
    spacing: Space.md;
    height: 28px;
    Rectangle { width: 8px; }
    ColumnHead {
        horizontal-stretch: 2;
        preferred-width: 0px;
        min-width: 0px;
        text: "SOUND";
        can-order: root.orders;
        on: root.orders && SoundsData.order-column == "Sound";
        // A to Z, or round the keys from C, first.
        up: !SoundsData.order-reversed;
        clicked => { SoundsData.order-by-column("Sound"); }
    }
    if !root.narrow: ColumnHead {
        width: 110px;
        text: "TYPE";
        can-order: root.orders;
        on: root.orders && SoundsData.order-column == "Type";
        // A to Z, or round the keys from C, first.
        up: !SoundsData.order-reversed;
        clicked => { SoundsData.order-by-column("Type"); }
    }
    if !root.narrow: ColumnHead {
        width: 52px;
        text: "KEY";
        can-order: root.orders;
        on: root.orders && SoundsData.order-column == "Key";
        // A to Z, or round the keys from C, first.
        up: !SoundsData.order-reversed;
        clicked => { SoundsData.order-by-column("Key"); }
    }
    if !root.narrow: Caps {
        width: 80px;
        text: "TEMPO";
        vertical-alignment: center;
    }
    Caps {
        width: 56px;
        text: "LENGTH";
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    if !root.narrow: Caps {
        width: root.rediscover ? 0 : 96px;
        text: root.rediscover ? "" : root.history ? "PLAYED" : SoundsData.knows-use ? "USED" : "";
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    if !root.narrow: Caps {
        horizontal-stretch: root.rediscover ? 3 : 1;
        preferred-width: 0px;
        min-width: 0px;
        text: root.rediscover ? "WHY" : "FOLDER";
        vertical-alignment: center;
    }
}

// One pad of the kit builder. In a narrow list the pad's name goes before its sound's, rather than in a column of its
// own, so the sound keeps room for its name (it was cut to two letters in a 900 px window).
component PadLineView inherits ListLine {
    in property <PadLine> pad;
    in property <int> place;
    callback chosen();
    // Where the names' column would leave the sound under about 140 px. The line is as wide as the list, whatever is
    // in it, so this doesn't depend on itself.
    property <bool> narrow: root.width < 520px;
    height: 52px;
    selected: pad.picked;
    // An empty pad has nothing to drag.
    draggable: pad.filled;
    lifted: root.place == SoundsData.lifted-pad;
    landed: root.place == SoundsData.landed-pad;
    drag-out => { SoundsData.drag-pad(root.place); }
    drag-let-go => { SoundsData.drag-let-go(); }
    clicked => {
        root.chosen();
        SoundsData.pad-pick(root.place);
    }
    double-clicked => { SoundsData.pad-play(root.place); }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        if !root.narrow: Text {
            width: 120px;
            text: root.pad.name;
            color: Theme.text;
            font-size: Type.body;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Dot { tint: root.pad.filled ? Theme.sound-type(root.pad.colour) : Theme.edge; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            alignment: center;
            HorizontalLayout {
                spacing: Space.sm;
                // Never wider than the names' column in a wide list, so a long name can't squeeze the sound out.
                if root.narrow: Text {
                    max-width: 120px;
                    text: root.pad.name;
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.pad.sound;
                    color: root.pad.playing ? Theme.accent : root.pad.filled ? Theme.text : Theme.muted;
                    font-size: Type.body;
                    overflow: elide;
                }
            }
            Text {
                text: root.pad.detail;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            ToggleChip {
                text: "Lock";
                on: root.pad.locked;
                clicked => { SoundsData.pad-lock(root.place); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            StudioButton {
                horizontal-stretch: 0;
                text: "Re-roll";
                tip: "A new sound for just this pad";
                clicked => { SoundsData.pad-roll(root.place); }
            }
        }
        VerticalLayout {
            alignment: center;
            CloseButton {
                clicked => { SoundsData.pad-remove(root.place); }
            }
        }
    }
}

// Rediscover's forgotten folders, beside its list.
component FoldersCard inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    VerticalLayout {
        padding: Space.lg;
        spacing: Space.sm;
        Caps { text: "FORGOTTEN FOLDERS"; }
        Text {
            text: "Sample folders by how little of them your projects use. Click one to list its sounds.";
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        ListView {
            vertical-stretch: 1;
            for f in SoundsData.folders: ListLine {
                height: 44px;
                tip: f.folder;
                clicked => { SoundsData.pick-folder(f.folder); }
                VerticalLayout {
                    width: 100%;
                    padding-left: Space.sm;
                    padding-right: Space.sm;
                    alignment: center;
                    Text {
                        text: f.name;
                        color: Theme.text;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                    Text {
                        text: f.used;
                        color: Theme.muted;
                        font-size: Type.meta;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// The picked sound: what it is, its waveform (click to play from there), Play and what else it can do, its facts and
// tags. Nothing in it may be wider than the card: long names and paths wrap, and so do the buttons and tags.
component SoundPanel inherits SidePanel {
    close => { SoundsData.close-panel(); }
    // Whether the tag box has the keys: when the card closes with them, the page gives them back to its list.
    in-out property <bool> tag-keys;
    HorizontalLayout {
        spacing: Space.sm;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Dot { tint: Theme.sound-type(SoundsData.picked.colour); }
        }
        Text {
            text: SoundsData.picked.sound-type;
            color: Theme.sound-type(SoundsData.picked.colour);
            font-size: Type.meta;
            font-weight: 600;
        }
        Text {
            text: SoundsData.picked.type-from;
            color: Theme.muted;
            font-size: Type.meta;
        }
    }
    HorizontalLayout {
        spacing: Space.sm;
        // A name with no spaces breaks where it must, rather than making the card wider.
        Text {
            text: SoundsData.picked.name;
            color: Theme.text;
            font-family: Theme.title-font;
            font-size: Type.panel-title;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-stretch: 1;
            min-width: 0px;
        }
        VerticalLayout {
            alignment: start;
            HeartToggle {
                on: SoundsData.picked.favourite;
                tip: SoundsData.picked.favourite ? "A favourite: click to make it not one" : "Make it a favourite";
                key: SoundsData.favourite-key;
                clicked => { SoundsData.toggle-favourite(); }
            }
        }
    }
    // The path breaks after its slashes (the Rust side marks them), or anywhere in a folder name too long for a line.
    Text {
        text: SoundsData.picked.path;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    Well {
        height: 88px;
        Waveform {
            x: Space.sm;
            width: parent.width - 2 * Space.sm;
            shape: SoundsData.picked.wave;
            points: SoundsData.picked.points;
            tint: Theme.sound-type(SoundsData.picked.colour);
            playing: SoundsData.playing;
            played: SoundsData.playing ? SoundsData.played : 1;
            seconds: SoundsData.picked.seconds;
            can-seek: true;
            seek(at) => { SoundsData.seek(at); }
        }
    }
    // Where to take the sound from to drag it into a DAW or a folder: a handle of its own, as a click on the waveform
    // seeks there (Solomon's F12 note, 5 Nov 2026: the card had no plain place to drag it from).
    DragHandle {
        text: "Drag into your DAW or a folder";
        tip: "Drag the sound out as its own file, where it is on disk";
        lifted: SoundsData.lifted-picked;
        landed: SoundsData.landed-picked;
        drag-out => { SoundsData.drag-picked(); }
        drag-let-go => { SoundsData.drag-let-go(); }
    }
    // Every card's buttons: the lit one first, in even columns (the UX review of 10 Nov, B2).
    buttons := CardActions {
        room: root.inside;
        actions: SoundsData.actions;
        chosen(id) => { SoundsData.menu-chosen(id); }
        StudioButton {
            width: max(self.min-width, buttons.cell);
            text: SoundsData.playing ? "Stop" : "Play";
            main: true;
            tip: SoundsData.play-tip;
            key: SoundsData.play-key;
            clicked => { SoundsData.play(); }
        }
    }
    // Your own type for it: a button, not a filter's chip, as giving it a type filters nothing.
    HorizontalLayout {
        alignment: start;
        PickButton {
            name: "Your type";
            value: SoundsData.picked.own-type;
            none-text: "None of yours: its name's type";
            choices: SoundsData.type-choices;
            picked(t) => { SoundsData.set-type(t); }
        }
    }
    // In a narrow panel the facts wrap onto a second line, rather than run past its edge.
    FlexboxLayout {
        alignment: stretch;
        spacing-horizontal: Space.md;
        spacing-vertical: Space.sm;
        for f in SoundsData.picked.facts: VerticalLayout {
            spacing: Space.xs;
            horizontal-stretch: 1;
            Caps { text: f.name; }
            Text {
                text: f.value;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.meta;
            }
        }
    }
    if SoundsData.picked.character != "": Text {
        text: SoundsData.picked.character;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    // Its tags (a click picks or unpicks one on the Tag filter, its × takes it away) and a box to add one.
    VerticalLayout {
        spacing: Space.xs;
        Caps { text: "TAGS"; }
        FlexboxLayout {
            spacing: Space.xs;
            for t in SoundsData.picked-tags: TagChip {
                text: t.text;
                on: t.on;
                remove-tip: "Take the tag " + t.text + " away from this sound";
                clicked => { SoundsData.toggle-choice("tag", t.text); }
                removed => { SoundsData.remove-tag(t.text); }
            }
            tag-box := WordBox {
                width: 180px;
                hint: "Add a tag";
                tip: SoundsData.tag-tip;
                key: SoundsData.tag-key;
                // Not while another app's window is in front: the box gets them back with the window.
                changed has-keys => {
                    if (self.has-keys || AppKeys.window-active) {
                        root.tag-keys = self.has-keys;
                    }
                }
                accepted(text) => {
                    SoundsData.add-tag(text);
                    self.text = "";
                }
            }
        }
    }
    property <int> tag-asked: SoundsData.tag-asked;
    changed tag-asked => { tag-box.focus-all(); }
    // The tag box keeps the keys when the tags added push it down the card, out of sight (they wrap onto another line,
    // or the filter rows over the card do and the card gets shorter): Slint takes the keys from a part out of sight at
    // the next key, even Enter's own release, and then nothing had them. The card scrolls after the box as it moves in
    // the card or the card's height changes, never as the card is scrolled. Asked only while the box has the keys.
    property <length> tag-box-at: tag-box.has-keys ? root.held-at(tag-box.absolute-position.y) : 0px;
    changed tag-box-at => { root.keep-tag-box(); }
    changed height => { root.keep-tag-box(); }
    function keep-tag-box() {
        if (tag-box.has-keys) {
            root.reveal(tag-box.absolute-position.y, tag-box.absolute-position.y + tag-box.height);
        }
    }
    VerticalLayout {
        spacing: Space.xs;
        // The sounds like it, or the projects that use it: one switch, as the card has room for one list (Solomon's
        // F12 note, 5 Nov 2026: "a list of projects used in ... on the card somewhere you can switch to see").
        HorizontalLayout {
            alignment: start;
            Segmented {
                choices: ["Sounds like this", SoundsData.picked.projects-title];
                current: SoundsData.card-list;
                picked(i) => { SoundsData.card-list = i; }
            }
        }
        if SoundsData.card-list == 0 && SoundsData.alike-note != "": Text {
            width: root.inside;
            text: SoundsData.alike-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        if SoundsData.card-list == 0: VerticalLayout {
            spacing: Space.xs;
            for a in SoundsData.alike: ListLine {
                height: 28px;
                draggable: true;
                lifted: a.place == SoundsData.lifted-alike;
                landed: a.place == SoundsData.landed-alike;
                drag-out => { SoundsData.drag-alike(a.place); }
                drag-let-go => { SoundsData.drag-let-go(); }
                clicked => { SoundsData.pick-alike(a.place); }
                double-clicked => { SoundsData.play-alike(a.place); }
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: Space.sm;
                    padding-right: Space.sm;
                    spacing: Space.sm;
                    VerticalLayout {
                        alignment: center;
                        Dot { tint: Theme.sound-type(a.colour); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        text: a.name;
                        color: Theme.text;
                        font-size: Type.meta;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: a.sound-type;
                        color: Theme.muted;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 36px;
                        text: a.likeness;
                        color: Theme.muted;
                        font-family: Theme.number-font;
                        font-size: Type.meta;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
        if SoundsData.card-list == 1 && SoundsData.picked.projects-note != "": Text {
            width: root.inside;
            text: SoundsData.picked.projects-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        if SoundsData.card-list == 1: VerticalLayout {
            spacing: Space.xs;
            for u in SoundsData.picked.projects: ListLine {
                height: 28px;
                tip: "Open it on the Songs page";
                clicked => { SoundsData.open-project(u.id); }
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: Space.sm;
                    padding-right: Space.sm;
                    spacing: Space.sm;
                    VerticalLayout {
                        alignment: center;
                        Dot { tint: Theme.daw(u.daw); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        text: u.name;
                        color: Theme.text;
                        font-size: Type.meta;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: u.saved;
                        color: Theme.muted;
                        font-family: Theme.number-font;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component SoundsPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }
    // The card's tag box had the keys (Ctrl+T, or a click in it) as the card closed: the box went with the card, and
    // then nothing had the keys, so no key worked until a click (the whole-app review of 10 Nov, U-1). They come back
    // to the list. Only then: a card closed by a read meanwhile leaves them where they are (in the search, say).
    property <bool> card-keys;
    property <bool> card-shown: SoundsData.panel-shown;
    changed card-shown => {
        if (!self.card-shown && self.card-keys) {
            self.card-keys = false;
            keys.focus();
        }
    }

    VerticalLayout {
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        PageHeader {
            title: "Sounds";
            summary: SoundsData.summary;
            busy: SoundsData.busy;
            done: SoundsData.done;
        }
        // The views, the search and Autoplay, in every page's order (the UX review of 10 Nov, A5). They wrap onto another line when there isn't room (a narrow window), so
        // nothing runs off the page and the rows under them wrap too.
        FlexboxLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            VerticalLayout {
                alignment: center;
                Segmented {
                    choices: SoundsData.views;
                    current: SoundsData.view;
                    picked(i) => { SoundsData.pick-view(i); }
                }
            }
            search-box := SearchBox {
                // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and
                // Ctrl+Down step through the list from here.
                page-search: true;
                // Wide enough for its hint, whatever else the row holds (it showed cut short on Tiles and List).
                min-width: 320px;
                preferred-width: 400px;
                hint: "Search names, types, tags and folders";
                text <=> SoundsData.search;
                edited(t) => { SoundsData.search-edited(t); }
                key(k) => {
                    if (k == Key.DownArrow) {
                        keys.focus();
                        SoundsData.step(2, false);
                        return true;
                    }
                    false
                }
            }
            VerticalLayout {
                alignment: center;
                ToggleChip {
                    text: "Autoplay";
                    on: SoundsData.autoplay;
                    clicked => { SoundsData.toggle-autoplay(); }
                }
            }
        }
        // Each view's own choices, every one on show rather than in a menu (Solomon, 4 Nov 2026: "makes sure things
        // that are useful arent hidden away"). Each row is a FlexboxLayout in an `if`, with its filters in it always:
        // a filter in an `if` inside a FlexboxLayout is measured as if it wrapped, and leaves a gap under the row.
        if SoundsData.view < 2: FlexboxLayout {
            spacing: Space.md;
            cross-axis-alignment: center;
            vertical-stretch: 0;
            FilterPicks {
                name: "Order";
                filter: SoundsData.order-filter;
                toggled(text) => { SoundsData.pick-order(text); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: "Shuffle";
                tip: "A new order";
                clicked => { SoundsData.shuffle(); }
            }
        }
        if SoundsData.view == 2: FlexboxLayout {
            spacing: Space.md;
            cross-axis-alignment: center;
            vertical-stretch: 0;
            FilterPicks {
                name: "Placed by";
                filter: SoundsData.placing-filter;
                toggled(text) => { SoundsData.galaxy-place-by(text); }
            }
            FilterPicks {
                name: "Light by";
                filter: SoundsData.light-filter;
                toggled(text) => { SoundsData.galaxy-light-by(text); }
            }
            FilterPicks {
                name: "Sweep plays";
                filter: SoundsData.sweep-play-filter;
                toggled(text) => { SoundsData.galaxy-sweep-plays(text); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: "Lay out again";
                tip: "Work the map out afresh from every sound's fingerprint";
                clicked => { SoundsData.galaxy-lay-out(); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: "Whole map";
                tip: "Zoom out to see every star";
                clicked => { SoundsData.galaxy-reset(); }
            }
        }
        // Rediscover's own choices, in place of the filters: the types as the Type filter shows them (the most used as
        // chips, the rest in a menu), the years, and how many, each on show.
        if SoundsData.view == 4: FlexboxLayout {
            spacing: Space.md;
            cross-axis-alignment: center;
            vertical-stretch: 0;
            FilterPicks {
                name: "Type";
                more-name: "More types";
                filter: SoundsData.re-type-filter;
                toggled(text) => { SoundsData.re-pick("type", text); }
                cleared => { SoundsData.re-pick("more-types", ""); }
            }
            if SoundsData.re-any-type: ToggleChip {
                text: "Clear types";
                on: false;
                clicked => { SoundsData.re-pick("type", ""); }
            }
            StudioSlider {
                low: "Safe";
                high: "Adventurous";
                tip: "Left sticks close to what you already use; right goes further afield";
                value <=> SoundsData.re-adventure;
                released(v) => { SoundsData.re-adventure-set(v); }
            }
            FilterPicks {
                name: "How many";
                filter: SoundsData.re-count-filter;
                toggled(text) => { SoundsData.re-pick("count", text); }
            }
            ToggleChip {
                text: "Include sounds used once";
                on: SoundsData.re-rarely;
                clicked => { SoundsData.re-toggle-rarely(); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: SoundsData.re-busy ? "Shuffling…" : "Shuffle";
                main: true;
                tip: "Dig out a new set";
                clicked => { SoundsData.re-shuffle(); }
            }
        }
        // The kit builder's choices, in place of the filters. They wrap in a narrow window, as the other rows do.
        if SoundsData.view == 5: FlexboxLayout {
            spacing: Space.sm;
            cross-axis-alignment: center;
            vertical-stretch: 0;
            StudioButton {
                horizontal-stretch: 0;
                text: SoundsData.kit-busy ? "Rolling…" : "Roll a kit";
                main: true;
                tip: "Fill every pad that isn't locked";
                clicked => { SoundsData.kit-roll(); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: SoundsData.kit-exporting ? "Exporting…" : "Export kit";
                enabled: !SoundsData.kit-exporting;
                tip: "Copy the pads into a folder of their own, ready for a sampler";
                clicked => { SoundsData.kit-export(); }
            }
            StudioButton {
                horizontal-stretch: 0;
                text: SoundsData.kit-sending ? "Sending…" : "Send to Bitwig";
                enabled: !SoundsData.kit-sending && !SoundsData.kit-busy;
                tip: "Put the kit on a Drum Machine on a new track in the project open in Bitwig: kick on C1, snare on D1, closed hat on F#1, and the rest on the free pads";
                clicked => { SoundsData.kit-to-bitwig(); }
            }
            ToggleChip {
                text: "Favour sounds I haven't used";
                on: SoundsData.kit-unused;
                clicked => { SoundsData.kit-toggle("unused"); }
            }
            ToggleChip {
                text: "One pack";
                on: SoundsData.kit-pack;
                clicked => { SoundsData.kit-toggle("pack"); }
            }
            MenuChip {
                name: "Key for bass";
                value: SoundsData.kit-key;
                choices: SoundsData.kit-keys;
                picked(v) => { SoundsData.kit-choose("key", v); }
            }
            StudioSlider {
                low: "Best fits";
                high: "Random";
                tip: "Left picks the sounds that fit each pad best; right, anything that fits";
                value <=> SoundsData.kit-randomness;
                released(v) => { SoundsData.kit-randomness-set(v); }
            }
            // An action with a menu, so a button, not a filter's chip.
            MenuButton {
                text: "Add a pad";
                items: SoundsData.kit-types;
                chosen(id) => { SoundsData.kit-add(id); }
            }
        }
        if SoundsData.view == 5: HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            vertical-stretch: 0;
            Text {
                text: "Export as";
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
            }
            ToggleChip {
                text: "Elektron ready (48 kHz, 16-bit WAV)";
                on: SoundsData.kit-elektron;
                clicked => { SoundsData.kit-toggle("elektron"); }
            }
            ToggleChip {
                text: "Mono";
                on: SoundsData.kit-mono;
                clicked => { SoundsData.kit-toggle("mono"); }
            }
            ToggleChip {
                text: "Normalise";
                on: SoundsData.kit-normalise;
                clicked => { SoundsData.kit-toggle("normalise"); }
            }
        }
        if SoundsData.view == 5 && SoundsData.kit-status != "": Text {
            text: SoundsData.kit-status;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        if SoundsData.view == 4 && SoundsData.re-intro != "": Text {
            text: SoundsData.re-intro;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        // The filters, the same as on every page: the types first (the most used as chips, every one with how many
        // sounds it would show), then the rest. A row moves a whole filter to the next line before it breaks one.
        if SoundsData.view < 4: FlexboxLayout {
            spacing: Space.md;
            vertical-stretch: 0;
            FilterPicks {
                name: "Type";
                more-name: "More types";
                filter: SoundsData.type-filter;
                toggled(text) => { SoundsData.toggle-choice("type", text); }
                cleared => { SoundsData.clear-chip("more-types"); }
            }
            if SoundsData.any-type: ToggleChip {
                text: "Clear types";
                on: false;
                clicked => { SoundsData.clear-chip("type"); }
            }
        }
        if SoundsData.view < 4: FlexboxLayout {
            spacing: Space.md;
            vertical-stretch: 0;
            FilterPicks {
                name: "Length";
                filter: SoundsData.length-filter;
                toggled(text) => { SoundsData.toggle-choice("length", text); }
                cleared => { SoundsData.clear-chip("length"); }
            }
            FilterPicks {
                name: "Key";
                filter: SoundsData.key-filter;
                toggled(text) => { SoundsData.toggle-choice("key", text); }
                cleared => { SoundsData.clear-chip("key"); }
            }
            if SoundsData.key-filter.more-picked != "": ToggleChip {
                text: "Keys that mix well";
                on: SoundsData.mix-well;
                clicked => { SoundsData.toggle("mix-well"); }
            }
            FilterPicks {
                name: "Tempo";
                filter: SoundsData.tempo-filter;
                toggled(text) => { SoundsData.toggle-choice("tempo", text); }
                cleared => { SoundsData.clear-chip("tempo"); }
            }
            // Not in an `if`: a filter in one is measured as if it wrapped, and leaves a gap under the row. With no
            // tags it shows nothing.
            FilterPicks {
                name: "Tag";
                filter: SoundsData.tag-filter;
                toggled(text) => { SoundsData.toggle-choice("tag", text); }
                cleared => { SoundsData.clear-chip("tag"); }
            }
            if SoundsData.knows-use: ToggleChip {
                text: "In my projects";
                on: SoundsData.used;
                clicked => { SoundsData.toggle("used"); }
            }
            if SoundsData.knows-use: ToggleChip {
                text: "Unused";
                on: SoundsData.unused;
                clicked => { SoundsData.toggle("unused"); }
            }
            ToggleChip {
                text: "Favourites";
                on: SoundsData.favourites;
                clicked => { SoundsData.toggle("favourites"); }
            }
            // Only sounds whose audio is exactly the same are copies: one of each shows while it's on.
            ToggleChip {
                text: SoundsData.hide-copies-text;
                on: SoundsData.hide-copies;
                clicked => { SoundsData.toggle("hide-copies"); }
            }
            // Only while a forgotten folder narrows the list: a click shows every folder's sounds again.
            if SoundsData.folder != "": ToggleChip {
                text: "In " + SoundsData.folder;
                on: true;
                clicked => { SoundsData.toggle("folder"); }
            }
            if SoundsData.any-filter: ToggleChip {
                text: "Clear";
                on: false;
                clicked => { SoundsData.clear(); }
            }
        }
        // The sounds, and the picked one's panel beside them.
        area := Rectangle {
            vertical-stretch: 1;
            // In a wide window (the UX review of 10 Nov, A1) the card stops at `Fit.card-max`, and so do the views
            // made of lines (List, History, Rediscover) at `Fit.list-max`, so a line's name and its numbers stay
            // within one look of each other. Tiles and the Galaxy take all the room: more of them is the point.
            property <length> lines-max: SoundsData.view == 1 || SoundsData.view == 3 ? Fit.list-max
                : SoundsData.view == 4 ? Fit.list-max + 300px
                : self.width;
            property <length> list-width: min(self.lines-max, SoundsData.panel-shown
                ? max(380px, self.width - SoundsData.panel-width - divider.width, self.width - Fit.card-max - divider.width)
                : self.width);
            property <length> card-width: min(Fit.card-max, self.width - self.list-width - divider.width);
            // Rediscover's forgotten folders take the list's right side when there's room.
            property <length> folders-width: SoundsData.view == 4 && SoundsData.folders.length > 0 && self.list-width >= 900px
                ? 300px
                : 0px;
            // The year strip, on Tiles, List and Galaxy: the views the filters pick for. Not on History, which lists
            // what was played whatever the filters say, nor Kits, which picks its own. Rediscover has one too, the
            // same strip, for the years it digs in (apart from the filters').
            property <bool> re-strip: SoundsData.view == 4;
            property <length> years-width: (SoundsData.view <= 2 ? SoundsData.years.length > 1 : self.re-strip && SoundsData.re-years.length > 1)
                && SoundsData.empty-title == ""
                ? 56px
                : 0px;
            if area.years-width > 0: YearRange {
                x: area.list-width - area.folders-width - area.years-width;
                y: 0;
                height: area.height;
                years: area.re-strip ? SoundsData.re-years : SoundsData.years;
                picked-from: area.re-strip ? SoundsData.re-years-from : SoundsData.years-from;
                picked-to: area.re-strip ? SoundsData.re-years-to : SoundsData.years-to;
                picked(a, b) => {
                    if (area.re-strip) {
                        SoundsData.re-years-picked(a, b);
                    } else {
                        SoundsData.years-picked(a, b);
                    }
                }
                cleared => {
                    if (area.re-strip) {
                        SoundsData.re-years-cleared();
                    } else {
                        SoundsData.years-cleared();
                    }
                }
            }
            keys := FocusScope {
                x: 0;
                width: area.list-width - area.folders-width - area.years-width;
                // Typing elsewhere (the search) takes the arrow keys from the Swept card too, as its look says.
                changed has-focus => {
                    if (!self.has-focus) {
                        SoundsData.galaxy-swept-keys = false;
                    }
                }
                key-pressed(event) => {
                    if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                        return reject;
                    }
                    if (event.text == Key.LeftArrow) {
                        SoundsData.step(-1, event.repeat);
                        return accept;
                    }
                    if (event.text == Key.RightArrow) {
                        SoundsData.step(1, event.repeat);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        SoundsData.step(-2, event.repeat);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        SoundsData.step(2, event.repeat);
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        SoundsData.play();
                        return accept;
                    }
                    reject
                }
                Well {
                    if SoundsData.empty-title != "" || (SoundsData.shown == 0 && SoundsData.view != 5): EmptyState {
                        // On top of the galaxy, whose picture from the graphics card covers whatever is under it.
                        z: 1;
                        title: SoundsData.empty-title != "" ? SoundsData.empty-title
                            : SoundsData.view == 4 ? SoundsData.re-empty-title : "No sounds match";
                        text: SoundsData.empty-title != "" ? SoundsData.empty-text
                            : SoundsData.view == 4 ? SoundsData.re-empty-text : "Try fewer filters or other words.";
                        action: SoundsData.empty-title != "" ? ""
                            : SoundsData.view == 4 ? (SoundsData.re-busy ? "" : "Shuffle")
                            : SoundsData.any-filter ? "Clear the filters" : "";
                        act => {
                            if (SoundsData.view == 4) {
                                SoundsData.re-shuffle();
                            } else {
                                SoundsData.clear();
                            }
                        }
                    }
                    // The tiles' shapes come in one picture from the graphics card when there's one (`TileGrid`),
                    // under the list, which then shows only their words; without a card each tile draws its own.
                    if SoundsData.empty-title == "" && SoundsData.shown > 0 && SoundsData.view == 0: grid-area := Rectangle {
                        clip: true;
                        // The height of a tile's lines of words, the same for every tile.
                        name-probe := Text {
                            visible: false;
                            text: "Ag";
                            font-size: Type.body;
                            font-weight: 600;
                        }
                        facts-probe := Text {
                            visible: false;
                            text: "Ag";
                            font-size: Type.meta;
                        }
                        property <length> name-height: name-probe.preferred-height;
                        property <length> facts-height: facts-probe.preferred-height;
                        property <length> wave-top: Space.md + max(self.name-height, 10px) + Space.xs + self.facts-height + Space.xs;
                        property <length> wave-height: TileSize.height - self.wave-top - Space.md;
                        // Where the picture's corner sits in the window, in pixels: it goes on a whole pixel, so the
                        // card draws the tiles as far past one as the list sits, and the picture goes that far back.
                        property <float> left: self.absolute-position.x / 1phx;
                        property <float> top: self.absolute-position.y / 1phx;
                        property <float> over-x: self.left - floor(self.left);
                        property <float> over-y: self.top - floor(self.top);
                        property <image> grid: TileGrid.picture({
                            top: tiles.content-y / 1px,
                            width: self.width / 1px,
                            height: self.height / 1px,
                            columns: tiles.columns,
                            tile-width: ((tiles.visible-width - Space.sm) / tiles.columns - Space.sm) / 1px,
                            tile-height: TileSize.height / 1px,
                            gap: Space.sm / 1px,
                            inside: Space.md / 1px,
                            name-height: self.name-height / 1px,
                            wave-top: self.wave-top / 1px,
                            wave-height: self.wave-height / 1px,
                            over-x: self.over-x,
                            over-y: self.over-y,
                            scale: 1px / 1phx,
                        }, {
                            radius: Theme.radius / 1px,
                            background: Theme.background,
                            well: Theme.well,
                            surface: Theme.surface,
                            raised: Theme.surface-raised,
                            edge: Theme.edge,
                            accent: Theme.accent,
                        }, TileGrid.asked);
                        property <bool> on-card: self.grid.width > 0;
                        if grid-area.on-card: Image {
                            x: -grid-area.over-x * 1phx;
                            y: -grid-area.over-y * 1phx;
                            width: grid-area.grid.width * 1phx;
                            height: grid-area.grid.height * 1phx;
                            source: grid-area.grid;
                        }
                        tiles := ListView {
                            property <int> columns: max(1, floor((self.visible-width - Space.sm) / (TileSize.width + Space.sm)));
                            row-height: TileSize.height + Space.sm;
                            rows: SoundsData.tile-rows.length;
                            show-top: SoundsData.show-row * self.row-height;
                            show-ask: SoundsData.show-ask;
                            show-done <=> SoundsData.show-done;
                            changed columns => { SoundsData.columns-changed(self.columns); }
                            init => {
                                SoundsData.columns-changed(self.columns);
                                SoundsData.list-made();
                            }
                            for r in SoundsData.tile-rows: HorizontalLayout {
                                // Every row this height: the list counts on it.
                                height: tiles.row-height;
                                padding-left: Space.sm;
                                padding-top: Space.sm;
                                spacing: Space.sm;
                                alignment: start;
                                for t in r.tiles: SoundTileView {
                                    width: (tiles.visible-width - Space.sm) / tiles.columns - Space.sm;
                                    tile: t;
                                    name-height: grid-area.name-height;
                                    facts-height: grid-area.facts-height;
                                    wave-top: grid-area.wave-top;
                                    wave-height: grid-area.wave-height;
                                    on-card: grid-area.on-card;
                                    chosen => { keys.focus(); }
                                    right-clicked(x, y) => {
                                        keys.focus();
                                        menu.open-at(x, y);
                                    }
                                }
                            }
                        }
                    }
                    if SoundsData.empty-title == "" && SoundsData.shown > 0 && (SoundsData.view == 1 || SoundsData.view == 3 || SoundsData.view == 4): list-box := VerticalLayout {
                        // Two lines a sound where the columns would leave its name under about 100 px (in a
                        // 900 px window); a big window with the panel and the year strip open keeps one line. The
                        // columns take about 510 px (SoundLineView): make one wider, and raise this with it.
                        property <bool> narrow: self.width < 660px;
                        property <length> line-height: self.narrow ? 52px : 40px;
                        ListHeading {
                            history: SoundsData.view == 3;
                            rediscover: SoundsData.view == 4;
                            narrow: list-box.narrow;
                        }
                        lines := ListView {
                            row-height: list-box.line-height;
                            rows: SoundsData.lines.length;
                            show-top: SoundsData.show-row * self.row-height;
                            show-ask: SoundsData.show-ask;
                            show-done <=> SoundsData.show-done;
                            init => { SoundsData.list-made(); }
                            for l in SoundsData.lines: SoundLineView {
                                // Every line this height: the list counts on it.
                                height: lines.row-height;
                                narrow: list-box.narrow;
                                line: l;
                                history: SoundsData.view == 3;
                                rediscover: SoundsData.view == 4;
                                chosen => { keys.focus(); }
                                right-clicked(x, y) => {
                                    keys.focus();
                                    menu.open-at(x, y);
                                }
                            }
                        }
                    }
                    if SoundsData.empty-title == "" && SoundsData.view == 5: ListView {
                        for pad[i] in SoundsData.pads: PadLineView {
                            pad: pad;
                            place: i;
                            chosen => { keys.focus(); }
                        }
                    }
                    if SoundsData.empty-title == "" && SoundsData.view == 2: sky := Rectangle {
                        clip: true;
                        init => { SoundsData.galaxy-resized(self.width, self.height); }
                        changed width => { SoundsData.galaxy-resized(self.width, self.height); }
                        changed height => { SoundsData.galaxy-resized(self.width, self.height); }
                        Image {
                            x: SoundsData.galaxy-image-x;
                            y: SoundsData.galaxy-image-y;
                            width: SoundsData.galaxy-image-width;
                            height: SoundsData.galaxy-image-height;
                            source: SoundsData.galaxy-image;
                            image-fit: fill;
                        }
                        if SoundsData.galaxy-trail != "": Path {
                            x: 0;
                            y: 0;
                            width: sky.width;
                            height: sky.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: sky.width / 1px;
                            viewbox-height: sky.height / 1px;
                            commands: SoundsData.galaxy-trail;
                            stroke: Theme.text;
                            stroke-width: 1.2px;
                            opacity: 0.45;
                        }
                        for d in SoundsData.galaxy-trail-dots: Rectangle {
                            x: d.x - 4px;
                            y: d.y - 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.text;
                            opacity: 0.2 + 0.6 * d.fade;
                        }
                        if SoundsData.galaxy-hover-shown: Rectangle {
                            x: SoundsData.galaxy-hover-x - 7px;
                            y: SoundsData.galaxy-hover-y - 7px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 1.5px;
                            border-color: Theme.text;
                            opacity: 0.7;
                        }
                        if SoundsData.galaxy-picked-shown: Rectangle {
                            x: SoundsData.galaxy-picked-x - 9px;
                            y: SoundsData.galaxy-picked-y - 9px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 2px;
                            border-color: Theme.accent;
                        }
                        PointerPad {
                            grabbing: SoundsData.galaxy-grabbing;
                            down(x, y) => {
                                keys.focus();
                                SoundsData.galaxy-swept-keys = false;
                                SoundsData.galaxy-sky-x = sky.absolute-position.x;
                                SoundsData.galaxy-sky-y = sky.absolute-position.y;
                                SoundsData.galaxy-down(x, y, false);
                            }
                            side-down(x, y) => {
                                keys.focus();
                                SoundsData.galaxy-down(x, y, true);
                            }
                            side-up => { SoundsData.galaxy-up(true); }
                            move(x, y) => { SoundsData.galaxy-move(x, y); }
                            cancelled => { SoundsData.galaxy-cancelled(); }
                            up => { SoundsData.galaxy-up(false); }
                            double => { SoundsData.galaxy-double(); }
                            wheel(x, dx, dy, ctrl, shift) => { SoundsData.galaxy-wheel(dy); }
                            gone => { SoundsData.galaxy-gone(); }
                        }
                        for l in SoundsData.galaxy-labels: MapName {
                            x: l.x - self.width / 2;
                            y: l.y - self.height;
                            text: l.name;
                            tint: Theme.sound-type(l.colour);
                            opacity: l.fade;
                            clicked => { SoundsData.galaxy-label(l.region); }
                        }
                        if SoundsData.galaxy-mini-shown: MapInset {
                            x: sky.width - self.width - Space.md;
                            y: sky.height - self.height - Space.md;
                            picture: SoundsData.galaxy-mini-image;
                            title: SoundsData.galaxy-mini-title;
                            box-x: SoundsData.galaxy-mini-x;
                            box-y: SoundsData.galaxy-mini-y;
                            box-width: SoundsData.galaxy-mini-width;
                            box-height: SoundsData.galaxy-mini-height;
                            go(x, y) => { SoundsData.galaxy-mini(x, y); }
                        }
                        if SoundsData.galaxy-swept.length > 0: Rectangle {
                            x: sky.width - self.width - Space.md;
                            y: Space.md;
                            width: 250px;
                            height: min(swept-card.preferred-height, sky.height - 2 * Space.md);
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            // Accent while the arrow keys go through it.
                            border-color: SoundsData.galaxy-swept-keys && keys.has-focus ? Theme.accent : Theme.edge;
                            clip: true;
                            // The card takes its own clicks and the wheel, so they don't reach the map under it; a
                            // click on it hands it the arrow keys.
                            TouchArea {
                                clicked => {
                                    keys.focus();
                                    SoundsData.galaxy-swept-keys = true;
                                }
                            }
                            swept-card := VerticalLayout {
                                padding: Space.md;
                                spacing: Space.xs;
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Caps {
                                        text: "SWEPT";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    StudioButton {
                                        text: "Back";
                                        tip: "The sound swept before this one";
                                        clicked => {
                                            keys.focus();
                                            SoundsData.galaxy-swept-keys = true;
                                            SoundsData.galaxy-swept-step(1);
                                        }
                                    }
                                    StudioButton {
                                        text: "Next";
                                        tip: "The sound swept after this one";
                                        clicked => {
                                            keys.focus();
                                            SoundsData.galaxy-swept-keys = true;
                                            SoundsData.galaxy-swept-step(-1);
                                        }
                                    }
                                }
                                for line[i] in SoundsData.galaxy-swept: ListLine {
                                    height: 30px;
                                    selected: line.current;
                                    tip: line.kind;
                                    draggable: true;
                                    lifted: line.place == SoundsData.lifted-alike;
                                    landed: line.place == SoundsData.landed-alike;
                                    drag-out => { SoundsData.drag-alike(line.place); }
                                    drag-let-go => { SoundsData.drag-let-go(); }
                                    clicked => {
                                        keys.focus();
                                        SoundsData.galaxy-swept-keys = true;
                                        SoundsData.galaxy-swept-go(i);
                                    }
                                    HorizontalLayout {
                                        padding-left: Space.sm;
                                        padding-right: Space.sm;
                                        spacing: Space.sm;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Dot { tint: Theme.sound-type(line.colour); }
                                        }
                                        Text {
                                            text: line.name;
                                            color: line.current ? Theme.text : Theme.muted;
                                            font-size: Type.meta;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    // What the arrow keys do here, so it's seen, not guessed.
                                    Text {
                                        text: SoundsData.galaxy-swept-keys && keys.has-focus
                                            ? "Up and Down go through these"
                                            : "Click here, then Up and Down";
                                        color: SoundsData.galaxy-swept-keys && keys.has-focus ? Theme.accent : Theme.muted;
                                        font-size: Type.meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    LinkText {
                                        text: "Clear";
                                        tint: Theme.muted;
                                        font-size: Type.meta;
                                        clicked => { SoundsData.galaxy-swept-clear(); }
                                    }
                                }
                            }
                        }
                        // What the arrow keys do on the map, in its bottom left corner (the mini-map has the right).
                        if SoundsData.shown > 0 && SoundsData.galaxy-note == "": Text {
                            x: Space.md;
                            y: sky.height - self.height - Space.md;
                            text: "Arrow keys: the nearest sound that way";
                            color: Theme.muted;
                            font-size: Type.meta;
                        }
                        if SoundsData.galaxy-hover-text != "": HoverNote {
                            text: SoundsData.galaxy-hover-text;
                            at-x: SoundsData.galaxy-mouse-x;
                            at-y: SoundsData.galaxy-mouse-y;
                            room-width: sky.width;
                            room-height: sky.height;
                        }
                        // Only with stars to show: when the filters leave none, the list's own word says so in the
                        // same place, and the two would sit on top of each other.
                        if SoundsData.galaxy-note != "" && SoundsData.shown > 0: EmptyState {
                            title: SoundsData.galaxy-busy ? "Making the galaxy" : "";
                            text: SoundsData.galaxy-note;
                        }
                    }
                }
            }
            if area.folders-width > 0: FoldersCard {
                x: area.list-width - area.folders-width + Space.md;
                width: area.folders-width - Space.md;
                height: parent.height;
            }
            divider := PanelDivider {
                // No seam to drag once the window has room for the sounds and the card at their widest.
                visible: SoundsData.panel-shown && area.card-width < Fit.card-max;
                x: area.list-width;
                height: parent.height;
                panel-width: area.card-width;
                room: area.width;
                resizing(w) => { SoundsData.panel-width = w; }
                resized(w) => { SoundsData.panel-resized(w); }
            }
            if SoundsData.panel-shown: SoundPanel {
                x: area.list-width + divider.width;
                width: area.card-width;
                height: parent.height;
                tag-keys <=> root.card-keys;
            }
            menu := RightClickMenu {
                items: SoundsData.menu;
                chosen(id) => { SoundsData.menu-chosen(id); }
            }
        }
    }
}
