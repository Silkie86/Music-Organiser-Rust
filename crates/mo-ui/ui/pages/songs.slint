// The Songs page: one line per song, newest save first, under time headings, with search, filter chips and a year
// scrubber, and the picked song's panel beside it. Agreed with Solomon on 2026-10-31.
import { ListView, ListBox, Fit } from "../list.slint";
import { ArrangementPreview } from "arrangement.slint";
import { Theme, AppKeys, Type, Space, PageHeader, Well, Panel, SearchBox, ToggleChip, FilterPicks, FilterList, FilterColumn, TickLine, FilterView, ListLine, CutText, Stars, YearRange, YearBar, Caps, ColumnHead, Heart, CloseButton, TabBar, LinkText, StudioButton, ActionKey, MenuLine, MenuCard, Groove, MenuItem, RightClickMenu, NoticeStrip, EmptyState, SidePanel, StarsPick, HeartToggle, TagChip, WordBox, MenuChip, Icons, CheckLine, TickSquare, Widths, Seam, SignCount } from "../studio.slint";

// One line of the list: a heading ("This week", "2019") when `heading` isn't empty, else a song.
export struct SongLine {
    heading: string,
    // Where the song is in the page's rows (mo-app's `Songs::rows`), for picking it.
    row: int,
    name: string,
    details: string,
    date: string,
    date-tip: string,
    // What's missing: "1 plugin, 3 samples", for the wide list's column, and said in full ("1 plugin, 3 samples
    // missing") for after the details in the narrow one.
    missing: string,
    missing-words: string,
    rating: int,
    favourite: bool,
    status: string,
    daw: string,
    // How many of its to-dos are left.
    todos: int,
    // How long FL Studio has had it open ("41 h"); empty when not known.
    time: string,
}

// A song on the Dust off card: its place in the page's rows, its name, and its status, time spent and year.
export struct DustLine {
    row: int,
    name: string,
    about: string,
}

// One of the picked song's to-dos on its card: `n` is its place in the song's list, which a tick or × names.
export struct TodoLine {
    n: int,
    text: string,
    done: bool,
    // The day it was added: "16 Nov".
    date: string,
}

// One line of Next up: a song (its name in `text`, its status and date in `about`), or one of its to-dos left (`n`).
// `row` is the song's place in the page's rows.
export struct NextLine {
    song: bool,
    row: int,
    n: int,
    text: string,
    about: string,
}

// One of Overview's counts ("9 plugins", "3 missing"), opening the tab at `tab`.
export struct CountLine {
    text: string,
    missing: string,
    tab: int,
}

export struct PluginLine {
    name: string,
    about: string,
    installed: bool,
}

export struct SampleLine {
    name: string,
    folder: string,
    path: string,
    missing: bool,
    unplayed: bool,
}

// One line of the Saves tab: a run's heading when `run` isn't empty, else a save.
export struct SaveLine {
    run: string,
    details: string,
    name: string,
    date: string,
    path: string,
    missing: bool,
    newest: bool,
    // The DAW the save opens in, which its buttons name.
    daw: string,
}

// One line of the song panel's Older saves menu: clicking it opens `path`.
export struct OlderLine {
    text: string,
    path: string,
}

// One line of the song's Health strip, with its button when `action` isn't empty.
export struct HealthLine {
    text: string,
    why: string,
    action: string,
}

export struct DetailPair {
    name: string,
    value: string,
}

// The picked song, for its panel.
export struct PanelSong {
    daw: string,
    facts: string,
    name: string,
    saves: string,
    // When the song last reached the backup drive; empty until a backup drive is picked.
    backed: string,
    status: string,
    rating: int,
    favourite: bool,
    key: string,
    // The key was worked out from the notes, not typed in.
    key-heard: bool,
    tags: string,
    notes: string,
    // How long FL Studio has had it open ("41 h"), and that in words; empty when not known.
    time: string,
    time-tip: string,
}

// One of the picked song's tags; `on` while the Tag filter has it.
export struct SongTag {
    text: string,
    on: bool,
}

// What the page shows and what it reports, filled and answered by mo-ui's songs.rs.
export global SongsData {
    in property <[SongLine]> lines;
    // The year strip beside the list: each year with how many songs; drag over years to show only those.
    in property <[YearBar]> years;
    // The places in `years` of the first and last years picked, top first (-1 when none are).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    in property <string> count;
    // Shown instead of the list while it loads, or when the library can't be read or has no songs: a title, and a
    // line under it.
    in property <string> message: "Reading your library…";
    in property <string> message-text;
    // How many songs the filters let through: with none, the list says so and offers to clear them.
    in property <int> shown;
    in-out property <string> search;
    // The filters (mo-app's `songs::SongChips`): the DAW, the status and the tag, more than one of each.
    in property <FilterView> daw-filter;
    in property <FilterView> status-filter;
    in property <FilterView> tag-filter;
    in property <bool> favourites;
    in property <bool> missing;
    // Show only songs with to-dos left.
    in property <bool> has-todos;
    in property <bool> hide-archived;
    in property <bool> any-filter;
    // "Using Serum", while the list shows only the songs of one plugin (the Plugins page's Show in Songs).
    in property <string> only;
    in property <int> selected: -1;
    // Up and Down on the list (and Down from the search box): the song above or below the one picked.
    callback step(int);
    // Bring a song into view: its line's top in the list, and a count that goes up each time it's asked.
    in property <length> show-y;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    // Where the list is turned to (list.slint's ListView keeps it): it's there again when the page is shown again.
    in-out property <length> list-y;
    // The song panel, shown while a song is picked.
    in property <PanelSong> song;
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <[CountLine]> counts;
    in property <[string]> runs;
    // "Reading…" while the newest save's record loads, or why it couldn't be read.
    in property <string> detail-message;
    in property <string> plugins-heading;
    in property <[PluginLine]> plugins;
    in property <string> samples-heading;
    in property <[SampleLine]> samples;
    in property <string> saves-heading;
    in property <[SaveLine]> saves;
    // The Older saves menu: "VERSIONS" or "RECENT SAVES", its lines, and "See all 12 saves". No lines, no button.
    in property <string> older-heading;
    in property <[OlderLine]> older;
    in property <string> older-see-all;
    // Where the Saves tab is in `tabs`, for "See all".
    in property <int> saves-tab;
    in property <string> tracks;
    in property <[DetailPair]> details;
    in property <[string]> warnings;
    // The Health strip: folded to its summary line until opened.
    in property <string> health-summary;
    in property <[HealthLine]> health;
    in-out property <bool> health-open;
    callback health-go(int);
    callback search-edited(string);
    // A filter's choice was picked or unpicked: which filter ("daw", "status", "tag") and the choice's words; or its
    // menu's Any was.
    callback toggle-choice(string, string);
    callback clear-chip(string);
    callback toggle(string);
    callback clear();
    // The column the list goes by, as its heading says it ("Last saved"), and whether that order is turned round; a
    // click on a heading (its words) picks it, a second turns it round.
    in property <string> order-column;
    in property <bool> order-reversed;
    callback order-picked(string);
    callback select(int);
    // The buttons' tooltips and keys, from the shortcut list.
    in property <ActionKey> open-key;
    in property <ActionKey> open-own-key;
    in property <ActionKey> reveal-key;
    in property <ActionKey> copy-key;
    // The card's heart's and tag box's keys (Ctrl+D and Ctrl+T, as on Sounds); Ctrl+T bumps `tag-asked`, and the tag
    // box takes the keys.
    in property <ActionKey> favourite-key;
    in property <ActionKey> tag-key;
    in property <int> tag-asked;
    // Opens the picked song's newest save: FL Studio songs go to Bitwig, the rest to their own DAW.
    callback open();
    // Opens the picked song's newest save in its own DAW (FL Studio's "Open in FL Studio").
    callback open-own();
    // Opens one save of the picked song, by its path.
    callback open-save(string);
    // A save right-clicked on the Saves tab: `save-menu-for` fills `save-menu` for it, `save-menu-chosen` runs a line.
    in property <[MenuItem]> save-menu;
    callback save-menu-for(string);
    callback save-menu-chosen(string);
    // A song line right-clicked (it's picked first): `song-menu-for` fills `song-menu` for its song, with the panel's
    // buttons and their keys; `song-menu-chosen` runs a line, by its action's id.
    in property <[MenuItem]> song-menu;
    callback song-menu-for(int);
    callback song-menu-chosen(string);
    // A button on a save's line on the Saves tab: the save's path, and "open", "bitwig", "reveal" or "copy", as the
    // lines of its right-click menu.
    callback save-chosen(string, string);
    // The save picked on the Saves tab ("" for none: the newest), which the song's buttons act on, and its name.
    in property <string> picked-save;
    in property <string> picked-save-name;
    callback pick-save(string, string);
    callback reveal();
    callback copy-path();
    // Opens the Presets page on the picked song's sounds (its newest save's).
    callback show-presets();
    callback close-panel();
    // You give the picked song something, kept for the song (all its saves): `what` is "status" (one of `statuses`),
    // "stars" ("0" to "5"), "favourite" (turned over), "add-tag" or "remove-tag" (the tag).
    callback give(string, string);
    in property <[string]> statuses;
    in property <[SongTag]> song-tags;
    // The picked song's to-dos ("add-todo" with the words, "tick-todo" and "remove-todo" with a line's `n`), and
    // "3 left" ("" while it has none).
    in property <[TodoLine]> song-todos;
    // The Dust off card: a few songs you spent real time on and left (a new few each week); empty hides it.
    in property <[DustLine]> dust-lines;
    // "Not now" on the Dust off card: the song at that row is off it for about three months.
    callback not-now(int);
    in property <string> todos-left;
    // Next up instead of the list: every to-do left on the songs the filters show, under each song's name.
    in-out property <bool> next-up;
    in property <[NextLine]> next-lines;
    in property <int> next-count;
    // A change given to the song at `row` of the page's rows (a to-do ticked on Next up), as `give`.
    callback give-to(int, string, string);
    // Headings and songs are one height. Slint's ListView places a far jump by the average height of the lines on
    // screen, so with two heights "Show it" landed hundreds of lines away from the song in a big library; with one,
    // a song's place is simply its line number times this.
    out property <length> line-height: 62px;
}

// What's wrong with a plugin on the Plugins tab: beside it, or first under its name in a narrow panel.
component PluginTrouble inherits Text {
    text: "Not installed";
    color: Theme.missing;
    font-size: Type.meta;
}

// What's wrong with a sample on the Samples tab, the same way.
component SampleTrouble inherits Text {
    in property <SampleLine> sample;
    text: root.sample.missing ? "Can't be found" : "Loaded, never played";
    color: root.sample.missing ? Theme.missing : Theme.faint;
    font-size: Type.meta;
}

// A tab's content in the song panel. It says how tall it wants to be at the panel's real width, because the `if`
// round it is measured at its widest: in a narrow window, where its lines wrap, the panel then scrolls far enough.
component TabRoom inherits VerticalLayout {
    in-out property <length> wants;
    init => { self.wants = self.preferred-height; }
    changed preferred-height => { self.wants = self.preferred-height; }
}

// The song's to-do list on its card: what's left first, then what's done, and a box to add one (Enter). Kept for the
// song, on all its saves (rule 14).
component TodoCard inherits Rectangle {
    // Whether its box has the keys (SongPanel's `todo-keys`).
    in-out property <bool> box-keys;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    background: Theme.well;
    VerticalLayout {
        padding: Space.sm;
        if SongsData.song-todos.length > 0: HorizontalLayout {
            spacing: Space.sm;
            padding-left: Space.xs;
            padding-right: Space.xs;
            height: 22px;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: Icons.todo;
                    stroke: Theme.muted;
                    stroke-width: 1.5px;
                }
            }
            Caps {
                text: "TO-DO";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: SongsData.todos-left;
                color: Theme.faint;
                font-size: Type.meta;
                vertical-alignment: center;
            }
        }
        for t in SongsData.song-todos: CheckLine {
            text: t.text;
            done: t.done;
            date: t.date;
            remove-tip: "Take it off the list";
            ticked => { SongsData.give("tick-todo", t.n); }
            removed => { SongsData.give("remove-todo", t.n); }
        }
        HorizontalLayout {
            padding-top: SongsData.song-todos.length > 0 ? Space.xs : 0px;
            WordBox {
                horizontal-stretch: 1;
                hint: "Add a to-do";
                tip: "Type what's left to do on this song and press Enter";
                // Not while another app's window is in front: the box gets them back with the window.
                changed has-keys => {
                    if (self.has-keys || AppKeys.window-active) {
                        root.box-keys = self.has-keys;
                    }
                }
                accepted(text) => {
                    if (text != "") {
                        SongsData.give("add-todo", text);
                        self.text = "";
                    }
                }
            }
        }
    }
}

// Dust off: a few songs you spent real time on in FL Studio and left (not finished, not saved for six months), a new
// few each week. The heading orders the whole list that way; the moon puts a song off the card for three months.
component DustOffCard inherits VerticalLayout {
    padding-left: Space.xs;
    padding-right: Space.xs;
    padding-top: Space.sm;
    padding-bottom: Space.sm;
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        ColumnHead {
            text: "DUST OFF";
            tip: "Songs you spent hours on and left. Click to order the list this way";
            on: SongsData.order-column == "Dust off";
            // Most time first, as TIME.
            up: SongsData.order-reversed;
            clicked => { SongsData.order-picked("Dust off"); }
        }
    }
    for d in SongsData.dust-lines: dust-line := ListLine {
        height: 34px;
        selected: d.row == SongsData.selected;
        clicked => { SongsData.select(d.row); }
        double-clicked => {
            SongsData.select(d.row);
            SongsData.open();
        }
        HorizontalLayout {
            padding-left: Space.md;
            padding-right: Space.sm;
            spacing: Space.sm;
            CutText {
                over: dust-line.resting;
                mouse: dust-line.mouse;
                text: d.name;
                color: Theme.text;
                font-size: Type.row-title;
                font-weight: 500;
                vertical-alignment: center;
            }
            CutText {
                over: dust-line.resting;
                mouse: dust-line.mouse;
                text: d.about;
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                StudioButton {
                    width: 32px;
                    icon: Icons.moon;
                    quiet: true;
                    tip: "Not now: off this card for 3 months";
                    clicked => { SongsData.not-now(d.row); }
                }
            }
        }
    }
}

// Next up: every to-do left on the songs the filters show, under each song's name. A tick gives it to its song; a
// click on a song's name opens its card.
component NextUpList inherits Rectangle {
    property <length> line-height: 34px;
    // A ticked to-do leaves the list at once and the next moves up into its place: a click straight after (a double
    // click) waits, so it can't tick that one too.
    property <bool> resting;
    Timer {
        interval: 400ms;
        running: root.resting;
        triggered => { root.resting = false; }
    }
    if SongsData.next-lines.length == 0: EmptyState {
        title: "Nothing to do";
        text: "Add to-dos on a song's card.";
    }
    ListView {
        row-height: root.line-height;
        rows: SongsData.next-lines.length;
        for line in SongsData.next-lines: Rectangle {
            height: root.line-height;
            if line.song: song-name := ListLine {
                x: Space.xs;
                width: parent.width - 2 * Space.xs;
                selected: line.row == SongsData.selected;
                clicked => { SongsData.select(line.row); }
                double-clicked => {
                    SongsData.select(line.row);
                    SongsData.open();
                }
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    padding-top: Space.sm;
                    spacing: Space.sm;
                    alignment: start;
                    CutText {
                        over: song-name.resting;
                        mouse: song-name.mouse;
                        text: line.text;
                        color: Theme.text;
                        font-size: Type.row-title;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Text {
                        text: line.about;
                        color: Theme.muted;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                }
            }
            if !line.song: HorizontalLayout {
                padding-left: Space.md + Space.xs;
                padding-right: Space.md;
                spacing: Space.sm;
                VerticalLayout {
                    alignment: center;
                    TickSquare {
                        clicked => {
                            if (!root.resting) {
                                root.resting = true;
                                SongsData.give-to(line.row, "tick-todo", line.n);
                            }
                        }
                    }
                }
                CutText {
                    horizontal-stretch: 1;
                    text: line.text;
                    color: Theme.text;
                    font-size: Type.body;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The list or Next up, with how many to-dos are left.
component ListSwitch inherits HorizontalLayout {
    spacing: 0;
    alignment: start;
    ToggleChip {
        icon: Icons.songs;
        text: "Songs";
        tip: "every song, in the list's order";
        on: !SongsData.next-up;
        joined-right: true;
        clicked => { SongsData.next-up = false; }
    }
    ToggleChip {
        icon: Icons.todo;
        text: "Next up";
        tip: SongsData.next-count > 0 ? SongsData.next-count + " to-dos left, song by song" : "nothing left to do";
        badge: SongsData.next-count > 0 ? SongsData.next-count : "";
        on: SongsData.next-up;
        joined-left: true;
        clicked => { SongsData.next-up = true; }
    }
}

// The picked song: what it is, its counts and its tabs. Its status, stars, heart and tags are the song's, on all its
// saves (rule 14), and are kept in songs.db.
component SongPanel inherits Panel {
    // Whether the tag box has the keys: when the card closes with them, the page gives them back to its list.
    in-out property <bool> tag-keys;
    // The same for the to-do box.
    in-out property <bool> todo-keys;
    // How tall the tab on show wants to be, which it says itself (see TabRoom).
    property <length> tab-height;
    // Too narrow for a list line's name to share its line with a date or what's wrong (about 250 px in the narrowest
    // window): those go on the line below. The panel's width is set by hand, so this doesn't depend on itself.
    property <bool> narrow: root.width < 400px;
    // The song on show, by its place in the library's list. When another is picked, the panel goes back to its top,
    // so the new song opens at its name, as it opens on Overview. A new tab keeps the place, as the tabs are in sight.
    property <int> song-row: SongsData.selected;
    changed song-row => { flick.content-y = 0; }
    // Ctrl+T (projects.tag): the keys go to the tag box, with anything typed in it picked.
    property <int> tag-asked: SongsData.tag-asked;
    changed tag-asked => { tag-box.focus-all(); }

    // Scrolls when what it holds is taller than the panel, as the other pages' panels do: in a narrow window its
    // rows wrap, and the tab below keeps the room it needs. Otherwise it fills the panel, and the tab's well takes
    // the room that's left.
    flick := Flickable {
        content-width: flick.width;
        content-height: content.height;
        // The wheel scrolls it; a drag with the mouse is for what's in it, such as a clip dragged out to a DAW.
        mouse-drag-pan-enabled: false;
        content := VerticalLayout {
            x: 0;
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            padding: Space.lg;
            padding-bottom: Space.md;
            spacing: Space.sm;
            HorizontalLayout {
                spacing: Space.sm;
                vertical-stretch: 0;
                Text {
                    text: SongsData.song.daw;
                    color: Theme.daw(SongsData.song.daw);
                    font-size: Type.meta;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                CutText {
                    own-mouse: true;
                    text: SongsData.song.facts;
                    color: Theme.muted;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                CloseButton {
                    clicked => { SongsData.close-panel(); }
                }
            }
            CutText {
                own-mouse: true;
                text: SongsData.song.name;
                color: Theme.text;
                font-family: Theme.title-font;
                font-size: Type.panel-title;
                font-weight: 600;
            }
            // How many saves, and beside it how long FL Studio has had it open (its words in the tooltip).
            if SongsData.song.saves != "" || SongsData.song.time != "": HorizontalLayout {
                spacing: Space.md;
                CutText {
                    own-mouse: true;
                    text: SongsData.song.saves;
                    color: Theme.muted;
                    font-size: Type.meta;
                    horizontal-stretch: 1;
                }
                if SongsData.song.time != "": SignCount {
                    icon: Icons.clock;
                    text: SongsData.song.time;
                    tip: SongsData.song.time-tip;
                }
            }
            if SongsData.song.backed != "": CutText {
                own-mouse: true;
                text: SongsData.song.backed;
                color: Theme.muted;
                font-size: Type.meta;
            }
            // Its status, stars, key and tags, and its buttons below: each row wraps in a narrow panel, so nothing runs past
            // its edge.
            FlexboxLayout {
                spacing-horizontal: Space.md;
                spacing-vertical: Space.sm;
                cross-axis-alignment: center;
                padding-top: Space.xs;
                padding-bottom: Space.sm;
                vertical-stretch: 0;
                MenuChip {
                    name: "Status";
                    value: SongsData.song.status;
                    choices: SongsData.statuses;
                    has-any: false;
                    lights: false;
                    picked(status) => { SongsData.give("status", status); }
                }
                StarsPick {
                    rating: SongsData.song.rating;
                    picked(stars) => { SongsData.give("stars", stars); }
                }
                HeartToggle {
                    on: SongsData.song.favourite;
                    tip: SongsData.song.favourite ? "A favourite: click to make it not one" : "Make it a favourite";
                    key: SongsData.favourite-key.key;
                    clicked => { SongsData.give("favourite", ""); }
                }
                if SongsData.song.key != "": HorizontalLayout {
                    spacing: Space.sm;
                    Caps {
                        text: "KEY";
                        vertical-alignment: center;
                    }
                    Text {
                        text: SongsData.song.key + (SongsData.song.key-heard ? " (from the notes)" : "");
                        color: Theme.text;
                        font-size: Type.body;
                        vertical-alignment: center;
                    }
                }
            }
            // Its tags: a click filters the list by one, × takes it off, and the box adds one.
            FlexboxLayout {
                spacing: Space.xs;
                padding-bottom: Space.sm;
                vertical-stretch: 0;
                for t in SongsData.song-tags: TagChip {
                    text: t.text;
                    on: t.on;
                    remove-tip: "Take the tag " + t.text + " off this song";
                    clicked => { SongsData.toggle-choice("tag", t.text); }
                    removed => { SongsData.give("remove-tag", t.text); }
                }
                tag-box := WordBox {
                    width: 160px;
                    hint: "Add a tag";
                    tip: "Type a tag and press Enter: it's kept for the song, on all its saves";
                    key: SongsData.tag-key.key;
                    // Not while another app's window is in front: the box gets them back with the window.
                    changed has-keys => {
                        if (self.has-keys || AppKeys.window-active) {
                            root.tag-keys = self.has-keys;
                        }
                    }
                    accepted(text) => {
                        SongsData.give("add-tag", text);
                        self.text = "";
                    }
                }
            }
            // Which save the buttons below act on, when one is picked on the Saves tab; a click goes back to the newest.
            // Right above them, below the status, stars, heart and tags, which are the whole song's: above those, it
            // read as if they changed the picked save alone (the whole-app review of 14 Nov, SG-3).
            if SongsData.picked-save != "": HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                CutText {
                    own-mouse: true;
                    text: "The buttons below act on the picked save: " + SongsData.picked-save-name;
                    color: Theme.accent;
                    font-size: Type.meta;
                    vertical-alignment: center;
                }
                LinkText {
                    text: "Back to the newest";
                    font-size: Type.meta;
                    clicked => { SongsData.pick-save("", ""); }
                }
            }
            FlexboxLayout {
                spacing: Space.sm;
                vertical-stretch: 0;
                padding-bottom: Space.xs;
                StudioButton {
                    text: SongsData.song.daw == "FL Studio" ? "Open in Bitwig" : "Open in " + SongsData.song.daw;
                    main: true;
                    tip: SongsData.open-key.what;
                    key: SongsData.open-key.key;
                    clicked => { SongsData.open(); }
                }
                if SongsData.song.daw == "FL Studio": StudioButton {
                    text: "Open in FL Studio";
                    tip: SongsData.open-own-key.what;
                    key: SongsData.open-own-key.key;
                    clicked => { SongsData.open-own(); }
                }
                if SongsData.older.length > 0: HorizontalLayout {
                    older-button := StudioButton {
                        text: "Older saves";
                        menu: true;
                        clicked => { older-menu.show(); }
                    }
                    older-menu := PopupWindow {
                        x: 0;
                        y: older-button.height + Space.xs;
                        width: max(older-button.width, 320px);
                        MenuCard {
                            HorizontalLayout {
                                padding-left: Space.md;
                                Caps {
                                    text: SongsData.older-heading;
                                    height: self.preferred-height + Space.sm;
                                    vertical-alignment: center;
                                }
                            }
                            for line in SongsData.older: MenuLine {
                                text: line.text;
                                clicked => { SongsData.open-save(line.path); }
                            }
                            Groove { }
                            MenuLine {
                                text: SongsData.older-see-all;
                                clicked => { SongsData.tab = SongsData.saves-tab; }
                            }
                        }
                    }
                }
                StudioButton {
                    icon: Icons.folder;
                    text: "Show in folder";
                    quiet: true;
                    tip: SongsData.reveal-key.what;
                    key: SongsData.reveal-key.key;
                    clicked => { SongsData.reveal(); }
                }
                StudioButton {
                    icon: Icons.copy;
                    text: "Copy path";
                    quiet: true;
                    tip: SongsData.copy-key.what;
                    key: SongsData.copy-key.key;
                    clicked => { SongsData.copy-path(); }
                }
            }
            TodoCard {
                vertical-stretch: 0;
                box-keys <=> root.todo-keys;
            }
            if SongsData.health-summary != "": NoticeStrip {
                text: SongsData.health-summary;
                open <=> SongsData.health-open;
                if SongsData.health-open: VerticalLayout {
                    spacing: Space.sm;
                    for h[i] in SongsData.health: HorizontalLayout {
                        spacing: Space.sm;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: h.text;
                                color: Theme.text;
                                font-size: Type.body;
                                wrap: word-wrap;
                            }
                            if h.why != "": Text {
                                text: h.why;
                                color: Theme.muted;
                                font-size: Type.meta;
                                wrap: word-wrap;
                            }
                        }
                        if h.action != "": VerticalLayout {
                            alignment: center;
                            StudioButton {
                                text: h.action;
                                clicked => { SongsData.health-go(i); }
                            }
                        }
                    }
                }
            }
            if SongsData.song.notes != "": Text {
                text: SongsData.song.notes;
                color: Theme.muted;
                font-size: Type.body;
                wrap: word-wrap;
                max-height: 60px;
                overflow: elide;
            }
            TabBar {
                vertical-stretch: 0;
                tabs: SongsData.tabs;
                current <=> SongsData.tab;
            }
            Well {
                vertical-stretch: 1;
                // As tall as the tab on show says it wants to be at the panel's width, so in a narrow window the panel
                // scrolls rather than squeeze it.
                preferred-height: root.tab-height;
                // Overview: the counts, each opening its tab, the arrangement, then the song's runs.
                if SongsData.tab == 0: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.lg;
                    spacing: Space.sm;
                    // They wrap in a narrow panel, each count with the dot before it.
                    FlexboxLayout {
                        vertical-stretch: 0;
                        spacing: Space.sm;
                        for c[i] in SongsData.counts: HorizontalLayout {
                            spacing: Space.sm;
                            if i > 0: Text {
                                text: "·";
                                color: Theme.faint;
                                font-size: Type.body;
                            }
                            LinkText {
                                text: c.text;
                                clicked => { SongsData.tab = c.tab; }
                            }
                            if c.missing != "": LinkText {
                                text: "(" + c.missing + ")";
                                tint: Theme.missing;
                                clicked => { SongsData.tab = c.tab; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            if SongsData.counts.length > 0: Text {
                                text: "·";
                                color: Theme.faint;
                                font-size: Type.body;
                            }
                            LinkText {
                                text: "Its sounds on Presets";
                                clicked => { SongsData.show-presets(); }
                            }
                        }
                    }
                    if SongsData.detail-message != "": Text {
                        text: SongsData.detail-message;
                        color: Theme.muted;
                        font-size: Type.meta;
                        wrap: word-wrap;
                    }
                    ArrangementPreview {
                        vertical-stretch: 1;
                    }
                    if SongsData.runs.length > 1: Caps {
                        text: "RUNS";
                    }
                    for run in SongsData.runs.length > 1 ? SongsData.runs : []: Text {
                        text: run;
                        color: Theme.text;
                        font-size: Type.body;
                    }
                    for w in SongsData.warnings: Text {
                        text: w;
                        color: Theme.warning;
                        font-size: Type.meta;
                        wrap: word-wrap;
                    }
                }
                if SongsData.tab == 1: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    save-menu := RightClickMenu {
                        items: SongsData.save-menu;
                        chosen(id) => { SongsData.save-menu-chosen(id); }
                    }
                    Caps { text: SongsData.saves-heading; }
                    ListView {
                        // A few lines, and never fewer: in a narrow window the panel scrolls instead. As tall as the
                        // room left otherwise.
                        min-height: 160px;
                        preferred-height: 160px;
                        for line in SongsData.saves: Rectangle {
                            height: line.run != "" ? 40px : root.narrow ? 44px : 30px;
                            if line.run != "": HorizontalLayout {
                                padding-top: Space.md;
                                spacing: Space.sm;
                                Text {
                                    text: line.run;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                CutText {
                                    own-mouse: true;
                                    text: line.details;
                                    color: Theme.muted;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                }
                            }
                            // Click a save to pick it for the song's buttons, double-click to open it, right-click for
                            // the same in a menu. Nothing is hidden (Solomon, 4 Nov 2026): the buttons are the card's.
                            if line.run == "": save-line := ListLine {
                              // A click picks the save: the song's own buttons above (Open, Show in folder, Copy path)
                              // then act on it, and so do their keys. No buttons on the line itself, as everywhere else
                              // (the UX review of 10 Nov, B10).
                              selected: line.path == SongsData.picked-save;
                              clicked => { SongsData.pick-save(line.path, line.name); }
                              double-clicked => { SongsData.open-save(line.path); }
                              right-clicked(x, y) => {
                                  SongsData.save-menu-for(line.path);
                                  save-menu.open-at(x, y);
                              }
                              if !root.narrow: HorizontalLayout {
                                padding-left: Space.sm;
                                padding-right: Space.sm;
                                spacing: Space.md;
                                Text {
                                    text: line.date;
                                    width: 96px;
                                    color: Theme.muted;
                                    font-family: Theme.number-font;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                }
                                CutText {
                                    over: save-line.resting;
                                    mouse: save-line.mouse;
                                    text: line.name;
                                    color: line.newest ? Theme.text : Theme.muted;
                                    font-weight: line.newest ? 600 : 400;
                                    font-size: Type.body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if line.missing: Text {
                                    text: "File moved";
                                    color: Theme.missing;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                }
                              }
                              // In a narrow panel: the save's name, then its date and whether it has moved below it.
                              if root.narrow: VerticalLayout {
                                padding-left: Space.sm;
                                padding-right: Space.sm;
                                alignment: center;
                                spacing: Space.xs;
                                CutText {
                                    over: save-line.resting;
                                    mouse: save-line.mouse;
                                    text: line.name;
                                    color: line.newest ? Theme.text : Theme.muted;
                                    font-weight: line.newest ? 600 : 400;
                                    font-size: Type.body;
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Text {
                                        text: line.date;
                                        color: Theme.muted;
                                        font-family: Theme.number-font;
                                        font-size: Type.meta;
                                    }
                                    if line.missing: CutText {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        over: save-line.resting;
                                        mouse: save-line.mouse;
                                        text: "File moved";
                                        color: Theme.missing;
                                        font-size: Type.meta;
                                    }
                                }
                              }
                            }
                        }
                    }
                }
                if SongsData.tab == 2: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.plugins-heading; }
                    ListView {
                        min-height: 160px;
                        preferred-height: 160px;
                        for p in SongsData.plugins: HorizontalLayout {
                            height: 48px;
                            padding-left: Space.sm;
                            padding-right: Space.sm;
                            spacing: Space.md;
                            VerticalLayout {
                                alignment: center;
                                spacing: Space.xs;
                                horizontal-stretch: 1;
                                CutText {
                                    own-mouse: true;
                                    text: p.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                }
                                // In a narrow panel what's wrong comes first on this line, so the name above keeps
                                // the whole width.
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    if root.narrow && !p.installed: PluginTrouble { }
                                    CutText {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        own-mouse: true;
                                        text: p.about;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                    }
                                }
                            }
                            if !root.narrow && !p.installed: PluginTrouble { vertical-alignment: center; }
                        }
                    }
                }
                if SongsData.tab == 3: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.samples-heading; }
                    ListView {
                        min-height: 160px;
                        preferred-height: 160px;
                        for sm in SongsData.samples: HorizontalLayout {
                            height: 48px;
                            padding-left: Space.sm;
                            padding-right: Space.sm;
                            spacing: Space.md;
                            VerticalLayout {
                                alignment: center;
                                spacing: Space.xs;
                                horizontal-stretch: 1;
                                CutText {
                                    own-mouse: true;
                                    text: sm.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                }
                                // As on Plugins: in a narrow panel what's wrong comes first on this line.
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    if root.narrow && (sm.missing || sm.unplayed): SampleTrouble { sample: sm; }
                                    CutText {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        own-mouse: true;
                                        text: sm.folder;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                    }
                                }
                            }
                            if !root.narrow && (sm.missing || sm.unplayed): SampleTrouble {
                                sample: sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if SongsData.tab == 4: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.lg;
                    spacing: Space.sm;
                    alignment: start;
                    if SongsData.detail-message != "": Caps { text: SongsData.detail-message; }
                    if SongsData.tracks != "": Caps { text: "TRACKS"; }
                    if SongsData.tracks != "": Text {
                        text: SongsData.tracks;
                        color: Theme.text;
                        font-size: Type.body;
                        wrap: word-wrap;
                    }
                    if SongsData.details.length > 0: Caps { text: "FROM THE FILE"; }
                    for d in SongsData.details: HorizontalLayout {
                        spacing: Space.md;
                        // At most two fifths of the room inside the panel (its padding and this tab's), its words wrapping,
                        // so in a narrow panel the value keeps room beside it. The panel's own width, which is set by
                        // hand, so this line's width doesn't depend on itself.
                        Text {
                            text: d.name;
                            width: clamp((root.width - 4 * Space.lg) * 0.4, 0px, 160px);
                            color: Theme.muted;
                            font-size: Type.body;
                            wrap: word-wrap;
                        }
                        Text {
                            text: d.value;
                            color: Theme.text;
                            font-size: Type.body;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

export component SongsPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }
    // The card's tag box had the keys (Ctrl+T, or a click in it) as the card closed (Esc in the empty box, its ×, or a
    // read): the box went with the card, and then nothing had the keys, so no key worked until a click (the whole-app
    // review of 14 Nov, AP-1, as Sounds had it on 10 Nov, U-1). They come back to the list. Only then: a card closed
    // by a read meanwhile leaves them where they are (in the search, say). The card is made from this one line.
    property <bool> card-keys;
    // The same for the card's to-do box.
    property <bool> card-todo-keys;
    property <bool> card-shown: SongsData.selected >= 0;
    changed card-shown => {
        if (!self.card-shown && (self.card-keys || self.card-todo-keys)) {
            self.card-keys = false;
            self.card-todo-keys = false;
            keys.focus();
        }
    }
    // The list's headings, with the Songs / Next up switch: Next up lies below them.
    property <length> heads-height: 30px;

    VerticalLayout {
        // In a window wider than the list and the song's panel at their widest, the page stops there (the UX review
        // of 10 Nov, A1): the list a third of the room up to `Fit.narrow-max`, the panel up to twice `Fit.list-max`
        // (its arrangement likes the width), side by side from the left. A list or filter column dragged to another
        // width moves where it stops by as much (the filter column's usual width is 208 px).
        x: 0;
        width: min(root.width, (Widths.songs-filters - 208px) + (Widths.songs-list > 0 ? Widths.songs-list : Fit.narrow-max)
            + 16px + 2 * Fit.list-max + 2 * Space.xl);
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        PageHeader {
            title: "Songs";
            summary: SongsData.count;
            job-line: false;
        }
        search-box := SearchBox {
            // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and Ctrl+Down step
            // through the list from here.
            page-search: true;
            hint: "Search songs, plugins, tags, notes, a key or a year";
            text <=> SongsData.search;
            edited(t) => { SongsData.search-edited(t); }
            key(k) => {
                // Down goes on into the list, as on Sounds and MIDI, when it has a song to go to.
                if (k == Key.DownArrow && SongsData.shown > 0) {
                    keys.focus();
                    SongsData.step(1);
                    return true;
                }
                false
            }
        }
        split := Rectangle {
            vertical-stretch: 1;
            // The filters, in a column at the side as on every page (Solomon, 10 Nov 2026): each one's choices as a
            // tick list with how many songs it would show; more than one of each can be picked.
            // The list, and the picked song's panel beside it. Placed by hand: the list takes a third of the width beside
            // the panel (spec 3.2), never so little that the names can't be read.
            area := Rectangle {
                x: column.room;
                y: 0;
                width: split.width - self.x;
                height: split.height;
                // The list's usual width (a third of the room, within limits), and the widest it may be dragged: never
                // so wide the panel gets under 480 px, but always as wide as its usual width.
                property <length> list-third: clamp((self.width - 16px) / 3, 380px, Fit.narrow-max);
                property <length> list-most: max(self.list-third, self.width - 16px - 480px);
                // Up and Down step through the list once it has the keys (a line clicked, or Down from the search box).
                // Esc goes on to the window, whose one step back (app.escape) clears the search, then puts the panel away.
                keys := FocusScope {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    // The same width whether a song is picked or not: the panel's place is always there (review B1), so
                    // nothing moves when one is picked. A third of the room until its seam is dragged, then the width
                    // it was dragged to; never so wide the panel gets under 480 px.
                    width: Widths.songs-list > 0
                        ? clamp(Widths.songs-list, Widths.least("songs.list"), area.list-most)
                        : area.list-third;
                    key-pressed(event) => {
                        // Not under Next up: the list it would step through isn't on show.
                        if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta || SongsData.next-up) {
                            return reject;
                        }
                        if (event.text == Key.UpArrow) {
                            SongsData.step(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            SongsData.step(1);
                            return accept;
                        }
                        reject
                    }
                    list-well := Well {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width;
                        // Narrow beside the panel: the status goes beside the name and what's missing after the details,
                        // so the name keeps its room.
                        property <bool> wide: self.width > 640px;
                        if SongsData.message != "": EmptyState {
                            title: SongsData.message;
                            text: SongsData.message-text;
                        }
                        if SongsData.message == "": HorizontalLayout {
                            ListBox {
                                horizontal-stretch: 1;
                                turned: list.content-y;
                                after: list.row-height;
                                to-top => { list.to-top(); }
                                // Its scroll bar (the list's own is off).
                                whole: list.rows * list.row-height;
                                seen: list.visible-height;
                                scroll-to(y) => { list.scroll-to(y); }
                                VerticalLayout {
                                    if !SongsData.any-filter && SongsData.dust-lines.length > 0: DustOffCard { }
                                    // The list or Next up, then the headings, which order the list: a click goes by that
                                    // column, a second turns it round.
                                    HorizontalLayout {
                                        height: root.heads-height;
                                        padding-left: Space.xs + Space.md;
                                        padding-right: Space.xs + Space.md;
                                        spacing: Space.md;
                                        switch := ListSwitch {
                                            y: (parent.height - self.height) / 2;
                                        }
                                        name-head := ColumnHead {
                                            horizontal-stretch: 1;
                                            text: "SONG";
                                            on: SongsData.order-column == "Song";
                                            // A to Z first.
                                            up: !SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Song"); }
                                        }
                                        if list-well.wide: ColumnHead {
                                            width: Widths.songs-status;
                                            part: "songs.status";
                                            resizing(w) => { Widths.songs-status = w; }
                                            // Never so wide the name column beside it gets under 120 px (under the
                                            // Songs / Next up switch and the Song heading, the rows' names have both).
                                            most: self.width + max(0px, switch.width + Space.md + name-head.width - 120px);
                                            right: true;
                                            text: "STATUS";
                                            on: SongsData.order-column == "Status";
                                            up: SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Status"); }
                                        }
                                        ColumnHead {
                                            width: Widths.songs-time;
                                            part: "songs.time";
                                            resizing(w) => { Widths.songs-time = w; }
                                            most: self.width + max(0px, switch.width + Space.md + name-head.width - 120px);
                                            right: true;
                                            text: "TIME";
                                            tip: "Time spent in FL Studio";
                                            on: SongsData.order-column == "Time";
                                            // Most first.
                                            up: SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Time"); }
                                        }
                                        ColumnHead {
                                            width: Widths.songs-saved;
                                            part: "songs.saved";
                                            resizing(w) => { Widths.songs-saved = w; }
                                            // Never so wide the name column beside it gets under 120 px (under the
                                            // Songs / Next up switch and the Song heading, the rows' names have both).
                                            most: self.width + max(0px, switch.width + Space.md + name-head.width - 120px);
                                            right: true;
                                            text: "LAST SAVED";
                                            on: SongsData.order-column == "Last saved";
                                            up: SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Last saved"); }
                                        }
                                    }
                                    list := ListView {
                                        own-bar: true;
                                        horizontal-stretch: 1;
                                        row-height: SongsData.line-height;
                                        rows: SongsData.lines.length;
                                        show-top: SongsData.show-y;
                                        show-ask: SongsData.show-ask;
                                        show-done <=> SongsData.show-done;
                                        kept-y <=> SongsData.list-y;
                                        for line in SongsData.lines: Rectangle {
                                            // Every line this height: the list counts on it.
                                            height: SongsData.line-height;
                                            if line.heading != "": Caps {
                                                x: Space.lg;
                                                y: parent.height - self.height - Space.sm;
                                                text: line.heading;
                                            }
                                            if line.heading == "": song-line := ListLine {
                                                x: Space.xs;
                                                width: parent.width - 2 * Space.xs;
                                                selected: line.row == SongsData.selected;
                                                // The date's tooltip, over the date at the right.
                                                tip: line.date-tip;
                                                tip-from: self.width - Space.md - Widths.songs-saved;
                                                clicked => {
                                                    SongsData.select(line.row);
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    SongsData.select(line.row);
                                                    SongsData.open();
                                                }
                                                // The line is picked first (ListLine does that), so the menu acts on it.
                                                right-clicked(x, y) => {
                                                    keys.focus();
                                                    SongsData.song-menu-for(line.row);
                                                    song-menu.open-at(x, y);
                                                }
                                                // The DAW's colour, as a thin bar at the left (the design system's song row).
                                                Rectangle {
                                                    x: Space.xs + 2px;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 3px;
                                                    height: parent.height - 2 * Space.md;
                                                    border-radius: 1.5px;
                                                    background: Theme.daw(line.daw);
                                                }
                                                HorizontalLayout {
                                                    padding-left: Space.md;
                                                    padding-right: Space.md;
                                                    spacing: Space.md;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        horizontal-stretch: 1;
                                                        HorizontalLayout {
                                                            spacing: Space.sm;
                                                            alignment: start;
                                                            CutText {
                                                                over: song-line.resting;
                                                                mouse: song-line.mouse;
                                                                text: line.name;
                                                                color: Theme.text;
                                                                font-size: Type.row-title;
                                                                font-weight: 500;
                                                            }
                                                            if line.favourite: Heart { y: (parent.height - self.height) / 2; }
                                                            // To-dos left: the list sign and how many.
                                                            if line.todos > 0: SignCount {
                                                                icon: Icons.todo;
                                                                text: line.todos;
                                                            }
                                                            // Its status as a small tag beside the name (the UX review of 10 Nov,
                                                            // C5): one of the main things the list is filtered by. A wide list
                                                            // has it in a column of its own.
                                                            if line.status != "" && !list-well.wide: Rectangle {
                                                                y: (parent.height - self.height) / 2;
                                                                width: status-tag.preferred-width + 2 * Space.sm;
                                                                height: 18px;
                                                                border-radius: 9px;
                                                                border-width: 1px;
                                                                border-color: Theme.edge;
                                                                status-tag := Text {
                                                                    text: line.status;
                                                                    color: Theme.muted;
                                                                    font-size: Type.tiny;
                                                                }
                                                            }
                                                        }
                                                        // Then what's missing, in red (Solomon, 15 Nov 2026: "should be
                                                        // able to see if a song has something missing without seeing
                                                        // its card"). The details give way to it first. A wide list has
                                                        // it in a column of its own.
                                                        HorizontalLayout {
                                                            alignment: start;
                                                            spacing: Space.xs;
                                                            CutText {
                                                                over: song-line.resting;
                                                                mouse: song-line.mouse;
                                                                text: line.details
                                                                    + (line.missing-words != "" && !list-well.wide && line.details != "" ? " ·" : "");
                                                                color: Theme.muted;
                                                                font-size: Type.meta;
                                                                // A text's stretch is 0 unless it's given one: both
                                                                // would give way alike.
                                                                horizontal-stretch: 1;
                                                            }
                                                            if line.missing-words != "" && !list-well.wide: CutText {
                                                                over: song-line.resting;
                                                                mouse: song-line.mouse;
                                                                text: line.missing-words;
                                                                color: Theme.missing;
                                                                font-size: Type.meta;
                                                                horizontal-stretch: 0;
                                                            }
                                                        }
                                                    }
                                                    if list-well.wide: VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        width: Widths.songs-status;
                                                        CutText {
                                                            over: song-line.resting;
                                                            mouse: song-line.mouse;
                                                            text: line.missing;
                                                            color: Theme.missing;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                        if line.status != "": Text {
                                                            text: line.status;
                                                            color: Theme.muted;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: Widths.songs-time;
                                                        Text {
                                                            x: 0;
                                                            width: parent.width;
                                                            text: line.time;
                                                            color: Theme.muted;
                                                            font-family: Theme.number-font;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        width: Widths.songs-saved;
                                                        Text {
                                                            text: line.date;
                                                            color: Theme.muted;
                                                            font-family: Theme.number-font;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                        if line.rating > 0: HorizontalLayout {
                                                            alignment: end;
                                                            Stars { rating: line.rating; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if SongsData.years.length > 1 && !SongsData.next-up: YearRange {
                                width: 56px;
                                framed: false;
                                years: SongsData.years;
                                picked-from: SongsData.years-from;
                                picked-to: SongsData.years-to;
                                picked(a, b) => { SongsData.years-picked(a, b); }
                                cleared => { SongsData.years-cleared(); }
                            }
                        }
                        // Over the empty list (which stays, so a song shown from elsewhere still scrolls into sight),
                        // beside the year strip: what Sounds and MIDI say when nothing matches (review X3-7).
                        if SongsData.message == "" && SongsData.shown == 0: EmptyState {
                            x: 0;
                            y: 0;
                            width: parent.width - (SongsData.years.length > 1 ? 56px : 0px);
                            height: parent.height;
                            title: "No songs match";
                            text: "Try fewer filters or other words.";
                            action: SongsData.any-filter ? "Clear the filters" : "";
                            act => { SongsData.clear(); }
                        }
                        // Next up, over the list, its headings and the year strip, with the switch at its top again.
                        if SongsData.message == "" && SongsData.next-up: Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: Theme.radius;
                            background: Theme.well;
                            // Clicks and the wheel stop here: the list under it isn't on show.
                            TouchArea {
                                scroll-event(e) => { accept }
                            }
                            VerticalLayout {
                                HorizontalLayout {
                                    height: root.heads-height;
                                    padding-left: Space.xs + Space.md;
                                    alignment: start;
                                    ListSwitch {
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                NextUpList {
                                    vertical-stretch: 1;
                                }
                            }
                        }
                    }
                }
                if root.card-shown: SongPanel {
                    x: keys.width + 16px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - self.x;
                    tag-keys <=> root.card-keys;
                    todo-keys <=> root.card-todo-keys;
                }
                if !root.card-shown: SidePanel {
                    x: keys.width + 16px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - self.x;
                    closable: false;
                    EmptyState {
                        vertical-stretch: 1;
                        title: "Pick a song";
                    }
                }
                // The gap between the list and the panel: drag it to give the list more or less room.
                Seam {
                    x: keys.width;
                    width: 16px;
                    height: parent.height;
                    part: "songs.list";
                    now: keys.width;
                    most: max(self.least, min(Widths.most("songs.list"), area.list-most));
                    resizing(w) => { Widths.songs-list = w; }
                }
                // A song line's right-click menu: the panel's buttons, each with its key (rule 15; review X3-24).
                song-menu := RightClickMenu {
                    items: SongsData.song-menu;
                    chosen(id) => { SongsData.song-menu-chosen(id); }
                }
            }
            // After the list, so the opened column of a narrow window lies over it.
            column := FilterColumn {
                part: "songs.filters";
                // The list and the panel at their least beside it.
                keep-room: 320px + 16px + 480px;
                wide: Widths.songs-filters;
                resizing(w) => { Widths.songs-filters = w; }
                page-width: split.width;
                height: split.height;
                active: SongsData.any-filter;
                FilterList {
                    name: "DAW";
                    filter: SongsData.daw-filter;
                    toggled(text) => { SongsData.toggle-choice("daw", text); }
                    cleared => { SongsData.clear-chip("daw"); }
                }
                FilterList {
                    name: "STATUS";
                    filter: SongsData.status-filter;
                    toggled(text) => { SongsData.toggle-choice("status", text); }
                    cleared => { SongsData.clear-chip("status"); }
                }
                if SongsData.tag-filter.chips.length + SongsData.tag-filter.more.length > 0: FilterList {
                    name: "TAG";
                    more-name: "More tags";
                    filter: SongsData.tag-filter;
                    toggled(text) => { SongsData.toggle-choice("tag", text); }
                    cleared => { SongsData.clear-chip("tag"); }
                }
                VerticalLayout {
                    Caps {
                        text: "SHOW ONLY";
                        height: 22px;
                    }
                    TickLine {
                        text: "Favourites";
                        on: SongsData.favourites;
                        clicked => { SongsData.toggle("favourites"); }
                    }
                    TickLine {
                        text: "Missing something";
                        on: SongsData.missing;
                        clicked => { SongsData.toggle("missing"); }
                    }
                    TickLine {
                        text: "Has to-dos";
                        on: SongsData.has-todos;
                        clicked => { SongsData.toggle("todos"); }
                    }
                    if SongsData.only != "": TickLine {
                        text: SongsData.only;
                        on: true;
                        clicked => { SongsData.toggle("only"); }
                    }
                }
                TickLine {
                    text: "Hide archived";
                    on: SongsData.hide-archived;
                    clicked => { SongsData.toggle("hide-archived"); }
                }
                if SongsData.any-filter: HorizontalLayout {
                    alignment: start;
                    StudioButton {
                        text: "Clear filters";
                        clicked => { SongsData.clear(); }
                    }
                }
            }
        }
    }
}
