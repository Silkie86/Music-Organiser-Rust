// The Songs page: one line per song, newest save first, under time headings, with search, filter chips and a year
// scrubber, and the picked song's panel beside it. Agreed with Solomon on 2026-10-31.
import { ListView } from "std-widgets.slint";
import { Theme, Well, SearchBox, ToggleChip, MenuChip, ListLine, Stars, YearMark, Caps, Heart, CloseButton, TabBar, LinkText, StudioButton } from "../studio.slint";

// One line of the list: a heading ("This week", "2019") when `heading` isn't empty, else a song.
export struct SongLine {
    heading: string,
    // Where the song is in the page's rows (mo-app's `Songs::rows`), for picking it.
    row: int,
    name: string,
    details: string,
    date: string,
    date-tip: string,
    missing: string,
    rating: int,
    favourite: bool,
    status: string,
    daw: string,
}

// Where a year starts in the list, for the scrubber.
export struct YearStart {
    year: string,
    y: length,
}

// One of Overview's counts ("9 plugins", "3 missing"), opening the tab at `tab`.
export struct CountLine {
    text: string,
    missing: string,
    tab: int,
}

export struct PluginLine {
    name: string,
    about: string,
    installed: bool,
}

export struct SampleLine {
    name: string,
    folder: string,
    path: string,
    missing: bool,
    unplayed: bool,
}

// One line of the Saves tab: a run's heading when `run` isn't empty, else a save.
export struct SaveLine {
    run: string,
    details: string,
    name: string,
    date: string,
    path: string,
    missing: bool,
    newest: bool,
}

export struct DetailPair {
    name: string,
    value: string,
}

// The picked song, for its panel.
export struct PanelSong {
    daw: string,
    facts: string,
    name: string,
    saves: string,
    status: string,
    rating: int,
    favourite: bool,
    key: string,
    // The key was worked out from the notes, not typed in.
    key-heard: bool,
    tags: string,
    notes: string,
}

// What the page shows and what it reports, filled and answered by mo-ui's songs.rs.
export global SongsData {
    in property <[SongLine]> lines;
    in property <[YearStart]> years;
    in property <string> count;
    // Shown instead of the list while it loads, or when the library can't be read.
    in property <string> message: "Reading your library…";
    in-out property <string> search;
    in property <[string]> daws;
    in property <[string]> statuses;
    in property <[string]> tags;
    in property <string> daw;
    in property <string> status;
    in property <string> tag;
    in property <bool> favourites;
    in property <bool> missing;
    in property <bool> hide-archived;
    in property <bool> any-filter;
    in property <int> selected: -1;
    // The song panel, shown while a song is picked.
    in property <PanelSong> song;
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <[CountLine]> counts;
    in property <[string]> runs;
    // "Reading…" while the newest save's record loads, or why it couldn't be read.
    in property <string> detail-message;
    in property <string> plugins-heading;
    in property <[PluginLine]> plugins;
    in property <string> samples-heading;
    in property <[SampleLine]> samples;
    in property <string> saves-heading;
    in property <[SaveLine]> saves;
    in property <string> tracks;
    in property <[DetailPair]> details;
    in property <[string]> warnings;
    callback search-edited(string);
    callback pick(string, string);
    callback toggle(string);
    callback clear();
    callback select(int);
    // Opens the picked song's newest save in its DAW.
    callback open();
    // Opens one save of the picked song, by its path.
    callback open-save(string);
    callback reveal();
    callback copy-path();
    callback close-panel();
    // Every line is one of two heights, so a year's place in the list can be worked out.
    out property <length> heading-height: 34px;
    out property <length> song-height: 54px;
}

// The picked song: what it is, its counts and its tabs. Read-only until the Rust app's database is trusted.
component SongPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;

    VerticalLayout {
        padding: 20px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 0;
            Text {
                text: SongsData.song.daw;
                color: SongsData.song.daw == "FL Studio" ? Theme.fl-studio : SongsData.song.daw == "Bitwig" || SongsData.song.daw == "Bitwig Studio" ? Theme.bitwig : SongsData.song.daw == "Studio One" ? Theme.studio-one : Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: SongsData.song.facts;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            CloseButton {
                clicked => { SongsData.close-panel(); }
            }
        }
        Text {
            text: SongsData.song.name;
            color: Theme.text;
            font-size: 22px;
            font-weight: 600;
            overflow: elide;
        }
        if SongsData.song.saves != "": Text {
            text: SongsData.song.saves;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            padding-top: 4px;
            padding-bottom: 6px;
            vertical-stretch: 0;
            Text {
                text: SongsData.song.status;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            if SongsData.song.rating > 0: VerticalLayout {
                alignment: center;
                Stars { rating: SongsData.song.rating; }
            }
            if SongsData.song.favourite: HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Heart { }
                }
                Text {
                    text: "Favourite";
                    color: Theme.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            if SongsData.song.key != "": HorizontalLayout {
                spacing: 6px;
                Caps {
                    text: "KEY";
                    vertical-alignment: center;
                }
                Text {
                    text: SongsData.song.key + (SongsData.song.key-heard ? " (from the notes)" : "");
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            if SongsData.song.tags != "": Text {
                text: SongsData.song.tags;
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            vertical-stretch: 0;
            padding-bottom: 4px;
            StudioButton {
                text: "Open in " + SongsData.song.daw;
                main: true;
                clicked => { SongsData.open(); }
            }
            StudioButton {
                text: "Show in folder";
                clicked => { SongsData.reveal(); }
            }
            StudioButton {
                text: "Copy path";
                clicked => { SongsData.copy-path(); }
            }
        }
        if SongsData.song.notes != "": Text {
            text: SongsData.song.notes;
            color: Theme.muted;
            font-size: 13px;
            wrap: word-wrap;
            max-height: 60px;
            overflow: elide;
        }
        TabBar {
            vertical-stretch: 0;
            tabs: SongsData.tabs;
            current <=> SongsData.tab;
        }
        Well {
            vertical-stretch: 1;
            // Overview: the counts, each opening its tab, then the song's runs.
            if SongsData.tab == 0: VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for c[i] in SongsData.counts: HorizontalLayout {
                        spacing: 6px;
                        if i > 0: Text {
                            text: "·";
                            color: Theme.faint;
                            font-size: 13px;
                        }
                        LinkText {
                            text: c.text;
                            clicked => { SongsData.tab = c.tab; }
                        }
                        if c.missing != "": LinkText {
                            text: "(" + c.missing + ")";
                            tint: Theme.missing;
                            clicked => { SongsData.tab = c.tab; }
                        }
                    }
                }
                if SongsData.detail-message != "": Text {
                    text: SongsData.detail-message;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if SongsData.runs.length > 1: Caps {
                    text: "RUNS";
                }
                for run in SongsData.runs.length > 1 ? SongsData.runs : []: Text {
                    text: run;
                    color: Theme.text;
                    font-size: 13px;
                }
                for w in SongsData.warnings: Text {
                    text: w;
                    color: Theme.warning;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if SongsData.tab == 1: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Caps { text: SongsData.saves-heading; }
                ListView {
                    for line in SongsData.saves: Rectangle {
                        height: line.run != "" ? 40px : 30px;
                        if line.run != "": HorizontalLayout {
                            padding-top: 12px;
                            spacing: 10px;
                            Text {
                                text: line.run;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: line.details;
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // Double-click a save to open it.
                        if line.run == "": ListLine {
                          double-clicked => { SongsData.open-save(line.path); }
                          HorizontalLayout {
                            padding-left: 8px;
                            spacing: 12px;
                            Text {
                                text: line.date;
                                width: 96px;
                                color: Theme.muted;
                                font-family: Theme.number-font;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: line.name;
                                color: line.newest ? Theme.text : Theme.muted;
                                font-weight: line.newest ? 600 : 400;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if line.missing: Text {
                                text: "File moved";
                                color: Theme.missing;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                          }
                        }
                    }
                }
            }
            if SongsData.tab == 2: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.plugins-heading; }
                ListView {
                    for p in SongsData.plugins: HorizontalLayout {
                        height: 44px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: p.name;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Text {
                                text: p.about;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        if !p.installed: Text {
                            text: "Not installed";
                            color: Theme.missing;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if SongsData.tab == 3: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.samples-heading; }
                ListView {
                    for sm in SongsData.samples: HorizontalLayout {
                        height: 44px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: sm.name;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Text {
                                text: sm.folder;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        if sm.missing || sm.unplayed: Text {
                            text: sm.missing ? "Can't be found" : "Loaded, never played";
                            color: sm.missing ? Theme.missing : Theme.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if SongsData.tab == 4: VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;
                if SongsData.detail-message != "": Caps { text: SongsData.detail-message; }
                if SongsData.tracks != "": Caps { text: "TRACKS"; }
                if SongsData.tracks != "": Text {
                    text: SongsData.tracks;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if SongsData.details.length > 0: Caps { text: "FROM THE FILE"; }
                for d in SongsData.details: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: d.name;
                        width: 160px;
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    Text {
                        text: d.value;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

export component SongsPage inherits Rectangle {
    forward-focus: search-box;

    VerticalLayout {
        padding: 28px;
        padding-bottom: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 0;
            Text {
                text: "Songs";
                font-size: 24px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: SongsData.count;
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        search-box := SearchBox {
            hint: "Search songs, plugins, tags, notes, a key or a year";
            text <=> SongsData.search;
            edited(t) => { SongsData.search-edited(t); }
            key(k) => {
                if (k == Key.Escape && SongsData.search != "") {
                    SongsData.search = "";
                    SongsData.search-edited("");
                    return true;
                }
                // With the search already empty, Esc puts the song panel away.
                if (k == Key.Escape && SongsData.selected >= 0) {
                    SongsData.close-panel();
                    return true;
                }
                false
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            vertical-stretch: 0;
            MenuChip {
                name: "DAW";
                value: SongsData.daw;
                choices: SongsData.daws;
                picked(v) => { SongsData.pick("daw", v); }
            }
            MenuChip {
                name: "Status";
                value: SongsData.status;
                choices: SongsData.statuses;
                picked(v) => { SongsData.pick("status", v); }
            }
            MenuChip {
                name: "Tag";
                value: SongsData.tag;
                choices: SongsData.tags;
                picked(v) => { SongsData.pick("tag", v); }
            }
            ToggleChip {
                text: "Favourites";
                on: SongsData.favourites;
                clicked => { SongsData.toggle("favourites"); }
            }
            ToggleChip {
                text: "Missing something";
                on: SongsData.missing;
                clicked => { SongsData.toggle("missing"); }
            }
            ToggleChip {
                text: "Hide archived";
                on: SongsData.hide-archived;
                clicked => { SongsData.toggle("hide-archived"); }
            }
            if SongsData.any-filter: ToggleChip {
                text: "Clear";
                on: false;
                clicked => { SongsData.clear(); }
            }
        }
        // The list, and the picked song's panel beside it. Placed by hand: the list takes a third of the width beside
        // the panel (spec 3.2), never so little that the names can't be read.
        area := Rectangle {
            vertical-stretch: 1;
            list-well := Well {
                x: 0;
                y: 0;
                height: parent.height;
                width: SongsData.selected >= 0 ? max(380px, (parent.width - 16px) / 3) : parent.width;
                // Narrow beside the panel: what's missing and the status make room for the name.
                property <bool> wide: SongsData.selected < 0 || self.width > 640px;
                if SongsData.message != "": Text {
                    text: SongsData.message;
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if SongsData.message == "": HorizontalLayout {
                    list := ListView {
                        horizontal-stretch: 1;
                        for line in SongsData.lines: Rectangle {
                            height: line.heading != "" ? SongsData.heading-height : SongsData.song-height;
                            if line.heading != "": Caps {
                                x: 16px;
                                y: parent.height - self.height - 6px;
                                text: line.heading;
                            }
                            if line.heading == "": ListLine {
                                x: 4px;
                                width: parent.width - 8px;
                                selected: line.row == SongsData.selected;
                                clicked => { SongsData.select(line.row); }
                            double-clicked => {
                                SongsData.select(line.row);
                                SongsData.open();
                            }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: line.name;
                                                color: Theme.text;
                                                font-size: 14px;
                                                font-weight: 500;
                                                overflow: elide;
                                            }
                                            if line.favourite: Heart { y: (parent.height - self.height) / 2; }
                                        }
                                        Text {
                                            text: line.details;
                                            color: Theme.muted;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    if list-well.wide: VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        width: 150px;
                                        Text {
                                            text: line.missing;
                                            color: Theme.missing;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                        }
                                        if line.status != "": Text {
                                            text: line.status;
                                            color: Theme.muted;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        width: 90px;
                                        Text {
                                            text: line.date;
                                            color: Theme.muted;
                                            font-family: Theme.number-font;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                        if line.rating > 0: HorizontalLayout {
                                            alignment: end;
                                            Stars { rating: line.rating; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The year scrubber: jump to the first song of a year.
                    if SongsData.years.length > 1: VerticalLayout {
                        width: 52px;
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        for y in SongsData.years: YearMark {
                            text: y.year;
                            // Never past the end, so the last year doesn't leave the list mostly empty.
                            clicked => { list.content-y = -min(y.y, max(0px, list.content-height - list.visible-height)); }
                        }
                    }
                }
            }
            if SongsData.selected >= 0: SongPanel {
                x: list-well.width + 16px;
                y: 0;
                height: parent.height;
                width: parent.width - self.x;
            }
        }
    }
}
