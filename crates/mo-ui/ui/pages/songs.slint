// The Songs page: one line per song, newest save first, under time headings, with search, filter chips and a year
// scrubber, and the picked song's panel beside it. Agreed with Solomon on 2026-10-31.
import { ListView } from "std-widgets.slint";
import { Theme, Type, Space, Well, SearchBox, ToggleChip, MenuChip, ListLine, Stars, YearMark, Caps, Heart, CloseButton, TabBar, LinkText, StudioButton, ActionKey, MenuLine, Groove } from "../studio.slint";

// One line of the list: a heading ("This week", "2019") when `heading` isn't empty, else a song.
export struct SongLine {
    heading: string,
    // Where the song is in the page's rows (mo-app's `Songs::rows`), for picking it.
    row: int,
    name: string,
    details: string,
    date: string,
    date-tip: string,
    missing: string,
    rating: int,
    favourite: bool,
    status: string,
    daw: string,
}

// Where a year starts in the list, for the scrubber.
export struct YearStart {
    year: string,
    y: length,
}

// One of Overview's counts ("9 plugins", "3 missing"), opening the tab at `tab`.
export struct CountLine {
    text: string,
    missing: string,
    tab: int,
}

export struct PluginLine {
    name: string,
    about: string,
    installed: bool,
}

export struct SampleLine {
    name: string,
    folder: string,
    path: string,
    missing: bool,
    unplayed: bool,
}

// One line of the Saves tab: a run's heading when `run` isn't empty, else a save.
export struct SaveLine {
    run: string,
    details: string,
    name: string,
    date: string,
    path: string,
    missing: bool,
    newest: bool,
}

// One line of the song panel's Older saves menu: clicking it opens `path`.
export struct OlderLine {
    text: string,
    path: string,
}

// One line of the song's Health strip, with its button when `action` isn't empty.
export struct HealthLine {
    text: string,
    why: string,
    action: string,
}

export struct DetailPair {
    name: string,
    value: string,
}

// The picked song, for its panel.
export struct PanelSong {
    daw: string,
    facts: string,
    name: string,
    saves: string,
    status: string,
    rating: int,
    favourite: bool,
    key: string,
    // The key was worked out from the notes, not typed in.
    key-heard: bool,
    tags: string,
    notes: string,
}

// What the page shows and what it reports, filled and answered by mo-ui's songs.rs.
export global SongsData {
    in property <[SongLine]> lines;
    in property <[YearStart]> years;
    in property <string> count;
    // Shown instead of the list while it loads, or when the library can't be read.
    in property <string> message: "Reading your library…";
    in-out property <string> search;
    in property <[string]> daws;
    in property <[string]> statuses;
    in property <[string]> tags;
    in property <string> daw;
    in property <string> status;
    in property <string> tag;
    in property <bool> favourites;
    in property <bool> missing;
    in property <bool> hide-archived;
    in property <bool> any-filter;
    in property <int> selected: -1;
    // Bring a song into view: its line's top in the list, and a count that goes up each time it's asked.
    in property <length> show-y;
    in property <int> show-ask;
    // The song panel, shown while a song is picked.
    in property <PanelSong> song;
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <[CountLine]> counts;
    in property <[string]> runs;
    // "Reading…" while the newest save's record loads, or why it couldn't be read.
    in property <string> detail-message;
    in property <string> plugins-heading;
    in property <[PluginLine]> plugins;
    in property <string> samples-heading;
    in property <[SampleLine]> samples;
    in property <string> saves-heading;
    in property <[SaveLine]> saves;
    // The Older saves menu: "VERSIONS" or "RECENT SAVES", its lines, and "See all 12 saves". No lines, no button.
    in property <string> older-heading;
    in property <[OlderLine]> older;
    in property <string> older-see-all;
    // Where the Saves tab is in `tabs`, for "See all".
    in property <int> saves-tab;
    in property <string> tracks;
    in property <[DetailPair]> details;
    in property <[string]> warnings;
    // The Health strip: folded to its summary line until opened.
    in property <string> health-summary;
    in property <[HealthLine]> health;
    in-out property <bool> health-open;
    callback health-go(int);
    callback search-edited(string);
    callback pick(string, string);
    callback toggle(string);
    callback clear();
    callback select(int);
    // The buttons' tooltips and keys, from the shortcut list.
    in property <ActionKey> open-key;
    in property <ActionKey> reveal-key;
    in property <ActionKey> copy-key;
    // Opens the picked song's newest save in its DAW.
    callback open();
    // Opens one save of the picked song, by its path.
    callback open-save(string);
    callback reveal();
    callback copy-path();
    callback close-panel();
    // Every line is one of two heights, so a year's place in the list can be worked out.
    out property <length> heading-height: 38px;
    out property <length> song-height: 62px;
}

// The picked song: what it is, its counts and its tabs. Read-only until the Rust app's database is trusted.
component SongPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;

    VerticalLayout {
        padding: Space.lg;
        padding-bottom: Space.md;
        spacing: Space.sm;
        HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            Text {
                text: SongsData.song.daw;
                color: Theme.daw(SongsData.song.daw);
                font-size: Type.meta;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: SongsData.song.facts;
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            CloseButton {
                clicked => { SongsData.close-panel(); }
            }
        }
        Text {
            text: SongsData.song.name;
            color: Theme.text;
            font-size: Type.panel-title;
            font-weight: 600;
            overflow: elide;
        }
        if SongsData.song.saves != "": Text {
            text: SongsData.song.saves;
            color: Theme.muted;
            font-size: Type.meta;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Space.md;
            alignment: start;
            padding-top: Space.xs;
            padding-bottom: Space.sm;
            vertical-stretch: 0;
            Text {
                text: SongsData.song.status;
                color: Theme.text;
                font-size: Type.body;
                vertical-alignment: center;
            }
            if SongsData.song.rating > 0: VerticalLayout {
                alignment: center;
                Stars { rating: SongsData.song.rating; }
            }
            if SongsData.song.favourite: HorizontalLayout {
                spacing: Space.xs;
                VerticalLayout {
                    alignment: center;
                    Heart { }
                }
                Text {
                    text: "Favourite";
                    color: Theme.muted;
                    font-size: Type.body;
                    vertical-alignment: center;
                }
            }
            if SongsData.song.key != "": HorizontalLayout {
                spacing: Space.sm;
                Caps {
                    text: "KEY";
                    vertical-alignment: center;
                }
                Text {
                    text: SongsData.song.key + (SongsData.song.key-heard ? " (from the notes)" : "");
                    color: Theme.text;
                    font-size: Type.body;
                    vertical-alignment: center;
                }
            }
            if SongsData.song.tags != "": Text {
                text: SongsData.song.tags;
                color: Theme.muted;
                font-size: Type.body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            vertical-stretch: 0;
            padding-bottom: Space.xs;
            StudioButton {
                text: "Open in " + SongsData.song.daw;
                main: true;
                tip: SongsData.open-key.what;
                key: SongsData.open-key.key;
                clicked => { SongsData.open(); }
            }
            if SongsData.older.length > 0: HorizontalLayout {
                older-button := StudioButton {
                    text: "Older saves";
                    menu: true;
                    clicked => { older-menu.show(); }
                }
                older-menu := PopupWindow {
                    x: 0;
                    y: older-button.height + Space.xs;
                    width: max(older-button.width, 320px);
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.edge;
                        drop-shadow-color: Theme.shadow;
                        drop-shadow-blur: 12px;
                        VerticalLayout {
                            padding: Space.xs;
                            Caps {
                                text: SongsData.older-heading;
                                height: self.preferred-height + Space.sm;
                                vertical-alignment: center;
                                x: Space.sm;
                            }
                            for line in SongsData.older: MenuLine {
                                text: line.text;
                                clicked => { SongsData.open-save(line.path); }
                            }
                            Groove { }
                            MenuLine {
                                text: SongsData.older-see-all;
                                clicked => { SongsData.tab = SongsData.saves-tab; }
                            }
                        }
                    }
                }
            }
            StudioButton {
                text: "Show in folder";
                tip: SongsData.reveal-key.what;
                key: SongsData.reveal-key.key;
                clicked => { SongsData.reveal(); }
            }
            StudioButton {
                text: "Copy path";
                tip: SongsData.copy-key.what;
                key: SongsData.copy-key.key;
                clicked => { SongsData.copy-path(); }
            }
        }
        if SongsData.health-summary != "": Rectangle {
            vertical-stretch: 0;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.warning.transparentize(60%);
            background: Theme.warning.transparentize(92%);
            height: strip.preferred-height;
            strip := VerticalLayout {
                padding: Space.sm;
                padding-left: Space.md;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        text: SongsData.health-summary;
                        color: Theme.warning;
                        font-size: Type.body;
                        font-weight: 500;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LinkText {
                        text: SongsData.health-open ? "Hide" : "Show";
                        tint: Theme.muted;
                        font-size: Type.meta;
                        clicked => { SongsData.health-open = !SongsData.health-open; }
                    }
                }
                if SongsData.health-open: VerticalLayout {
                    spacing: Space.sm;
                    for h[i] in SongsData.health: HorizontalLayout {
                        spacing: Space.sm;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: h.text;
                                color: Theme.text;
                                font-size: Type.body;
                                wrap: word-wrap;
                            }
                            if h.why != "": Text {
                                text: h.why;
                                color: Theme.muted;
                                font-size: Type.meta;
                                wrap: word-wrap;
                            }
                        }
                        if h.action != "": VerticalLayout {
                            alignment: center;
                            StudioButton {
                                text: h.action;
                                clicked => { SongsData.health-go(i); }
                            }
                        }
                    }
                }
            }
        }
        if SongsData.song.notes != "": Text {
            text: SongsData.song.notes;
            color: Theme.muted;
            font-size: Type.body;
            wrap: word-wrap;
            max-height: 60px;
            overflow: elide;
        }
        TabBar {
            vertical-stretch: 0;
            tabs: SongsData.tabs;
            current <=> SongsData.tab;
        }
        Well {
            vertical-stretch: 1;
            // Overview: the counts, each opening its tab, then the song's runs.
            if SongsData.tab == 0: VerticalLayout {
                padding: Space.lg;
                spacing: Space.sm;
                alignment: start;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    for c[i] in SongsData.counts: HorizontalLayout {
                        spacing: Space.sm;
                        if i > 0: Text {
                            text: "·";
                            color: Theme.faint;
                            font-size: Type.body;
                        }
                        LinkText {
                            text: c.text;
                            clicked => { SongsData.tab = c.tab; }
                        }
                        if c.missing != "": LinkText {
                            text: "(" + c.missing + ")";
                            tint: Theme.missing;
                            clicked => { SongsData.tab = c.tab; }
                        }
                    }
                }
                if SongsData.detail-message != "": Text {
                    text: SongsData.detail-message;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
                if SongsData.runs.length > 1: Caps {
                    text: "RUNS";
                }
                for run in SongsData.runs.length > 1 ? SongsData.runs : []: Text {
                    text: run;
                    color: Theme.text;
                    font-size: Type.body;
                }
                for w in SongsData.warnings: Text {
                    text: w;
                    color: Theme.warning;
                    font-size: Type.meta;
                    wrap: word-wrap;
                }
            }
            if SongsData.tab == 1: VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;
                Caps { text: SongsData.saves-heading; }
                ListView {
                    for line in SongsData.saves: Rectangle {
                        height: line.run != "" ? 40px : 30px;
                        if line.run != "": HorizontalLayout {
                            padding-top: Space.md;
                            spacing: Space.sm;
                            Text {
                                text: line.run;
                                color: Theme.text;
                                font-size: Type.body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: line.details;
                                color: Theme.muted;
                                font-size: Type.meta;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // Double-click a save to open it.
                        if line.run == "": ListLine {
                          double-clicked => { SongsData.open-save(line.path); }
                          HorizontalLayout {
                            padding-left: Space.sm;
                            spacing: Space.md;
                            Text {
                                text: line.date;
                                width: 96px;
                                color: Theme.muted;
                                font-family: Theme.number-font;
                                font-size: Type.meta;
                                vertical-alignment: center;
                            }
                            Text {
                                text: line.name;
                                color: line.newest ? Theme.text : Theme.muted;
                                font-weight: line.newest ? 600 : 400;
                                font-size: Type.body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if line.missing: Text {
                                text: "File moved";
                                color: Theme.missing;
                                font-size: Type.meta;
                                vertical-alignment: center;
                            }
                          }
                        }
                    }
                }
            }
            if SongsData.tab == 2: VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;
                Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.plugins-heading; }
                ListView {
                    for p in SongsData.plugins: HorizontalLayout {
                        height: 48px;
                        padding-left: Space.sm;
                        padding-right: Space.sm;
                        spacing: Space.md;
                        VerticalLayout {
                            alignment: center;
                            spacing: Space.xs;
                            horizontal-stretch: 1;
                            Text {
                                text: p.name;
                                color: Theme.text;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: p.about;
                                color: Theme.muted;
                                font-size: Type.meta;
                                overflow: elide;
                            }
                        }
                        if !p.installed: Text {
                            text: "Not installed";
                            color: Theme.missing;
                            font-size: Type.meta;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if SongsData.tab == 3: VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;
                Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.samples-heading; }
                ListView {
                    for sm in SongsData.samples: HorizontalLayout {
                        height: 48px;
                        padding-left: Space.sm;
                        padding-right: Space.sm;
                        spacing: Space.md;
                        VerticalLayout {
                            alignment: center;
                            spacing: Space.xs;
                            horizontal-stretch: 1;
                            Text {
                                text: sm.name;
                                color: Theme.text;
                                font-size: Type.body;
                                overflow: elide;
                            }
                            Text {
                                text: sm.folder;
                                color: Theme.muted;
                                font-size: Type.meta;
                                overflow: elide;
                            }
                        }
                        if sm.missing || sm.unplayed: Text {
                            text: sm.missing ? "Can't be found" : "Loaded, never played";
                            color: sm.missing ? Theme.missing : Theme.faint;
                            font-size: Type.meta;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if SongsData.tab == 4: VerticalLayout {
                padding: Space.lg;
                spacing: Space.sm;
                alignment: start;
                if SongsData.detail-message != "": Caps { text: SongsData.detail-message; }
                if SongsData.tracks != "": Caps { text: "TRACKS"; }
                if SongsData.tracks != "": Text {
                    text: SongsData.tracks;
                    color: Theme.text;
                    font-size: Type.body;
                    wrap: word-wrap;
                }
                if SongsData.details.length > 0: Caps { text: "FROM THE FILE"; }
                for d in SongsData.details: HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        text: d.name;
                        width: 160px;
                        color: Theme.muted;
                        font-size: Type.body;
                    }
                    Text {
                        text: d.value;
                        color: Theme.text;
                        font-size: Type.body;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

export component SongsPage inherits Rectangle {
    forward-focus: search-box;

    VerticalLayout {
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        HorizontalLayout {
            spacing: Space.md;
            vertical-stretch: 0;
            Text {
                text: "Songs";
                font-size: Type.page-title;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: SongsData.count;
                color: Theme.muted;
                font-size: Type.body;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        search-box := SearchBox {
            hint: "Search songs, plugins, tags, notes, a key or a year";
            text <=> SongsData.search;
            edited(t) => { SongsData.search-edited(t); }
            key(k) => {
                if (k == Key.Escape && SongsData.search != "") {
                    SongsData.search = "";
                    SongsData.search-edited("");
                    return true;
                }
                // With the search already empty, Esc puts the song panel away.
                if (k == Key.Escape && SongsData.selected >= 0) {
                    SongsData.close-panel();
                    return true;
                }
                false
            }
        }
        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            vertical-stretch: 0;
            MenuChip {
                name: "DAW";
                value: SongsData.daw;
                choices: SongsData.daws;
                picked(v) => { SongsData.pick("daw", v); }
            }
            MenuChip {
                name: "Status";
                value: SongsData.status;
                choices: SongsData.statuses;
                picked(v) => { SongsData.pick("status", v); }
            }
            MenuChip {
                name: "Tag";
                value: SongsData.tag;
                choices: SongsData.tags;
                picked(v) => { SongsData.pick("tag", v); }
            }
            ToggleChip {
                text: "Favourites";
                on: SongsData.favourites;
                clicked => { SongsData.toggle("favourites"); }
            }
            ToggleChip {
                text: "Missing something";
                on: SongsData.missing;
                clicked => { SongsData.toggle("missing"); }
            }
            ToggleChip {
                text: "Hide archived";
                on: SongsData.hide-archived;
                clicked => { SongsData.toggle("hide-archived"); }
            }
            if SongsData.any-filter: ToggleChip {
                text: "Clear";
                on: false;
                clicked => { SongsData.clear(); }
            }
        }
        // The list, and the picked song's panel beside it. Placed by hand: the list takes a third of the width beside
        // the panel (spec 3.2), never so little that the names can't be read.
        area := Rectangle {
            vertical-stretch: 1;
            list-well := Well {
                x: 0;
                y: 0;
                height: parent.height;
                width: SongsData.selected >= 0 ? max(380px, (parent.width - 16px) / 3) : parent.width;
                // Narrow beside the panel: what's missing and the status make room for the name.
                property <bool> wide: SongsData.selected < 0 || self.width > 640px;
                if SongsData.message != "": Text {
                    text: SongsData.message;
                    color: Theme.muted;
                    font-size: Type.body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if SongsData.message == "": HorizontalLayout {
                    property <int> show-ask: SongsData.show-ask;
                    // Scrolls only when the line is out of sight.
                    changed show-ask => {
                        if (SongsData.show-y < -list.content-y
                            || SongsData.show-y + SongsData.song-height > -list.content-y + list.visible-height) {
                            list.content-y = -clamp(SongsData.show-y - list.visible-height / 3, 0px,
                                max(0px, list.content-height - list.visible-height));
                        }
                    }
                    list := ListView {
                        horizontal-stretch: 1;
                        for line in SongsData.lines: Rectangle {
                            height: line.heading != "" ? SongsData.heading-height : SongsData.song-height;
                            if line.heading != "": Caps {
                                x: Space.lg;
                                y: parent.height - self.height - Space.sm;
                                text: line.heading;
                            }
                            if line.heading == "": ListLine {
                                x: Space.xs;
                                width: parent.width - 2 * Space.xs;
                                selected: line.row == SongsData.selected;
                                // The date's tooltip, over the date at the right.
                                tip: line.date-tip;
                                tip-from: self.width - Space.md - 90px;
                                clicked => { SongsData.select(line.row); }
                                double-clicked => {
                                    SongsData.select(line.row);
                                    SongsData.open();
                                }
                                // The DAW's colour, as a thin bar at the left (the design system's song row).
                                Rectangle {
                                    x: Space.xs + 2px;
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: parent.height - 2 * Space.md;
                                    border-radius: 1.5px;
                                    background: Theme.daw(line.daw);
                                }
                                HorizontalLayout {
                                    padding-left: Space.md;
                                    padding-right: Space.md;
                                    spacing: Space.md;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: Space.xs;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: Space.sm;
                                            alignment: start;
                                            Text {
                                                text: line.name;
                                                color: Theme.text;
                                                font-size: Type.row-title;
                                                font-weight: 500;
                                                overflow: elide;
                                            }
                                            if line.favourite: Heart { y: (parent.height - self.height) / 2; }
                                        }
                                        Text {
                                            text: line.details;
                                            color: Theme.muted;
                                            font-size: Type.meta;
                                            overflow: elide;
                                        }
                                    }
                                    if list-well.wide: VerticalLayout {
                                        alignment: center;
                                        spacing: Space.xs;
                                        width: 150px;
                                        Text {
                                            text: line.missing;
                                            color: Theme.missing;
                                            font-size: Type.meta;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                        }
                                        if line.status != "": Text {
                                            text: line.status;
                                            color: Theme.muted;
                                            font-size: Type.meta;
                                            horizontal-alignment: right;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: Space.xs;
                                        width: 90px;
                                        Text {
                                            text: line.date;
                                            color: Theme.muted;
                                            font-family: Theme.number-font;
                                            font-size: Type.meta;
                                            horizontal-alignment: right;
                                        }
                                        if line.rating > 0: HorizontalLayout {
                                            alignment: end;
                                            Stars { rating: line.rating; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The year scrubber: jump to the first song of a year.
                    if SongsData.years.length > 1: VerticalLayout {
                        width: 52px;
                        // No gap between the marks, so as many years fit as before the bigger text.
                        padding: Space.xs;
                        alignment: start;
                        for y in SongsData.years: YearMark {
                            text: y.year;
                            // Never past the end, so the last year doesn't leave the list mostly empty.
                            clicked => { list.content-y = -min(y.y, max(0px, list.content-height - list.visible-height)); }
                        }
                    }
                }
            }
            if SongsData.selected >= 0: SongPanel {
                x: list-well.width + 16px;
                y: 0;
                height: parent.height;
                width: parent.width - self.x;
            }
        }
    }
}
