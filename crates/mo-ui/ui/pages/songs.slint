// The Songs page: one line per song, newest save first, under time headings, with search, filter chips and a year
// scrubber, and the picked song's panel beside it. Agreed with Solomon on 2026-10-31.
import { ListView, ListBox, Fit } from "../list.slint";
import { ArrangementPreview } from "arrangement.slint";
import { Theme, AppKeys, Type, Space, PageHeader, Well, SearchBox, ToggleChip, FilterPicks, FilterList, FilterColumn, TickLine, FilterView, ListLine, Stars, YearRange, YearBar, Caps, ColumnHead, Heart, CloseButton, TabBar, LinkText, StudioButton, ActionKey, MenuLine, MenuCard, Groove, MenuItem, RightClickMenu, NoticeStrip, EmptyState, SidePanel, StarsPick, HeartToggle, TagChip, WordBox, MenuChip } from "../studio.slint";

// One line of the list: a heading ("This week", "2019") when `heading` isn't empty, else a song.
export struct SongLine {
    heading: string,
    // Where the song is in the page's rows (mo-app's `Songs::rows`), for picking it.
    row: int,
    name: string,
    details: string,
    date: string,
    date-tip: string,
    missing: string,
    rating: int,
    favourite: bool,
    status: string,
    daw: string,
}

// One of Overview's counts ("9 plugins", "3 missing"), opening the tab at `tab`.
export struct CountLine {
    text: string,
    missing: string,
    tab: int,
}

export struct PluginLine {
    name: string,
    about: string,
    installed: bool,
}

export struct SampleLine {
    name: string,
    folder: string,
    path: string,
    missing: bool,
    unplayed: bool,
}

// One line of the Saves tab: a run's heading when `run` isn't empty, else a save.
export struct SaveLine {
    run: string,
    details: string,
    name: string,
    date: string,
    path: string,
    missing: bool,
    newest: bool,
    // The DAW the save opens in, which its buttons name.
    daw: string,
}

// One line of the song panel's Older saves menu: clicking it opens `path`.
export struct OlderLine {
    text: string,
    path: string,
}

// One line of the song's Health strip, with its button when `action` isn't empty.
export struct HealthLine {
    text: string,
    why: string,
    action: string,
}

export struct DetailPair {
    name: string,
    value: string,
}

// The picked song, for its panel.
export struct PanelSong {
    daw: string,
    facts: string,
    name: string,
    saves: string,
    // When the song last reached the backup drive; empty until a backup drive is picked.
    backed: string,
    status: string,
    rating: int,
    favourite: bool,
    key: string,
    // The key was worked out from the notes, not typed in.
    key-heard: bool,
    tags: string,
    notes: string,
}

// One of the picked song's tags; `on` while the Tag filter has it.
export struct SongTag {
    text: string,
    on: bool,
}

// What the page shows and what it reports, filled and answered by mo-ui's songs.rs.
export global SongsData {
    in property <[SongLine]> lines;
    // The year strip beside the list: each year with how many songs; drag over years to show only those.
    in property <[YearBar]> years;
    // The places in `years` of the first and last years picked, top first (-1 when none are).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();
    in property <string> count;
    // Shown instead of the list while it loads, or when the library can't be read or has no songs: a title, and a
    // line under it.
    in property <string> message: "Reading your library…";
    in property <string> message-text;
    // How many songs the filters let through: with none, the list says so and offers to clear them.
    in property <int> shown;
    in-out property <string> search;
    // The filters (mo-app's `songs::SongChips`): the DAW, the status and the tag, more than one of each.
    in property <FilterView> daw-filter;
    in property <FilterView> status-filter;
    in property <FilterView> tag-filter;
    in property <bool> favourites;
    in property <bool> missing;
    in property <bool> hide-archived;
    in property <bool> any-filter;
    // "Using Serum", while the list shows only the songs of one plugin (the Plugins page's Show in Songs).
    in property <string> only;
    in property <int> selected: -1;
    // Up and Down on the list (and Down from the search box): the song above or below the one picked.
    callback step(int);
    // Bring a song into view: its line's top in the list, and a count that goes up each time it's asked.
    in property <length> show-y;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    // Where the list is turned to (list.slint's ListView keeps it): it's there again when the page is shown again.
    in-out property <length> list-y;
    // The song panel, shown while a song is picked.
    in property <PanelSong> song;
    in property <[string]> tabs;
    in-out property <int> tab;
    in property <[CountLine]> counts;
    in property <[string]> runs;
    // "Reading…" while the newest save's record loads, or why it couldn't be read.
    in property <string> detail-message;
    in property <string> plugins-heading;
    in property <[PluginLine]> plugins;
    in property <string> samples-heading;
    in property <[SampleLine]> samples;
    in property <string> saves-heading;
    in property <[SaveLine]> saves;
    // The Older saves menu: "VERSIONS" or "RECENT SAVES", its lines, and "See all 12 saves". No lines, no button.
    in property <string> older-heading;
    in property <[OlderLine]> older;
    in property <string> older-see-all;
    // Where the Saves tab is in `tabs`, for "See all".
    in property <int> saves-tab;
    in property <string> tracks;
    in property <[DetailPair]> details;
    in property <[string]> warnings;
    // The Health strip: folded to its summary line until opened.
    in property <string> health-summary;
    in property <[HealthLine]> health;
    in-out property <bool> health-open;
    callback health-go(int);
    callback search-edited(string);
    // A filter's choice was picked or unpicked: which filter ("daw", "status", "tag") and the choice's words; or its
    // menu's Any was.
    callback toggle-choice(string, string);
    callback clear-chip(string);
    callback toggle(string);
    callback clear();
    // The column the list goes by, as its heading says it ("Last saved"), and whether that order is turned round; a
    // click on a heading (its words) picks it, a second turns it round.
    in property <string> order-column;
    in property <bool> order-reversed;
    callback order-picked(string);
    callback select(int);
    // The buttons' tooltips and keys, from the shortcut list.
    in property <ActionKey> open-key;
    in property <ActionKey> open-own-key;
    in property <ActionKey> reveal-key;
    in property <ActionKey> copy-key;
    // Opens the picked song's newest save: FL Studio songs go to Bitwig, the rest to their own DAW.
    callback open();
    // Opens the picked song's newest save in its own DAW (FL Studio's "Open in FL Studio").
    callback open-own();
    // Opens one save of the picked song, by its path.
    callback open-save(string);
    // A save right-clicked on the Saves tab: `save-menu-for` fills `save-menu` for it, `save-menu-chosen` runs a line.
    in property <[MenuItem]> save-menu;
    callback save-menu-for(string);
    callback save-menu-chosen(string);
    // A song line right-clicked (it's picked first): `song-menu-for` fills `song-menu` for its song, with the panel's
    // buttons and their keys; `song-menu-chosen` runs a line, by its action's id.
    in property <[MenuItem]> song-menu;
    callback song-menu-for(int);
    callback song-menu-chosen(string);
    // A button on a save's line on the Saves tab: the save's path, and "open", "bitwig", "reveal" or "copy", as the
    // lines of its right-click menu.
    callback save-chosen(string, string);
    // The save picked on the Saves tab ("" for none: the newest), which the song's buttons act on, and its name.
    in property <string> picked-save;
    in property <string> picked-save-name;
    callback pick-save(string, string);
    callback reveal();
    callback copy-path();
    // Opens the Presets page on the picked song's sounds (its newest save's).
    callback show-presets();
    callback close-panel();
    // You give the picked song something, kept for the song (all its saves): `what` is "status" (one of `statuses`),
    // "stars" ("0" to "5"), "favourite" (turned over), "add-tag" or "remove-tag" (the tag).
    callback give(string, string);
    in property <[string]> statuses;
    in property <[SongTag]> song-tags;
    // Headings and songs are one height. Slint's ListView places a far jump by the average height of the lines on
    // screen, so with two heights "Show it" landed hundreds of lines away from the song in a big library; with one,
    // a song's place is simply its line number times this.
    out property <length> line-height: 62px;
}

// What's wrong with a plugin on the Plugins tab: beside it, or first under its name in a narrow panel.
component PluginTrouble inherits Text {
    text: "Not installed";
    color: Theme.missing;
    font-size: Type.meta;
}

// What's wrong with a sample on the Samples tab, the same way.
component SampleTrouble inherits Text {
    in property <SampleLine> sample;
    text: root.sample.missing ? "Can't be found" : "Loaded, never played";
    color: root.sample.missing ? Theme.missing : Theme.faint;
    font-size: Type.meta;
}

// A tab's content in the song panel. It says how tall it wants to be at the panel's real width, because the `if`
// round it is measured at its widest: in a narrow window, where its lines wrap, the panel then scrolls far enough.
component TabRoom inherits VerticalLayout {
    in-out property <length> wants;
    init => { self.wants = self.preferred-height; }
    changed preferred-height => { self.wants = self.preferred-height; }
}

// The picked song: what it is, its counts and its tabs. Read-only until the Rust app's database is trusted.
component SongPanel inherits Rectangle {
    // How tall the tab on show wants to be, which it says itself (see TabRoom).
    property <length> tab-height;
    // Too narrow for a list line's name to share its line with a date or what's wrong (about 250 px in the narrowest
    // window): those go on the line below. The panel's width is set by hand, so this doesn't depend on itself.
    property <bool> narrow: root.width < 400px;
    // The song on show, by its place in the library's list. When another is picked, the panel goes back to its top,
    // so the new song opens at its name, as it opens on Overview. A new tab keeps the place, as the tabs are in sight.
    property <int> song-row: SongsData.selected;
    changed song-row => { flick.content-y = 0; }
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;

    // Scrolls when what it holds is taller than the panel, as the other pages' panels do: in a narrow window its
    // rows wrap, and the tab below keeps the room it needs. Otherwise it fills the panel, and the tab's well takes
    // the room that's left.
    flick := Flickable {
        content-width: flick.width;
        content-height: content.height;
        // The wheel scrolls it; a drag with the mouse is for what's in it, such as a clip dragged out to a DAW.
        mouse-drag-pan-enabled: false;
        content := VerticalLayout {
            x: 0;
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            padding: Space.lg;
            padding-bottom: Space.md;
            spacing: Space.sm;
            HorizontalLayout {
                spacing: Space.sm;
                vertical-stretch: 0;
                Text {
                    text: SongsData.song.daw;
                    color: Theme.daw(SongsData.song.daw);
                    font-size: Type.meta;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: SongsData.song.facts;
                    color: Theme.muted;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                CloseButton {
                    clicked => { SongsData.close-panel(); }
                }
            }
            Text {
                text: SongsData.song.name;
                color: Theme.text;
                font-family: Theme.title-font;
                font-size: Type.panel-title;
                font-weight: 600;
                overflow: elide;
            }
            if SongsData.song.saves != "": Text {
                text: SongsData.song.saves;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
            if SongsData.song.backed != "": Text {
                text: SongsData.song.backed;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
            // Which save the buttons act on, when one is picked on the Saves tab; a click goes back to the newest.
            if SongsData.picked-save != "": HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                Text {
                    text: "The buttons act on the picked save: " + SongsData.picked-save-name;
                    color: Theme.accent;
                    font-size: Type.meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
                LinkText {
                    text: "Back to the newest";
                    font-size: Type.meta;
                    clicked => { SongsData.pick-save("", ""); }
                }
            }
            // Its status, stars, key and tags, and its buttons below: each row wraps in a narrow panel, so nothing runs past
            // its edge.
            FlexboxLayout {
                spacing-horizontal: Space.md;
                spacing-vertical: Space.sm;
                cross-axis-alignment: center;
                padding-top: Space.xs;
                padding-bottom: Space.sm;
                vertical-stretch: 0;
                MenuChip {
                    name: "Status";
                    value: SongsData.song.status;
                    choices: SongsData.statuses;
                    has-any: false;
                    lights: false;
                    picked(status) => { SongsData.give("status", status); }
                }
                StarsPick {
                    rating: SongsData.song.rating;
                    picked(stars) => { SongsData.give("stars", stars); }
                }
                HeartToggle {
                    on: SongsData.song.favourite;
                    tip: SongsData.song.favourite ? "A favourite: click to make it not one" : "Make it a favourite";
                    clicked => { SongsData.give("favourite", ""); }
                }
                if SongsData.song.key != "": HorizontalLayout {
                    spacing: Space.sm;
                    Caps {
                        text: "KEY";
                        vertical-alignment: center;
                    }
                    Text {
                        text: SongsData.song.key + (SongsData.song.key-heard ? " (from the notes)" : "");
                        color: Theme.text;
                        font-size: Type.body;
                        vertical-alignment: center;
                    }
                }
            }
            // Its tags: a click filters the list by one, × takes it off, and the box adds one.
            FlexboxLayout {
                spacing: Space.xs;
                padding-bottom: Space.sm;
                vertical-stretch: 0;
                for t in SongsData.song-tags: TagChip {
                    text: t.text;
                    on: t.on;
                    remove-tip: "Take the tag " + t.text + " off this song";
                    clicked => { SongsData.toggle-choice("tag", t.text); }
                    removed => { SongsData.give("remove-tag", t.text); }
                }
                WordBox {
                    width: 160px;
                    hint: "Add a tag";
                    tip: "Type a tag and press Enter: it's kept for the song, on all its saves";
                    accepted(text) => {
                        SongsData.give("add-tag", text);
                        self.text = "";
                    }
                }
            }
            FlexboxLayout {
                spacing: Space.sm;
                vertical-stretch: 0;
                padding-bottom: Space.xs;
                StudioButton {
                    text: SongsData.song.daw == "FL Studio" ? "Open in Bitwig" : "Open in " + SongsData.song.daw;
                    main: true;
                    tip: SongsData.open-key.what;
                    key: SongsData.open-key.key;
                    clicked => { SongsData.open(); }
                }
                if SongsData.song.daw == "FL Studio": StudioButton {
                    text: "Open in FL Studio";
                    tip: SongsData.open-own-key.what;
                    key: SongsData.open-own-key.key;
                    clicked => { SongsData.open-own(); }
                }
                if SongsData.older.length > 0: HorizontalLayout {
                    older-button := StudioButton {
                        text: "Older saves";
                        menu: true;
                        clicked => { older-menu.show(); }
                    }
                    older-menu := PopupWindow {
                        x: 0;
                        y: older-button.height + Space.xs;
                        width: max(older-button.width, 320px);
                        MenuCard {
                            HorizontalLayout {
                                padding-left: Space.md;
                                Caps {
                                    text: SongsData.older-heading;
                                    height: self.preferred-height + Space.sm;
                                    vertical-alignment: center;
                                }
                            }
                            for line in SongsData.older: MenuLine {
                                text: line.text;
                                clicked => { SongsData.open-save(line.path); }
                            }
                            Groove { }
                            MenuLine {
                                text: SongsData.older-see-all;
                                clicked => { SongsData.tab = SongsData.saves-tab; }
                            }
                        }
                    }
                }
                StudioButton {
                    text: "Show in folder";
                    tip: SongsData.reveal-key.what;
                    key: SongsData.reveal-key.key;
                    clicked => { SongsData.reveal(); }
                }
                StudioButton {
                    text: "Copy path";
                    tip: SongsData.copy-key.what;
                    key: SongsData.copy-key.key;
                    clicked => { SongsData.copy-path(); }
                }
            }
            if SongsData.health-summary != "": NoticeStrip {
                text: SongsData.health-summary;
                open <=> SongsData.health-open;
                if SongsData.health-open: VerticalLayout {
                    spacing: Space.sm;
                    for h[i] in SongsData.health: HorizontalLayout {
                        spacing: Space.sm;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: h.text;
                                color: Theme.text;
                                font-size: Type.body;
                                wrap: word-wrap;
                            }
                            if h.why != "": Text {
                                text: h.why;
                                color: Theme.muted;
                                font-size: Type.meta;
                                wrap: word-wrap;
                            }
                        }
                        if h.action != "": VerticalLayout {
                            alignment: center;
                            StudioButton {
                                text: h.action;
                                clicked => { SongsData.health-go(i); }
                            }
                        }
                    }
                }
            }
            if SongsData.song.notes != "": Text {
                text: SongsData.song.notes;
                color: Theme.muted;
                font-size: Type.body;
                wrap: word-wrap;
                max-height: 60px;
                overflow: elide;
            }
            TabBar {
                vertical-stretch: 0;
                tabs: SongsData.tabs;
                current <=> SongsData.tab;
            }
            Well {
                vertical-stretch: 1;
                // As tall as the tab on show says it wants to be at the panel's width, so in a narrow window the panel
                // scrolls rather than squeeze it.
                preferred-height: root.tab-height;
                // Overview: the counts, each opening its tab, the arrangement, then the song's runs.
                if SongsData.tab == 0: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.lg;
                    spacing: Space.sm;
                    // They wrap in a narrow panel, each count with the dot before it.
                    FlexboxLayout {
                        vertical-stretch: 0;
                        spacing: Space.sm;
                        for c[i] in SongsData.counts: HorizontalLayout {
                            spacing: Space.sm;
                            if i > 0: Text {
                                text: "·";
                                color: Theme.faint;
                                font-size: Type.body;
                            }
                            LinkText {
                                text: c.text;
                                clicked => { SongsData.tab = c.tab; }
                            }
                            if c.missing != "": LinkText {
                                text: "(" + c.missing + ")";
                                tint: Theme.missing;
                                clicked => { SongsData.tab = c.tab; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            if SongsData.counts.length > 0: Text {
                                text: "·";
                                color: Theme.faint;
                                font-size: Type.body;
                            }
                            LinkText {
                                text: "Its sounds on Presets";
                                clicked => { SongsData.show-presets(); }
                            }
                        }
                    }
                    if SongsData.detail-message != "": Text {
                        text: SongsData.detail-message;
                        color: Theme.muted;
                        font-size: Type.meta;
                        wrap: word-wrap;
                    }
                    ArrangementPreview {
                        vertical-stretch: 1;
                    }
                    if SongsData.runs.length > 1: Caps {
                        text: "RUNS";
                    }
                    for run in SongsData.runs.length > 1 ? SongsData.runs : []: Text {
                        text: run;
                        color: Theme.text;
                        font-size: Type.body;
                    }
                    for w in SongsData.warnings: Text {
                        text: w;
                        color: Theme.warning;
                        font-size: Type.meta;
                        wrap: word-wrap;
                    }
                }
                if SongsData.tab == 1: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    save-menu := RightClickMenu {
                        items: SongsData.save-menu;
                        chosen(id) => { SongsData.save-menu-chosen(id); }
                    }
                    Caps { text: SongsData.saves-heading; }
                    ListView {
                        // A few lines, and never fewer: in a narrow window the panel scrolls instead. As tall as the
                        // room left otherwise.
                        min-height: 160px;
                        preferred-height: 160px;
                        for line in SongsData.saves: Rectangle {
                            height: line.run != "" ? 40px : root.narrow ? 44px : 30px;
                            if line.run != "": HorizontalLayout {
                                padding-top: Space.md;
                                spacing: Space.sm;
                                Text {
                                    text: line.run;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: line.details;
                                    color: Theme.muted;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            // Click a save to pick it for the song's buttons, double-click to open it, right-click for
                            // the same in a menu. Nothing is hidden (Solomon, 4 Nov 2026): the buttons are the card's.
                            if line.run == "": ListLine {
                              // A click picks the save: the song's own buttons above (Open, Show in folder, Copy path)
                              // then act on it, and so do their keys. No buttons on the line itself, as everywhere else
                              // (the UX review of 10 Nov, B10).
                              selected: line.path == SongsData.picked-save;
                              clicked => { SongsData.pick-save(line.path, line.name); }
                              double-clicked => { SongsData.open-save(line.path); }
                              right-clicked(x, y) => {
                                  SongsData.save-menu-for(line.path);
                                  save-menu.open-at(x, y);
                              }
                              if !root.narrow: HorizontalLayout {
                                padding-left: Space.sm;
                                padding-right: Space.sm;
                                spacing: Space.md;
                                Text {
                                    text: line.date;
                                    width: 96px;
                                    color: Theme.muted;
                                    font-family: Theme.number-font;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: line.name;
                                    color: line.newest ? Theme.text : Theme.muted;
                                    font-weight: line.newest ? 600 : 400;
                                    font-size: Type.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if line.missing: Text {
                                    text: "File moved";
                                    color: Theme.missing;
                                    font-size: Type.meta;
                                    vertical-alignment: center;
                                }
                              }
                              // In a narrow panel: the save's name, then its date and whether it has moved below it.
                              if root.narrow: VerticalLayout {
                                padding-left: Space.sm;
                                padding-right: Space.sm;
                                alignment: center;
                                spacing: Space.xs;
                                Text {
                                    text: line.name;
                                    color: line.newest ? Theme.text : Theme.muted;
                                    font-weight: line.newest ? 600 : 400;
                                    font-size: Type.body;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    Text {
                                        text: line.date;
                                        color: Theme.muted;
                                        font-family: Theme.number-font;
                                        font-size: Type.meta;
                                    }
                                    if line.missing: Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: "File moved";
                                        color: Theme.missing;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                              }
                            }
                        }
                    }
                }
                if SongsData.tab == 2: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.plugins-heading; }
                    ListView {
                        min-height: 160px;
                        preferred-height: 160px;
                        for p in SongsData.plugins: HorizontalLayout {
                            height: 48px;
                            padding-left: Space.sm;
                            padding-right: Space.sm;
                            spacing: Space.md;
                            VerticalLayout {
                                alignment: center;
                                spacing: Space.xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: p.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    overflow: elide;
                                }
                                // In a narrow panel what's wrong comes first on this line, so the name above keeps
                                // the whole width.
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    if root.narrow && !p.installed: PluginTrouble { }
                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: p.about;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                            }
                            if !root.narrow && !p.installed: PluginTrouble { vertical-alignment: center; }
                        }
                    }
                }
                if SongsData.tab == 3: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.md;
                    spacing: Space.sm;
                    Caps { text: SongsData.detail-message != "" ? SongsData.detail-message : SongsData.samples-heading; }
                    ListView {
                        min-height: 160px;
                        preferred-height: 160px;
                        for sm in SongsData.samples: HorizontalLayout {
                            height: 48px;
                            padding-left: Space.sm;
                            padding-right: Space.sm;
                            spacing: Space.md;
                            VerticalLayout {
                                alignment: center;
                                spacing: Space.xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: sm.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    overflow: elide;
                                }
                                // As on Plugins: in a narrow panel what's wrong comes first on this line.
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    if root.narrow && (sm.missing || sm.unplayed): SampleTrouble { sample: sm; }
                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: sm.folder;
                                        color: Theme.muted;
                                        font-size: Type.meta;
                                        overflow: elide;
                                    }
                                }
                            }
                            if !root.narrow && (sm.missing || sm.unplayed): SampleTrouble {
                                sample: sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if SongsData.tab == 4: TabRoom {
                    wants <=> root.tab-height;
                    padding: Space.lg;
                    spacing: Space.sm;
                    alignment: start;
                    if SongsData.detail-message != "": Caps { text: SongsData.detail-message; }
                    if SongsData.tracks != "": Caps { text: "TRACKS"; }
                    if SongsData.tracks != "": Text {
                        text: SongsData.tracks;
                        color: Theme.text;
                        font-size: Type.body;
                        wrap: word-wrap;
                    }
                    if SongsData.details.length > 0: Caps { text: "FROM THE FILE"; }
                    for d in SongsData.details: HorizontalLayout {
                        spacing: Space.md;
                        // At most two fifths of the room inside the panel (its padding and this tab's), its words wrapping,
                        // so in a narrow panel the value keeps room beside it. The panel's own width, which is set by
                        // hand, so this line's width doesn't depend on itself.
                        Text {
                            text: d.name;
                            width: clamp((root.width - 4 * Space.lg) * 0.4, 0px, 160px);
                            color: Theme.muted;
                            font-size: Type.body;
                            wrap: word-wrap;
                        }
                        Text {
                            text: d.value;
                            color: Theme.text;
                            font-size: Type.body;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

export component SongsPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }

    VerticalLayout {
        // In a window wider than the list and the song's panel at their widest, the page stops there (the UX review
        // of 10 Nov, A1): the list a third of the room up to `Fit.narrow-max`, the panel up to twice `Fit.list-max`
        // (its arrangement likes the width), side by side from the left.
        x: 0;
        width: min(root.width, Fit.narrow-max + 16px + 2 * Fit.list-max + 2 * Space.xl);
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        PageHeader {
            title: "Songs";
            summary: SongsData.count;
            job-line: false;
        }
        search-box := SearchBox {
            // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and Ctrl+Down step
            // through the list from here.
            page-search: true;
            hint: "Search songs, plugins, tags, notes, a key or a year";
            text <=> SongsData.search;
            edited(t) => { SongsData.search-edited(t); }
            key(k) => {
                // Down goes on into the list, as on Sounds and MIDI, when it has a song to go to.
                if (k == Key.DownArrow && SongsData.shown > 0) {
                    keys.focus();
                    SongsData.step(1);
                    return true;
                }
                false
            }
        }
        split := Rectangle {
            vertical-stretch: 1;
            // The filters, in a column at the side as on every page (Solomon, 10 Nov 2026): each one's choices as a
            // tick list with how many songs it would show; more than one of each can be picked.
            // The list, and the picked song's panel beside it. Placed by hand: the list takes a third of the width beside
            // the panel (spec 3.2), never so little that the names can't be read.
            area := Rectangle {
                x: column.room;
                y: 0;
                width: split.width - self.x;
                height: split.height;
                // Up and Down step through the list once it has the keys (a line clicked, or Down from the search box).
                // Esc goes on to the window, whose one step back (app.escape) clears the search, then puts the panel away.
                keys := FocusScope {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    // The same width whether a song is picked or not: the panel's place is always there (review B1), so
                    // nothing moves when one is picked.
                    width: clamp((parent.width - 16px) / 3, 380px, Fit.narrow-max);
                    key-pressed(event) => {
                        if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                            return reject;
                        }
                        if (event.text == Key.UpArrow) {
                            SongsData.step(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            SongsData.step(1);
                            return accept;
                        }
                        reject
                    }
                    list-well := Well {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width;
                        // Narrow beside the panel: what's missing and the status make room for the name.
                        property <bool> wide: self.width > 640px;
                        if SongsData.message != "": EmptyState {
                            title: SongsData.message;
                            text: SongsData.message-text;
                        }
                        if SongsData.message == "": HorizontalLayout {
                            ListBox {
                                horizontal-stretch: 1;
                                turned: list.content-y;
                                after: list.row-height;
                                to-top => { list.to-top(); }
                                VerticalLayout {
                                    // The headings order the list: a click goes by that column, a second turns it round.
                                    HorizontalLayout {
                                        padding-left: Space.xs + Space.md;
                                        padding-right: Space.xs + Space.md;
                                        spacing: Space.md;
                                        ColumnHead {
                                            horizontal-stretch: 1;
                                            text: "SONG";
                                            on: SongsData.order-column == "Song";
                                            // A to Z first.
                                            up: !SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Song"); }
                                        }
                                        if list-well.wide: ColumnHead {
                                            width: 150px;
                                            right: true;
                                            text: "STATUS";
                                            on: SongsData.order-column == "Status";
                                            up: SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Status"); }
                                        }
                                        ColumnHead {
                                            width: 90px;
                                            right: true;
                                            text: "LAST SAVED";
                                            on: SongsData.order-column == "Last saved";
                                            up: SongsData.order-reversed;
                                            clicked => { SongsData.order-picked("Last saved"); }
                                        }
                                    }
                                    list := ListView {
                                        horizontal-stretch: 1;
                                        row-height: SongsData.line-height;
                                        rows: SongsData.lines.length;
                                        show-top: SongsData.show-y;
                                        show-ask: SongsData.show-ask;
                                        show-done <=> SongsData.show-done;
                                        kept-y <=> SongsData.list-y;
                                        for line in SongsData.lines: Rectangle {
                                            // Every line this height: the list counts on it.
                                            height: SongsData.line-height;
                                            if line.heading != "": Caps {
                                                x: Space.lg;
                                                y: parent.height - self.height - Space.sm;
                                                text: line.heading;
                                            }
                                            if line.heading == "": ListLine {
                                                x: Space.xs;
                                                width: parent.width - 2 * Space.xs;
                                                selected: line.row == SongsData.selected;
                                                // The date's tooltip, over the date at the right.
                                                tip: line.date-tip;
                                                tip-from: self.width - Space.md - 90px;
                                                clicked => {
                                                    SongsData.select(line.row);
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    SongsData.select(line.row);
                                                    SongsData.open();
                                                }
                                                // The line is picked first (ListLine does that), so the menu acts on it.
                                                right-clicked(x, y) => {
                                                    keys.focus();
                                                    SongsData.song-menu-for(line.row);
                                                    song-menu.open-at(x, y);
                                                }
                                                // The DAW's colour, as a thin bar at the left (the design system's song row).
                                                Rectangle {
                                                    x: Space.xs + 2px;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 3px;
                                                    height: parent.height - 2 * Space.md;
                                                    border-radius: 1.5px;
                                                    background: Theme.daw(line.daw);
                                                }
                                                HorizontalLayout {
                                                    padding-left: Space.md;
                                                    padding-right: Space.md;
                                                    spacing: Space.md;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        horizontal-stretch: 1;
                                                        HorizontalLayout {
                                                            spacing: Space.sm;
                                                            alignment: start;
                                                            Text {
                                                                text: line.name;
                                                                color: Theme.text;
                                                                font-size: Type.row-title;
                                                                font-weight: 500;
                                                                overflow: elide;
                                                            }
                                                            if line.favourite: Heart { y: (parent.height - self.height) / 2; }
                                                            // Its status as a small tag beside the name (the UX review of 10 Nov,
                                                            // C5): one of the main things the list is filtered by. A wide list
                                                            // has it in a column of its own.
                                                            if line.status != "" && !list-well.wide: Rectangle {
                                                                y: (parent.height - self.height) / 2;
                                                                width: status-tag.preferred-width + 2 * Space.sm;
                                                                height: 18px;
                                                                border-radius: 9px;
                                                                border-width: 1px;
                                                                border-color: Theme.edge;
                                                                status-tag := Text {
                                                                    text: line.status;
                                                                    color: Theme.muted;
                                                                    font-size: Type.tiny;
                                                                }
                                                            }
                                                        }
                                                        Text {
                                                            text: line.details;
                                                            color: Theme.muted;
                                                            font-size: Type.meta;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    if list-well.wide: VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        width: 150px;
                                                        Text {
                                                            text: line.missing;
                                                            color: Theme.missing;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                            overflow: elide;
                                                        }
                                                        if line.status != "": Text {
                                                            text: line.status;
                                                            color: Theme.muted;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: Space.xs;
                                                        width: 90px;
                                                        Text {
                                                            text: line.date;
                                                            color: Theme.muted;
                                                            font-family: Theme.number-font;
                                                            font-size: Type.meta;
                                                            horizontal-alignment: right;
                                                        }
                                                        if line.rating > 0: HorizontalLayout {
                                                            alignment: end;
                                                            Stars { rating: line.rating; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if SongsData.years.length > 1: YearRange {
                                width: 56px;
                                years: SongsData.years;
                                picked-from: SongsData.years-from;
                                picked-to: SongsData.years-to;
                                picked(a, b) => { SongsData.years-picked(a, b); }
                                cleared => { SongsData.years-cleared(); }
                            }
                        }
                        // Over the empty list (which stays, so a song shown from elsewhere still scrolls into sight),
                        // beside the year strip: what Sounds and MIDI say when nothing matches (review X3-7).
                        if SongsData.message == "" && SongsData.shown == 0: EmptyState {
                            x: 0;
                            y: 0;
                            width: parent.width - (SongsData.years.length > 1 ? 56px : 0px);
                            height: parent.height;
                            title: "No songs match";
                            text: "Try fewer filters or other words.";
                            action: SongsData.any-filter ? "Clear the filters" : "";
                            act => { SongsData.clear(); }
                        }
                    }
                }
                if SongsData.selected >= 0: SongPanel {
                    x: keys.width + 16px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - self.x;
                }
                if SongsData.selected < 0: SidePanel {
                    x: keys.width + 16px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - self.x;
                    closable: false;
                    EmptyState {
                        vertical-stretch: 1;
                        title: "Pick a song";
                        text: "Its saves, plugins, samples and arrangement show here.";
                    }
                }
                // A song line's right-click menu: the panel's buttons, each with its key (rule 15; review X3-24).
                song-menu := RightClickMenu {
                    items: SongsData.song-menu;
                    chosen(id) => { SongsData.song-menu-chosen(id); }
                }
            }
            // After the list, so the opened column of a narrow window lies over it.
            column := FilterColumn {
                page-width: split.width;
                height: split.height;
                active: SongsData.any-filter;
                FilterList {
                    name: "DAW";
                    filter: SongsData.daw-filter;
                    toggled(text) => { SongsData.toggle-choice("daw", text); }
                    cleared => { SongsData.clear-chip("daw"); }
                }
                FilterList {
                    name: "STATUS";
                    filter: SongsData.status-filter;
                    toggled(text) => { SongsData.toggle-choice("status", text); }
                    cleared => { SongsData.clear-chip("status"); }
                }
                if SongsData.tag-filter.chips.length + SongsData.tag-filter.more.length > 0: FilterList {
                    name: "TAG";
                    more-name: "More tags";
                    filter: SongsData.tag-filter;
                    toggled(text) => { SongsData.toggle-choice("tag", text); }
                    cleared => { SongsData.clear-chip("tag"); }
                }
                VerticalLayout {
                    Caps {
                        text: "SHOW ONLY";
                        height: 22px;
                    }
                    TickLine {
                        text: "Favourites";
                        on: SongsData.favourites;
                        clicked => { SongsData.toggle("favourites"); }
                    }
                    TickLine {
                        text: "Missing something";
                        on: SongsData.missing;
                        clicked => { SongsData.toggle("missing"); }
                    }
                    if SongsData.only != "": TickLine {
                        text: SongsData.only;
                        on: true;
                        clicked => { SongsData.toggle("only"); }
                    }
                }
                TickLine {
                    text: "Hide archived";
                    on: SongsData.hide-archived;
                    clicked => { SongsData.toggle("hide-archived"); }
                }
                if SongsData.any-filter: HorizontalLayout {
                    alignment: start;
                    StudioButton {
                        text: "Clear filters";
                        clicked => { SongsData.clear(); }
                    }
                }
            }
        }
    }
}
