// The Space page (phase 4): the drives your projects, samples, backup and the app's own files are on, how full each
// is, what the app's own files take, (part 2) Bitwig's copies of Library multisamples, with Fix for the saves you
// tick, (part 3) the old copies moving plugin folders left, and (part 4) spare plugin copies, with Remove for the ones
// you tick and the Recycle Bin's Put back. Agreed layout: the design canvas's Space board
// (2026-11-03): the drives across the top, Biggest wins first, Also taking room, and the picked line's card beside
// them. Only shared parts from studio.slint; mo-app decides every word (mo_app::space), mo-ui/src/space.rs fills it.
import { Fit } from "../list.slint";
import { Theme, Type, Space, Caps, Well, PageHeader, ListLine, SidePanel, PanelDivider, EmptyState, HowItWorks, CardAction, CardActions, TickBox, LinkText, Meter, MenuItem, RightClickMenu } from "../studio.slint";

// One drive across the top.
export struct DriveCard {
    name: string,
    // "38 GB free of 500 GB", or "Not plugged in".
    room: string,
    // How much of it is used, 0 to 1.
    used: float,
    // What of yours is on it: "Projects, samples and the app's files".
    holds: string,
    // Why it needs room when it's nearly full; empty when it has room.
    note: string,
    // 0 it has room, 1 nearly full, 2 almost full.
    fill: int,
    // Whether its room could be read (an unplugged drive shows without a bar).
    here: bool,
}

// A line of a list on the page: what it is, why it's there, and its size.
export struct RoomLine {
    id: string,
    title: string,
    why: string,
    size: string,
    // Its part of all the room the wins free, 0 to 1: its meter. 0 for a line that frees nothing.
    share: float,
}

// One part on the picked line's card: its name, what it holds and its size. A part can also have a tick, a line saying
// how it's doing, and links to open it (a fixed project in Bitwig, an old copy in its folder), put it back from the
// Recycle Bin or show more; a save under its project is a step in.
export struct CardPart {
    name: string,
    what: string,
    size: string,
    under: bool,
    can-tick: bool,
    ticked: bool,
    // Some of what its tick is for are ticked, not all (a format's tick for its spare copies): it shows a dash.
    partly: bool,
    status: string,
    // Shows `status` as a problem.
    problem: bool,
    // The words of its link that opens it ("Open in Bitwig", "Show in folder") or puts it back ("Put back"); "" for
    // none.
    open: string,
    // The words of its link that shows or hides more under it; "" for none.
    more: string,
}

export global SpaceData {
    in property <string> summary;
    in property <[DriveCard]> drives;
    // What can be freed, biggest first; then what's still to come (and why a kind isn't listed when it isn't).
    in property <[RoomLine]> wins;
    in property <string> wins-note;
    in property <[RoomLine]> also;
    // The buttons beside Biggest wins first: Measure again, Open Recycle Bin.
    in property <[CardAction]> actions;
    // The picked line's id, or "" when none is; then its card.
    in property <string> picked;
    in property <string> card-kind;
    in property <string> card-title;
    in property <string> card-big;
    in property <string> card-big-note;
    in property <string> card-lead;
    // Whether the card's parts have ticks: each keeps room for its tick, so the names line up.
    in property <bool> card-ticks;
    in property <[CardPart]> card-parts;
    // What to know about the parts, above them with the buttons.
    in property <string> card-note;
    in property <string> card-room;
    in property <string> card-warning;
    in property <[CardAction]> card-actions;
    // The picked line's right-click menu: its card's buttons, each with its key (rule 15; the review of 10 Nov, X3-2).
    in property <[MenuItem]> line-menu;
    in-out property <length> panel-width: 380px;
    callback pick(string);
    callback close-card();
    // A button on the page or the card (its id).
    callback chosen(string);
    callback panel-resized(length);
    // A part on the card (its place in the list): its tick changed, its link that opens it, its link that shows more.
    callback tick-part(int, bool);
    callback open-part(int);
    callback more-part(int);
}

// A drive: its name and room, a bar of how full it is, what of yours it holds, and why it needs room when it does.
component DriveView inherits Rectangle {
    in property <DriveCard> drive;
    // How full it is in the colours every theme shares (all good, a warning, missing), never the accent: some
    // themes' accent is a red.
    property <color> tint: drive.fill == 2 ? Theme.missing : drive.fill == 1 ? Theme.warning : Theme.ok;
    width: 300px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: drive.fill > 0 ? self.tint.transparentize(50%) : Theme.stroke;
    // At the top when a taller card beside it makes this one taller too.
    VerticalLayout {
        padding: Space.lg;
        spacing: Space.sm;
        alignment: start;
        HorizontalLayout {
            spacing: Space.md;
            Text {
                text: root.drive.name;
                color: Theme.text;
                font-size: Type.row-title;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.drive.room;
                color: root.drive.fill > 0 ? root.tint : Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        // How full, as the shared level meter, in how-full's colour.
        if root.drive.here: Meter {
            height: 6px;
            level: root.drive.used;
            tint: root.tint;
        }
        Text {
            text: root.drive.holds;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
        }
        if root.drive.note != "": Text {
            text: root.drive.note;
            color: root.tint;
            font-size: Type.meta;
            wrap: word-wrap;
        }
    }
}

// A line of Biggest wins first or Also taking room: picked, it opens its card. Right-clicked, it's picked first (as
// ListLine does), then `menu-at` asks for its menu where the mouse is.
component RoomLineView inherits ListLine {
    in property <RoomLine> line;
    callback menu-at(length, length);
    height: 56px;
    selected: SpaceData.picked == line.id;
    clicked => { SpaceData.pick(root.line.id); }
    right-clicked(x, y) => { root.menu-at(x, y); }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        VerticalLayout {
            alignment: center;
            spacing: Space.xs;
            horizontal-stretch: 1;
            Text {
                text: root.line.title;
                color: Theme.text;
                font-size: Type.body;
                overflow: elide;
            }
            Text {
                text: root.line.why;
                color: Theme.muted;
                font-size: Type.meta;
                overflow: elide;
            }
        }
        // How much of all the room to free is this line's (the UX review of 10 Nov, C4).
        if root.line.share > 0: VerticalLayout {
            alignment: center;
            Meter {
                width: 118px;
                height: 8px;
                level: root.line.share;
            }
        }
        Text {
            text: root.line.size;
            color: Theme.text;
            font-family: Theme.number-font;
            font-size: Type.body;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 76px;
        }
    }
}

// The picked line's card: what it is, its size in big figures, its parts, the room on its drive, and what to do.
component SpaceCard inherits SidePanel {
    // Where the parts really end, from where the last one is laid out (see `parts-end` below).
    property <length> parts-end;
    // Another line's card starts at its top, not as far down as the last one was scrolled.
    property <string> picked: SpaceData.picked;
    changed picked => {
        self.to-top();
        how.open = false;
    }
    close => { SpaceData.close-card(); }
    Caps { text: SpaceData.card-kind; }
    Text {
        text: SpaceData.card-title;
        color: Theme.text;
        font-family: Theme.title-font;
        font-size: Type.panel-title;
        font-weight: 600;
        wrap: word-wrap;
        min-width: 0px;
    }
    VerticalLayout {
        spacing: Space.xs;
        Text {
            text: SpaceData.card-big;
            color: Theme.text;
            font-family: Theme.number-font;
            font-size: Type.heading;
            font-weight: 600;
        }
        // How a removal went can be long ("61 old autosaves and 1 cache are in the Recycle Bin, and 2 stayed").
        if SpaceData.card-big-note != "": Text {
            text: SpaceData.card-big-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    // What to know about the parts and what the buttons do, then the buttons, above the parts: a long list of parts
    // can't push the main button out of sight.
    if SpaceData.card-note != "": Text {
        text: SpaceData.card-note;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    CardActions {
        actions: SpaceData.card-actions;
        chosen(id) => { SpaceData.chosen(id); }
    }
    // How the line works, folded: the size, what the button does and the button come first (review C7).
    how := HowItWorks { text: SpaceData.card-lead; }
    // The parts are measured as if none of their lines wrapped (Slint measures what's in a `for` so), but each is laid
    // out at its real height: so the box is at least as tall as where the last one ends, or the card's own height (and
    // what follows the parts) fell short of it, and a long card's last parts couldn't be scrolled to. `alignment:
    // start` keeps the parts at the top of the box, so where the last one ends doesn't move with the box's height.
    if SpaceData.card-parts.length > 0: VerticalLayout {
        alignment: start;
        min-height: root.parts-end;
        for part[i] in SpaceData.card-parts: HorizontalLayout {
            spacing: Space.sm;
            // The gap above each part but the first: a gap between them in the box would come before the marker below
            // too, and make the box a gap taller than its parts.
            padding-top: i == 0 ? 0px : Space.md;
            padding-left: part.under ? Space.xl : 0px;
            // Room for a tick, ticked or not, so the names line up. Ticking re-lists the parts from mo-app.
            if SpaceData.card-ticks: VerticalLayout {
                alignment: start;
                width: 26px;
                if part.can-tick: TickBox {
                    height: 20px;
                    checked: part.ticked;
                    partly: part.partly;
                    changed checked => { SpaceData.tick-part(i, self.checked); }
                }
            }
            VerticalLayout {
                spacing: Space.xs;
                horizontal-stretch: 1;
                Text {
                    text: part.name;
                    color: Theme.text;
                    font-size: part.under ? Type.meta : Type.body;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                if part.what != "": Text {
                    text: part.what;
                    color: Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                if part.status != "": Text {
                    text: part.status;
                    color: part.problem ? Theme.warning : Theme.muted;
                    font-size: Type.meta;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                if part.open != "" || part.more != "": HorizontalLayout {
                    spacing: Space.md;
                    alignment: start;
                    if part.open != "": LinkText {
                        text: part.open;
                        font-size: Type.meta;
                        clicked => { SpaceData.open-part(i); }
                    }
                    if part.more != "": LinkText {
                        text: part.more;
                        font-size: Type.meta;
                        clicked => { SpaceData.more-part(i); }
                    }
                }
            }
            Text {
                text: part.size;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.meta;
            }
        }
        // Where the last part ends. It takes none of the card's spare room (a Rectangle would, unlike a Text), so the
        // parts' box stays as tall as the parts.
        Rectangle {
            height: 0px;
            vertical-stretch: 0;
            init => { root.parts-end = self.y; }
            changed y => { root.parts-end = self.y; }
        }
    }
    if SpaceData.card-room != "": Text {
        text: SpaceData.card-room;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    if SpaceData.card-warning != "": Text {
        text: SpaceData.card-warning;
        color: Theme.warning;
        font-size: Type.meta;
        wrap: word-wrap;
    }
    // The room left over goes below everything, not between the parts.
    Rectangle {
        vertical-stretch: 1;
    }
}

export component SpacePage inherits Rectangle {
    property <bool> card-shown: SpaceData.picked != "";
    // In a wide window the lines stop at `Fit.list-max` (the UX review of 10 Nov, A1), so a line's name and its size
    // stay within one look of each other; the card takes the room that's left.
    property <length> main-width: min(Fit.list-max + 2 * Space.xl, self.card-shown ? max(480px, self.width - SpaceData.panel-width - divider.width) : self.width);
    property <length> card-width: self.width - self.main-width - divider.width - Space.xl;
    Flickable {
        x: 0;
        width: root.main-width;
        height: parent.height;
        // Never wider than its room, as on the side cards: a long line wraps instead of pushing the page sideways.
        content-width: self.width;
        content-height: page.preferred-height;
        page := VerticalLayout {
            x: 0;
            width: parent.width;
            padding: Space.xl;
            spacing: Space.xl;
            alignment: start;
            PageHeader {
                title: "Space";
                summary: SpaceData.summary;
            }
            // The drives your folders are on; they wrap onto another row when the window is narrow.
            FlexboxLayout {
                spacing: Space.md;
                for d in SpaceData.drives: DriveView {
                    drive: d;
                }
            }
            VerticalLayout {
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.md;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Caps { text: "BIGGEST WINS FIRST"; }
                    }
                    CardActions {
                        horizontal-stretch: 0;
                        actions: SpaceData.actions;
                        chosen(id) => { SpaceData.chosen(id); }
                    }
                }
                for line in SpaceData.wins: RoomLineView {
                    line: line;
                    menu-at(x, y) => { line-menu.open-at(x, y); }
                }
                // Why a kind has no line, smaller once there are lines above it; none when there's nothing to say.
                if SpaceData.wins-note != "": Well {
                    min-height: SpaceData.wins.length > 0 ? 0px : 96px;
                    VerticalLayout {
                        padding: SpaceData.wins.length > 0 ? Space.lg : Space.xl;
                        alignment: center;
                        Text {
                            text: SpaceData.wins-note;
                            color: Theme.muted;
                            font-size: Type.body;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if SpaceData.also.length > 0: VerticalLayout {
                spacing: Space.sm;
                Caps { text: "ALSO TAKING ROOM"; }
                for line in SpaceData.also: RoomLineView {
                    line: line;
                    menu-at(x, y) => { line-menu.open-at(x, y); }
                }
            }
        }
    }
    divider := PanelDivider {
        visible: root.card-shown;
        x: root.main-width;
        height: parent.height;
        panel-width: root.card-width + Space.xl;
        room: root.width;
        min-list: 480px;
        resizing(w) => { SpaceData.panel-width = w; }
        resized(w) => { SpaceData.panel-resized(w); }
    }
    if root.card-shown: SpaceCard {
        x: root.main-width + divider.width;
        y: Space.xl;
        width: root.card-width;
        height: parent.height - 2 * Space.xl;
    }
    // In a window wider than the lines get, the card's place is there before a line is picked, as on the list pages,
    // so a wide screen has no empty side (Solomon, 11 Nov).
    if !root.card-shown && root.width - root.main-width >= 360px: SidePanel {
        x: root.main-width + divider.width;
        y: Space.xl;
        width: root.width - self.x - Space.xl;
        height: parent.height - 2 * Space.xl;
        closable: false;
        EmptyState {
            vertical-stretch: 1;
            title: "Pick a line";
            text: "What it holds and what you can do about it show here.";
        }
    }
    // A line's right-click menu: its card's buttons, each with its key (rule 15), as on Songs.
    line-menu := RightClickMenu {
        items: SpaceData.line-menu;
        chosen(id) => { SpaceData.chosen(id); }
    }
}
