// The MIDI page, the browse side (spec 3.4): every MIDI part in your projects and MIDI folders, one line per set of
// notes ("in 20 files"), with kind chips, From, Key, Order, Shuffle and the year strip; the picked part's card with
// its piano roll, its key as the key finder reads it, its facts, and what you can do with it. Only shared parts from
// studio.slint; mo-app decides every word (mo_app::midi), mo-ui/src/midi.rs fills it.
import { ListView, ListBox, Fit } from "../list.slint";
import { Theme, AppKeys, Type, Space, Well, SearchBox, ToggleChip, MenuChip, FilterList, FilterColumn, FilterView, ListLine, DragHandle, Caps, ColumnHead, StudioButton, MenuItem, CardAction, CardActions, RightClickMenu, SidePanel, PanelDivider, EmptyState, Dot, PageHeader, YearRange, YearBar } from "../studio.slint";

// One part in the list.
export struct MidiLine {
    // Its place in the list on show.
    row: int,
    title: string,
    // "Night drive 12 · FL Studio · in 3 files".
    from: string,
    // "Piano · Chords · 8 bars · 64 notes".
    details: string,
    // "Part of a longer phrase", in the accent colour; "" for none.
    phrase: string,
    key: string,
    date: string,
    // How many bars long ("" when unknown) and how many files have these notes, for their columns.
    bars: string,
    files: string,
    // Its kind's colour, as a place in Theme.sound-types (-1 grey).
    colour: int,
    // Why the app thinks it's that kind, for the tooltip.
    why: string,
    picked: bool,
}

// A name laid on the piano roll's picture ("C4"): the box it goes in, from the roll's top left, its colour, and whether
// it's a key's name, at the bottom of its box on the right, or a note's, halfway down from the left.
export struct RollLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    text: string,
    color: color,
    key: bool,
}

// The room the roll has, for its picture: its whole size, its margins (at the left, and round the rest) and the size of
// the names laid on it.
export struct RollRoom {
    width: length,
    height: length,
    left: length,
    margin: length,
    name: length,
}

// One of the card's facts: BARS 8.
export struct MidiFact {
    name: string,
    value: string,
}

// The picked part, as its card shows it.
export struct PickedPart {
    kind: string,
    kind-why: string,
    colour: int,
    title: string,
    from: string,
    // Marked where it may break, after its slashes.
    path: string,
    // The key finder's reading: "C minor or Eb major", "72% sure", and why.
    key: string,
    key-sure: string,
    key-why: string,
    // Where the reading comes from ("Read now from its notes by the key finder").
    key-from: string,
    // The chord chart, a bar each ("Am7 | Dm9 G7 | Cmaj7"), read from the notes once they're read; "" for none.
    chords: string,
    chords-why: string,
    instrument: string,
    phrase: string,
    // The roll's lowest and highest key: "C2", "G4".
    roll-low: string,
    roll-high: string,
    // "4,000 notes shown of 5,210", or "".
    roll-note: string,
    // The other files with the same notes, and "and 12 more".
    others: [string],
    others-more: string,
    // In a "Fits my song" list: how the part is moved to fit the song ("Moved 3 semitones up to fit Night drive…"),
    // which is how the roll shows it and how it plays, drags and is sent; "" in any other list.
    fit: string,
}

export global MidiData {
    in property <string> summary;
    in property <string> busy;
    in property <float> done;
    // Your MIDI being read into the Rust index.
    in property <bool> reading;
    callback read-again();
    // The Read MIDI again button's key (it stops a reading too), from the one shortcut list (rule 15).
    in property <string> read-again-key;
    callback stop-reading();

    in-out property <string> search;
    callback search-edited(string);
    // The filters, the same as every page's (FilterPicks): the kinds of part, where they come from (neither picked
    // is both) and the keys, each choice with how many parts it would show.
    in property <FilterView> kind-filter;
    in property <FilterView> from-filter;
    in property <FilterView> key-filter;
    // A choice on the filter "kind", "from" or "key" was picked or unpicked: its words.
    callback toggle(string, string);
    // The filter's menu's Any.
    callback clear-chip(string);
    // The column the list goes by, as its heading says it ("Saved"; "" while shuffled or ranked), and whether that
    // order is turned round.
    in property <string> order-column;
    in property <bool> order-reversed;
    // "order" and the words of the column's heading that was clicked.
    callback pick(string, string);
    callback shuffle();
    // "Shaped most like Bass · Pattern 3 first · 500", or "" when the list isn't ranked against a part.
    in property <string> target;
    callback clear-target();
    in property <string> result;
    // "Fits my song": the list is the parts that go with a song you're working on, the best first (mo-app's
    // midi_fits). The songs offered, the one saved last first; the one picked ("" while it's off); and what's looked
    // for, as a place in `fit-wants-words` (parts to play over the song's chords, or chords for its melody; -1 until
    // the song has been read).
    in property <[string]> fit-songs;
    in property <string> fit-song;
    in property <int> fit-wants: -1;
    in property <[string]> fit-wants-words;
    callback fit-song-picked(string);
    callback fit-wants-picked(int);
    // Said in the list's place while it has no lines of "Fits my song": it's looking, no part fits, or the search
    // couldn't be made ("" otherwise). And whether fewer filters could give it lines, so clearing them is offered.
    in property <string> fit-none-title;
    in property <string> fit-none-text;
    in property <bool> fit-none-filters;

    in property <[YearBar]> years;
    // The picked years, as places in `years` (-1 for none).
    in property <int> years-from: -1;
    in property <int> years-to: -1;
    callback years-picked(int, int);
    callback years-cleared();

    in property <[MidiLine]> lines;
    in property <int> shown;
    // The line to bring into sight, each time `show-ask` goes up.
    in property <int> show-row;
    in property <int> show-ask;
    // The last ask the list has turned to (list.slint's ListView keeps it).
    in-out property <int> show-done;
    // Where the list is turned to (list.slint's ListView keeps it): it's there again when the page is shown again.
    in-out property <length> list-y;
    callback select(int);
    callback step(int);

    // Said instead of the list while there's nothing to show yet ("" once there is).
    in property <string> empty-title;
    in property <string> empty-text;
    in property <bool> any-filter;
    callback clear();

    in property <bool> panel-shown;
    in-out property <length> panel-width: 420px;
    callback panel-resized(length);
    callback close-panel();
    in property <PickedPart> picked;
    // The picked part's piano roll: how many keys it shows top to bottom (none while its notes are read), its picture
    // (rows, keyboard, bar lines and notes, drawn off the window's thread by mo-ui's piano_roll) and the names on it.
    in property <int> roll-keys;
    in property <image> roll-picture;
    in property <[RollLabel]> roll-labels;
    // The roll's room, each time it, the window's scale or one of the roll's choices changes, so its picture is drawn
    // again to fit.
    callback roll-laid-out(RollRoom);
    // The roll's choices: a keyboard down its side, and each note's name on it.
    in-out property <bool> roll-keyboard: true;
    in-out property <bool> roll-names: false;
    // Playing the picked part as a loop with a General MIDI sound matched to it: whether it plays, the sound and why
    // ("Electric Piano 1 · from its name: rhodes · 120 BPM"), what went wrong, and the key that plays or stops it.
    in property <bool> playing;
    in property <string> sound-line;
    in property <string> play-note;
    in property <string> play-key;
    // No SoundFont to play with yet: what to do, and a button to choose one.
    in property <bool> soundfont-missing;
    in property <string> soundfont-note;
    in property <string> soundfont-where;
    callback play-toggled();
    callback choose-soundfont();
    // Playing the picked part in a DAW, through whatever is on the track selected in Bitwig or the channel selected
    // in FL Studio: which one plays ("" none, "bitwig", "fl"), which is starting, how it went, and their keys.
    in property <string> daw-playing;
    in property <string> daw-starting;
    in property <string> daw-note;
    in property <string> bitwig-key;
    in property <string> fl-key;
    callback daw-play(string);
    // Dragging a part out into a DAW as a MIDI clip (mo-ui's drag.rs): a line of the list by its row, or the picked
    // part by its card's handle; then `drag-let-go` if the button comes up before the drag has got going. The part is
    // dimmed where it was picked up while it's carried, and glows there for a moment once it has landed.
    callback drag-row(int);
    callback drag-picked();
    callback drag-let-go();
    in property <int> lifted-row: -1;
    in property <int> landed-row: -1;
    in property <bool> lifted-picked;
    in property <bool> landed-picked;
    in property <[MidiFact]> facts;
    in property <[CardAction]> actions;
    in property <[MenuItem]> menu;
    callback menu-chosen(string);
}

// The list's headings: a click orders the list by that column, a second click turns it round.
component ListHeading inherits HorizontalLayout {
    // A narrow list (beside the filter column and the card at 1440 wide) leaves out Bars and Files, which the card
    // says too, and keeps a short Key, so the part's name has room.
    in property <bool> tight;
    padding-left: Space.md + Space.xs;
    padding-right: Space.md + Space.xs;
    spacing: Space.md;
    height: 28px;
    Rectangle { width: 8px; }
    ColumnHead {
        horizontal-stretch: 1;
        text: "PART";
        on: MidiData.order-column == "Part";
        // A to Z first.
        up: !MidiData.order-reversed;
        clicked => { MidiData.pick("order", "Part"); }
    }
    if !root.tight: ColumnHead {
        width: 44px;
        right: true;
        text: "BARS";
        tip: "How many bars long";
        on: MidiData.order-column == "Bars";
        up: MidiData.order-reversed;
        clicked => { MidiData.pick("order", "Bars"); }
    }
    if !root.tight: ColumnHead {
        width: 44px;
        right: true;
        text: "FILES";
        tip: "How many of your files have these notes";
        on: MidiData.order-column == "Files";
        up: MidiData.order-reversed;
        clicked => { MidiData.pick("order", "Files"); }
    }
    ColumnHead {
        width: root.tight ? 48px : 96px;
        text: "KEY";
        on: MidiData.order-column == "Key";
        // Round the circle from C first.
        up: !MidiData.order-reversed;
        clicked => { MidiData.pick("order", "Key"); }
    }
    ColumnHead {
        width: 96px;
        text: "SAVED";
        on: MidiData.order-column == "Saved";
        up: MidiData.order-reversed;
        clicked => { MidiData.pick("order", "Saved"); }
    }
}

component MidiLineView inherits ListLine {
    in property <MidiLine> line;
    // As the heading's.
    in property <bool> tight;
    callback chosen();
    height: 52px;
    selected: line.picked;
    tip: line.why;
    tip-below: 26px;
    draggable: true;
    lifted: root.line.row == MidiData.lifted-row;
    landed: root.line.row == MidiData.landed-row;
    drag-out => { MidiData.drag-row(root.line.row); }
    drag-let-go => { MidiData.drag-let-go(); }
    clicked => {
        root.chosen();
        MidiData.select(root.line.row);
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        VerticalLayout {
            alignment: center;
            Dot { tint: Theme.sound-type(root.line.colour); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            alignment: center;
            spacing: Space.xs;
            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: root.line.title;
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
                Text {
                    text: root.line.from;
                    color: Theme.muted;
                    font-size: Type.meta;
                    overflow: elide;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: root.line.details;
                    color: Theme.muted;
                    font-size: Type.meta;
                    overflow: elide;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
                if root.line.phrase != "": Text {
                    text: root.line.phrase;
                    // Plain information, so not the accent (that means picked or playing).
                    color: Theme.text;
                    font-size: Type.meta;
                }
            }
        }
        if !root.tight: Text {
            width: 44px;
            text: root.line.bars;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if !root.tight: Text {
            width: 44px;
            text: root.line.files;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            width: root.tight ? 48px : 96px;
            text: root.line.key;
            color: Theme.text;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 96px;
            text: root.line.date;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
        }
    }
}

// The picked part's notes: a row for each key (the black keys' rows darker), a line at each bar, each note a bar of
// the accent colour, as strong as it's played. A keyboard down the side and the notes' names are choices; with
// names on, the roll grows so a row has room for its name. The rows, keys, lines and notes are one picture, drawn off
// the window's thread on the graphics card or the processor (mo-ui's piano_roll, from mo_app::piano_roll, which lays
// it out in the room this gives it); the names are laid on it here.
component PianoRoll inherits Well {
    private property <length> name-row: Type.tiny + 2px;
    // The choices and the window's scale, watched, so the picture is drawn again when one changes.
    private property <bool> keyboard: MidiData.roll-keyboard;
    private property <bool> names: MidiData.roll-names;
    private property <float> scale: 1px / 1phx;
    height: MidiData.roll-names
        ? clamp(MidiData.roll-keys * self.name-row + 2 * Space.sm, 200px, 520px)
        : 200px;
    clip: true;
    function laid-out() {
        MidiData.roll-laid-out({
            width: self.width,
            height: self.height,
            left: Space.xs,
            margin: Space.sm,
            name: Type.tiny,
        });
    }
    init => {
        root.laid-out();
    }
    changed width => {
        root.laid-out();
    }
    changed height => {
        root.laid-out();
    }
    changed keyboard => {
        root.laid-out();
    }
    changed names => {
        root.laid-out();
    }
    changed scale => {
        root.laid-out();
    }
    // Shown pixel for pixel, as sharp as it was drawn: it's made for the roll's size at the window's scale, a whole
    // number of pixels each way (so it may go up to a pixel into the margin, which is the well's colour too).
    Image {
        x: Space.xs;
        y: Space.sm;
        width: self.source.width * 1phx;
        height: self.source.height * 1phx;
        source: MidiData.roll-picture;
    }
    for l in MidiData.roll-labels: Text {
        x: l.x;
        y: l.key ? l.y + l.height - self.height : l.y + (l.height - self.height) / 2;
        width: l.width;
        text: l.text;
        color: l.color;
        font-family: Theme.number-font;
        font-size: Type.tiny;
        horizontal-alignment: l.key ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    }
    if !MidiData.roll-keyboard: Text {
        x: Space.xs;
        y: Space.xs;
        text: MidiData.picked.roll-high;
        color: Theme.faint;
        font-family: Theme.number-font;
        font-size: Type.tiny;
    }
    if !MidiData.roll-keyboard: Text {
        x: Space.xs;
        y: parent.height - self.height - Space.xs;
        text: MidiData.picked.roll-low;
        color: Theme.faint;
        font-family: Theme.number-font;
        font-size: Type.tiny;
    }
}

// The roll's two choices, under it.
component RollChoices inherits HorizontalLayout {
    spacing: Space.sm;
    alignment: start;
    ToggleChip {
        text: "Keyboard";
        on: MidiData.roll-keyboard;
        clicked => { MidiData.roll-keyboard = !MidiData.roll-keyboard; }
    }
    ToggleChip {
        text: "Note names";
        on: MidiData.roll-names;
        clicked => { MidiData.roll-names = !MidiData.roll-names; }
    }
}

component PartPanel inherits SidePanel {
    close => { MidiData.close-panel(); }
    HorizontalLayout {
        spacing: Space.sm;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Dot { tint: Theme.sound-type(MidiData.picked.colour); }
        }
        Text {
            text: MidiData.picked.kind;
            color: Theme.sound-type(MidiData.picked.colour);
            font-size: Type.meta;
            font-weight: 600;
        }
        Text {
            text: MidiData.picked.kind-why;
            color: Theme.muted;
            font-size: Type.meta;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }
    Text {
        text: MidiData.picked.title;
        color: Theme.text;
        font-family: Theme.title-font;
        font-size: Type.heading;
        font-weight: 600;
        wrap: word-wrap;
        min-width: 0px;
    }
    Text {
        text: MidiData.picked.from;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    Text {
        text: MidiData.picked.path;
        color: Theme.faint;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    // Straight above the roll, which shows the part as this line says it's moved.
    if MidiData.picked.fit != "": Text {
        text: MidiData.picked.fit;
        color: Theme.text;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    PianoRoll { }
    if MidiData.roll-keys > 0: RollChoices { }
    if MidiData.picked.roll-note != "": Text {
        text: MidiData.picked.roll-note;
        color: Theme.muted;
        font-size: Type.meta;
    }
    // Where to take the part from to drag it into a DAW, straight under its picture as on every card (the UX
    // review of 10 Nov, B3): it goes as a MIDI clip of its own (a new .mid file; the part's
    // own file is never touched).
    DragHandle {
        text: "Drag into your DAW as a MIDI clip";
        tip: "Drag the part out as a new MIDI file of its notes";
        lifted: MidiData.lifted-picked;
        landed: MidiData.landed-picked;
        drag-out => { MidiData.drag-picked(); }
        drag-let-go => { MidiData.drag-let-go(); }
    }
    // The card's buttons, in the order every card keeps (review B2): play first (the lit one), then into the DAW, then
    // show and copy, in two even columns. Play is the part round and round with a General MIDI sound matched to it.
    buttons := CardActions {
        room: root.inside;
        actions: MidiData.actions;
        chosen(id) => { MidiData.menu-chosen(id); }
        StudioButton {
            main: true;
            width: max(self.min-width, buttons.cell);
            enabled: !MidiData.soundfont-missing || MidiData.playing;
            text: MidiData.playing ? "Stop" : "Play loop";
            tip: MidiData.playing ? "Stop the loop" : "Play the part round and round with a General MIDI sound matched to it";
            key: MidiData.play-key;
            clicked => { MidiData.play-toggled(); }
        }
        StudioButton {
            width: max(self.min-width, buttons.cell);
            text: MidiData.daw-playing == "bitwig" || MidiData.daw-starting == "bitwig" ? "Stop in Bitwig" : "Play in Bitwig";
            tip: MidiData.daw-playing == "bitwig" || MidiData.daw-starting == "bitwig" ? "Stop the part and take its clip out of Bitwig" : "Play the part round and round through what's on the track selected in Bitwig";
            key: MidiData.bitwig-key;
            clicked => { MidiData.daw-play("bitwig"); }
        }
        StudioButton {
            width: max(self.min-width, buttons.cell);
            text: MidiData.daw-playing == "fl" || MidiData.daw-starting == "fl" ? "Stop in FL Studio" : "Play in FL Studio";
            tip: MidiData.daw-playing == "fl" || MidiData.daw-starting == "fl" ? "Stop the part in FL Studio" : "Play the part round and round through the channel selected in FL Studio";
            key: MidiData.fl-key;
            clicked => { MidiData.daw-play("fl"); }
        }
    }
    // The sound it plays with, and at what tempo: a line of its own below the buttons.
    Text {
        text: MidiData.sound-line;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    if MidiData.daw-note != "": Text {
        text: MidiData.daw-note;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    if MidiData.play-note != "": Text {
        text: MidiData.play-note;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
    if MidiData.soundfont-missing: VerticalLayout {
        spacing: Space.xs;
        Text {
            text: MidiData.soundfont-note;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        HorizontalLayout {
            alignment: start;
            StudioButton {
                horizontal-stretch: 0;
                text: "Choose a SoundFont…";
                tip: MidiData.soundfont-where;
                clicked => { MidiData.choose-soundfont(); }
            }
        }
    }
    VerticalLayout {
        spacing: Space.xs;
        Caps { text: "KEY"; }
        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            Text {
                text: MidiData.picked.key;
                color: Theme.text;
                font-size: Type.row-title;
                font-weight: 600;
            }
            if MidiData.picked.key-sure != "": VerticalLayout {
                alignment: end;
                Text {
                    text: MidiData.picked.key-sure;
                    color: Theme.muted;
                    font-family: Theme.number-font;
                    font-size: Type.meta;
                }
            }
        }
        Text {
            text: MidiData.picked.key-why;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
        Text {
            text: MidiData.picked.key-from;
            color: Theme.faint;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    if MidiData.picked.chords != "": VerticalLayout {
        spacing: Space.xs;
        Caps { text: "CHORDS"; }
        Text {
            text: MidiData.picked.chords;
            color: Theme.text;
            font-size: Type.body;
            wrap: word-wrap;
            min-width: 0px;
        }
        if MidiData.picked.chords-why != "": Text {
            text: MidiData.picked.chords-why;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    HorizontalLayout {
        spacing: Space.md;
        for f in MidiData.facts: VerticalLayout {
            spacing: Space.xs;
            horizontal-stretch: 1;
            Caps { text: f.name; }
            Text {
                text: f.value;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.meta;
            }
        }
    }
    if MidiData.picked.instrument != "": VerticalLayout {
        spacing: Space.xs;
        Caps { text: "INSTRUMENT"; }
        Text {
            text: MidiData.picked.instrument;
            color: Theme.muted;
            font-size: Type.meta;
            wrap: word-wrap;
            min-width: 0px;
        }
    }
    if MidiData.picked.phrase != "": Text {
        text: MidiData.picked.phrase;
        color: Theme.text;
        font-size: Type.meta;
    }
    if MidiData.picked.others.length > 0: VerticalLayout {
        spacing: Space.xs;
        Caps { text: "THE SAME NOTES ARE IN"; }
        for o in MidiData.picked.others: Text {
            text: o;
            color: Theme.muted;
            font-size: Type.meta;
            overflow: elide;
            min-width: 0px;
        }
        if MidiData.picked.others-more != "": Text {
            text: MidiData.picked.others-more;
            color: Theme.faint;
            font-size: Type.meta;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component MidiPage inherits Rectangle {
    forward-focus: search-box;
    // Ctrl+F (app.search): the keys go to the search box, its words picked so typing replaces them (review X3-22).
    property <int> search-asked: AppKeys.search;
    changed search-asked => { search-box.focus-all(); }

    VerticalLayout {
        padding: Space.xl;
        padding-bottom: Space.lg;
        spacing: Space.md;
        PageHeader {
            title: "MIDI";
            summary: MidiData.summary;
            busy: MidiData.busy;
            done: MidiData.done;
        }
        HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            search-box := SearchBox {
                // Esc goes on to the window's keys (the page's next step back, app.escape), and Ctrl+Up and
                // Ctrl+Down step through the list from here.
                page-search: true;
                horizontal-stretch: 1;
                min-width: 320px;
                max-width: 480px;
                hint: "Search MIDI: dark, Cm, trap, piano…";
                text <=> MidiData.search;
                edited(t) => { MidiData.search-edited(t); }
                key(k) => {
                    if (k == Key.DownArrow) {
                        keys.focus();
                        MidiData.step(1);
                        return true;
                    }
                    false
                }
            }
            // The top row's order on every page (the UX review of 10 Nov, A5): search, how the list is ordered, and
            // the page's own action at the far right. The list's headings order it (B5); Shuffle is the one order no
            // column has.
            VerticalLayout {
                alignment: center;
                StudioButton {
                    horizontal-stretch: 0;
                    text: "Shuffle";
                    tip: "A random order: press again for another";
                    clicked => { MidiData.shuffle(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                StudioButton {
                    horizontal-stretch: 0;
                    text: MidiData.reading ? "Stop" : "Read MIDI again";
                    tip: MidiData.reading ? "Stop reading: it carries on from there next time"
                        : "Look for new and changed projects and MIDI files, and try the ones that failed again. Only those are read.";
                    key: MidiData.read-again-key;
                    clicked => {
                        if (MidiData.reading) {
                            MidiData.stop-reading();
                        } else {
                            MidiData.read-again();
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: Space.sm;
            vertical-stretch: 0;
            // "Fits my song": its chip picks the song (and Off), lit while it's on; then what's looked for, two
            // joined chips with one lit. The list's own line follows, as it does the "parts like this one" chip.
            if MidiData.fit-songs.length > 0 || MidiData.fit-song != "": VerticalLayout {
                alignment: center;
                MenuChip {
                    name: "Fits my song";
                    value: MidiData.fit-song;
                    choices: MidiData.fit-songs;
                    any-text: "Off";
                    picked(song) => { MidiData.fit-song-picked(song); }
                }
            }
            if MidiData.fit-song != "": VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    for words[i] in MidiData.fit-wants-words: ToggleChip {
                        text: words;
                        on: MidiData.fit-wants == i;
                        joined-left: i > 0;
                        joined-right: i + 1 < MidiData.fit-wants-words.length;
                        clicked => { MidiData.fit-wants-picked(i); }
                    }
                }
            }
            // Only the parts like this one: the shared chip, as on the other pages; a click shows them all again.
            if MidiData.target != "": VerticalLayout {
                alignment: center;
                ToggleChip {
                    text: MidiData.target + "  ×";
                    on: true;
                    clicked => { MidiData.clear-target(); }
                }
            }
            Text {
                text: MidiData.result;
                color: Theme.muted;
                font-size: Type.meta;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
        }
        split := Rectangle {
            vertical-stretch: 1;
            area := Rectangle {
                x: column.room;
                y: 0;
                width: split.width - self.x;
                height: split.height;
                // The card's place is always there (empty until a part is picked), so nothing moves when one is.
                property <length> list-width: min(Fit.list-max, max(380px, self.width - MidiData.panel-width - divider.width));
                property <length> card-width: self.width - self.list-width - divider.width;
                property <length> years-width: MidiData.years.length > 1 && MidiData.empty-title == "" ? 56px : 0px;
                if area.years-width > 0: YearRange {
                    x: area.list-width - area.years-width;
                    y: 0;
                    height: area.height;
                    years: MidiData.years;
                    picked-from: MidiData.years-from;
                    picked-to: MidiData.years-to;
                    picked(a, b) => { MidiData.years-picked(a, b); }
                    cleared => { MidiData.years-cleared(); }
                }
                keys := FocusScope {
                    x: 0;
                    width: area.list-width - area.years-width;
                    key-pressed(event) => {
                        if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                            return reject;
                        }
                        if (event.text == Key.UpArrow) {
                            MidiData.step(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            MidiData.step(1);
                            return accept;
                        }
                        reject
                    }
                    Well {
                        if MidiData.empty-title != "" || MidiData.shown == 0: EmptyState {
                            title: MidiData.empty-title != "" ? MidiData.empty-title
                                : MidiData.fit-none-title != "" ? MidiData.fit-none-title : "No parts match";
                            text: MidiData.empty-title != "" ? MidiData.empty-text
                                : MidiData.fit-none-title != "" ? MidiData.fit-none-text : "Try fewer filters or other words.";
                            // Not where the filters aren't why the list is empty (a song that can't be read).
                            action: MidiData.empty-title == "" && MidiData.any-filter
                                && (MidiData.fit-none-title == "" || MidiData.fit-none-filters) ? "Clear the filters" : "";
                            act => { MidiData.clear(); }
                        }
                        if MidiData.empty-title == "" && MidiData.shown > 0: ListBox {
                            turned: lines.content-y;
                            after: lines.row-height;
                            to-top => { lines.to-top(); }
                            VerticalLayout {
                                ListHeading {
                                    tight: area.list-width < 620px;
                                }
                                lines := ListView {
                                    row-height: 52px;
                                    rows: MidiData.lines.length;
                                    show-top: MidiData.show-row * self.row-height;
                                    show-ask: MidiData.show-ask;
                                    show-done <=> MidiData.show-done;
                                    kept-y <=> MidiData.list-y;
                                    for l in MidiData.lines: MidiLineView {
                                        tight: area.list-width < 620px;
                                        // Every line this height: the list counts on it.
                                        height: lines.row-height;
                                        line: l;
                                        chosen => { keys.focus(); }
                                        right-clicked(x, y) => {
                                            keys.focus();
                                            menu.open-at(x, y);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                divider := PanelDivider {
                    x: area.list-width;
                    height: parent.height;
                    // The card's width as it's shown, so a drag starts from what you see. The list stops at its
                    // widest, so in a wide window the seam only goes left of there.
                    panel-width: area.card-width;
                    room: area.width;
                    resizing(w) => { MidiData.panel-width = w; }
                    resized(w) => { MidiData.panel-resized(w); }
                }
                if MidiData.panel-shown: PartPanel {
                    x: area.list-width + divider.width;
                    width: area.card-width;
                    height: parent.height;
                }
                if !MidiData.panel-shown: SidePanel {
                    x: area.list-width + divider.width;
                    width: area.card-width;
                    height: parent.height;
                    closable: false;
                    EmptyState {
                        vertical-stretch: 1;
                        title: "Pick a part";
                        text: "Its notes, its key and what it can do show here.";
                    }
                }
                menu := RightClickMenu {
                    items: MidiData.menu;
                    chosen(id) => { MidiData.menu-chosen(id); }
                }
            }
            // The filters, in a column at the side as on every page (Solomon, 10 Nov 2026): each one's choices as a
            // tick list, the keys in a menu that scrolls. Each says how many parts picking it would show. After the
            // list, so the opened column of a narrow window lies over it.
            column := FilterColumn {
                page-width: split.width;
                height: split.height;
                active: MidiData.any-filter;
                FilterList {
                    name: "KIND";
                    filter: MidiData.kind-filter;
                    toggled(text) => { MidiData.toggle("kind", text); }
                    cleared => { MidiData.clear-chip("kind"); }
                }
                FilterList {
                    name: "FROM";
                    filter: MidiData.from-filter;
                    toggled(text) => { MidiData.toggle("from", text); }
                    cleared => { MidiData.clear-chip("from"); }
                }
                FilterList {
                    name: "KEY";
                    filter: MidiData.key-filter;
                    toggled(text) => { MidiData.toggle("key", text); }
                    cleared => { MidiData.clear-chip("key"); }
                }
                if MidiData.any-filter: HorizontalLayout {
                    alignment: start;
                    StudioButton {
                        text: "Clear filters";
                        clicked => { MidiData.clear(); }
                    }
                }
            }
        }
    }
}
