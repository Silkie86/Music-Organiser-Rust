// The Curves page's side card: the curve editor (the screen design of 14 Nov 2026, built on the plan Solomon
// approved that day). From the top, as every card reads: the name plate with Undo and Redo, the picked curve's facts,
// the ruler, the picture, the drag strip, then Hear, the grid and Save as new curve, and the picked curve's own
// buttons. The picture's still layers (grid, fill, curve) are one picture drawn off the window's thread
// (mo_app::curve_picture, mo-ui/src/curve_editor.rs); what moves with the mouse or the sound is laid over it here.
// Only shared parts from studio.slint.
import { Theme, Motion, MenuItem, RightClickMenu, AppKeys, Type, Space, Well, SearchBox, ToggleChip, DragHandle, StudioButton, TempoStepper, Tip, CardAction, CardActions, SidePanel, MouseField } from "../studio.slint";

// One of the ruler's marks: where (from the picture's left) and its bar and beat ("1", "1.2"; none when the marks are
// too close to number each).
export struct RulerMark {
    x: length,
    text: string,
    bar: bool,
}

// A point's dot on the picture: where its middle is, and whether the mouse is on it or holds it.
export struct EditorDot {
    x: length,
    y: length,
    hot: bool,
    held: bool,
}

// A tile of the clip strip: a clip (a remembered highlight) on the picture's own time line.
export struct ClipTile {
    x: length,
    width: length,
    name: string,
    // Its length in words.
    words: string,
    pinned: bool,
    // Its part is the highlight.
    picked: bool,
    // Tiles take turns between two plain shades.
    lighter: bool,
    // The mouse is on it, and on its pin.
    hot: bool,
    pin-hot: bool,
    // It's a clip wide enough for a pin.
    can-pin: bool,
}

export global CurveEditorData {
    // The curve on the card and, in muted words after it, whether it's been changed ("edited, not saved").
    in property <string> name;
    in property <string> state-words;
    // The picked curve as found, on one line: "1 bar · 9 points ·" then where ("In 2 songs").
    in property <string> facts;
    in property <string> found;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> changed;
    in property <string> undo-key;
    in property <string> redo-key;
    in property <string> save-key;
    in property <string> hear-key;
    // The still layers, drawn to fit the room the page reports (`laid-out`), and the ruler's marks over them.
    in property <image> picture;
    in property <[RulerMark]> ruler;
    // Where the curve ends, from the picture's left; under 0 when its end isn't in sight.
    in property <length> end-x: -1px;
    // The grid: its step (0 is 1/4, 1 is 1/8, 2 is 1/16, 3 is 1/32, -1 is off) and whether it's triplets or dotted.
    in property <int> grid-step: 2;
    in property <bool> grid-triplet;
    in property <bool> grid-dotted;
    // Hear: whether the tone plays, and where it is now, from the picture's left (under 0 when not in sight).
    in property <bool> playing;
    in property <length> playhead: -1px;
    // How it's heard: the metronome (a click on each beat), and the speed in words ("120 BPM"), whether that's another
    // speed than the usual one. A change is heard at once while the
    // tone plays.
    in property <bool> metronome;
    in property <string> speed-words: "120 BPM";
    in property <bool> speed-changed;
    in property <string> metronome-key;
    in property <string> faster-key;
    in property <string> slower-key;
    callback metronome-toggled();
    // The speed a step slower (-1) or faster (1), or back to the usual one (0).
    callback speed-stepped(int);
    // The picture's room, each time it or the window's scale changes.
    callback laid-out(length, length);
    // The wheel over the ruler or the picture: where (from the picture's left), how far, and whether Shift is held
    // (Shift moves along; without it the wheel zooms round the mouse).
    callback wheel(length, length, bool);
    // A grid chip: 0 to 3 a step, 4 Triplet (on or off), 5 Dotted (on or off), 6 Off.
    callback grid-picked(int);
    // The points' dots on show, the line under the mouse and the curve as it was when a drag began (both as path
    // commands in the picture's own points; "" for none), and the picture's size they're drawn in.
    in property <[EditorDot]> dots;
    in property <string> hot-line;
    in property <string> ghost;
    in property <length> picture-width;
    in property <length> picture-height;
    // The pointer over the picture: 0 arrow, 1 open hand, 2 closed hand, 3 up and down, 4 left and right, 5 and 6
    // the two diagonals (top left to bottom right, top right to bottom left), 7 copy.
    in property <int> pointer;
    // The highlight's frame in the picture's points (round the whole curve when nothing is highlighted: `hl-whole`),
    // the handle under the mouse or held (0 none, 1 the bar, 2 left, 3 right, 4 top, 5 bottom, 6 to 9 the corners:
    // top left, top right, bottom left, bottom right), and whether the mouse is on the picture.
    in property <bool> hl-shown;
    in property <bool> hl-whole;
    in property <length> hl-left;
    in property <length> hl-right;
    in property <length> hl-top;
    in property <length> hl-bottom;
    in property <int> hl-hot;
    in property <bool> hl-near;
    // The hint line: what's under the mouse, what it does, what the keys change; and the keys held.
    in property <string> hint-name;
    in property <string> hint-does;
    in property <string> hint-keys;
    in property <bool> shift;
    in property <bool> alt;
    in property <bool> ctrl;
    in property <bool> mac;
    // The read-out by the mouse while dragging ("" for none), and where the mouse is.
    in property <string> read-out;
    in property <length> read-x;
    in property <length> read-y;
    // The mouse on the picture: 0 moved, 1 pressed, 2 let go, 3 double-clicked, 4 left, 5 press taken away; where; Shift, Alt, Ctrl.
    callback mouse(int, length, length, bool, bool, bool);
    // The clip strip's tiles, and the mouse on it: 0 moved, 1 pressed, 2 let go, 3 double-clicked, 4 left, 5 press
    // taken away, 6 right-clicked; where, from the picture's left; Shift, Alt, Ctrl.
    in property <[ClipTile]> clips;
    callback strip(int, length, bool, bool, bool);
    // The right-click menu on the picture and the strip: asked for just before it opens, and what was chosen.
    in property <[MenuItem]> part-menu;
    callback menu-opens();
    callback menu-chosen(string);
    callback undo();
    callback redo();
    callback hear();
    callback save-as-new();
}

// A handle on the highlight's frame: a pill on a side, a dot on a corner; filled and a size up under the mouse or
// held. `mid-x` and `mid-y` are where its middle sits. Faint (`near` off) round the whole curve until the mouse comes.
component FrameHandle inherits Rectangle {
    in property <bool> across;
    in property <bool> corner;
    in property <bool> hot;
    in property <bool> near: true;
    in property <length> mid-x;
    in property <length> mid-y;
    property <length> long: root.hot ? 34px : 28px;
    property <length> thin: root.hot ? 8px : 6px;
    property <length> dot: root.hot ? 12px : 10px;
    x: root.mid-x - self.width / 2;
    y: root.mid-y - self.height / 2;
    width: root.corner ? root.dot : root.across ? root.long : root.thin;
    height: root.corner ? root.dot : root.across ? root.thin : root.long;
    border-radius: min(self.width, self.height) / 2;
    background: root.hot ? Theme.accent : Theme.well;
    border-width: root.hot ? 0px : 1.5px;
    border-color: Theme.accent.transparentize(root.near ? 0% : 55%);
    animate width, height { duration: Motion.tap; }
}

// A key's cap, as on the hint line: lit while it's held.
component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    width: label.preferred-width + 12px;
    height: 20px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.lit ? Theme.accent : Theme.edge;
    background: root.lit ? Theme.accent.transparentize(78%) : Theme.well;
    label := Text {
        text: root.text;
        color: root.lit ? Theme.text : Theme.muted;
        font-family: Theme.number-font;
        font-size: Type.tiny;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// One of the three keys at the hint line's right, always on show with what it means: they teach the editor's three
// rules, and light while held. On a narrow hint line only the held key says what it means.
component KeyLamp inherits HorizontalLayout {
    in property <string> key;
    in property <string> means;
    in property <bool> lit;
    in property <bool> compact;
    spacing: Space.xs;
    alignment: start;
    VerticalLayout {
        alignment: center;
        KeyCap {
            text: root.key;
            lit: root.lit;
        }
    }
    if !root.compact || root.lit: Text {
        text: root.means;
        color: root.lit ? Theme.text : Theme.faint;
        font-size: Type.meta;
        font-weight: root.lit ? 600 : 400;
        vertical-alignment: center;
    }
}

// The hint line under the picture: what's under the mouse, what a drag or a double-click does there, and what the
// keys change. A phrase that doesn't fit is cut at the lamps, never laid over them.
component HintLine inherits Rectangle {
    height: 34px;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.edge;
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;
        Text {
            text: CurveEditorData.hint-name;
            color: Theme.text;
            font-size: Type.body;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: CurveEditorData.hint-does + (CurveEditorData.hint-keys != "" ? "  ·  " + CurveEditorData.hint-keys : "");
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        KeyLamp {
            key: "Shift";
            means: "free";
            lit: CurveEditorData.shift;
            compact: root.width < 900px;
        }
        KeyLamp {
            key: CurveEditorData.mac ? "Option" : "Alt";
            means: "bend";
            lit: CurveEditorData.alt;
            compact: root.width < 900px;
        }
        KeyLamp {
            key: CurveEditorData.mac ? "Cmd" : "Ctrl";
            means: "make";
            lit: CurveEditorData.ctrl;
            compact: root.width < 900px;
        }
    }
}

// The small label by the mouse while dragging: what the drag is doing, in numbers.
component ReadOut inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 16px;
    height: 24px;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.accent.transparentize(40%);
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-family: Theme.number-font;
        font-size: Type.small;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// The ruler: a mark at each beat with its place, the end mark, and the play marker while Hear plays. It keeps the
// picture's room at its sides (the marks' places are the picture's own), so a bar line runs straight down both.
component Ruler inherits Rectangle {
    height: 24px;
    clip: true;
    for m in CurveEditorData.ruler: Rectangle {
        x: m.x - 0.5px;
        y: root.height - (m.bar ? 10px : 8px);
        width: 1px;
        height: m.bar ? 10px : 8px;
        background: Theme.stroke;
        Text {
            x: 4px;
            y: -(root.height - parent.height) + 1px;
            text: m.text;
            // The bars stand out; the beats between them ("1.2") are smaller and fainter, so the eye finds the bars
            // first (Solomon, 14 Nov 2026).
            color: m.bar ? Theme.text : Theme.faint;
            font-family: Theme.number-font;
            font-size: m.bar ? Type.meta : Type.tiny;
            font-weight: m.bar ? 600 : 400;
        }
    }
    // The end mark: how long the whole curve is.
    if CurveEditorData.end-x >= 0: Rectangle {
        x: CurveEditorData.end-x - 3px;
        y: 3px;
        width: 6px;
        height: root.height - 3px;
        border-radius: 2px;
        background: Theme.text;
    }
    if CurveEditorData.playing && CurveEditorData.playhead >= 0: Path {
        x: CurveEditorData.playhead - 5px;
        y: root.height - 7px;
        width: 10px;
        height: 7px;
        viewbox-width: 10;
        viewbox-height: 7;
        commands: "M 0 0 L 10 0 L 5 7 Z";
        fill: Theme.accent;
    }
    TouchArea {
        scroll-event(e) => {
            CurveEditorData.wheel(self.mouse-x, e.delta-y != 0 ? e.delta-y : e.delta-x, e.modifiers.shift);
            EventResult.accept
        }
    }
}

// The clip strip: the curve's clips end to end over the picture, on its time line. A curve with no clips shows one
// tile with its own name, so the strip is always there.
component ClipStrip inherits Rectangle {
    // A right-click, in the window's own points.
    callback menu(length, length);
    height: 30px;
    clip: true;
    for t in CurveEditorData.clips: Rectangle {
        x: t.x;
        width: t.width;
        height: root.height;
        border-radius: Theme.radius;
        border-width: t.picked ? 1.5px : 1px;
        border-color: t.picked ? Theme.accent : Theme.edge;
        background: t.picked ? Theme.accent.transparentize(86%)
            : Theme.surface-raised.brighter((t.lighter ? 22% : 0%) + (t.hot ? 8% : 0%));
        HorizontalLayout {
            padding-left: Space.sm;
            padding-right: t.can-pin ? Space.xl : Space.xs;
            spacing: Space.sm;
            Text {
                horizontal-stretch: 1;
                text: t.name;
                overflow: elide;
                color: Theme.text;
                font-size: Type.meta;
                font-weight: 500;
                vertical-alignment: center;
            }
            // A narrow tile drops its length first; its name shortens after that.
            if t.width >= 200px: Text {
                horizontal-stretch: 0;
                text: t.words;
                color: Theme.faint;
                font-family: Theme.number-font;
                font-size: Type.tiny;
                vertical-alignment: center;
            }
        }
        // Its pin: always on show when pinned, else while the mouse is on the tile.
        if t.can-pin && (t.pinned || t.hot): Rectangle {
            x: parent.width - 17px;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: t.pinned ? Theme.accent : transparent;
            border-width: 1.5px;
            border-color: t.pinned ? Theme.accent : t.pin-hot ? Theme.text : Theme.muted;
        }
    }
    touch := MouseField {
        changed inside => {
            if !self.inside {
                self.tell(4, false, false, false);
            }
        }
        function tell(kind: int, shift: bool, alt: bool, ctrl: bool) {
            CurveEditorData.strip(kind, self.mouse-x, shift, alt, ctrl);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move {
                self.tell(0, e.modifiers.shift, e.modifiers.alt, e.modifiers.control || e.modifiers.meta);
            } else if e.kind == PointerEventKind.cancel {
                self.tell(5, false, false, false);
            } else if e.button == PointerEventButton.left {
                self.tell(e.kind == PointerEventKind.down ? 1 : 2, e.modifiers.shift, e.modifiers.alt,
                    e.modifiers.control || e.modifiers.meta);
            } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                // The clip under the mouse is highlighted first: the menu is about it.
                self.tell(6, false, false, false);
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            self.tell(3, CurveEditorData.shift, CurveEditorData.alt, CurveEditorData.ctrl);
        }
        scroll-event(e) => {
            CurveEditorData.wheel(self.mouse-x, e.delta-y != 0 ? e.delta-y : e.delta-x, e.modifiers.shift);
            EventResult.accept
        }
    }
}

// The grid's chips, joined in one strip after its name: one step is always picked unless it's off, and Triplet is
// on or off beside it.
component GridStrip inherits HorizontalLayout {
    // Whether its name leads the chips: left out where the card is too narrow for it and the buttons beside it.
    in property <bool> named: true;
    spacing: 0;
    alignment: start;
    if root.named: VerticalLayout {
        alignment: center;
        Rectangle {
            width: name.preferred-width + 2 * Space.md;
            height: 28px;
            border-top-left-radius: 14px;
            border-bottom-left-radius: 14px;
            border-width: 1px;
            border-color: Theme.edge;
            background: Theme.well;
            name := Text {
                text: "Grid";
                color: Theme.muted;
                font-size: Type.meta;
                font-weight: 500;
            }
        }
    }
    for g[i] in ["1/4", "1/8", "1/16", "1/32", "Triplet", "Dotted", "Off"]: VerticalLayout {
        alignment: center;
        ToggleChip {
            text: g;
            on: i < 4 ? CurveEditorData.grid-step == i
                : i == 4 ? CurveEditorData.grid-triplet && CurveEditorData.grid-step >= 0
                : i == 5 ? CurveEditorData.grid-dotted && CurveEditorData.grid-step >= 0
                : CurveEditorData.grid-step < 0;
            dim: (i == 4 || i == 5) && CurveEditorData.grid-step < 0;
            joined-left: root.named || i > 0;
            joined-right: i < 6;
            clicked => { CurveEditorData.grid-picked(i); }
        }
    }
}

// The editor card. `close` puts the curve away; the page gives the picked curve's own parts (its rename box, its drag
// strip, its buttons and message) as it has them, since they act on the curve as found in the list.
export component CurveEditor inherits SidePanel {
    // Renaming: the name plate shows a box instead of the name while this is on.
    in property <bool> renaming;
    in-out property <string> rename-text;
    // Whether the rename box has the keys: when it goes with them, the page gives them back to its list.
    in-out property <bool> rename-keys;
    callback rename-done(string);
    callback rename-dropped();
    // The drag strip: the curve's file carried out to a Bitwig automation lane.
    in property <bool> lifted;
    in property <bool> landed;
    callback drag-out();
    callback drag-let-go();
    // The picked curve's own buttons, and a line of what just happened.
    in property <[CardAction]> actions;
    in property <string> message;
    callback chosen(string);
    // Whether "In 2 songs" opens a list of those places, and a click on it: where the list opens (as the window has
    // it), under the words.
    in property <bool> found-opens;
    callback found-clicked(length, length);

    // The name plate: the curve's name, whether it's changed, Undo and Redo.
    HorizontalLayout {
        height: 32px;
        spacing: Space.sm;
        if !root.renaming: Text {
            text: CurveEditorData.name;
            color: Theme.text;
            font-family: Theme.title-font;
            font-size: Type.heading;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
        }
        if !root.renaming && (CurveEditorData.changed || CurveEditorData.state-words != ""): Text {
            text: CurveEditorData.changed ? "edited, not saved" : CurveEditorData.state-words;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        if root.renaming: SearchBox {
            horizontal-stretch: 1;
            search: false;
            hint: "A name for this curve";
            text <=> root.rename-text;
            // It takes the keys as it's made, and a change handler starts from what `init` leaves, so the one below
            // would never see them come: it's said here, and the handler sees them go (or come back).
            init => {
                self.focus();
                root.rename-keys = true;
            }
            // Not while another app's window is in front: the box gets them back with the window.
            changed has-keys => {
                if (self.has-keys || AppKeys.window-active) {
                    root.rename-keys = self.has-keys;
                }
            }
            key(k) => {
                if (k == Key.Return) {
                    root.rename-done(root.rename-text);
                    return true;
                }
                if (k == Key.Escape) {
                    root.rename-dropped();
                    return true;
                }
                false
            }
        }
        if !root.renaming: Rectangle {
            horizontal-stretch: 1;
        }
        StudioButton {
            horizontal-stretch: 0;
            width: 32px;
            icon: "M 5.5 3 L 2 6.5 L 5.5 10 M 2 6.5 L 10 6.5 A 4 4 0 0 1 10 14.5 L 7 14.5";
            tip: "Undo";
            key: CurveEditorData.undo-key;
            enabled: CurveEditorData.can-undo;
            clicked => { CurveEditorData.undo(); }
        }
        StudioButton {
            horizontal-stretch: 0;
            width: 32px;
            icon: "M 10.5 3 L 14 6.5 L 10.5 10 M 14 6.5 L 6 6.5 A 4 4 0 0 0 6 14.5 L 9 14.5";
            tip: "Redo";
            key: CurveEditorData.redo-key;
            enabled: CurveEditorData.can-redo;
            clicked => { CurveEditorData.redo(); }
        }
        // Room for the card's own × at its top right corner.
        Rectangle {
            width: Space.lg;
        }
    }
    // The picked curve's facts, as found (not as edited): its length and points, then where it was found.
    if CurveEditorData.facts != "" || CurveEditorData.found != "": HorizontalLayout {
        height: 28px;
        spacing: Space.xs;
        Text {
            text: CurveEditorData.facts;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        found := Text {
            text: CurveEditorData.found + (root.found-opens ? "  ▾" : "");
            color: Theme.text;
            font-size: Type.meta;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            found-touch := TouchArea {
                enabled: root.found-opens;
                mouse-cursor: root.found-opens ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.found-clicked(found.absolute-position.x, found.absolute-position.y + found.height);
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // How Hear plays it: the metronome and the speed, at the line's right end.
        metronome := ToggleChip {
            text: "Metronome";
            on: CurveEditorData.metronome;
            clicked => { CurveEditorData.metronome-toggled(); }
            Tip {
                text: "A click on each beat while the curve is heard";
                key: CurveEditorData.metronome-key;
                hovering: metronome.hovered;
                at-y: metronome.height + Space.xs;
            }
        }
        TempoStepper {
            slower-key: CurveEditorData.slower-key;
            faster-key: CurveEditorData.faster-key;
            bpm-text: CurveEditorData.speed-words;
            changed: CurveEditorData.speed-changed;
            stepped(by) => { CurveEditorData.speed-stepped(by); }
            reset => { CurveEditorData.speed-stepped(0); }
        }
    }
    VerticalLayout {
        vertical-stretch: 1;
        spacing: Space.sm;
        Ruler { }
        ClipStrip {
            menu(x, y) => {
                CurveEditorData.menu-opens();
                part-menu.open-at(x, y);
            }
        }
        // The picture: a sunken screen, all the height that's left.
        screen := Well {
            vertical-stretch: 1;
            min-height: 160px;
            clip: true;
            // What can be done to the highlighted part, each line with its key.
            part-menu := RightClickMenu {
                items: CurveEditorData.part-menu;
                chosen(id) => { CurveEditorData.menu-chosen(id); }
            }
            function laid-out() {
                CurveEditorData.laid-out(self.width, self.height);
            }
            init => {
                self.laid-out();
            }
            changed width => {
                self.laid-out();
            }
            changed height => {
                self.laid-out();
            }
            // The window moved to a screen with another scale: the same room in points is other pixels.
            property <float> scale: 1px / 1phx;
            changed scale => {
                self.laid-out();
            }
            // Drawn at the window's own pixels, so its lines stay sharp.
            Image {
                x: 0;
                y: 0;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: CurveEditorData.picture;
            }
            // The play line, only while Hear plays.
            if CurveEditorData.playing && CurveEditorData.playhead >= 0: Rectangle {
                x: CurveEditorData.playhead - 0.5px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.accent;
            }
            // The curve as it was when the drag began, faint behind the new one.
            if CurveEditorData.ghost != "": Path {
                x: 0;
                y: 0;
                width: CurveEditorData.picture-width;
                height: CurveEditorData.picture-height;
                viewbox-width: CurveEditorData.picture-width / 1px;
                viewbox-height: CurveEditorData.picture-height / 1px;
                commands: CurveEditorData.ghost;
                stroke: Theme.text.transparentize(72%);
                stroke-width: 1.5px;
                fill: transparent;
            }
            // The line under the mouse, lit.
            if CurveEditorData.hot-line != "": Path {
                x: 0;
                y: 0;
                width: CurveEditorData.picture-width;
                height: CurveEditorData.picture-height;
                viewbox-width: CurveEditorData.picture-width / 1px;
                viewbox-height: CurveEditorData.picture-height / 1px;
                commands: CurveEditorData.hot-line;
                stroke: Theme.accent;
                stroke-width: 3.5px;
                fill: transparent;
            }
            // The highlight: its frame from the part's floor to its top, its bar in the room above the picture's top
            // line, and its handles. With nothing highlighted, pills round the whole curve.
            if CurveEditorData.hl-shown: hl := Rectangle {
                property <length> l: CurveEditorData.hl-left;
                property <length> r: CurveEditorData.hl-right;
                property <length> t: CurveEditorData.hl-top;
                property <length> b: CurveEditorData.hl-bottom;
                property <int> hot: CurveEditorData.hl-hot;
                property <bool> whole: CurveEditorData.hl-whole;
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clip: true;
                if !hl.whole: Rectangle {
                    x: hl.l;
                    y: hl.t;
                    width: max(1px, hl.r - hl.l);
                    height: max(1px, hl.b - hl.t);
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(30%);
                }
                if !hl.whole: Rectangle {
                    x: hl.l;
                    y: 3px;
                    width: max(1px, hl.r - hl.l);
                    height: 12px;
                    border-radius: 3px;
                    background: Theme.accent.transparentize(hl.hot == 1 ? 0% : 50%);
                    // Two grip lines.
                    for i in 2: Rectangle {
                        x: (parent.width - 12px) / 2;
                        y: 4px + i * 3px;
                        width: 12px;
                        height: 1px;
                        background: Theme.accent-text;
                        visible: parent.width >= 20px;
                    }
                }
                FrameHandle {
                    mid-x: hl.l;
                    mid-y: (hl.t + hl.b) / 2;
                    hot: hl.hot == 2;
                    near: !hl.whole || CurveEditorData.hl-near;
                }
                FrameHandle {
                    mid-x: hl.r;
                    mid-y: (hl.t + hl.b) / 2;
                    hot: hl.hot == 3;
                    near: !hl.whole || CurveEditorData.hl-near;
                }
                FrameHandle {
                    across: true;
                    mid-x: (hl.l + hl.r) / 2;
                    mid-y: hl.t;
                    hot: hl.hot == 4;
                    near: !hl.whole || CurveEditorData.hl-near;
                }
                FrameHandle {
                    across: true;
                    mid-x: (hl.l + hl.r) / 2;
                    mid-y: hl.b;
                    hot: hl.hot == 5;
                    near: !hl.whole || CurveEditorData.hl-near;
                }
                if !hl.whole: FrameHandle {
                    corner: true;
                    mid-x: hl.l;
                    mid-y: hl.t;
                    hot: hl.hot == 6;
                }
                if !hl.whole: FrameHandle {
                    corner: true;
                    mid-x: hl.r;
                    mid-y: hl.t;
                    hot: hl.hot == 7;
                }
                if !hl.whole: FrameHandle {
                    corner: true;
                    mid-x: hl.l;
                    mid-y: hl.b;
                    hot: hl.hot == 8;
                }
                if !hl.whole: FrameHandle {
                    corner: true;
                    mid-x: hl.r;
                    mid-y: hl.b;
                    hot: hl.hot == 9;
                }
            }
            // The points: small and plain, a size up with an accent ring under the mouse, filled while held.
            for d in CurveEditorData.dots: Rectangle {
                property <length> across: d.hot || d.held ? 11px : 6px;
                x: d.x - self.width / 2;
                y: d.y - self.height / 2;
                width: self.across + (d.hot || d.held ? 0px : 3px);
                height: self.width;
                border-radius: self.width / 2;
                background: d.held ? Theme.accent : d.hot ? Theme.well : Theme.text;
                border-width: d.held ? 0px : d.hot ? 2px : 1.5px;
                border-color: d.hot ? Theme.accent : Theme.well;
            }
            touch := MouseField {
                // The mouse left: what showed under it is put away.
                changed inside => {
                    if !self.inside {
                        self.tell(4, false, false, false);
                    }
                }
                mouse-cursor: CurveEditorData.pointer == 1 ? MouseCursor.grab
                    : CurveEditorData.pointer == 2 ? MouseCursor.grabbing
                    : CurveEditorData.pointer == 3 ? MouseCursor.ns-resize
                    : CurveEditorData.pointer == 4 ? MouseCursor.ew-resize
                    : CurveEditorData.pointer == 5 ? MouseCursor.nwse-resize
                    : CurveEditorData.pointer == 6 ? MouseCursor.nesw-resize
                    : CurveEditorData.pointer == 7 ? MouseCursor.copy
                    : MouseCursor.default;
                function tell(kind: int, shift: bool, alt: bool, ctrl: bool) {
                    CurveEditorData.mouse(kind, self.mouse-x, self.mouse-y, shift, alt, ctrl);
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move {
                        self.tell(0, e.modifiers.shift, e.modifiers.alt, e.modifiers.control || e.modifiers.meta);
                    } else if e.kind == PointerEventKind.cancel {
                        // The press was taken away: what was dragged goes back where it was.
                        self.tell(5, false, false, false);
                    } else if e.button == PointerEventButton.left {
                        self.tell(e.kind == PointerEventKind.down ? 1 : 2, e.modifiers.shift, e.modifiers.alt,
                            e.modifiers.control || e.modifiers.meta);
                    } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        CurveEditorData.menu-opens();
                        part-menu.open-at(self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
                double-clicked => {
                    self.tell(3, CurveEditorData.shift, CurveEditorData.alt, CurveEditorData.ctrl);
                }
                scroll-event(e) => {
                    CurveEditorData.wheel(self.mouse-x, e.delta-y != 0 ? e.delta-y : e.delta-x, e.modifiers.shift);
                    EventResult.accept
                }
            }
            // What the drag is doing, by the mouse; flipped to stay inside the picture.
            if CurveEditorData.read-out != "": ReadOut {
                text: CurveEditorData.read-out;
                x: CurveEditorData.read-x + 14px + self.width > parent.width
                    ? CurveEditorData.read-x - 14px - self.width
                    : CurveEditorData.read-x + 14px;
                y: max(2px, CurveEditorData.read-y - 10px - self.height);
            }
        }
        HintLine { }
    }
    // Where to take the curve from to drag it onto an automation lane: its file in the app's Curves folder.
    DragHandle {
        text: "Drag onto a Bitwig automation lane";
        tip: "Drag the curve's file onto an automation lane in Bitwig, or save it to Bitwig's curves to find it in its browser";
        lifted: root.lifted;
        landed: root.landed;
        drag-out => { root.drag-out(); }
        drag-let-go => { root.drag-let-go(); }
    }
    // The card's buttons: Hear first, the grid, then the way out.
    HorizontalLayout {
        height: 32px;
        spacing: Space.md;
        StudioButton {
            horizontal-stretch: 0;
            text: CurveEditorData.playing ? "Stop" : "Hear";
            main: CurveEditorData.playing;
            tip: CurveEditorData.playing ? "Stop the tone" : "Hear the curve as the volume of a tone, round and round";
            key: CurveEditorData.hear-key;
            clicked => { CurveEditorData.hear(); }
        }
        GridStrip {
            named: root.inside >= 680px;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        StudioButton {
            horizontal-stretch: 0;
            text: "Save as new curve";
            main: !CurveEditorData.playing;
            tip: CurveEditorData.changed ? "Keep the curve as it is now, as a new curve of its own" : "Nothing has been changed yet";
            key: CurveEditorData.save-key;
            enabled: CurveEditorData.changed;
            clicked => { CurveEditorData.save-as-new(); }
        }
    }
    // The picked curve's own buttons, as on every card: they act on the curve as found, not on the edits.
    CardActions {
        room: root.inside;
        actions: root.actions;
        chosen(id) => { root.chosen(id); }
    }
    if root.message != "": Text {
        text: root.message;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
}
