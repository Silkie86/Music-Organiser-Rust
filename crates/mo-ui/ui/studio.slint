// ListView is only for a long menu's lines: it makes only the lines in sight, and its bar follows the theme.
import { ListView } from "std-widgets.slint";

// The app's one shared style (rule 16): colour tokens set from the theme in use, and the few building blocks every
// page uses. Pages never set a raw colour or their own button look; the style test in mo-ui checks that.

export global Theme {
    // Filled in from mo-app's themes when the app starts and whenever the look changes. The values here are Graphite,
    // so the live preview in VS Code shows the default look.
    in-out property <color> background: #121212;
    in-out property <color> sidebar: #171717;
    in-out property <color> surface: #1D1D1D;
    in-out property <color> surface-raised: #252525;
    in-out property <color> stroke: #323232;
    in-out property <color> hover: #2A2A2A;
    in-out property <color> text: #F0F0F0;
    in-out property <color> muted: #A3A3A3;
    in-out property <color> faint: #8E8E8E;
    in-out property <color> accent: #3DDC97;
    in-out property <color> accent-text: #06180F;
    in-out property <bool> light: false;
    in-out property <bool> square: false;
    in-out property <string> text-font: "IBM Plex Sans";
    in-out property <string> number-font: "IBM Plex Mono";
    // Page names and other big titles: the app's own title face (mo-app's `ThemeFont::title_family`).
    in-out property <string> title-font: "Space Grotesk";

    // Each place's own colour, in rail order (mo-app's `themes::place_colours`), like the coloured strips on a mixing
    // desk: the place's icon on the rail and the mark beside its page's name wear it, so you can tell where you are at
    // a glance. Nothing else does: what's picked, playing or working stays in the accent.
    in-out property <[color]> places: [#FF8F5E, #46C8E8, #C08CF0, #F0CF4F, #7F95FF, #8BD45A, #F07FB0, #A3A3A3];
    // The place on show (the window sets it), and its colour.
    in-out property <int> here;
    out property <color> here-colour: place(here);
    public pure function place(i: int) -> color {
        if (i < 0 || i >= places.length) {
            return muted;
        }
        return places[i];
    }

    // Derived: the dark edge under raised things and the well behind pressed-in fields. Light themes get softer ones.
    out property <color> edge: light ? stroke.darker(25%) : #0B0B0B;
    out property <color> well: light ? surface.darker(4%) : background.darker(20%);
    out property <color> shine: light ? #ffffff80 : #ffffff12;
    out property <length> radius: square ? 1px : 4px;

    // How things went, the same in every theme: missing or failed, a warning, all good.
    out property <color> missing: #F0616D;
    out property <color> warning: #F2B33D;
    out property <color> ok: #4ACB8B;
    // Words on something coloured `warning`, like a marker's flag.
    out property <color> on-warning: #1A1208;
    // Shadows under cards and dialogs, and the dimming behind a dialog.
    out property <color> shadow: #00000080;
    out property <color> scrim: #00000099;

    // The DAWs' own colours, the same in every theme.
    out property <color> fl-studio: #5EA8FF;
    out property <color> bitwig: #F2994A;
    out property <color> studio-one: #4ACB8B;

    // Sound types' colours, the same in every theme (the C# app's StarColours): Kick, 808, Snare, Clap, Hat, Cymbal,
    // Perc, Tom, Bass, Lead, Pad, Keys, Pluck, Chord, Vocal, FX, Loop, Guitar, Texture, then four spare ones for other
    // types. mo-app's `sounds::type_colour` gives a type's place in this list.
    out property <[color]> sound-types: [
        #FF6B5B, #FF8A4C, #FFB547, #FFD15C, #E8E36A, #C9E46A, #F59ABF, #F07C9E, #7C8CFF, #4FB3FF,
        #5CD6E0, #3DDC97, #7FE0B0, #62C9A8, #C792EA, #B39DDB, #9AB8D6, #E0A86A, #8FA3B8,
        #8FA3B8, #A8B88F, #B89A8F, #9F8FB8,
    ];

    // A sound type's colour from its place in `sound-types`; grey (-1) for a sound with no type yet.
    public pure function sound-type(i: int) -> color {
        if (i < 0 || i >= sound-types.length) {
            return #6E6E6E;
        }
        return sound-types[i];
    }

    // A DAW's colour from its name as the library writes it, or `muted` for one without a colour of its own.
    public pure function daw(name: string) -> color {
        if (name == "FL Studio") {
            return fl-studio;
        }
        if (name == "Bitwig" || name == "Bitwig Studio") {
            return bitwig;
        }
        if (name == "Studio One") {
            return studio-one;
        }
        return muted;
    }
}

// How long things take to move, the same everywhere, so the whole app moves at one pace. Motion only ever shows where
// something went (the rail's light slides to the place you picked, a view's lit button slides to the view): small
// shapes move, never a whole page, and nothing moves on its own unless a job is working, so it never costs a frame.
export global Motion {
    // Under the mouse: hover and press, so a control answers at once.
    out property <duration> tap: 90ms;
    // Something lit sliding to where you picked.
    out property <duration> move: 180ms;
    // Something arriving or settling: a mark growing in, a glow fading out.
    out property <duration> settle: 260ms;
}

// Text sizes (the agreed scale, nearer the C# app at 125%). Pages use these, never a size of their own.
export global Type {
    // A page's name, top left.
    out property <length> page-title: 28px;
    // The song's name in the song panel.
    out property <length> panel-title: 26px;
    // A dialog's or a card's title.
    out property <length> heading: 20px;
    // A name in a list, rail lines.
    out property <length> row-title: 16px;
    // Buttons, tabs, Health lines, panel text.
    out property <length> body: 15px;
    // Second lines under a name, chips, counts, dates. A step up from 13 px (Solomon, 10 Nov 2026: the small grey
    // words weren't comfortable on his wide screen at 100%); so are the three below.
    out property <length> meta: 14px;
    // Group headings in capitals.
    out property <length> caps: 13px;
    // Words laid on a drawn view where room is tight: bar numbers, markers, track details.
    out property <length> small: 13px;
    // The smallest: a clip's name on its title bar in a drawn view.
    out property <length> tiny: 12px;
}

// Gaps and padding, on a 4px grid. Pages use these, never a gap of their own.
export global Space {
    // Between a name and its second line; inside small chips.
    out property <length> xs: 4px;
    // Between chips, buttons and tabs in a row.
    out property <length> sm: 8px;
    // Inside rows and buttons; between rows of controls.
    out property <length> md: 12px;
    // Inside panels and the Health strip.
    out property <length> lg: 16px;
    // Between the big parts of a page; the page's own margin.
    out property <length> xl: 24px;
}

// What a button does and its key, from the app-wide shortcut list (rule 15), for its tooltip.
export struct ActionKey {
    what: string,
    key: string,
}

// The tooltip on show, if any: one for the whole window, drawn by `TipLayer` over everything. A `Tip` in a control
// fills it in. Drawn in the window itself, not as a popup, so it never takes the mouse: a click while it shows still
// reaches the control under it.
export global TipState {
    in-out property <string> text;
    in-out property <string> key;
    // Its top left in the window, and where its bottom goes instead when there's no room below.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> above-y;
    in-out property <bool> shown;

    // Puts the tooltip away: a key was pressed, which can change the page under a resting mouse.
    public function hide() {
        shown = false;
    }
}

// The app's own keys, for the pages and the controls on them (rule 15).
export global AppKeys {
    // Bumped by Ctrl+F (app.search): the page on show puts the keys in its search box. Only the page on show is there
    // to see it change.
    in-out property <int> search;
    // Bumped by Home (app.listTop): the list on show goes back to its top (list.slint's ListBox), and its key, for
    // the tooltip of the button that does the same.
    in-out property <int> list-top;
    in property <string> list-top-key;
    // Whether this window is the one in front, with the keys (set as the system says so, before Slint hears of it). A
    // text box loses the keys while another app's window is in front and gets them back after: a page doesn't count
    // that as the keys going to another part of the window.
    in-out property <bool> window-active: true;
    // A key a page's search box would only use to move its cursor (Up or Down with Ctrl, Alt or Meta, in one line of
    // text), passed on to the app's shortcuts, so Ctrl+Up and Ctrl+Down step through the list even while you type:
    // whether it ran. The text and Ctrl, Shift, Alt, Meta and repeat, as the window's own `key`.
    callback key(string, bool, bool, bool, bool, bool) -> bool;
}

// The one tooltip (rules 15 and 16): after the mouse rests on a control for a moment, says what it does and shows its
// key. Put it in a control with `hovering` from the control's TouchArea; `at-x`/`at-y` is where its top left goes, in
// the control's own space, and `above-y` where its bottom goes when there's no room below.
export component Tip {
    in property <string> text;
    in property <string> key;
    in property <bool> hovering;
    in property <length> at-x;
    in property <length> at-y;
    in property <length> above-y: -Space.xs;
    x: 0;
    y: 0;
    width: 0;
    height: 0;
    property <bool> wanted: hovering && (text != "" || key != "");
    property <bool> mine;
    // The words it put up: once its own words change, they're how it knows the tip on show is still its own.
    property <string> put-text;
    property <string> put-key;
    Timer {
        interval: 600ms;
        running: root.wanted && !root.mine;
        triggered => {
            root.mine = true;
            root.put-text = root.text;
            root.put-key = root.key;
            TipState.text = root.text;
            TipState.key = root.key;
            TipState.x = root.absolute-position.x + root.at-x;
            TipState.y = root.absolute-position.y + root.at-y;
            TipState.above-y = root.absolute-position.y + root.above-y;
            TipState.shown = true;
        }
    }
    changed wanted => {
        if (!root.wanted) {
            root.put-away();
        }
    }
    // A list line reused for another song while its tip shows: the old words would stay, so put them away.
    changed text => {
        root.put-away();
    }
    changed key => {
        root.put-away();
    }
    // Only puts away the tip if it's still this one (the mouse may already rest on the next control).
    function put-away() {
        if (root.mine) {
            root.mine = false;
            if (TipState.text == root.put-text && TipState.key == root.put-key) {
                TipState.shown = false;
            }
        }
    }
}

// Draws the tooltip on show. Goes last in the window, so it's over everything; kept inside the window's edges.
export component TipLayer {
    if TipState.shown: Rectangle {
        x: max(0px, min(TipState.x, root.width - self.width - Space.xs));
        y: TipState.y + self.height > root.height ? max(0px, TipState.above-y - self.height) : TipState.y;
        width: line.preferred-width;
        height: line.preferred-height;
        background: Theme.surface-raised;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.shadow;
        line := HorizontalLayout {
            padding-left: Space.sm;
            padding-right: Space.sm;
            padding-top: Space.xs;
            padding-bottom: Space.xs;
            spacing: Space.sm;
            if TipState.text != "": Text {
                text: TipState.text;
                color: Theme.text;
                font-size: Type.meta;
                vertical-alignment: center;
            }
            if TipState.key != "": Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.stroke;
                background: Theme.well;
                HorizontalLayout {
                    padding-left: Space.xs;
                    padding-right: Space.xs;
                    Text {
                        text: TipState.key;
                        color: Theme.muted;
                        font-family: Theme.number-font;
                        font-size: Type.meta;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A two-tone grooved line: a dark line with a faint light one under it, like a panel seam.
export component Groove inherits VerticalLayout {
    Rectangle {
        height: 1px;
        background: Theme.edge;
    }
    Rectangle {
        height: 1px;
        background: Theme.light ? #ffffff : #ffffff0d;
    }
}

// A small heading in capitals, for groups like "In your DAWs".
export component Caps inherits Text {
    font-size: Type.caps;
    font-weight: 500;
    color: Theme.muted;
    letter-spacing: 0.8px;
}

// A list's column heading that orders the list (the UX review of 10 Nov, B5): a click on it puts the list in that
// column's order, a second click turns the order round. The heading the list goes by is lit in the accent colour
// (the accent means "on") with a small arrow for which way. Every page's list headings are made of these, so the
// "Order" row of chips above a list isn't needed. A column the list can't go by sets `can-order` off: plain capitals.
export component ColumnHead inherits Rectangle {
    in property <string> text;
    // The list goes by this column.
    in property <bool> on;
    // Which way, when it's on: up for the smallest, the earliest or A first.
    in property <bool> up;
    in property <bool> can-order: true;
    // Numbers sit at the right of their column, and so does their heading.
    in property <bool> right;
    in property <string> tip;
    callback clicked;
    height: 28px;
    HorizontalLayout {
        alignment: root.right ? end : start;
        spacing: Space.xs;
        label := Caps {
            text: root.text;
            vertical-alignment: center;
            color: root.on ? Theme.accent : touch.has-hover && root.can-order ? Theme.text : Theme.muted;
        }
        if root.on: VerticalLayout {
            alignment: center;
            Path {
                width: 7px;
                height: 5px;
                fill: Theme.accent;
                commands: root.up ? "M 0 5 L 3.5 0 L 7 5 Z" : "M 0 0 L 7 0 L 3.5 5 Z";
            }
        }
    }
    touch := TouchArea {
        enabled: root.can-order;
        mouse-cursor: root.can-order ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

// The shaded, top-lit button. `main` is the page's main action, in the accent colour; `danger` says in red that it
// removes something for good (only ever the yes of a question that said what goes).
export component StudioButton inherits Rectangle {
    in property <string> text;
    in property <bool> main: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // The tooltip and the key from the shortcut list, if it has one.
    in property <string> tip;
    in property <string> key;
    // Opens a menu: a small arrow after the words.
    in property <bool> menu;
    // A drawn sign instead of words (one of the `Icons`), for a small square button; `tip` then says what it does.
    in property <string> icon;
    callback clicked;
    min-width: icon != "" ? 32px : label.preferred-width + (menu ? 38px : 24px);
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    background: !enabled ? Theme.surface : main
        ? (touch.pressed ? Theme.accent.darker(15%) : @linear-gradient(180deg, Theme.accent.brighter(12%) 0%, Theme.accent.darker(6%) 100%))
        : (touch.pressed ? Theme.well : @linear-gradient(180deg, (touch.has-hover ? Theme.hover : Theme.surface-raised).brighter(8%) 0%, Theme.surface-raised.darker(6%) 100%));
    animate background { duration: Motion.tap; }
    // The top-lit edge.
    Rectangle {
        y: 1px;
        height: 1px;
        x: parent.border-radius;
        width: parent.width - 2 * parent.border-radius;
        background: touch.pressed ? transparent : Theme.shine;
    }
    label := Text {
        x: (parent.width - self.width - (root.menu ? 14px : 0px)) / 2;
        // A button with an icon shows only the icon; its words go in `tip`.
        visible: root.icon == "";
        text: root.text;
        color: !root.enabled ? Theme.faint : root.main ? Theme.accent-text : root.danger ? Theme.missing : Theme.text;
        font-size: Type.body;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if root.icon != "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: label.color;
        stroke-width: 1.5px;
    }
    if root.menu: Path {
        x: label.x + label.width + 6px;
        y: (parent.height - 6px) / 2;
        width: 8px;
        height: 6px;
        viewbox-width: 8;
        viewbox-height: 6;
        commands: "M 1 1 L 4 4.5 L 7 1";
        stroke: label.color;
        stroke-width: 1.5px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        key: root.key;
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

// One line on the left-hand rail. Its icon wears the place's own colour (`tint`), dimmed until it's picked or under
// the mouse. The light on the picked line is drawn by the rail itself (`lit-bar` off), so it can slide from place to
// place; a line on its own (Settings) lights its own.
export component RailItem inherits Rectangle {
    in property <string> text;
    // The place's icon (a 16 by 16 path from Icons), beside its name.
    in property <string> icon;
    in property <bool> selected;
    // The place's colour (Theme.place).
    in property <color> tint: Theme.muted;
    // Whether this line draws its own light when picked.
    in property <bool> lit-bar: true;
    // The key that goes here, from the shortcut list.
    in property <string> key;
    callback clicked;
    height: 40px;
    border-radius: Theme.radius;
    background: selected ? Theme.surface-raised : touch.pressed ? Theme.well : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.tap; }
    // The light on the picked place, in its colour.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected && root.lit-bar ? parent.height - 2 * Space.sm : 0;
        border-radius: 1.5px;
        background: root.tint;
        animate height { duration: Motion.move; easing: ease-out; }
    }
    if root.icon != "": Path {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: root.selected || touch.has-hover ? root.tint : root.tint.transparentize(45%);
        stroke-width: 1.5px;
        animate stroke { duration: Motion.tap; }
    }
    name := Text {
        x: root.icon != "" ? 38px : 12px;
        text: root.text;
        color: root.selected ? Theme.text : touch.has-hover ? Theme.text.transparentize(15%) : Theme.muted;
        font-size: Type.row-title;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
        height: parent.height;
        animate color { duration: Motion.tap; }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: "Go to " + root.text;
        key: root.key;
        hovering: touch.has-hover && !touch.pressed;
        at-x: root.width + Space.xs;
        at-y: Space.xs;
    }
}

// A sunken panel, like a screen set into the hardware: for previews, lists and empty pages.
export component Well inherits Rectangle {
    background: Theme.well;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
}

// A small × button, for putting a card away or taking a line off a list.
export component CloseButton inherits Rectangle {
    // What it does, shown when the mouse rests on it; none for a card's own ×.
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 20px;
    height: 20px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    Text {
        text: "×";
        color: root.enabled ? Theme.muted : Theme.faint;
        font-size: Type.body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

// A rounded chip that does something when clicked, like "2 running" under the activity cards.
export component Chip inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? Theme.hover : Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.edge;
    animate background { duration: Motion.tap; }
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.meta;
        font-weight: 500;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A tick box with its words beside it. Clicking either ticks or unticks it.
export component TickBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    // Some of what it's for are ticked, but not all (a format whose copies you've ticked some of): a dash instead of
    // the tick. Clicking it ticks them all.
    in property <bool> partly;
    width: label.preferred-width + 26px;
    Rectangle {
        x: 0;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke;
        background: root.checked || root.partly ? Theme.accent : Theme.well;
        // The tick is drawn, as the app's fonts have no ✓.
        if root.checked: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 4 8.5 L 7 11.5 L 12.5 5";
            stroke: Theme.accent-text;
            stroke-width: 2px;
        }
        if root.partly && !root.checked: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 4.5 8 L 11.5 8";
            stroke: Theme.accent-text;
            stroke-width: 2px;
        }
    }
    label := Text {
        x: 24px;
        text: root.text;
        color: Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

// A slider from 0 to 1 between two words ("Safe" … "Adventurous"): drag or click the track, or use the arrow keys.
// `moved` follows the knob; `released` says where it was let go, for work that should only run then.
export component StudioSlider inherits HorizontalLayout {
    in property <string> low;
    in property <string> high;
    in property <string> tip;
    in-out property <float> value;
    callback moved(float);
    callback released(float);
    spacing: Space.sm;
    Text {
        text: root.low;
        color: Theme.muted;
        font-size: Type.meta;
        vertical-alignment: center;
    }
    track := Rectangle {
        width: 120px;
        height: 28px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 4px;
            border-radius: 2px;
            background: Theme.well;
            border-width: 1px;
            border-color: Theme.stroke;
        }
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: root.value * parent.width;
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }
        knob := Rectangle {
            x: root.value * (parent.width - self.width);
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: keys.has-focus ? Theme.accent : Theme.text;
        }
        touch := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    keys.focus();
                    root.value = clamp(self.mouse-x / self.width, 0, 1);
                    root.moved(root.value);
                } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.released(root.value);
                }
            }
            moved => {
                root.value = clamp(self.mouse-x / self.width, 0, 1);
                root.moved(root.value);
            }
        }
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.LeftArrow || e.text == Key.RightArrow {
                    root.value = clamp(root.value + (e.text == Key.LeftArrow ? -0.1 : 0.1), 0, 1);
                    root.moved(root.value);
                    root.released(root.value);
                    return accept;
                }
                reject
            }
        }
        Tip {
            text: root.tip;
            hovering: touch.has-hover && !touch.pressed;
            at-x: touch.mouse-x;
            at-y: touch.mouse-y + Space.xl;
            above-y: touch.mouse-y - Space.sm;
        }
    }
    Text {
        text: root.high;
        color: Theme.muted;
        font-size: Type.meta;
        vertical-alignment: center;
    }
}

// The search box: a pressed-in field with its hint shown until something is typed.
export component SearchBox inherits Rectangle {
    in property <string> hint: "Search";
    in-out property <string> text <=> input.text;
    // The page's own search, not a box for a name: Ctrl+Up and Ctrl+Down step through the page's list from it, and Esc
    // goes on to the app's keys (the page's next step back), as anywhere on the page.
    in property <bool> page-search;
    // Whether the keys are in it: a page gives them back to its list when a box for a name goes (on a card).
    out property <bool> has-keys: input.has-focus;
    callback edited(string);
    // Down and Enter go to the page first (and Esc, in a box that isn't the page's search); it returns true when it
    // used the key.
    callback key(string) -> bool;
    forward-focus: input;
    // One height for every control in a row (buttons, view switches, search): the row lines up.
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.well;
    animate border-color { duration: Motion.tap; }
    // The same magnifier as Ctrl+K's, lit while you type, so every search looks like one.
    Path {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Icons.search;
        stroke: input.has-focus ? Theme.accent : Theme.faint;
        stroke-width: 1.6px;
    }
    Text {
        x: 34px;
        text: root.hint;
        visible: input.text == "";
        color: Theme.faint;
        font-size: Type.body;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 34px;
        width: parent.width - 44px;
        height: parent.height;
        color: Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent.transparentize(60%);
        edited => { root.edited(self.text); }
        key-pressed(event) => {
            // Down, Enter and Esc on their own go to the page; held with Ctrl, Alt or Meta they're other keys. The
            // page's search leaves Esc alone: it goes on to the window, whose keys follow the shortcut list (rule 15)
            // and do a held key's step once.
            if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == Key.DownArrow || event.text == Key.Return
                    || (event.text == Key.Escape && !root.page-search))) {
                if (root.key(event.text)) {
                    return accept;
                }
            }
            // In the page's search, Up and Down with Ctrl, Alt or Meta go to the app's keys (the line above or below in
            // the list). A box for a name keeps them to move its cursor: stepping would pick another line and lose it.
            if (root.page-search && (event.modifiers.control || event.modifiers.alt || event.modifiers.meta)
                && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                if (AppKeys.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta, event.repeat)) {
                    return accept;
                }
            }
            reject
        }
    }

    // Ctrl+F: the keys come here with the words picked, so what you type replaces them.
    public function focus-all() {
        input.focus();
        input.select-all();
    }
}

// Ctrl+K in sight at the top of the rail: it looks like a search field (the magnifier, quiet words, the key in a
// keycap at the right), because that's what it opens, so it reads as "type here" instead of one more button.
export component JumpField inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <string> tip;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.stroke : Theme.edge;
    background: touch.pressed ? Theme.well.darker(10%) : Theme.well;
    animate border-color { duration: Motion.tap; }
    Path {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Icons.search;
        stroke: touch.has-hover ? Theme.muted : Theme.faint;
        stroke-width: 1.6px;
    }
    Text {
        x: 34px;
        width: parent.width - self.x - keycap.width - Space.md;
        height: parent.height;
        text: root.text;
        color: touch.has-hover ? Theme.muted : Theme.faint;
        font-size: Type.body;
        vertical-alignment: center;
        overflow: elide;
    }
    keycap := Rectangle {
        visible: root.key != "";
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: keytext.preferred-width + 10px;
        height: 20px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke;
        background: Theme.surface-raised;
        keytext := Text {
            text: root.key;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.tiny;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        key: root.key;
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

// A chip that's on or off, like "Favourites".
export component ToggleChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    // Joined to the chip before or after it in a filter's strip (FilterPicks): that side is square.
    in property <bool> joined-left;
    in property <bool> joined-right;
    // The mouse rests on it (for a tip beside it).
    out property <bool> hovered: touch.has-hover && !touch.pressed;
    // A choice that would show nothing ("Arranging 0"): its words are faint, so the useful choices stand out (the UX
    // review of 10 Nov, B8). It can still be clicked.
    in property <bool> dim;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-top-left-radius: joined-left ? 0 : 14px;
    border-bottom-left-radius: joined-left ? 0 : 14px;
    border-top-right-radius: joined-right ? 0 : 14px;
    border-bottom-right-radius: joined-right ? 0 : 14px;
    border-width: 2px;
    border-color: on ? Theme.accent : Theme.edge;
    background: on ? Theme.accent.transparentize(80%) : touch.has-hover ? Theme.hover : Theme.surface-raised;
    animate background, border-color { duration: Motion.tap; }
    label := Text {
        text: root.text;
        color: root.on ? Theme.text : root.dim ? Theme.faint : Theme.muted;
        font-size: Type.meta;
        font-weight: 500;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One line of a drop-down or right-click menu, with its key at the right (rule 15: every menu line shows its key). In
// a menu that picks (`tickable`), each line keeps room for a tick, and the one that's picked (`on`) is ticked, in bold,
// on a tint of the accent, so it's easy to see (Solomon's note, 4 Nov 2026).
export component MenuLine inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> tickable;
    in property <string> key;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius;
    background: root.on
        ? Theme.accent.transparentize(touch.has-hover ? 70% : 78%)
        : touch.has-hover && root.enabled ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: root.tickable ? Space.sm : Space.md;
        padding-right: Space.md;
        spacing: Space.xl;
        HorizontalLayout {
            spacing: Space.sm;
            horizontal-stretch: 1;
            if root.tickable: Rectangle {
                width: 14px;
                if root.on: Path {
                    width: 12px;
                    height: 10px;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M 1 5 L 4.5 8.5 L 11 1.5";
                    stroke: Theme.accent;
                    stroke-width: 1.75px;
                }
            }
            Text {
                text: root.text;
                color: !root.enabled ? Theme.faint : Theme.text;
                font-size: Type.body;
                font-weight: root.on ? 600 : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        if root.key != "": Text {
            text: root.key;
            color: Theme.faint;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The card a menu's lines sit on, inside a PopupWindow: raised, with a shadow.
export component MenuCard inherits Rectangle {
    background: Theme.surface-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 12px;
    VerticalLayout {
        padding: Space.xs;
        @children
    }
}

// The look of a chip that opens a menu: its name, with what's picked after it ("DAW: FL Studio"), lit while
// something is, and a small arrow. MenuChip and PicksChip share it, so the two always look the same.
component MenuChipFace inherits Rectangle {
    in property <string> name;
    // What's picked, as the chip says it after its name; "" for none.
    in property <string> value;
    // Joined to the chip before it in a filter's strip (FilterPicks): its left side is square.
    in property <bool> joined-left;
    // Lit in the accent while something is picked. Off for a choice that always has one picked (OneOfChip): lit all
    // the time, it would say nothing.
    in property <bool> lights: true;
    property <bool> lit: root.lights && root.value != "";
    // Says only what's picked, without the name before it, where the name is already written above it (FilterList).
    in property <bool> bare;
    callback clicked;
    width: label.preferred-width + 34px;
    height: 28px;
    border-top-left-radius: joined-left ? 0 : 14px;
    border-bottom-left-radius: joined-left ? 0 : 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-width: 2px;
    border-color: root.lit ? Theme.accent : Theme.edge;
    background: root.lit ? Theme.accent.transparentize(80%) : touch.has-hover ? Theme.hover : Theme.surface-raised;
    animate background, border-color { duration: Motion.tap; }
    label := Text {
        x: 12px;
        text: root.value == "" ? root.name : root.bare ? root.value : root.name + ": " + root.value;
        color: root.value != "" ? Theme.text : Theme.muted;
        font-size: Type.meta;
        font-weight: 500;
        vertical-alignment: center;
        height: parent.height;
    }
    Path {
        x: parent.width - 18px;
        y: (parent.height - 6px) / 2;
        width: 8px;
        height: 6px;
        viewbox-width: 8;
        viewbox-height: 6;
        commands: "M 1 1 L 4 4.5 L 7 1";
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The lines of a menu that picks one of a list: the first line (`none-text`, unless `has-none` is off) picks "", the
// one picked (`value`) is ticked, and a list longer than 16 lines scrolls (with the wheel over it, or its bar). Only the
// lines in sight are made, so a list of thousands (every plugin maker, say) opens at once instead of the window laying
// out every line first. MenuChip's menu, and PickButton's.
component PickLines inherits MenuCard {
    in property <[string]> choices;
    in property <string> value;
    in property <bool> has-none: true;
    in property <string> none-text: "Any";
    callback picked(string);
    if root.has-none: MenuLine {
        text: root.none-text;
        on: root.value == "";
        tickable: true;
        clicked => { root.picked(""); }
    }
    if root.choices.length > 0: ListView {
        height: min(root.choices.length, 16) * 32px;
        for c in root.choices: MenuLine {
            text: c;
            on: root.value == c;
            tickable: true;
            clicked => { root.picked(c); }
        }
    }
}

// A chip that picks one of a list, like "DAW: FL Studio". "Any" clears it. In its menu the one that's picked is
// ticked, and a list longer than 16 lines scrolls (with the wheel over it, or its bar).
export component MenuChip inherits MenuChipFace {
    in property <[string]> choices;
    // Whether the menu starts with "Any" (which picks ""); off for a chip that always has a value.
    in property <bool> has-any: true;
    // What that first line says, where "Any" isn't what picking nothing means.
    in property <string> any-text: "Any";
    callback picked(string);
    clicked => { menu.show(); }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 220px);
        // Scrolling (or dragging its bar) keeps it open; picking a line closes it.
        close-policy: close-on-click-outside;
        PickLines {
            choices: root.choices;
            value: root.value;
            has-none: root.has-any;
            none-text: root.any-text;
            picked(c) => {
                menu.close();
                root.picked(c);
            }
        }
    }
}

// One choice of a filter, as its chip or menu line shows it: its words, how many lines it would show ("" when it isn't
// counted), and whether it's picked.
export struct FilterChoice {
    text: string,
    count: string,
    on: bool,
}

// A filter as mo-app's `filters` shows it: its choices as chips of their own (a short list), or in a menu (a longer
// one), and what the menu's chip says is picked ("" for none).
export struct FilterView {
    chips: [FilterChoice],
    more: [FilterChoice],
    more-picked: string,
}

// A chip whose menu can pick more than one, like "Plugin: Serum + 2". Each picked line is ticked, with its count at
// the right; a click picks or unpicks a line and the menu stays open for the next. "Any" picks none and closes it. A
// list longer than 16 lines scrolls, and only the lines in sight are made, as in MenuChip's menu.
export component PicksChip inherits MenuChipFace {
    in property <[FilterChoice]> choices;
    // A line was picked or unpicked (its words), or Any was.
    callback toggled(string);
    callback cleared();
    clicked => { menu.show(); }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 240px);
        // Picking, scrolling or dragging its bar keeps it open; a click outside it closes it.
        close-policy: close-on-click-outside;
        MenuCard {
            MenuLine {
                text: "Any";
                on: root.value == "";
                tickable: true;
                clicked => {
                    menu.close();
                    root.cleared();
                }
            }
            if root.choices.length > 0: ListView {
                height: min(root.choices.length, 16) * 32px;
                for c in root.choices: MenuLine {
                    text: c.text;
                    key: c.count;
                    on: c.on;
                    tickable: true;
                    clicked => { root.toggled(c.text); }
                }
            }
        }
    }
}

// The name at the start of a filter's strip: a sunken cap, so the chips after it read as its choices.
component FilterName inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 22px;
    height: 28px;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
    border-width: 2px;
    border-color: Theme.edge;
    background: Theme.well;
    label := Text {
        x: 12px;
        text: root.text;
        color: Theme.muted;
        font-size: Type.meta;
        font-weight: 500;
        vertical-alignment: center;
        height: parent.height;
    }
}

// A filter, the same on every page (Solomon's notes, 4 Nov 2026): a short list's choices as chips of their own, each
// picked or unpicked by a click, joined into one strip behind the filter's name ("Type | Kick | Snare | More"), so
// it's plain they set the same thing; or a longer list's in a PicksChip's menu, the chip saying the name and what's
// picked. A long list can also keep its first choices as chips, with the rest in a menu at the strip's end
// (`more-name`: the sounds' types, the most used first). mo-app's `filters` decides which, what each says and whether
// more than one can be picked. Put filters in a row `Space.md` apart, so each one's strip stands apart.
export component FilterPicks inherits FlexboxLayout {
    in property <string> name;
    in property <FilterView> filter;
    // What the menu after the chips is called, when there are both.
    in property <string> more-name: "More";
    // A choice was picked or unpicked: its words, as its chip or menu line says them.
    callback toggled(string);
    // The menu's Any: it unpicks what's picked in the menu (all of the filter, unless some choices are chips too).
    callback cleared();
    property <bool> has-chips: root.filter.chips.length > 0;
    property <bool> has-more: root.filter.more.length > 0;
    // The strip's parts touch; only a strip too long for a line breaks onto a second one.
    spacing-horizontal: 0;
    spacing-vertical: Space.sm;
    // As wide as the whole filter on one line, so the row it's in moves it to a line of its own before breaking it; it
    // only wraps inside itself when it's wider than a line on its own (a narrow window, a long list of chips).
    preferred-width: root.has-chips ? line.preferred-width : head.preferred-width;
    // The name before the chips, or the menu's chip: always the first thing, so the name never ends a line.
    Rectangle {
        min-width: head.min-width;
        preferred-width: head.preferred-width;
        max-width: head.preferred-width;
        min-height: head.min-height;
        preferred-height: head.preferred-height;
        head := HorizontalLayout {
            if root.has-chips: FilterName {
                text: root.name;
            }
            if !root.has-chips && root.has-more: PicksChip {
                name: root.name;
                value: root.filter.more-picked;
                choices: root.filter.more;
                toggled(text) => { root.toggled(text); }
                cleared => { root.cleared(); }
            }
        }
        // Never drawn: the strip on one line, to measure it.
        line := HorizontalLayout {
            visible: false;
            FilterName {
                text: root.name;
            }
            for c in root.filter.chips: ToggleChip {
                text: c.count == "" ? c.text : c.text + "  " + c.count;
            }
            if root.has-more: MenuChipFace {
                name: root.more-name;
                value: root.filter.more-picked;
            }
        }
    }
    for c[i] in root.filter.chips: ToggleChip {
        text: c.count == "" ? c.text : c.text + "  " + c.count;
        on: c.on;
        dim: c.count == "0";
        // A chip that starts a new line (the strip broke in a narrow window) rounds its left side again.
        joined-left: self.x > 0;
        joined-right: root.has-more || i < root.filter.chips.length - 1;
        clicked => { root.toggled(c.text); }
    }
    if root.has-chips && root.has-more: PicksChip {
        name: root.more-name;
        value: root.filter.more-picked;
        choices: root.filter.more;
        joined-left: self.x > 0;
        toggled(text) => { root.toggled(text); }
        cleared => { root.cleared(); }
    }
}

// A tick box with its words: one choice of a filter in the filter column (FilterList), or an on/off choice there
// ("Favourites"). Picked, its box is filled with a tick; `count` is how many lines it would show, at the right; `dim`
// (nothing to show) greys it, and it can still be clicked.
export component TickLine inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> on;
    in property <bool> dim;
    callback clicked;
    height: 26px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.tap; }
    HorizontalLayout {
        padding-left: Space.xs;
        padding-right: Space.sm;
        spacing: Space.sm;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                border-width: 1.5px;
                border-color: root.on ? Theme.accent : Theme.muted.transparentize(root.dim ? 70% : 40%);
                background: root.on ? Theme.accent : transparent;
                if root.on: Path {
                    x: 2px;
                    y: 3px;
                    width: 10px;
                    height: 8px;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M 1 5 L 4.5 8.5 L 11 1.5";
                    stroke: Theme.accent-text;
                    stroke-width: 2px;
                }
            }
        }
        Text {
            text: root.text;
            color: root.on ? Theme.text : root.dim ? Theme.faint.transparentize(40%) : Theme.muted;
            font-size: Type.meta;
            font-weight: root.on ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.count != "": Text {
            text: root.count;
            color: Theme.faint.transparentize(root.dim ? 50% : 0%);
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A part that knows whether the mouse is over it (`hovered`), for what shows only then: a line's own small buttons
// (Settings, Shortcuts). It takes no clicks from what's inside it. A button inside is over it, so a line that holds
// one counts the mouse on that button with a HoverSense round the button too.
export component HoverSense inherits Rectangle {
    out property <bool> hovered: sense.has-hover;
    sense := TouchArea { }
    @children
}

// A slider with two handles, for a span of numbers (the Sounds page's Tempo, in the filter column): what's let
// through lies between them, both ends in. A handle at its end sets no limit there, so with both at their ends nothing
// is lit (the accent means "on"). `bars` stand over the track, one for each equal part of it: how much there is at
// each place, 0 to 1 of the tallest, and the ones between the handles are the bright ones. A press takes the nearer
// handle and a drag moves it a `step` at a time; `changed` says where both are, and the page gives them back as
// `low` and `high`.
export component RangeSlider inherits Rectangle {
    in property <int> low-end;
    in property <int> high-end: 100;
    in property <int> step: 1;
    in property <int> low;
    in property <int> high: 100;
    in property <[float]> bars;
    callback changed(int, int);
    out property <bool> on: root.low > root.low-end || root.high < root.high-end;
    property <length> knob: 14px;
    // How far a handle's middle can go.
    property <length> run: self.width - root.knob;
    property <length> track-y: 34px;
    pure function place(value: int) -> length {
        return root.knob / 2 + root.run * (value - root.low-end) / max(1, root.high-end - root.low-end);
    }
    pure function value-at(x: length) -> int {
        return clamp(root.low-end + Math.round((x - root.knob / 2) / root.run * (root.high-end - root.low-end) / root.step) * root.step, root.low-end, root.high-end);
    }
    height: 46px;
    for share[i] in root.bars: Rectangle {
        property <length> slot: root.run / root.bars.length;
        // The numbers this bar stands for, and whether any of them are between the handles.
        property <float> from: root.low-end + i * (root.high-end - root.low-end) / root.bars.length;
        property <float> to: root.low-end + (i + 1) * (root.high-end - root.low-end) / root.bars.length;
        property <bool> inside: (self.to > root.low && self.from < root.high) || (root.low == root.high && self.from <= root.low && self.to > root.low);
        x: root.knob / 2 + i * self.slot + 1px;
        y: root.track-y - 6px - self.height;
        width: self.slot - 2px;
        height: max(2px, share * 26px);
        border-radius: 1px;
        background: !self.inside ? Theme.faint.transparentize(70%) : root.on ? Theme.accent : Theme.faint;
    }
    Rectangle {
        x: root.knob / 2;
        y: root.track-y;
        width: root.run;
        height: 4px;
        border-radius: 2px;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.stroke;
    }
    Rectangle {
        x: root.place(root.low);
        y: root.track-y;
        width: root.place(root.high) - self.x;
        height: 4px;
        border-radius: 2px;
        background: root.on ? Theme.accent : Theme.faint.transparentize(40%);
    }
    for at in [root.low, root.high]: Rectangle {
        x: root.place(at) - root.knob / 2;
        y: root.track-y + 2px - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        border-width: 1px;
        border-color: Theme.edge;
        background: touch.has-hover || touch.pressed ? Theme.text : Theme.muted.brighter(20%);
        animate background { duration: Motion.tap; }
    }
    touch := TouchArea {
        // Which handle the press took: the higher one, or the lower.
        property <bool> high-held;
        function follow() {
            if self.high-held {
                root.changed(root.low, max(root.low, root.value-at(self.mouse-x)));
            } else {
                root.changed(min(root.high, root.value-at(self.mouse-x)), root.high);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                // The nearer handle; where they share a place, the one that can go the way the press is.
                self.high-held = root.low == root.high ? self.mouse-x > root.place(root.high) : abs(self.mouse-x - root.place(root.high)) < abs(self.mouse-x - root.place(root.low));
                self.follow();
            }
        }
        moved => {
            if self.pressed {
                self.follow();
            }
        }
    }
}

// A filter in the filter column (Solomon, 10 Nov 2026: the chips "are taking up alot of space and look messy"; he
// picked a column of tick lists at the page's side): its name in capitals, each choice a TickLine under it, every one
// in sight, and a longer list's rest in a menu under them (`more-name`). It shows the same FilterView as FilterPicks.
export component FilterList inherits VerticalLayout {
    in property <string> name;
    in property <FilterView> filter;
    in property <string> more-name: "More";
    callback toggled(string);
    callback cleared();
    alignment: start;
    spacing: 0;
    Caps {
        text: root.name;
        height: 22px;
    }
    for c in root.filter.chips: TickLine {
        text: c.text;
        count: c.count;
        on: c.on;
        dim: c.count == "0" && !c.on;
        clicked => { root.toggled(c.text); }
    }
    if root.filter.more.length > 0: HorizontalLayout {
        alignment: start;
        padding-top: root.filter.chips.length > 0 ? Space.xs : 0;
        PicksChip {
            name: root.filter.chips.length > 0 ? root.more-name : "Any";
            bare: root.filter.chips.length == 0;
            value: root.filter.more-picked;
            choices: root.filter.more;
            toggled(text) => { root.toggled(text); }
            cleared => { root.cleared(); }
        }
    }
}

// The filter column: a page's filters as FilterLists and TickLines, one under the other at the page's left side. It
// scrolls with the wheel when the window is too short for them all. The page places it by hand over the left of the
// room it shares with its list (`page-width` wide), and starts its list `room` in from the left. In a narrow window
// the column folds to a slim tab that says "Filters" (lit while any filter is picked, `active`), so the list keeps
// its room; a click opens the column over the list, and another puts it away.
export component FilterColumn inherits Rectangle {
    in property <length> page-width;
    // Off where a view has nothing to put in it: it takes no room.
    in property <bool> shown: true;
    // What the folded column's tab says, a letter a line, and the line that folds it again.
    in property <[string]> tab: ["F", "I", "L", "T", "E", "R", "S"];
    in property <string> tab-close: "CLOSE FILTERS";
    in property <bool> active;
    property <bool> narrow: root.page-width < 860px;
    property <bool> open;
    property <bool> folded: root.narrow && !root.open;
    // How far in the page's list starts.
    out property <length> room: !root.shown ? 0px : root.narrow ? 28px + Space.sm : 208px + Space.lg;
    x: 0;
    y: 0;
    visible: root.shown;
    width: root.folded ? 28px : 208px;
    background: root.narrow && root.open ? Theme.background : transparent;
    clip: true;
    flick := Flickable {
        visible: !root.folded;
        y: root.narrow ? 30px : 0px;
        height: parent.height - self.y;
        width: parent.width - Space.md;
        content-width: self.width;
        content-height: max(self.height, lists.preferred-height);
        mouse-drag-pan-enabled: false;
        lists := VerticalLayout {
            x: 0;
            y: 0;
            width: flick.width;
            alignment: start;
            spacing: Space.md;
            @children
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.edge;
    }
    // The tab: all of the folded column, or a line across the top of the opened one.
    if root.narrow: Rectangle {
        x: 0;
        y: 0;
        width: root.folded ? 27px : parent.width - 1px;
        height: root.folded ? parent.height : 26px;
        border-radius: Theme.radius;
        background: tab.has-hover ? Theme.hover : root.folded ? Theme.surface : transparent;
        // Folded, the word reads down the tab, a letter a line (a turned Text isn't drawn turned by every renderer).
        if root.folded: VerticalLayout {
            y: Space.md;
            height: self.preferred-height;
            for letter in root.tab: Caps {
                text: letter;
                horizontal-alignment: center;
                color: root.active ? Theme.accent : Theme.muted;
            }
        }
        if !root.folded: Caps {
            x: Space.xs;
            text: root.tab-close;
            vertical-alignment: center;
            color: Theme.muted;
        }
        tab := TouchArea {
            clicked => { root.open = !root.open; }
        }
    }
}

// A small drop-down for a choice where one is always picked (how the Galaxy places its stars): its name and what's
// picked, and a menu of the choices with the picked one ticked. It shows a `one_of` FilterView.
export component OneOfChip inherits MenuChipFace {
    in property <FilterView> filter;
    callback picked(string);
    value: root.filter.more-picked;
    lights: false;
    clicked => { menu.show(); }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 200px);
        MenuCard {
            for c in root.filter.chips: MenuLine {
                text: c.text;
                on: c.on;
                tickable: true;
                clicked => { root.picked(c.text); }
            }
        }
    }
}

// A line of a list that can be picked: the shared look for every list's rows (rule 16).
export component ListLine inherits Rectangle {
    in property <bool> selected;
    // A tooltip for the part of the line right of `tip-from` and below `tip-below` (a date, say, or a line's second
    // row), shown by the mouse.
    in property <string> tip;
    in property <length> tip-from;
    in property <length> tip-below;
    callback clicked;
    callback double-clicked;
    // A right click, after the line is picked, with the mouse's place in the window: the page opens its
    // `RightClickMenu` there.
    callback right-clicked(length, length);
    // Whether the mouse is over it (it's shaded then).
    out property <bool> hovered: touch.has-hover;
    // Where across the line the mouse was last pressed: a line with parts that mean something by where they're
    // clicked (a waveform that plays from that spot) reads it in `clicked`.
    out property <length> pressed-x: touch.pressed-x;
    // It can be dragged out of the app (a sound to a DAW): `drag-out` once the left button is down and the mouse has
    // moved a few points, then `drag-let-go` if the button comes up before the drag has got going (mo-ui's drag.rs).
    // `lifted` dims the line while it's carried, and `landed` glows round it for a moment once it has landed.
    in property <bool> draggable;
    in property <bool> lifted;
    in property <bool> landed;
    callback drag-out();
    callback drag-let-go();
    // The pointer over it: a hand that grabs on a `DragHandle`.
    in property <MouseCursor> cursor: MouseCursor.default;
    // This press has started a drag, so letting go isn't a click.
    property <bool> dragged;
    border-radius: Theme.radius;
    // No easing here: lists reuse their lines as they scroll, and an eased line would trail the scroll.
    background: selected ? Theme.surface-raised : touch.has-hover ? Theme.hover : transparent;
    opacity: root.lifted ? 0.4 : 1;
    // The accent bar on the picked line.
    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0;
        background: Theme.accent;
    }
    // Under the line's own parts, so a button or chip on the line takes its own click; a click anywhere else on
    // the line still picks it.
    touch := TouchArea {
        mouse-cursor: root.cursor;
        clicked => {
            if !root.dragged {
                root.clicked();
            }
        }
        double-clicked => {
            if !root.dragged {
                root.double-clicked();
            }
        }
        moved => {
            if root.draggable && !root.dragged && self.pressed
                && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragged = true;
                root.drag-out();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.dragged = false;
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragged {
                root.drag-let-go();
            } else if e.kind == PointerEventKind.cancel && root.dragged {
                // The press was taken away before the drag got going (by what scrolls the line, or the window losing
                // the mouse): the button's coming up won't be heard here, so the drag is off now.
                root.drag-let-go();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                // The menu acts on what's picked, so pick this line first.
                root.clicked();
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    @children
    // The glow round a line that has just landed in another app: in quickly, out slowly.
    Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
        opacity: 0;
        states [
            landed when root.landed: {
                opacity: 1;
                in {
                    animate opacity { duration: 90ms; }
                }
                out {
                    animate opacity { duration: 600ms; easing: ease-out; }
                }
            }
        ]
    }
    Tip {
        text: root.tip;
        hovering: touch.has-hover && !touch.pressed && touch.mouse-x >= root.tip-from && touch.mouse-y >= root.tip-below;
        at-x: touch.mouse-x;
        at-y: touch.mouse-y + Space.xl;
        above-y: touch.mouse-y - Space.sm;
    }
}

// A handle on a card to drag what it shows out of the app (a sound into a DAW or a folder), so it's plain where to
// take it from: a grip and its words in an outline, with a hand that grabs. It drags as a list line does (`drag-out`,
// then `drag-let-go`; `lifted` dims it while it's carried, `landed` glows round it once it has landed).
export component DragHandle inherits ListLine {
    in property <string> text;
    draggable: true;
    cursor: MouseCursor.grab;
    height: 32px;
    border-width: 1px;
    border-color: Theme.edge;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.sm;
        VerticalLayout {
            alignment: center;
            Path {
                width: 16px;
                height: 16px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: Icons.grip;
                stroke: Theme.muted;
                stroke-width: 1.5px;
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.text;
            color: Theme.muted;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A star rating out of five, drawn.
export component Stars inherits HorizontalLayout {
    in property <int> rating;
    // Each star's size.
    in property <length> size: 10px;
    spacing: 1px;
    for i in 5: Path {
        width: root.size;
        height: root.size;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 5 0.5 L 6.3 3.6 L 9.6 3.8 L 7.1 6 L 7.9 9.3 L 5 7.5 L 2.1 9.3 L 2.9 6 L 0.4 3.8 L 3.7 3.6 Z";
        fill: i < root.rating ? Theme.warning : transparent;
        stroke: i < root.rating ? Theme.warning : Theme.faint;
        stroke-width: 0.8px;
    }
}

// A small heart, for a favourite.
// Stars to click on a card: a click on a star gives that many, and a click on the last lit star takes them all away.
// Bigger than the list's Stars, with room around each to hit; the stars up to the one under the mouse show lit.
export component StarsPick inherits Rectangle {
    in property <int> rating;
    callback picked(int);
    // The star the mouse is over, counted from 1; 0 for none.
    property <int> over: touch.has-hover ? clamp(ceil(touch.mouse-x / 20px), 1, 5) : 0;
    width: 100px;
    height: 28px;
    for i in 5: Path {
        x: i * 20px + 3px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 5 0.5 L 6.3 3.6 L 9.6 3.8 L 7.1 6 L 7.9 9.3 L 5 7.5 L 2.1 9.3 L 2.9 6 L 0.4 3.8 L 3.7 3.6 Z";
        fill: i < root.rating ? Theme.warning : transparent;
        stroke: i < root.rating ? Theme.warning : i < root.over ? Theme.muted : Theme.faint;
        stroke-width: 0.8px;
    }
    touch := TouchArea {
        clicked => {
            root.picked(root.over == root.rating ? 0 : root.over);
        }
    }
    Tip {
        text: root.over == root.rating && root.rating > 0 ? "Take the stars away" : root.over == 1 ? "Give it 1 star" : "Give it " + root.over + " stars";
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

export component Heart inherits Path {
    in property <bool> on: true;
    width: 11px;
    height: 10px;
    viewbox-width: 11;
    viewbox-height: 10;
    commands: "M 5.5 9.3 L 1.2 5.1 C -0.4 3.4 0.6 0.5 3 0.5 C 4.2 0.5 5 1.2 5.5 2 C 6 1.2 6.8 0.5 8 0.5 C 10.4 0.5 11.4 3.4 9.8 5.1 Z";
    fill: on ? Theme.accent : transparent;
    stroke: on ? Theme.accent : Theme.faint;
    stroke-width: 0.8px;
}

// A heart to click on a card: a favourite or not. Filled while it is one; its tooltip says what a click does, with its
// key from the shortcut list (rule 15).
export component HeartToggle inherits Rectangle {
    in property <bool> on;
    in property <string> tip;
    in property <string> key;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.well : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.tap; }
    Heart {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 15px;
        on: root.on;
        stroke: root.on ? Theme.accent : touch.has-hover ? Theme.muted : Theme.faint;
        stroke-width: 1.2px;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        key: root.key;
        hovering: touch.has-hover && !touch.pressed;
        at-y: root.height + Space.xs;
    }
}

// A tag on a card: a chip lit while a filter has it (a click picks or unpicks it there), joined to a × that takes it
// away, as a filter's strip joins its chips.
export component TagChip inherits HorizontalLayout {
    in property <string> text;
    in property <bool> on;
    in property <string> remove-tip;
    callback clicked;
    callback removed;
    spacing: 0;
    ToggleChip {
        text: root.text;
        on: root.on;
        joined-right: true;
        clicked => { root.clicked(); }
    }
    Rectangle {
        width: remove.width;
        height: remove.height;
        remove := ToggleChip {
            text: "×";
            on: root.on;
            joined-left: true;
            clicked => { root.removed(); }
        }
        Tip {
            text: root.remove-tip;
            hovering: remove.hovered;
            at-y: parent.height + Space.xs;
        }
    }
}

// A small box to type a word or two into on a card, like a new tag: its hint shows while it's empty, Enter says it's
// done, and Esc clears what's typed (then goes on to the app's keys). Its key (Ctrl+T for a tag) shows in its tooltip,
// as keys never show on the page.
export component WordBox inherits Rectangle {
    in property <string> hint;
    // The tooltip and the key from the shortcut list, if it has one.
    in property <string> tip;
    in property <string> key;
    in-out property <string> text <=> input.text;
    // Whether the keys are in it: a page gives them back to its list when it goes (it's on a card that can close).
    out property <bool> has-keys: input.has-focus;
    callback accepted(string);
    forward-focus: input;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.well;
    animate border-color { duration: Motion.tap; }
    // Only to know the mouse is over it, for the tooltip: the box under it gets the clicks first. A click at its rim
    // (around the words) puts the keys in the box too.
    hover := TouchArea {
        clicked => { input.focus(); }
        Text {
            x: Space.md;
            width: parent.width - 2 * Space.md;
            height: parent.height;
            text: root.hint;
            visible: input.text == "";
            color: Theme.faint;
            font-size: Type.meta;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: Space.md;
            width: parent.width - 2 * Space.md;
            height: parent.height;
            color: Theme.text;
            font-size: Type.meta;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.accent.transparentize(60%);
            accepted => { root.accepted(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape && self.text != "") {
                    self.text = "";
                    return accept;
                }
                reject
            }
        }
    }
    // Not while you type in it: it would cover what's under the box.
    Tip {
        text: root.tip;
        key: root.key;
        hovering: hover.has-hover && !input.has-focus;
        at-y: root.height + Space.xs;
    }

    // A key asked for it (Ctrl+T for a tag): the keys come here, with anything typed picked.
    public function focus-all() {
        input.focus();
        input.select-all();
    }
}

// A row of tabs over a panel: the picked one is underlined in the accent colour. Where there isn't room for them all
// on one line (a narrow panel), they wrap onto the next, so every tab stays in sight.
export component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current;
    // False keeps them on one line, beside something that should shorten first (a note that can be cut short).
    in property <bool> wrap: true;
    // Where the picked tab is, which each tab reports, so its underline slides from tab to tab, and line to line.
    property <length> lit-x;
    property <length> lit-y;
    property <length> lit-width;
    // Each tab's height, which the underline sits at the foot of.
    property <length> tab-height: 36px;
    // Off until the first frame is drawn, so a page opening on its third view doesn't slide there from the left.
    property <bool> ready;
    Timer {
        interval: 1ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
    // As wide as its row lets it be (never narrower than its widest tab), and as tall as its lines, never taller.
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    max-height: row.preferred-height;
    vertical-stretch: 0;
    row := FlexboxLayout {
        // Set here, as Slint reads a flexbox's `flex-wrap` only where the flexbox is made, not where it's used.
        flex-wrap: root.wrap ? FlexboxLayoutWrap.wrap : FlexboxLayoutWrap.no-wrap;
        spacing: Space.xs;
        for name[i] in root.tabs: Rectangle {
            property <bool> is-current: i == root.current;
            width: label.preferred-width + 20px;
            height: root.tab-height;
            border-radius: Theme.radius;
            background: touch.has-hover && !self.is-current ? Theme.hover : transparent;
            animate background { duration: Motion.tap; }
            init => { self.report(); }
            changed is-current => { self.report(); }
            changed x => { self.report(); }
            changed y => { self.report(); }
            changed width => { self.report(); }
            function report() {
                if (self.is-current) {
                    root.lit-x = self.x;
                    root.lit-y = self.y;
                    root.lit-width = self.width;
                }
            }
            label := Text {
                text: name;
                color: parent.is-current ? Theme.text : Theme.muted;
                font-size: Type.body;
                font-weight: 500;
            }
            touch := TouchArea {
                clicked => { root.current = i; }
            }
        }
    }
    Rectangle {
        y: root.lit-y + root.tab-height - 2px;
        height: 2px;
        x: root.lit-x + 8px;
        width: max(0px, root.lit-width - 16px);
        visible: root.current >= 0 && root.current < root.tabs.length;
        border-radius: 1px;
        background: Theme.accent;
        animate x, y, width { duration: root.ready ? Motion.move : 0ms; easing: ease-out; }
    }
}

// Words that do something when clicked, like "9 plugins" opening the Plugins tab: underlined under the mouse.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    in property <length> font-size: Type.body;
    callback clicked;
    width: label.preferred-width;
    height: label.preferred-height;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: root.font-size;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: touch.has-hover ? root.tint : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A longer explanation, folded to a line that opens it (the UX review of 10 Nov, C7: a card or a Settings tab opened
// with a paragraph or two before its first button). What must be known before a button is pressed stays in sight
// beside the button; this is for how the thing works.
export component HowItWorks inherits VerticalLayout {
    in property <string> text;
    in-out property <bool> open;
    spacing: Space.xs;
    HorizontalLayout {
        alignment: start;
        LinkText {
            text: root.open ? "Hide how this works" : "How this works";
            tint: Theme.muted;
            font-size: Type.meta;
            clicked => { root.open = !root.open; }
        }
    }
    if root.open: Text {
        text: root.text;
        color: Theme.muted;
        font-size: Type.meta;
        wrap: word-wrap;
        min-width: 0px;
    }
}

// The mouse on a drawn view (arrangement, piano roll, galaxy): where it moves, a left press and its letting go, a
// double-click, the wheel in notches (positive away from you) and leaving. Fills its parent.
export component PointerPad inherits TouchArea {
    in property <bool> grabbing;
    callback down(length, length);
    callback move(length, length);
    callback up();
    // The right or middle button went down, and came up again (a press of the other buttons).
    callback side-down(length, length);
    callback side-up();
    // The press was taken away (the window lost the mouse): `up` follows, but it wasn't let go on purpose.
    callback cancelled();
    callback double();
    callback wheel(length, float, float, bool, bool);
    callback gone();
    mouse-cursor: grabbing ? MouseCursor.grabbing : MouseCursor.default;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.down(self.mouse-x, self.mouse-y);
        } else if e.kind == PointerEventKind.down && (e.button == PointerEventButton.right || e.button == PointerEventButton.middle) {
            root.side-down(self.mouse-x, self.mouse-y);
        } else if e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.middle) {
            root.side-up();
        } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) || e.kind == PointerEventKind.cancel {
            if e.kind == PointerEventKind.cancel {
                root.cancelled();
            }
            root.up();
        } else if e.kind == PointerEventKind.move {
            root.move(self.mouse-x, self.mouse-y);
        }
    }
    double-clicked => { root.double(); }
    scroll-event(e) => {
        // A wheel notch comes as 60px.
        root.wheel(self.mouse-x, e.delta-x / 60px, e.delta-y / 60px, e.modifiers.control, e.modifiers.shift);
        accept
    }
    changed has-hover => {
        if !self.has-hover {
            root.gone();
        }
    }
}

// What's under the mouse on a drawn view, shown at once beside it (a tooltip waits; this follows the mouse). Put it in
// the view with the mouse's place; it keeps inside the view.
export component HoverNote inherits Rectangle {
    in property <string> text;
    in property <length> at-x;
    in property <length> at-y;
    in property <length> room-width;
    in property <length> room-height;
    x: max(0px, min(at-x + 14px, room-width - self.width - Space.xs));
    y: at-y + 18px + self.height > room-height ? max(0px, at-y - self.height - Space.sm) : at-y + 18px;
    width: min(line.preferred-width + 2 * Space.sm, room-width - 2 * Space.xs);
    height: line.preferred-height + 2 * Space.xs;
    background: Theme.surface-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow;
    line := Text {
        x: Space.sm;
        width: parent.width - 2 * Space.sm;
        text: root.text;
        color: Theme.text;
        font-size: Type.meta;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The drawn signs for small square buttons (`StudioButton { icon: Icons.more; }`), on a 16 by 16 grid.
export global Icons {
    // Six dots in two rows of three: a handle to take hold of and drag.
    out property <string> grip: "M 5.25 4 A 0.75 0.75 0 1 0 6.75 4 A 0.75 0.75 0 1 0 5.25 4 M 9.25 4 A 0.75 0.75 0 1 0 10.75 4 A 0.75 0.75 0 1 0 9.25 4 M 5.25 8 A 0.75 0.75 0 1 0 6.75 8 A 0.75 0.75 0 1 0 5.25 8 M 9.25 8 A 0.75 0.75 0 1 0 10.75 8 A 0.75 0.75 0 1 0 9.25 8 M 5.25 12 A 0.75 0.75 0 1 0 6.75 12 A 0.75 0.75 0 1 0 5.25 12 M 9.25 12 A 0.75 0.75 0 1 0 10.75 12 A 0.75 0.75 0 1 0 9.25 12";
    // Three dots: more things to do with what's picked.
    out property <string> more: "M 2.5 8 A 0.75 0.75 0 1 0 4 8 A 0.75 0.75 0 1 0 2.5 8 M 7.25 8 A 0.75 0.75 0 1 0 8.75 8 A 0.75 0.75 0 1 0 7.25 8 M 12 8 A 0.75 0.75 0 1 0 13.5 8 A 0.75 0.75 0 1 0 12 8";
    // A magnifier: search (the page's search box and Ctrl+K).
    out property <string> search: "M 11.5 6.5 A 5 5 0 1 1 1.5 6.5 A 5 5 0 1 1 11.5 6.5 M 10.2 10.2 L 14.5 14.5";
    // An arrow up to a line: back to the top of a list.
    out property <string> top: "M 3 2.5 L 13 2.5 M 8 14 L 8 5.5 M 4.5 9 L 8 5.5 L 11.5 9";
    // Two sliders: the page's own options.
    out property <string> options: "M 2 5 L 14 5 M 2 11 L 14 11 M 5.5 3 L 5.5 7 M 10.5 9 L 10.5 13";
    // The rail's places, one each.
    // Songs: two joined notes.
    out property <string> songs: "M 6 12 L 6 3 L 13 2 L 13 11 M 6 12 A 2 2 0 1 1 2 12 A 2 2 0 1 1 6 12 M 13 11 A 2 2 0 1 1 9 11 A 2 2 0 1 1 13 11";
    // Sounds: a waveform.
    out property <string> sounds: "M 1 8 L 3 8 L 4.5 4 L 6.5 12 L 8.5 2 L 10.5 14 L 12 6 L 13 8 L 15 8";
    // Presets: a knob.
    out property <string> presets: "M 13.5 8 A 5.5 5.5 0 1 1 2.5 8 A 5.5 5.5 0 1 1 13.5 8 M 8 8 L 11 5";
    // MIDI: piano keys.
    out property <string> midi: "M 2 3 L 14 3 L 14 13 L 2 13 Z M 5 3 L 5 9 M 8 3 L 8 13 M 11 3 L 11 9";
    // Plugins: a plug.
    out property <string> plugins: "M 6 1.5 L 6 5 M 10 1.5 L 10 5 M 4 5 L 12 5 L 12 8 A 4 4 0 0 1 4 8 Z M 8 12 L 8 15";
    // Space: a pie with a slice taken out.
    out property <string> space: "M 7 3 A 6 6 0 1 0 13 9 L 7 9 Z M 9 1 L 9 7 L 15 7 A 6 6 0 0 0 9 1 Z";
    // Backup: a drive with an arrow going up into it.
    out property <string> backup: "M 2 10 L 14 10 L 14 14.5 L 2 14.5 Z M 8 8 L 8 1.5 M 5 4.5 L 8 1.5 L 11 4.5";
    // Settings: a cog.
    out property <string> settings: "M 10.5 8 A 2.5 2.5 0 1 1 5.5 8 A 2.5 2.5 0 1 1 10.5 8 M 8 1 L 8 3.5 M 8 12.5 L 8 15 M 1 8 L 3.5 8 M 12.5 8 L 15 8 M 3 3 L 4.8 4.8 M 11.2 11.2 L 13 13 M 13 3 L 11.2 4.8 M 4.8 11.2 L 3 13";
    // A place's icon from its place in rail order (mo-app's `Place::ALL`), "" for none.
    public pure function place(i: int) -> string {
        if (i == 0) { return songs; }
        if (i == 1) { return sounds; }
        if (i == 2) { return presets; }
        if (i == 3) { return midi; }
        if (i == 4) { return plugins; }
        if (i == 5) { return space; }
        if (i == 6) { return backup; }
        if (i == 7) { return settings; }
        return "";
    }
}

// A name over a map, like a neighbourhood of the galaxy ("KICK"): it lights up under the mouse, as a click on it flies
// into that part of the map.
export component MapName inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    callback clicked;
    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.surface-raised : Theme.scrim;
    row := HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        padding-top: Space.xs / 2;
        padding-bottom: Space.xs / 2;
        Text {
            text: root.text;
            color: root.tint;
            font-size: Type.meta;
            font-weight: 700;
            letter-spacing: 1.5px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The whole of a map in miniature with a box round the part on show, like the galaxy's mini-map: a click or a drag
// on it goes there. The box is in parts of the picture (0 to 1).
export component MapInset inherits Rectangle {
    in property <image> picture;
    in property <string> title;
    in property <float> box-x;
    in property <float> box-y;
    in property <float> box-width;
    in property <float> box-height;
    // Where on the picture it was pressed or dragged to (0 to 1 each way).
    callback go(float, float);
    width: column.preferred-width;
    height: column.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    clip: true;
    column := VerticalLayout {
        padding: Space.sm;
        spacing: Space.xs;
        Text {
            text: root.title;
            color: Theme.muted;
            font-size: Type.meta;
        }
        area := Rectangle {
            width: 132px;
            height: 132px;
            border-radius: Theme.radius;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.picture;
                image-fit: fill;
            }
            Rectangle {
                x: root.box-x * parent.width;
                y: root.box-y * parent.height;
                width: max(root.box-width * parent.width, 3px);
                height: max(root.box-height * parent.height, 3px);
                border-width: 1px;
                border-color: Theme.accent;
                background: Theme.accent.transparentize(88%);
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.go(self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                }
                moved => {
                    if self.pressed {
                        root.go(self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                }
                // The wheel stays with the map under the card.
                scroll-event(e) => { reject }
            }
        }
    }
}

// A year on a year strip: its name and how much of the list is in it (0 to 1 of the biggest year).
export struct YearBar {
    year: string,
    share: float,
}

// A strip of years beside a list, newest at the top, each with a bar for how much of the list is in it. Press on a
// year and drag over others to show only those years; a click picks just one; a double-click or All years shows
// every year again. The page says which are picked. In a short window the years' lines get shorter, so every year
// and All years still fit: the bars go when they'd run into the names, and when the lines are too short for every
// year's name, only every second (or third...) one is named, plus the one under the mouse and the first and last
// picked.
export component YearRange inherits VerticalLayout {
    in property <[YearBar]> years;
    // The places in `years` of the first and the last year picked, top first (-1 when none are).
    in property <int> picked-from: -1;
    in property <int> picked-to: -1;
    // Places in `years` from the first to the last picked (either way round).
    callback picked(int, int);
    callback cleared();
    // A year's line when there's room for every year at it.
    property <length> full-line: 20px;
    // Each year's line: the full line, or what the room leaves each year when that's less.
    property <length> line: min(root.full-line, strip.height / max(1, root.years.length));
    // A year's bar runs under its name: shorter than this, the two would touch, so the bars are left out.
    property <length> bar-room: 14px;
    // A year's name needs this much room for its figures not to touch the next year's.
    property <length> name-room: 10px;
    // Every how many years one is named.
    property <int> named-every: root.line >= root.name-room ? 1 : ceil(root.name-room / max(1px, root.line));
    // The year under the mouse, as its place in `years` (-1 when the mouse isn't on the strip).
    property <int> hovered: touch.has-hover ? clamp(floor(touch.mouse-y / root.line), 0, root.years.length - 1) : -1;
    // The drag going on, as places in `years` (-1 when there's none).
    property <int> from: -1;
    property <int> to: -1;
    // The years lit, top first: the ones being dragged over, or else the ones picked (-1 when none are).
    property <int> lit-top: root.from >= 0 ? min(root.from, root.to) : root.picked-from;
    property <int> lit-bottom: root.from >= 0 ? max(root.from, root.to) : root.picked-to;
    // The first and the last year lit are always named, so where they start and end can be read when not every year
    // is: unless a name that comes first is too close (the one under the mouse, then the first).
    property <bool> top-named: root.lit-top >= 0 && !root.crowds(root.lit-top, root.hovered);
    property <bool> bottom-named: root.lit-bottom > root.lit-top && !root.crowds(root.lit-bottom, root.hovered)
        && !(root.top-named && root.crowds(root.lit-bottom, root.lit-top));
    width: 56px;
    padding: Space.xs;
    spacing: Space.xs;
    alignment: start;
    // Whether a name at place `a` would come too close to the one at place `b` (when there is one, -1 when not).
    pure function crowds(a: int, b: int) -> bool {
        return b >= 0 && a != b && abs(a - b) * root.line < root.name-room;
    }
    strip := Rectangle {
        // Every year at its full line, but it gives way when the room is short, so All years is never pushed off the
        // bottom.
        preferred-height: root.years.length * root.full-line;
        min-height: 0px;
        for y[i] in root.years: Rectangle {
            property <bool> lit: root.lit-top >= 0 && i >= root.lit-top && i <= root.lit-bottom;
            property <bool> under: root.hovered == i;
            // Named when it's under the mouse or the first or last lit; else when there's room for it (every year,
            // or every second or third...) and none of those is too close.
            property <bool> named: self.under
                || (i == root.lit-top && root.top-named)
                || (i == root.lit-bottom && root.bottom-named)
                || (mod(i, root.named-every) == 0
                    && !root.crowds(i, root.hovered)
                    && !(root.top-named && root.crowds(i, root.lit-top))
                    && !(root.bottom-named && root.crowds(i, root.lit-bottom)));
            y: i * root.line;
            height: root.line;
            // Less round on a shorter line, and square once the bars are left out: round corners there would leave
            // little notches down a picked span's edges.
            border-radius: root.line >= root.bar-room ? min(Theme.radius, root.line / 5) : 0px;
            background: self.lit ? Theme.accent.transparentize(80%) : self.under ? Theme.hover : transparent;
            Rectangle {
                visible: root.line >= root.bar-room;
                x: Space.xs;
                y: parent.height - 3px;
                width: (parent.width - 2 * Space.xs) * y.share;
                height: 2px;
                border-radius: 1px;
                background: parent.lit ? Theme.accent : Theme.stroke;
            }
            Text {
                // Never shorter than its figures, centred on the line, so a short line doesn't cut them off.
                width: parent.width;
                height: max(parent.height, self.preferred-height);
                y: (parent.height - self.height) / 2;
                text: parent.named ? y.year : "";
                color: parent.lit || parent.under ? Theme.text : Theme.faint;
                font-family: Theme.number-font;
                font-size: Type.caps;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.from = clamp(floor(self.mouse-y / root.line), 0, root.years.length - 1);
                    root.to = root.from;
                }
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.from >= 0 {
                    root.picked(min(root.from, root.to), max(root.from, root.to));
                    root.from = -1;
                    root.to = -1;
                }
                // The window lost the mouse mid-drag: nothing is picked.
                if e.kind == PointerEventKind.cancel {
                    root.from = -1;
                    root.to = -1;
                }
            }
            moved => {
                if self.pressed && root.from >= 0 {
                    root.to = clamp(floor(self.mouse-y / root.line), 0, root.years.length - 1);
                }
            }
            // A release runs this before the button-up above, so the drag is forgotten first: otherwise the up
            // would pick the one year straight after the strip was cleared.
            double-clicked => {
                root.from = -1;
                root.to = -1;
                root.cleared();
            }
        }
    }
    LinkText {
        text: "All years";
        tint: Theme.muted;
        font-size: Type.meta;
        clicked => { root.cleared(); }
    }
}

// A coloured dot, like a sound's type or a DAW's colour beside a name.
export component Dot inherits Rectangle {
    in property <color> tint: Theme.muted;
    width: 8px;
    height: 8px;
    border-radius: self.width / 2;
    background: tint;
}

// One line under the rail's "In your DAWs": the DAW, what it has open (or that it isn't linked), whether its link
// answers, and the tooltip (mo_app::rail_daws::RailDaw).
export struct DawLine {
    daw: string,
    text: string,
    linked: bool,
    tip: string,
}

// A DAW's line on the rail: a light (lit while its link answers), its name, and what it has open under it. A click
// shows the song open there on Songs when it's one of yours, or Settings on the DAWs tab.
export component RailDawLine inherits Rectangle {
    in property <DawLine> line;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        spacing: Space.sm;
        VerticalLayout {
            alignment: center;
            Dot {
                tint: root.line.linked ? Theme.ok : Theme.faint;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.line.daw;
                color: Theme.muted;
                font-size: Type.meta;
            }
            Text {
                text: root.line.text;
                color: root.line.linked ? Theme.text : Theme.faint;
                font-size: Type.meta;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.line.tip;
        hovering: touch.has-hover && !touch.pressed;
        at-x: root.width + Space.xs;
        at-y: Space.xs;
    }
}

// How full or how far, as a level meter: lit segments like the LEDs on a mixer's channel, the same everywhere a
// share is shown. Segments 4px wide (one gap of 2px between), as many as fit.
export component Meter inherits Rectangle {
    // From 0 to 1.
    in property <float> level;
    // The lit colour; `warn-from` turns the segments past it amber, like a meter going into the red.
    in property <color> tint: Theme.accent;
    in property <float> warn-from: 2;
    property <int> segments: max(1, floor((self.width + 2px) / 6px));
    // A start shows at least one lit segment, and only a finished job lights the last one.
    property <int> lit: root.level <= 0 ? 0 : root.level >= 1 ? root.segments
        : clamp(ceil(root.level * root.segments), 1, root.segments - 1);
    for i in root.segments: Rectangle {
        x: i * 6px;
        width: 4px;
        height: root.height;
        border-radius: 1px;
        background: i >= root.lit ? Theme.stroke
            : (i + 1) / root.segments > root.warn-from ? Theme.warning : root.tint;
    }
}

// A job in the left rail: a slim line with its name, how far it is in words, and its meter while it runs (the UX
// review of 10 Nov, A3). Jobs used to be cards at the bottom right, on top of the side card; the rail has the room.
// A finished job stays a few seconds with a green dot; one that failed is a card (`ActivityCards`), as it needs
// reading. The whole name and words show in its tip.
export component RailJobLine inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    // 0 to 1, or below 0 while the job can't say how far it is.
    in property <float> progress;
    in property <bool> running;
    height: 48px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    VerticalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            spacing: Space.sm;
            VerticalLayout {
                alignment: center;
                Dot { tint: root.running ? Theme.accent : Theme.ok; }
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.meta;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Text {
            text: root.detail != "" ? root.detail : root.running ? "Working…" : "Done";
            color: Theme.muted;
            font-size: Type.small;
            overflow: elide;
        }
        // A known amount lights the meter; an unknown one sweeps back and forth.
        if root.running && root.progress >= 0: Meter {
            height: 4px;
            level: root.progress;
        }
        if root.running && root.progress < 0: Rectangle {
            height: 4px;
            border-radius: 1px;
            background: Theme.well;
            clip: true;
            Rectangle {
                x: (parent.width - self.width) * (0.5 + 0.5 * sin(animation-tick() / 900ms * 180deg));
                width: parent.width * 0.3;
                border-radius: 1px;
                background: Theme.accent;
            }
        }
    }
    touch := TouchArea { }
    Tip {
        text: root.detail != "" ? root.title + ": " + root.detail : root.title;
        hovering: touch.has-hover;
        at-x: root.width + Space.xs;
        at-y: Space.xs;
    }
}

// How far a job on this page has got: a small level meter and a few words, under the page's name. The job's activity
// card says the same; this keeps it in sight while you work on the page.
export component ProgressLine inherits HorizontalLayout {
    in property <string> text;
    // From 0 to 1.
    in property <float> done;
    // The accent for a job that's working; a level that isn't a job (how full a drive is) passes its own.
    in property <color> tint: Theme.accent;
    spacing: Space.sm;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Meter {
            width: 160px;
            height: 6px;
            level: root.done;
            tint: root.tint;
        }
    }
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: Type.meta;
        vertical-alignment: center;
    }
}

// A page's top: its name, a short summary beside it, and the job working on the page (if any) under them. Every page
// starts with one, so they all line up.
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> summary;
    // The job working on this page, in words; empty when nothing runs.
    in property <string> busy;
    in property <float> done;
    in property <bool> job-line: true;
    spacing: Space.xs;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: Space.md;
        // The place's mark, in its colour, as on the rail: it grows in when the page opens.
        VerticalLayout {
            alignment: center;
            mark := Rectangle {
                property <bool> shown;
                width: 4px;
                height: self.shown ? 24px : 4px;
                border-radius: 2px;
                background: Theme.here-colour;
                animate height { duration: Motion.settle; easing: ease-out; }
                init => { self.shown = true; }
            }
        }
        Text {
            text: root.title;
            font-family: Theme.title-font;
            font-size: Type.page-title;
            font-weight: 600;
            letter-spacing: -0.4px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.summary;
            color: Theme.muted;
            font-size: Type.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    // Always there, so the page doesn't jump when a job starts or ends; only seen while one runs. A page that never
    // runs a job of its own (Songs) leaves `job-line` off and keeps the room.
    if root.job-line: ProgressLine {
        visible: root.busy != "";
        text: root.busy;
        done: root.done;
    }
}

// Joined buttons where one is picked, like a page's views (Tiles, List, Galaxy, History). The lit block slides from
// the view you were on to the one you picked.
export component Segmented inherits Rectangle {
    in property <[string]> choices;
    // Each choice's tooltip key, from the shortcut list, if it has one.
    in property <[string]> keys;
    // The picked one. The page sets it when told of a pick, so a key that changes the view moves it too.
    in property <int> current;
    // The room either side of each label: less where many choices share a narrow row (Ctrl+K's kinds).
    in property <length> pad: Space.lg;
    callback picked(int);
    // Where the picked button is, which each button reports (read by a row that scrolls, to keep it in view).
    out property <length> lit-x;
    out property <length> lit-width;
    // Off until the first frame is drawn, so a page opening on its third view doesn't slide there from the left.
    property <bool> ready;
    Timer {
        interval: 1ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
    width: row.preferred-width;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    clip: true;
    background: @linear-gradient(180deg, Theme.surface-raised.brighter(8%) 0%, Theme.surface-raised.darker(6%) 100%);
    Rectangle {
        x: root.lit-x;
        width: root.lit-width;
        visible: root.current >= 0 && root.current < root.choices.length;
        // Picked is lifted, not painted: a lighter key with a lit strip along its bottom edge, like a pressed-in
        // button on a desk with its light on. One accent strip says "on" without turning the row into a block of colour.
        background: @linear-gradient(180deg, Theme.hover.brighter(Theme.light ? 0% : 30%) 0%, Theme.hover.brighter(Theme.light ? 0% : 12%) 100%);
        animate x, width { duration: root.ready ? Motion.move : 0ms; easing: ease-out; }
        Rectangle {
            x: Space.sm;
            y: parent.height - 3px;
            width: parent.width - 2 * Space.sm;
            height: 2px;
            border-radius: 1px;
            background: Theme.accent;
        }
    }
    row := HorizontalLayout {
        for name[i] in root.choices: Rectangle {
            property <bool> is-current: i == root.current;
            width: label.preferred-width + 2 * root.pad;
            background: self.is-current ? transparent : touch.pressed ? Theme.well : touch.has-hover ? Theme.hover.transparentize(40%) : transparent;
            animate background { duration: Motion.tap; }
            init => { self.report(); }
            changed is-current => { self.report(); }
            changed x => { self.report(); }
            changed width => { self.report(); }
            function report() {
                if (self.is-current) {
                    root.lit-x = self.x;
                    root.lit-width = self.width;
                }
            }
            // The seam between two buttons.
            Rectangle {
                x: 0;
                width: i == 0 ? 0 : 1px;
                background: Theme.edge;
            }
            label := Text {
                text: name;
                color: parent.is-current ? Theme.text : Theme.muted;
                font-size: Type.body;
                font-weight: parent.is-current ? 600 : 500;
                animate color { duration: Motion.tap; }
            }
            touch := TouchArea {
                clicked => { root.picked(i); }
            }
            Tip {
                text: name;
                key: root.keys[i];
                hovering: touch.has-hover && !touch.pressed;
                at-y: root.height + Space.xs;
            }
        }
    }
}

// What a menu offers: what it does, its key from the shortcut list, and the id the page acts on. A line with no words
// is a groove between groups.
export struct MenuItem {
    what: string,
    key: string,
    id: string,
    enabled: bool,
}

// The lines of a menu, on its card. A click on a line that can't be used does nothing, so the menu around it closes
// only when a line is chosen (or on a click outside it).
export component MenuItems inherits MenuCard {
    in property <[MenuItem]> items;
    callback chosen(string);
    for item in root.items: VerticalLayout {
        if item.what == "": Groove { }
        if item.what != "": MenuLine {
            text: item.what;
            key: item.key;
            enabled: item.enabled;
            clicked => { root.chosen(item.id); }
        }
    }
}

// A strip that warns about something, folded to its line until opened (Show, Hide), in the warning colour; `quiet`
// for news that needs no care, in the page's own colours. What it shows when opened goes inside it, after its line.
export component NoticeStrip inherits Rectangle {
    in property <string> text;
    in property <bool> quiet;
    in-out property <bool> open;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.quiet ? Theme.stroke : Theme.warning.transparentize(60%);
    background: root.quiet ? Theme.surface : Theme.warning.transparentize(92%);
    height: strip.preferred-height;
    strip := VerticalLayout {
        padding: Space.sm;
        padding-left: Space.md;
        spacing: Space.sm;
        HorizontalLayout {
            spacing: Space.sm;
            Text {
                text: root.text;
                color: root.quiet ? Theme.muted : Theme.warning;
                font-size: Type.body;
                font-weight: 500;
                // A long line is cut short with dots, not run under Show.
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            LinkText {
                text: root.open ? "Hide" : "Show";
                tint: Theme.muted;
                font-size: Type.meta;
                clicked => { root.open = !root.open; }
            }
        }
        @children
    }
}

// A button that opens a menu of lines under it, like "Remove older versions…". The menu lines up with the button's
// left edge, or with its right edge (`menu-at-right`, for a button at the right of a row, like the small "more" one).
export component MenuButton inherits StudioButton {
    in property <[MenuItem]> items;
    in property <bool> menu-at-right: false;
    callback chosen(string);
    menu: true;
    clicked => { button-menu.show(); }
    button-menu := PopupWindow {
        x: root.menu-at-right ? root.width - self.width : 0;
        y: root.height + Space.xs;
        width: max(root.width, 280px);
        close-policy: close-on-click-outside;
        MenuItems {
            items: root.items;
            chosen(id) => {
                button-menu.close();
                root.chosen(id);
            }
        }
    }
}

// A button that picks one of a list for what's on a card, like "Your type: Snare": its name and what's picked, as a
// MenuChip says them, with the same menu, but in a button's look. A chip lit with a value is a filter that's on (or one
// of a list's options), and what a card's thing is filters nothing (the whole-app review of 10 Nov, X3-10).
export component PickButton inherits StudioButton {
    in property <string> name;
    // What's picked; "" for none.
    in property <string> value;
    in property <[string]> choices;
    // What the menu's first line says: it picks "".
    in property <string> none-text: "Any";
    callback picked(string);
    text: root.value == "" ? root.name : root.name + ": " + root.value;
    menu: true;
    clicked => { pick-menu.show(); }
    pick-menu := PopupWindow {
        x: 0;
        y: root.height + Space.xs;
        width: max(root.width, 220px);
        close-policy: close-on-click-outside;
        PickLines {
            choices: root.choices;
            value: root.value;
            none-text: root.none-text;
            picked(c) => {
                pick-menu.close();
                root.picked(c);
            }
        }
    }
}

// One thing a side card offers, as a button: its words, what it does and its key (both from the shortcut list, for
// its tooltip, rule 15), and the id the page acts on.
export struct CardAction {
    text: string,
    tip: string,
    key: string,
    id: string,
    enabled: bool,
    // The card's main button, in the accent colour (Put back), or one that removes things, in the colour for missing
    // things (Remove).
    main: bool,
    danger: bool,
}

// A side card's buttons: everything you can do with what's picked, in sight rather than behind a "more" menu
// (Solomon's F12 note, 2026-11-02 03:28: "theres enough space just put them there"). The card's main button goes
// first, as a child; the rest follow and wrap onto another line when the card is narrow. The right-click menu on a
// line offers the same.
//
// Given the card's `room` (a SidePanel's `inside`), they stand in even columns (the UX review of 10 Nov, B2), two on
// a narrow card and four on a wide one, so they don't wrap raggedly; a button given as a child takes `cell` as its
// width. A button whose words need more than a column takes the whole line. The room comes from the card, not
// from this layout's own width: a part's width can't hang on the width of the layout that places it.
export component CardActions inherits FlexboxLayout {
    in property <[CardAction]> actions;
    in property <length> room;
    property <int> columns: self.room >= 600px ? 4 : 2;
    out property <length> cell: (self.room - (self.columns - 1) * self.spacing) / self.columns - 0.5px;
    callback chosen(string);
    spacing: Space.sm;
    // Two lists, one of them empty: a button with a `width` of its own gets no place from this layout unless that
    // width is a real one, so the buttons without a room mustn't have the binding at all.
    property <[CardAction]> none: [];
    @children
    for a in root.room > 0 ? root.none : root.actions: StudioButton {
        text: a.text;
        tip: a.tip;
        key: a.key;
        enabled: a.enabled;
        main: a.main;
        danger: a.danger;
        clicked => { root.chosen(a.id); }
    }
    for a in root.room > 0 ? root.actions : root.none: StudioButton {
        width: self.min-width > root.cell ? root.room : root.cell;
        text: a.text;
        tip: a.tip;
        key: a.key;
        enabled: a.enabled;
        main: a.main;
        danger: a.danger;
        clicked => { root.chosen(a.id); }
    }
}

// The menu of things to do with what's picked: a small "more" button, the same lines as the right-click menu.
export component MoreButton inherits MenuButton {
    icon: Icons.more;
    tip: "More";
    // The icon says it opens a menu: no arrow.
    menu: false;
    menu-at-right: true;
}

// A right-click menu: put one on the page and call `open-at` with the mouse's place in the window (as `ListLine`'s
// `right-clicked` gives it). Placed at 0,0 with no size of its own, so it takes no room and no clicks.
export component RightClickMenu {
    in property <[MenuItem]> items;
    callback chosen(string);
    x: 0;
    y: 0;
    width: 0;
    height: 0;
    property <length> at-x;
    property <length> at-y;
    public function open-at(x: length, y: length) {
        root.at-x = x - root.absolute-position.x;
        root.at-y = y - root.absolute-position.y;
        menu.show();
    }
    menu := PopupWindow {
        x: root.at-x;
        y: root.at-y;
        width: 280px;
        close-policy: close-on-click-outside;
        MenuItems {
            items: root.items;
            chosen(id) => {
                menu.close();
                root.chosen(id);
            }
        }
    }
}

// The page's own options (its numbers and choices, spec 3A), in a card under a small button at the end of the
// toolbar. The page's settings go inside it.
export component OptionsButton inherits StudioButton {
    in property <length> card-width: 320px;
    icon: Icons.options;
    tip: "Options for this page";
    clicked => { card.show(); }
    card := PopupWindow {
        x: root.width - self.width;
        y: root.height + Space.xs;
        width: root.card-width;
        close-policy: close-on-click-outside;
        MenuCard {
            VerticalLayout {
                padding: Space.md;
                spacing: Space.md;
                @children
            }
        }
    }
}

// The picked thing's panel beside a page's list: a raised card with a × to put it away (Esc does too).
export component SidePanel inherits Rectangle {
    callback close;
    // Whether it has something to close: an empty card ("Pick a part") shows no ×.
    in property <bool> closable: true;
    // The width its parts get: for a part that sets widths inside itself (`CardActions`' columns).
    out property <length> inside: self.width - 2 * Space.xl;
    // Back to its top: for a page whose one panel shows another card (it would open scrolled as far as the last one).
    public function to-top() {
        flick.content-y = 0;
    }
    // Where a part of what it holds is in it (`y` as the window has it): the same however far it's scrolled, so a part
    // can tell when it moved in the panel.
    pure public function held-at(y: length) -> length {
        y - flick.absolute-position.y - flick.content-y
    }
    // Scrolls as little as it must to bring a part of what it holds into sight (`top` and `bottom` as the window has
    // them): for a box with the keys that something moved out of sight. Slint scrolls a part into sight as it gets the
    // keys, not after, and takes the keys from one out of sight at the next key.
    public function reveal(top: length, bottom: length) {
        let shown-top = flick.absolute-position.y;
        let shown-bottom = shown-top + flick.height;
        if (bottom > shown-bottom) {
            flick.content-y = max(flick.height - flick.content-height, flick.content-y - (bottom - shown-bottom));
        } else if (top < shown-top) {
            flick.content-y = min(0px, flick.content-y + (shown-top - top));
        }
    }
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    // Scrolls when what it holds is taller than the panel; fills it otherwise, so a stretch at the end works. Never
    // wider than the panel: something too wide inside (a long path once) made the whole card slide right and lose its
    // right side (Solomon's F12 note, 2026-11-02 03:28), so it's cut at the edge instead, and the parts wrap.
    flick := Flickable {
        content-width: flick.width;
        // To where what it holds really ends: `end`, less the gap before it (see `end` below).
        content-height: max(flick.height, end.y - Space.md + Space.xl);
        // The wheel scrolls it (and a finger on a touch screen); a drag with the mouse is for what's in it, such as a
        // sound dragged out to a DAW, as in the app's lists.
        mouse-drag-pan-enabled: false;
        // At the top, as the scroll room isn't always as tall as it (it would sit in the middle of it otherwise).
        content := VerticalLayout {
            x: 0;
            y: 0;
            width: flick.width;
            // Taller than the panel by the gap before `end`: so what's above `end` gets the same room as without it
            // (a "Pick a plugin" note in the middle stays in the middle).
            height: max(flick.height + Space.md, self.preferred-height);
            padding: Space.xl;
            spacing: Space.md;
            @children
            // Where what the panel holds really ends, a gap below its last part. Slint measures a part inside an `if`
            // or a `for` as if none of its lines wrapped, so where they do the content's own height falls short, and
            // the panel stopped scrolling before its last lines (a long Space card's last parts). Laid out, each part
            // gets its real height, so `end` lands below the last one.
            end := Rectangle {
                height: 0px;
            }
        }
    }
    if root.closable: CloseButton {
        x: parent.width - self.width - Space.md;
        y: Space.md;
        clicked => { root.close(); }
    }
}

// The seam between a page's list and its side panel: drag it to give the panel more or less room. The page keeps the
// panel's width (and saves it, so each page remembers its own); this only reports the drag.
export component PanelDivider inherits Rectangle {
    // The panel's width now, and the room the list and panel share.
    in property <length> panel-width;
    in property <length> room;
    in property <length> min-list: 380px;
    in property <length> min-panel: 320px;
    // The new width while dragging, and once more when let go (to save it).
    callback resizing(length);
    callback resized(length);
    width: Space.lg;
    property <length> start-width;
    // Where the press was, in the window: the seam moves while it's dragged, so its own space won't do.
    property <length> start-x;
    property <bool> dragging;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 2px;
        height: min(48px, parent.height);
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: touch.pressed ? Theme.accent : touch.has-hover ? Theme.stroke : transparent;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                root.start-width = root.panel-width;
                root.start-x = self.absolute-position.x + self.mouse-x;
                root.dragging = false;
            }
            // Saved only when the seam really moved.
            if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.resized(root.panel-width);
            }
        }
        moved => {
            if self.pressed {
                root.dragging = true;
                root.resizing(clamp(root.start-width - (self.absolute-position.x + self.mouse-x - root.start-x), root.min-panel,
                    max(root.min-panel, root.room - root.width - root.min-list)));
            }
        }
    }
}

// What a list or panel shows when there's nothing in it: what's missing, why, and the one thing to do about it.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <string> action;
    callback act;
    alignment: center;
    spacing: Space.sm;
    // The place's icon in its colour, so even an empty page says where you are.
    if Icons.place(Theme.here) != "": HorizontalLayout {
        alignment: center;
        padding-bottom: Space.xs;
        Path {
            width: 32px;
            height: 32px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: Icons.place(Theme.here);
            stroke: Theme.here-colour.transparentize(25%);
            stroke-width: 2px;
        }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-family: Theme.title-font;
        font-size: Type.heading;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.text != "": Text {
        text: root.text;
        color: Theme.muted;
        font-size: Type.body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        padding-top: Space.sm;
        StudioButton {
            text: root.action;
            clicked => { root.act(); }
        }
    }
}

// A Waveform's lines as the graphics card drew them (see `Waves`): `picture`, which holds the Waveform with its corner
// `x` and `y` pixels in from the picture's own. An empty picture where the window draws the path instead.
export struct WavePicture {
    picture: image,
    x: float,
    y: float,
}

// Draws the waveforms on the graphics card (mo-ui's waves.rs). `picture` is the picture of a Waveform's lines (`shape`
// and `points` as the Waveform has them) in `tint`, for a Waveform `width` by `height` pixels with lines `line` pixels
// wide, sitting so far past a whole pixel in the window (across, then down, each from 0 to 1): drawn once on the card
// and kept, so the window shows a picture instead of working out every line again for each frame. Where there's no
// card (the screenshots, an old driver, MO_DRAW_CPU) its picture is empty, and the Waveform draws its path instead.
// `asked` changes when the card does, so every Waveform asks again.
export global Waves {
    in property <int> asked;
    pure callback picture(string, int, color, float, float, float, float, float, int) -> WavePicture;
}

// A sound's waveform, one thin line per stored peak, like the old app drew it. `shape` is the path the Rust side makes
// from the peaks (`mo_app::sounds::wave_path`: one line per peak, `points` wide and 100 high). What has played is
// drawn in the full tint with a playhead at the edge; with `seconds` given, the mouse shows a guide line with the time
// under it, and a click plays from there. The graphics card draws the lines when there's one (`Waves`); the window
// draws the path where there isn't.
export component Waveform inherits Rectangle {
    in property <string> shape;
    in property <int> points;
    in property <color> tint: Theme.accent;
    // How much has played, from 0 to 1.
    in property <float> played;
    // Whether it's playing now, which shows the playhead.
    in property <bool> playing;
    in property <bool> can-seek;
    // How long the waveform lasts, for the time under the mouse (0 shows none).
    in property <float> seconds;
    // Each line's width: thin enough that the lines stay apart.
    in property <length> line: max(1px, root.width / max(1, root.points) * 0.6);
    callback seek(float);
    // Where the Waveform sits in the window, in pixels. The window puts a picture on a whole pixel but draws a path just
    // where it is, so the card draws the lines as far past a whole pixel as the Waveform sits, and the picture goes that
    // far back: the lines land just where the path's would.
    property <float> pixel-x: root.absolute-position.x / 1phx;
    property <float> pixel-y: root.absolute-position.y / 1phx;
    // The lines drawn by the graphics card, in pixels, when there's a card; an empty picture when there isn't.
    property <WavePicture> drawn: Waves.picture(root.shape, root.points, root.tint, root.width / 1phx,
        root.height / 1phx, root.line / 1phx, root.pixel-x - floor(root.pixel-x), root.pixel-y - floor(root.pixel-y),
        Waves.asked);
    property <bool> on-card: root.drawn.picture.width > 0;
    clip: true;
    // The card's picture, shown pixel for pixel: see-through where it hasn't played yet, full where it has.
    if root.on-card: Image {
        x: -root.drawn.x * 1phx;
        y: -root.drawn.y * 1phx;
        width: root.drawn.picture.width * 1phx;
        height: root.drawn.picture.height * 1phx;
        source: root.drawn.picture;
        opacity: root.played >= 1 ? 1 : 0.45;
    }
    if root.on-card && root.played < 1: Rectangle {
        x: 0;
        width: root.width * clamp(root.played, 0, 1);
        clip: true;
        Image {
            x: -root.drawn.x * 1phx;
            y: -root.drawn.y * 1phx;
            width: root.drawn.picture.width * 1phx;
            height: root.drawn.picture.height * 1phx;
            source: root.drawn.picture;
        }
    }
    // Without a card, the path.
    if !root.on-card: Path {
        width: root.width;
        height: root.height;
        commands: root.shape;
        viewbox-width: max(1, root.points);
        viewbox-height: 100;
        fit: fill;
        stroke: root.played >= 1 ? root.tint : root.tint.transparentize(55%);
        stroke-width: root.line;
    }
    if !root.on-card && root.played < 1: Rectangle {
        x: 0;
        width: root.width * clamp(root.played, 0, 1);
        clip: true;
        Path {
            x: 0;
            width: root.width;
            height: root.height;
            commands: root.shape;
            viewbox-width: max(1, root.points);
            viewbox-height: 100;
            fit: fill;
            stroke: root.tint;
            stroke-width: root.line;
        }
    }
    if root.playing && root.played < 1: Rectangle {
        x: min(root.width * clamp(root.played, 0, 1), root.width - 2px);
        width: 2px;
        background: Theme.text;
    }
    area := TouchArea {
        enabled: root.can-seek;
        mouse-cursor: root.can-seek ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
    }
    if root.can-seek && area.has-hover && root.seconds > 0: Rectangle {
        property <float> at: clamp(area.mouse-x / root.width, 0, 1) * root.seconds;
        property <string> time: at >= 60
            ? floor(at / 60) + ":" + (mod(floor(at), 60) < 10 ? "0" : "") + mod(floor(at), 60)
            : (round(at * 100) / 100) + "s";
        Rectangle {
            x: area.mouse-x;
            width: 1px;
            background: Theme.muted;
        }
        Rectangle {
            x: area.mouse-x + 4px + label.preferred-width + 6px > root.width
                ? area.mouse-x - 4px - label.preferred-width - 6px
                : area.mouse-x + 4px;
            y: 2px;
            width: label.preferred-width + 6px;
            height: label.preferred-height + 2px;
            border-radius: 3px;
            background: Theme.sidebar;
            label := Text {
                text: time;
                color: Theme.text;
                font-family: Theme.number-font;
                font-size: Type.meta;
            }
        }
    }
}

// One folder in a list of folders (backup, sample folders, MIDI folders): its path, its size, a choice of how it's
// treated (like Whole or Slimmed) when the page gives choices, and a × to take it off the list.
export component FolderRow inherits Rectangle {
    in property <string> path;
    in property <string> size;
    in property <[string]> modes;
    // The picked mode; the page sets it when told of a pick.
    in property <int> mode;
    // Whether the row has its × (a list you can't change has none), whether it can be pressed now, and what it does.
    in property <bool> removable: true;
    in property <bool> enabled: true;
    in property <string> remove-tip: "Take this folder off the list (nothing on disk changes)";
    callback mode-picked(int);
    callback remove;
    height: 44px;
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        spacing: Space.md;
        path-text := Text {
            text: root.path;
            color: Theme.text;
            font-size: Type.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.size != "": Text {
            text: root.size;
            color: Theme.muted;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
        }
        if root.modes.length > 0: VerticalLayout {
            alignment: center;
            Segmented {
                choices: root.modes;
                current: root.mode;
                picked(i) => { root.mode-picked(i); }
            }
        }
        if root.removable: VerticalLayout {
            alignment: center;
            CloseButton {
                tip: root.remove-tip;
                enabled: root.enabled;
                clicked => { root.remove(); }
            }
        }
    }
    // The whole path, for one cut short with "…" (two long ones that differ only at the end look the same).
    path-touch := TouchArea {
        x: path-text.x;
        y: 0;
        width: path-text.width;
        height: root.height;
    }
    Tip {
        text: root.path;
        hovering: path-touch.has-hover;
        at-x: path-text.x;
        at-y: root.height;
    }
}
