// The app's one shared style (rule 16): colour tokens set from the theme in use, and the few building blocks every
// page uses. Pages never set a raw colour or their own button look; the style test in mo-ui checks that.

export global Theme {
    // Filled in from mo-app's themes when the app starts and whenever the look changes. The values here are Graphite,
    // so the live preview in VS Code shows the default look.
    in-out property <color> background: #121212;
    in-out property <color> sidebar: #171717;
    in-out property <color> surface: #1D1D1D;
    in-out property <color> surface-raised: #252525;
    in-out property <color> stroke: #323232;
    in-out property <color> hover: #2A2A2A;
    in-out property <color> text: #F0F0F0;
    in-out property <color> muted: #A3A3A3;
    in-out property <color> faint: #6E6E6E;
    in-out property <color> accent: #3DDC97;
    in-out property <color> accent-text: #06180F;
    in-out property <bool> light: false;
    in-out property <bool> square: false;
    in-out property <string> text-font: "IBM Plex Sans";
    in-out property <string> number-font: "IBM Plex Mono";

    // Derived: the dark edge under raised things and the well behind pressed-in fields. Light themes get softer ones.
    out property <color> edge: light ? stroke.darker(25%) : #0B0B0B;
    out property <color> well: light ? surface.darker(4%) : background.darker(20%);
    out property <color> shine: light ? #ffffff80 : #ffffff12;
    out property <length> radius: square ? 1px : 4px;

    // How things went, the same in every theme: missing or failed, a warning, all good.
    out property <color> missing: #F0616D;
    out property <color> warning: #F2B33D;
    out property <color> ok: #4ACB8B;
    // Shadows under cards and dialogs, and the dimming behind a dialog.
    out property <color> shadow: #00000080;
    out property <color> scrim: #00000099;

    // The DAWs' own colours, the same in every theme.
    out property <color> fl-studio: #5EA8FF;
    out property <color> bitwig: #F2994A;
    out property <color> studio-one: #4ACB8B;
}

// Text sizes (the agreed scale, nearer the C# app at 125%). Pages use these, never a size of their own.
export global Type {
    // A page's name, top left.
    out property <length> page-title: 28px;
    // The song's name in the song panel.
    out property <length> panel-title: 26px;
    // A dialog's or a card's title.
    out property <length> heading: 20px;
    // A name in a list, rail lines.
    out property <length> row-title: 16px;
    // Buttons, tabs, Health lines, panel text.
    out property <length> body: 15px;
    // Second lines under a name, chips, counts, dates.
    out property <length> meta: 13px;
    // Group headings in capitals.
    out property <length> caps: 12px;
}

// Gaps and padding, on a 4px grid. Pages use these, never a gap of their own.
export global Space {
    // Between a name and its second line; inside small chips.
    out property <length> xs: 4px;
    // Between chips, buttons and tabs in a row.
    out property <length> sm: 8px;
    // Inside rows and buttons; between rows of controls.
    out property <length> md: 12px;
    // Inside panels and the Health strip.
    out property <length> lg: 16px;
    // Between the big parts of a page; the page's own margin.
    out property <length> xl: 24px;
}

// A two-tone grooved line: a dark line with a faint light one under it, like a panel seam.
export component Groove inherits VerticalLayout {
    Rectangle {
        height: 1px;
        background: Theme.edge;
    }
    Rectangle {
        height: 1px;
        background: Theme.light ? #ffffff : #ffffff0d;
    }
}

// A small heading in capitals, for groups like "In your DAWs".
export component Caps inherits Text {
    font-size: Type.caps;
    font-weight: 500;
    color: Theme.muted;
    letter-spacing: 0.8px;
}

// The shaded, top-lit button. `main` is the page's main action, in the accent colour.
export component StudioButton inherits Rectangle {
    in property <string> text;
    in property <bool> main: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: label.preferred-width + 24px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
    background: !enabled ? Theme.surface : main
        ? (touch.pressed ? Theme.accent.darker(15%) : @linear-gradient(180deg, Theme.accent.brighter(12%) 0%, Theme.accent.darker(6%) 100%))
        : (touch.pressed ? Theme.well : @linear-gradient(180deg, (touch.has-hover ? Theme.hover : Theme.surface-raised).brighter(8%) 0%, Theme.surface-raised.darker(6%) 100%));
    animate background { duration: 90ms; }
    // The top-lit edge.
    Rectangle {
        y: 1px;
        height: 1px;
        x: parent.border-radius;
        width: parent.width - 2 * parent.border-radius;
        background: touch.pressed ? transparent : Theme.shine;
    }
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.faint : root.main ? Theme.accent-text : Theme.text;
        font-size: Type.body;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One line on the left-hand rail.
export component RailItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 40px;
    border-radius: Theme.radius;
    background: selected ? Theme.surface-raised : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    // The accent bar on the picked place.
    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0;
        background: Theme.accent;
        animate width { duration: 120ms; }
    }
    Text {
        x: 12px;
        text: root.text;
        color: root.selected ? Theme.text : Theme.muted;
        font-size: Type.row-title;
        font-weight: 500;
        vertical-alignment: center;
        height: parent.height;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A sunken panel, like a screen set into the hardware: for previews, lists and empty pages.
export component Well inherits Rectangle {
    background: Theme.well;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.edge;
}

// A small × button, for putting a card away.
export component CloseButton inherits Rectangle {
    callback clicked;
    width: 20px;
    height: 20px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    Text {
        text: "×";
        color: Theme.muted;
        font-size: Type.row-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A rounded chip that does something when clicked, like "2 running" under the activity cards.
export component Chip inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? Theme.hover : Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.edge;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.meta;
        font-weight: 500;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A tick box with its words beside it. Clicking either ticks or unticks it.
export component TickBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    width: label.preferred-width + 26px;
    Rectangle {
        x: 0;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke;
        background: root.checked ? Theme.accent : Theme.well;
        // The tick is drawn, as the app's fonts have no ✓.
        if root.checked: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 4 8.5 L 7 11.5 L 12.5 5";
            stroke: Theme.accent-text;
            stroke-width: 2px;
        }
    }
    label := Text {
        x: 24px;
        text: root.text;
        color: Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

// The search box: a pressed-in field with its hint shown until something is typed.
export component SearchBox inherits Rectangle {
    in property <string> hint: "Search";
    in-out property <string> text <=> input.text;
    callback edited(string);
    // Down, Enter and Esc go to the page first; it returns true when it used the key.
    callback key(string) -> bool;
    forward-focus: input;
    height: 36px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.well;
    Text {
        x: 10px;
        text: root.hint;
        visible: input.text == "";
        color: Theme.faint;
        font-size: Type.body;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        color: Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent.transparentize(60%);
        edited => { root.edited(self.text); }
        key-pressed(event) => {
            if (event.text == Key.DownArrow || event.text == Key.Return || event.text == Key.Escape) {
                if (root.key(event.text)) {
                    return accept;
                }
            }
            reject
        }
    }
}

// A chip that's on or off, like "Favourites".
export component ToggleChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.edge;
    background: on ? Theme.accent.transparentize(80%) : touch.has-hover ? Theme.hover : Theme.surface-raised;
    label := Text {
        text: root.text;
        color: root.on ? Theme.text : Theme.muted;
        font-size: Type.meta;
        font-weight: 500;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One line of a drop-down menu.
export component MenuLine inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    Text {
        x: 10px;
        text: root.text;
        color: root.on ? Theme.accent : Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
        height: parent.height;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A chip that picks one of a list, like "DAW: FL Studio". "Any" clears it.
export component MenuChip inherits Rectangle {
    in property <string> name;
    in property <string> value;
    in property <[string]> choices;
    callback picked(string);
    width: label.preferred-width + 34px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: value != "" ? Theme.accent : Theme.edge;
    background: value != "" ? Theme.accent.transparentize(80%) : touch.has-hover ? Theme.hover : Theme.surface-raised;
    label := Text {
        x: 12px;
        text: root.value == "" ? root.name : root.name + ": " + root.value;
        color: root.value != "" ? Theme.text : Theme.muted;
        font-size: Type.meta;
        font-weight: 500;
        vertical-alignment: center;
        height: parent.height;
    }
    Path {
        x: parent.width - 18px;
        y: (parent.height - 6px) / 2;
        width: 8px;
        height: 6px;
        viewbox-width: 8;
        viewbox-height: 6;
        commands: "M 1 1 L 4 4.5 L 7 1";
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }
    touch := TouchArea {
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 180px);
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 12px;
            VerticalLayout {
                padding: Space.xs;
                MenuLine {
                    text: "Any";
                    on: root.value == "";
                    clicked => { root.picked(""); }
                }
                for c in root.choices: MenuLine {
                    text: c;
                    on: root.value == c;
                    clicked => { root.picked(c); }
                }
            }
        }
    }
}

// A line of a list that can be picked: the shared look for every list's rows (rule 16).
export component ListLine inherits Rectangle {
    in property <bool> selected;
    callback clicked;
    callback double-clicked;
    border-radius: Theme.radius;
    background: selected ? Theme.surface-raised : touch.has-hover ? Theme.hover : transparent;
    // The accent bar on the picked line.
    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0;
        background: Theme.accent;
    }
    @children
    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

// A star rating out of five, drawn.
export component Stars inherits HorizontalLayout {
    in property <int> rating;
    spacing: 1px;
    for i in 5: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 5 0.5 L 6.3 3.6 L 9.6 3.8 L 7.1 6 L 7.9 9.3 L 5 7.5 L 2.1 9.3 L 2.9 6 L 0.4 3.8 L 3.7 3.6 Z";
        fill: i < root.rating ? Theme.warning : transparent;
        stroke: i < root.rating ? Theme.warning : Theme.faint;
        stroke-width: 0.8px;
    }
}

// One year on a scrubber beside a long list: click to jump to it.
export component YearMark inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 20px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    Text {
        text: root.text;
        color: touch.has-hover ? Theme.text : Theme.faint;
        font-family: Theme.number-font;
        font-size: Type.caps;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small heart, for a favourite.
export component Heart inherits Path {
    in property <bool> on: true;
    width: 11px;
    height: 10px;
    viewbox-width: 11;
    viewbox-height: 10;
    commands: "M 5.5 9.3 L 1.2 5.1 C -0.4 3.4 0.6 0.5 3 0.5 C 4.2 0.5 5 1.2 5.5 2 C 6 1.2 6.8 0.5 8 0.5 C 10.4 0.5 11.4 3.4 9.8 5.1 Z";
    fill: on ? Theme.accent : transparent;
    stroke: on ? Theme.accent : Theme.faint;
    stroke-width: 0.8px;
}

// A row of tabs over a panel: the picked one is underlined in the accent colour.
export component TabBar inherits HorizontalLayout {
    in property <[string]> tabs;
    in-out property <int> current;
    spacing: Space.xs;
    alignment: start;
    for name[i] in root.tabs: Rectangle {
        width: label.preferred-width + 20px;
        height: 36px;
        border-radius: Theme.radius;
        background: touch.has-hover && i != root.current ? Theme.hover : transparent;
        label := Text {
            text: name;
            color: i == root.current ? Theme.text : Theme.muted;
            font-size: Type.body;
            font-weight: 500;
        }
        Rectangle {
            y: parent.height - 2px;
            height: 2px;
            x: 8px;
            width: parent.width - 16px;
            background: i == root.current ? Theme.accent : transparent;
        }
        touch := TouchArea {
            clicked => { root.current = i; }
        }
    }
}

// Words that do something when clicked, like "9 plugins" opening the Plugins tab: underlined under the mouse.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    in property <length> font-size: Type.body;
    callback clicked;
    width: label.preferred-width;
    height: label.preferred-height;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: root.font-size;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: touch.has-hover ? root.tint : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
