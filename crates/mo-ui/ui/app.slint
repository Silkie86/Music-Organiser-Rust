// The window shell: the rail on the left and the page on show. Agreed map (2026-10-29): Songs, Sounds, Presets, MIDI,
// Plugins and Space, with Settings at the bottom.
import { Theme, Type, Space, Motion, Icons, RailItem, Groove, Caps, ActionKey, TipLayer, TipState, StudioButton } from "studio.slint";
import { ComingPage } from "pages/coming.slint";
import { PartsGallery } from "pages/parts.slint";
import { SoundsPage, SoundsData, GalaxyLabel, SweptLine, TrailDot, AlikeLine, FolderLine, PadLine, SoundTile, TileRow, SoundLine, SoundFact, PickedSound, TileGrid, TileGridAt, TileLook } from "pages/sounds.slint";
import { MenuItem, CardAction, YearBar, FilterChoice, FilterView } from "studio.slint";
import { SongsPage, SongsData, SongLine, PanelSong, CountLine, PluginLine, SampleLine, SaveLine, DetailPair, HealthLine, OlderLine } from "pages/songs.slint";
import { ArrangementData, ArrLabel, ArrKind } from "pages/arrangement.slint";
import { BackupPage, BackupData, BackupFolderLine, LeftOutLine } from "pages/backup.slint";
import { PluginsPage, PluginsData, PluginListLine, NeededCard, RoomBar, RoomFolder, UseRow, CopyRow } from "pages/plugins.slint";
import { PresetsPage, PresetsData, PresetLine, PresetFact, PartChip, PresetCard, CurveLineInfo, CurvePlace, CurveCardInfo } from "pages/presets.slint";
import { MidiPage, MidiData, MidiLine, RollLabel, RollRoom, MidiFact, PickedPart } from "pages/midi.slint";
// The waveforms drawn on the graphics card (mo-ui's waves.rs).
import { Waves, WavePicture } from "studio.slint";
export { Waves, WavePicture }
import { SpacePage, SpaceData, DriveCard, RoomLine, CardPart } from "pages/space.slint";
import { ActivityCards, CardInfo, KeySheet, KeyRow, NoteDialog } from "shell.slint";
import { Finder, FinderData, FinderLine } from "finder.slint";
import { SettingsPage, SettingsData, ThemeCardInfo, AccentInfo, SettingsFact, FolderGroupInfo, KeyLineInfo, DawRowInfo } from "pages/settings.slint";
// std-widgets' colours follow the theme (light or dark), for its scroll bars and the About part's Slint logo.
import { Palette } from "std-widgets.slint";

import "../fonts/IBMPlexSans-400.ttf";
import "../fonts/IBMPlexSans-500.ttf";
import "../fonts/IBMPlexSans-600.ttf";
import "../fonts/IBMPlexSans-700.ttf";
import "../fonts/IBMPlexMono-400.ttf";
import "../fonts/IBMPlexMono-500.ttf";
import "../fonts/IBMPlexMono-600.ttf";
import "../fonts/IBMPlexMono-700.ttf";
import "../fonts/SpaceGrotesk-400.ttf";
import "../fonts/SpaceGrotesk-500.ttf";
import "../fonts/SpaceGrotesk-600.ttf";
import "../fonts/SpaceGrotesk-700.ttf";
import "../fonts/SpaceMono-400.ttf";
import "../fonts/SpaceMono-700.ttf";

export { PresetsData, PresetLine, PresetFact, PartChip, PresetCard, CurveLineInfo, CurvePlace, CurveCardInfo }
export { MidiData, MidiLine, RollLabel, RollRoom, MidiFact, PickedPart }
export { FinderData, FinderLine }
export { Palette, SettingsData, ThemeCardInfo, AccentInfo, SettingsFact, FolderGroupInfo, KeyLineInfo, DawRowInfo }
export { Theme, Icons, ActionKey, MenuItem, CardAction, YearBar, FilterChoice, FilterView, SoundsData, GalaxyLabel, SweptLine, TrailDot, AlikeLine, FolderLine, PadLine, SoundTile, TileRow, SoundLine, SoundFact, PickedSound, TileGrid, TileGridAt, TileLook, BackupData, BackupFolderLine, LeftOutLine, SpaceData, DriveCard, RoomLine, CardPart, PluginsData, PluginListLine, NeededCard, RoomBar, RoomFolder, UseRow, CopyRow, ArrangementData, ArrLabel, ArrKind, CardInfo, KeyRow, SongsData, SongLine, PanelSong, CountLine, PluginLine, SampleLine, SaveLine, DetailPair, HealthLine, OlderLine }

export struct PlaceInfo {
    name: string,
    coming: string,
    // The key that goes there, from the shortcut list.
    key: string,
    // Its icon, from Icons.
    icon: string,
}

export component AppWindow inherits Window {
    title: "Music Organiser";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;
    default-font-family: Theme.text-font;

    // Every place in rail order. Settings is the last one, and sits apart at the bottom.
    in property <[PlaceInfo]> places;
    // The places on the rail itself: every place before Settings.
    in property <[PlaceInfo]> rail;
    in property <int> settings-place;
    // The places that have pages of their own so far (the rest show what's coming).
    in property <int> songs-place: 0;
    in property <int> sounds-place: 1;
    // Backup: a lean copy of your music on another drive.
    in property <int> backup-place: -1;
    // Plugins: every plugin your songs use, and what to install to open more of them.
    in property <int> plugins-place: -1;
    // Presets: the sounds in your songs and your preset files, and the curves.
    in property <int> presets-place: -1;
    // MIDI: every MIDI part in your projects and MIDI folders.
    in property <int> midi-place: -1;
    // Settings: General, Folders, DAWs, Shortcuts and Developer.
    in property <bool> settings-built: false;
    in property <int> space-place: -1;
    // The shared parts on one page instead of the places, for the screenshots only.
    in property <bool> parts-gallery;
    in-out property <int> place: 0;
    callback place-chosen(int);
    // A key press, with its modifiers and whether it's the key held down, for the app-wide shortcut list in mo-app.
    // Returns whether it was used.
    callback key(string, bool, bool, bool, bool, bool) -> bool;

    // Activity cards, bottom right.
    in property <[CardInfo]> cards;
    in property <int> put-away;
    callback dismiss-card(int);
    callback bring-back-cards();
    // Settings' "Try an activity card", until real jobs exist.
    callback try-job();

    // The key sheet (F1 or ?).
    in property <[KeyRow]> key-rows;
    in-out property <bool> sheet-open;

    // The F12 note.
    in-out property <bool> note-open;
    in-out property <string> note-text;
    in property <bool> note-has-picture;
    in-out property <bool> note-include-picture: true;
    callback note-edited(string);
    callback note-save();
    callback note-cancel();
    callback note-put-aside();

    // The place's colour follows the place on show (the rail's light, the mark by the page's name).
    init => { Theme.here = root.place; }
    changed place => { Theme.here = root.place; }

    forward-focus: keys;
    // Keys go back to the window once the Ctrl+K finder closes.
    property <bool> finder-open: FinderData.open;
    changed finder-open => {
        if (!self.finder-open) {
            keys.focus();
        }
    }
    keys := FocusScope {
        // Tab moves between the note's parts and never lands on this invisible scope, where typing would vanish.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            TipState.hide();
            if (event.text == Key.Escape && (root.sheet-open || root.note-open)) {
                if (root.note-open) {
                    root.note-put-aside();
                }
                root.sheet-open = false;
                keys.focus();
                return accept;
            }
            // While the note is open, keys are for typing: no shortcut runs behind it.
            if (root.note-open) {
                return reject;
            }
            if (root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta, event.repeat)) {
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // The rail.
            rail := Rectangle {
                width: 208px;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: Space.sm;
                    padding-top: Space.lg;
                    spacing: Space.xs;
                    // The app's name in its own title face.
                    Text {
                        text: "Music Organiser";
                        font-family: Theme.title-font;
                        font-size: Type.row-title;
                        font-weight: 700;
                        letter-spacing: -0.2px;
                        color: Theme.text;
                        height: 40px;
                        x: 10px;
                    }
                    // Ctrl+K in sight, not only on a key (Solomon, 4 Nov: nothing useful hidden away).
                    StudioButton {
                        text: "Jump to anything…";
                        tip: "Jump to a song, sound, page or action";
                        key: FinderData.jump-key;
                        clicked => { FinderData.open-asked(); }
                    }
                    Rectangle { height: 4px; }
                    // The rail's places are the first ones in `places`; Settings sits apart at the bottom.
                    places-list := VerticalLayout {
                        spacing: Space.xs;
                        for p[i] in root.rail: RailItem {
                            text: p.name;
                            icon: p.icon;
                            key: p.key;
                            tint: Theme.place(i);
                            lit-bar: false;
                            selected: root.place == i;
                            clicked => { root.place-chosen(i); }
                            // Tells the rail's light where the picked line is.
                            init => { self.report(); }
                            changed selected => { self.report(); }
                            changed y => { self.report(); }
                            changed height => { self.report(); }
                            function report() {
                                if (self.selected) {
                                    rail-light.at-y = places-list.y + self.y;
                                    rail-light.line = self.height;
                                }
                            }
                        }
                    }
                    Rectangle { height: 10px; }
                    Groove { }
                    Rectangle { height: 6px; }
                    Caps { text: "IN YOUR DAWS"; x: 10px; }
                    Text {
                        x: 10px;
                        text: "Nothing open";
                        color: Theme.faint;
                        font-size: Type.meta;
                    }
                    Rectangle { }
                    RailItem {
                        tint: Theme.place(root.settings-place);
                        text: root.places[root.settings-place].name;
                        icon: root.places[root.settings-place].icon;
                        key: root.places[root.settings-place].key;
                        selected: root.place == root.settings-place;
                        clicked => { root.place-chosen(root.settings-place); }
                    }
                }
                // The light on the picked place, in its colour. One light for the whole list, so it slides from the
                // place you were on to the one you picked: you see where you went. Settings lights its own.
                rail-light := Rectangle {
                    // The picked line's top and height, which the line reports; kept when Settings is picked, so the
                    // light goes out where it was instead of streaking down the rail.
                    in-out property <length> at-y;
                    in-out property <length> line;
                    property <bool> on-list: root.place >= 0 && root.place < root.rail.length;
                    // Off until the first frame is drawn, so the light doesn't slide in from the top as the app opens.
                    property <bool> ready;
                    Timer {
                        interval: 1ms;
                        running: !rail-light.ready;
                        triggered => { rail-light.ready = true; }
                    }
                    x: Space.sm;
                    width: 3px;
                    height: self.on-list ? self.line - 2 * Space.sm : 0;
                    y: self.at-y + (self.line - self.height) / 2;
                    border-radius: 1.5px;
                    background: Theme.here-colour;
                    animate y { duration: self.ready ? Motion.move : 0ms; easing: ease-out; }
                    animate height { duration: self.ready ? Motion.move : 0ms; easing: ease-out; }
                }
                // The seam between the rail and the page.
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.edge;
                }
            }
            // The page on show.
            if root.place == root.songs-place: SongsPage {
                horizontal-stretch: 1;
            }
            if root.place == root.sounds-place: SoundsPage {
                horizontal-stretch: 1;
            }
            if root.place == root.backup-place: BackupPage {
                horizontal-stretch: 1;
            }
            if root.place == root.plugins-place: PluginsPage {
                horizontal-stretch: 1;
            }
            if root.place == root.presets-place: PresetsPage {
                horizontal-stretch: 1;
            }
            if root.place == root.midi-place: MidiPage {
                horizontal-stretch: 1;
            }
            if root.place == root.settings-place && root.settings-built: SettingsPage {
                horizontal-stretch: 1;
            }
            if root.place == root.space-place: SpacePage {
                horizontal-stretch: 1;
            }
            if root.place != root.songs-place && root.place != root.sounds-place && root.place != root.backup-place
                && root.place != root.midi-place && root.place != root.space-place
                && !(root.place == root.settings-place && root.settings-built) && root.place != root.presets-place
                && root.place != root.plugins-place: ComingPage {
                horizontal-stretch: 1;
                title: root.places[root.place].name;
                coming: root.places[root.place].coming;
                can-try-job: root.place == root.settings-place;
                try-job => { root.try-job(); }
            }
        }

        // For the screenshots only: the shared parts on one page, over the page beside the rail.
        if root.parts-gallery: PartsGallery {
            x: rail.width;
            width: parent.width - self.x;
            height: parent.height;
        }

        ActivityCards {
            x: parent.width - self.width - 20px;
            y: parent.height - self.height - 20px;
            height: self.preferred-height;
            cards: root.cards;
            put-away: root.put-away;
            dismiss(id) => { root.dismiss-card(id); }
            bring-back => { root.bring-back-cards(); }
        }

        if root.sheet-open: KeySheet {
            rows: root.key-rows;
            close => {
                root.sheet-open = false;
                keys.focus();
            }
        }

        if root.note-open: note := NoteDialog {
            text <=> root.note-text;
            has-picture: root.note-has-picture;
            include-picture <=> root.note-include-picture;
            edited(t) => { root.note-edited(t); }
            save => {
                root.note-save();
                keys.focus();
            }
            cancel => {
                root.note-cancel();
                keys.focus();
            }
            put-aside => {
                root.note-put-aside();
                keys.focus();
            }
            init => { self.focus(); }
        }
        // Ctrl+K: jump to anything, over the page.
        if FinderData.open: Finder {
            width: 100%;
            height: 100%;
        }
        // The tooltip, over everything.
        TipLayer { width: 100%; height: 100%; }
    }
}
