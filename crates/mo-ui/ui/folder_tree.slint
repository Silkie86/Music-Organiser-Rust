// The folder tree beside a list of sounds (Solomon, 24 Nov 2026): only the folders that hold sounds the other filters
// let through, each with how many, ticked to narrow the list to them (as many as you like). The lines, picks and
// words are made by mo_app::sound_folders; this only shows them and says what was clicked.
import { AppKeys, Theme, Type, Space, Heights, Caps, SearchBox, CutText, ListLine, StudioButton, TagChip, CloseButton } from "studio.slint";
import { ListView } from "list.slint";

// One line of the tree. `picked`: 0 not, 1 picked with the folders inside it, 2 picked alone ("just this folder"),
// 3 inside a folder picked with its folders, 4 a folder inside it is picked.
export struct TreeLine {
    path: string,
    label: string,
    depth: int,
    count: string,
    used: string,
    has-children: bool,
    open: bool,
    picked: int,
    hidden: bool,
    away: bool,
    scanning: bool,
    empty: bool,
}

// A pick or a hidden folder, as a chip in the strip under the list: its name, how many sounds it shows ("412"; ""
// for a hidden one or before they're counted), and whether it's a hidden one (crossed out).
export struct TreePick {
    path: string,
    text: string,
    count: string,
    hidden: bool,
}

// One part of the picks' type mix: a type, how many sounds ("243"), its share of the picks' sounds (0 to 1), its
// colour's place in the Sounds palette (-1 grey), whether it's the rest of the types together ("Other", not a type to
// pick), and whether it's a type picked in the filter column (`dim` while others are and it isn't).
export struct MixPart {
    name: string,
    count: string,
    share: float,
    colour: int,
    rest: bool,
    dim: bool,
}

// The tick box of a line: lit when picked, a dash when a folder inside it is, faintly lit when a folder above it is.
component TreeTick inherits Rectangle {
    in property <int> picked;
    in property <bool> dim;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border-width: 1.5px;
    property <bool> lit: root.picked == 1 || root.picked == 2;
    border-color: root.lit || root.picked == 4 ? Theme.accent
        : root.picked == 3 ? Theme.accent.transparentize(50%)
        : Theme.muted.transparentize(root.dim ? 70% : 40%);
    background: root.lit ? Theme.accent : root.picked == 3 ? Theme.accent.transparentize(80%) : transparent;
    if root.lit || root.picked == 3: Path {
        x: 2px;
        y: 3px;
        width: 10px;
        height: 8px;
        viewbox-width: 12;
        viewbox-height: 10;
        commands: "M 1 5 L 4.5 8.5 L 11 1.5";
        stroke: root.lit ? Theme.accent-text : Theme.accent;
        stroke-width: 2px;
    }
    if root.picked == 4: Path {
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M 3.5 7 L 10.5 7";
        stroke: Theme.accent;
        stroke-width: 2px;
    }
}

// A small word on a line that says something about it: "just this folder", "drive away", "scanning".
component LineTag inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.faint;
    height: 16px;
    width: words.preferred-width + 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.ink.transparentize(50%);
    words := Text {
        text: root.text;
        color: root.ink;
        font-size: Type.tiny;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component TreeLineView inherits ListLine {
    in property <TreeLine> line;
    callback toggled();
    callback opened();
    property <length> indent: root.line.depth * 14px;
    height: Heights.tick-line;
    tip: root.line.path;
    // A right click picks the line for its menu first: that isn't a pick of the folder.
    clicked => {
        if !AppKeys.picking-for-menu {
            root.toggled();
        }
    }
    // Its two clicks pick and unpick it again; it opens, as a tree's folder does.
    double-clicked => {
        if root.line.has-children {
            root.opened();
        }
    }
    HorizontalLayout {
        padding-left: Space.xs + root.indent;
        padding-right: Space.sm;
        spacing: Space.xs;
        // The arrow that opens and closes the folder; room kept for it on a folder with nothing inside to show.
        Rectangle {
            width: 14px;
            arrow-touch := TouchArea {
                enabled: root.line.has-children;
                clicked => { root.opened(); }
            }
            if root.line.has-children: Path {
                width: 8px;
                height: 8px;
                viewbox-width: 8;
                viewbox-height: 8;
                commands: root.line.open ? "M 0 2 L 8 2 L 4 7 Z" : "M 2 0 L 7 4 L 2 8 Z";
                fill: Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            TreeTick {
                picked: root.line.picked;
                dim: root.line.empty || root.line.hidden || root.line.away;
            }
        }
        CutText {
            over: root.resting;
            anywhere: true;
            text: root.line.label;
            color: root.line.hidden || root.line.away ? Theme.faint.transparentize(30%)
                : root.line.picked == 1 || root.line.picked == 2 ? Theme.text
                : root.line.empty ? Theme.faint
                : Theme.muted;
            font-size: Type.meta;
            font-weight: root.line.picked == 1 || root.line.picked == 2 ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 40px;
        }
        if root.line.picked == 2: VerticalLayout {
            alignment: center;
            LineTag {
                text: "just this folder";
                ink: Theme.accent;
            }
        }
        if root.line.away: VerticalLayout {
            alignment: center;
            LineTag { text: "drive away"; }
        }
        if root.line.scanning: VerticalLayout {
            alignment: center;
            LineTag {
                text: "scanning";
                ink: Theme.accent;
            }
        }
        if root.line.hidden: VerticalLayout {
            alignment: center;
            LineTag { text: "hidden"; }
        }
        Text {
            text: root.line.count;
            color: Theme.faint;
            font-family: Theme.number-font;
            font-size: Type.meta;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if root.line.used != "": Text {
            text: root.line.used;
            color: Theme.faint.transparentize(35%);
            font-size: Type.tiny;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    // The tick box and the words lie under the line's own click; the arrow has its own (above).
}

// The tree: its name, a box to find a folder, the lines, and what's in the picks under them. Folded, it's a slim tab that says FOLDERS, lit while anything is picked, and a click opens it again.
export component FolderTree inherits Rectangle {
    in property <[TreeLine]> lines;
    in property <[TreePick]> picks;
    // "2 picked", or "" for none.
    in property <string> picked-words;
    // What the line under the tree says: how many sounds the picks show, or what to do.
    in property <string> note;
    in property <bool> folded;
    // In a narrow window it's folded to its tab whatever `folded` says, and a click opens it over the list for a
    // while (as the filter column does), without changing how it's kept for a wider window.
    in property <bool> narrow;
    property <bool> open-narrow;
    property <bool> shut: root.narrow ? !root.open-narrow : root.folded;
    in property <bool> any-picked;
    // What's in the picks: their types, and the line under them ("1,004 sounds · 62 used · 942 never used") with the
    // share of them used.
    in property <[MixPart]> mix;
    in property <string> mix-words;
    in property <float> used-share;
    in-out property <string> search;
    // Where the list is turned to, kept by the page so a tree made again comes back there.
    in-out property <length> kept-y;
    out property <length> room: root.narrow || root.folded ? 28px + Space.sm : 280px + Space.lg;
    callback toggled(string);
    callback opened(string);
    // A chip's ×: a pick taken off, or a hidden folder shown again (`hidden`).
    callback taken-off(string, bool);
    callback right-clicked(string, length, length);
    // A colour of the picks' type mix clicked: that type's name.
    callback mix-picked(string);
    callback search-edited(string);
    callback cleared();
    callback fold();
    function fold-or-open() {
        if root.narrow {
            root.open-narrow = !root.open-narrow;
        } else {
            root.fold();
        }
    }
    width: root.shut ? 28px : 280px;
    clip: true;
    background: root.narrow && !root.shut ? Theme.background : transparent;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.edge;
    }
    if root.shut: Rectangle {
        width: 27px;
        border-radius: Theme.radius;
        background: Theme.surface;
        VerticalLayout {
            y: Space.md;
            height: self.preferred-height;
            for letter in ["F", "O", "L", "D", "E", "R", "S"]: Caps {
                text: letter;
                horizontal-alignment: center;
                color: root.any-picked ? Theme.accent : Theme.muted;
            }
        }
        tab := TouchArea {
            clicked => { root.fold-or-open(); }
        }
    }
    if !root.shut: VerticalLayout {
        width: parent.width - Space.md;
        spacing: Space.sm;
        HorizontalLayout {
            height: 22px;
            Caps {
                text: "FOLDERS";
                vertical-alignment: center;
            }
            Text {
                text: root.picked-words;
                color: Theme.accent;
                font-size: Type.meta;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
            // Folds the tree away to its tab.
            CloseButton {
                tip: "Fold the folders away";
                clicked => { root.fold-or-open(); }
            }
        }
        SearchBox {
            hint: "Find a folder";
            text <=> root.search;
            edited(words) => { root.search-edited(words); }
        }
        tree := ListView {
            vertical-stretch: 1;
            row-height: Heights.tick-line;
            rows: root.lines.length;
            kept-y <=> root.kept-y;
            for l in root.lines: TreeLineView {
                line: l;
                toggled => { root.toggled(l.path); }
                opened => { root.opened(l.path); }
                right-clicked(x, y) => { root.right-clicked(l.path, x, y); }
            }
        }
        // Under the lines, at one height whatever is picked, so a tick never moves a line or shrinks the list (Solomon,
        // 24 Nov 2026). The picks themselves show as chips in a strip under the list ([`PickStrip`]); here, what's in
        // them: their types as one bar (a click on a colour picks that type) and how many your projects use.
        Rectangle {
            height: 104px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.edge;
            }
            if !root.any-picked: Text {
                y: Space.sm;
                width: parent.width;
                height: Heights.tick-line;
                text: root.note;
                color: Theme.faint;
                font-size: Type.meta;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.any-picked: VerticalLayout {
                y: Space.sm;
                height: parent.height - Space.sm;
                spacing: Space.xs;
                alignment: start;
                // (Clear is in the strip with the picks, under the list.)
                Caps {
                    height: Heights.tick-line;
                    text: "IN YOUR PICKS";
                    vertical-alignment: center;
                }
                // The types: each part as wide as its share.
                Rectangle {
                    height: 10px;
                    border-radius: 5px;
                    clip: true;
                    background: Theme.stroke;
                    HorizontalLayout {
                        for part in root.mix: Rectangle {
                            horizontal-stretch: part.share;
                            min-width: 0px;
                            preferred-width: 0px;
                            background: Theme.sound-type(part.colour);
                            opacity: part.dim ? 0.3 : 1;
                            TouchArea {
                                enabled: !part.rest;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => { root.mix-picked(part.name); }
                            }
                        }
                    }
                }
                // The first few named, with their colours.
                HorizontalLayout {
                    height: 16px;
                    spacing: Space.sm;
                    for part[i] in root.mix: HorizontalLayout {
                        visible: i < 3;
                        width: i < 3 ? self.preferred-width : 0px;
                        spacing: Space.xs;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 2px;
                                background: Theme.sound-type(part.colour);
                            }
                        }
                        Text {
                            text: part.name + " " + part.count;
                            color: Theme.muted;
                            font-size: Type.tiny;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // How much of them your projects use.
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    clip: true;
                    background: Theme.stroke;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.used-share, 0, 1);
                        background: Theme.accent;
                    }
                }
                Text {
                    text: root.mix-words;
                    color: Theme.faint;
                    font-size: Type.tiny;
                    overflow: elide;
                }
            }
        }
    }
}

// The picked and hidden folders as chips in a strip under the list, every one in sight (Solomon, 25 Nov 2026: past
// two they couldn't be seen under the tree), wrapping to more rows as they need; a chip's × takes it off.
export component PickStrip inherits Rectangle {
    in property <[TreePick]> picks;
    // Folders are picked (not only hidden): Clear has something to take off.
    in property <bool> any-picked;
    callback taken-off(string, bool);
    callback cleared();
    height: root.picks.length > 0 ? row.preferred-height : 0px;
    visible: root.picks.length > 0;
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.edge;
    }
    row := HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: Space.md;
        VerticalLayout {
            alignment: start;
            Caps {
                height: Heights.button;
                text: "FOLDERS";
                vertical-alignment: center;
            }
        }
        chips := FlexboxLayout {
            horizontal-stretch: 1;
            spacing: Space.xs;
            for p in root.picks: TagChip {
                text: p.hidden ? "Hidden: " + p.text : p.count == "" ? p.text : p.text + "  " + p.count;
                on: !p.hidden;
                remove-tip: p.hidden ? "Show this folder's sounds again" : "Take this folder off";
                clicked => { root.taken-off(p.path, p.hidden); }
                removed => { root.taken-off(p.path, p.hidden); }
            }
        }
        if root.any-picked: VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;
            StudioButton {
                text: "Clear";
                tip: "Take every folder pick off";
                clicked => { root.cleared(); }
            }
        }
    }
}
