<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# half of the twin test: runs the C# app's readers, unchanged, and writes what they find as JSON.
    It builds against a read-only clone of Silkie86/Music-Organiser; say where it is with -p:MoOldRepo=<folder>.
    The app's plugin scanner and Bitwig extension aren't needed to read files, so leave them out:
    dotnet build tools/twin/cs -c Release -p:MoOldRepo=<folder> -p:MoBuildNative=false -p:MoBuildBitwig=false
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>twin-cs</AssemblyName>
    <MoOldRepo Condition="'$(MoOldRepo)' == ''">$(MSBuildThisFileDirectory)../../../../Music-Organiser</MoOldRepo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MoOldRepo)/src/MusicOrganiser.Core/MusicOrganiser.Core.csproj" />
  </ItemGroup>
</Project>
